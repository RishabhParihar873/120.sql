'        AND CODE IN (',
'            SELECT CODE FROM (',
'                SELECT ''NOT STARTED'' AS CODE FROM DUAL WHERE :P1057_EMPLOYEE_ACCESS_STATUS IS NULL',
'                UNION ALL',
'                SELECT ''NOT STARTED'' FROM DUAL WHERE :P1057_EMPLOYEE_ACCESS_STATUS = ''NOT STARTED''',
'                UNION ALL',
'                SELECT ''WIP'' FROM DUAL WHERE :P1057_EMPLOYEE_ACCESS_STATUS = ''NOT STARTED''',
'                UNION ALL',
'                SELECT ''WIP'' FROM DUAL WHERE :P1057_EMPLOYEE_ACCESS_STATUS = ''WIP''',
'                UNION ALL',
'                SELECT ''COMPLETED'' FROM DUAL WHERE :P1057_EMPLOYEE_ACCESS_STATUS = ''WIP''',
'                UNION ALL',
'                SELECT ''COMPLETED'' FROM DUAL WHERE :P1057_EMPLOYEE_ACCESS_STATUS = ''COMPLETED''',
