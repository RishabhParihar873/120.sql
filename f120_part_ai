  'plsql_code', wwv_flow_string.join(wwv_flow_t_varchar2(
    'DECLARE',
    '    l_url                   VARCHAR2(4000);',
    '    l_token                 VARCHAR2(100);',
    '    l_sheet_id              NUMBER;',
    '    l_payload               CLOB;',
    '    l_response              CLOB;',
    '    l_row_id                NUMBER;',
    '    -- p_project_id            NUMBER := 1445;',
    '    p_project_id            NUMBER := :P1053_PRJ_ID;',
    '',
    '    -- Column IDs from table',
    '    l_col_predecessors      VARCHAR2(50);',
    '    ',
    '    -- Add more as needed...',
    '',
    'BEGIN',
    '    debug_proc(''Inside REMOVING PREDECESSORS'' || TO_CHAR(SYSTIMESTAMP, ''HH24:MI:SS.FF3''), ''Start'');',
    '',
    '    -- Step 1: Get Sheet ID',
    '    -- BEGIN',
    '        SELECT SHEET_ID INTO l_sheet_id',
    '        FROM CGCT_PROJECT_MASTER',
    '        WHERE ID = p_project_id;',
    '    -- EXCEPTION',
    '    --     WHEN OTHERS THEN',
    '    --         apex_debug.message(''Error Fetching Sheet ID: '' || SQLERRM);',
    '    -- END;',
    '',
    '    IF l_sheet_id IS NOT NULL THEN',
    '        -- Step 2: Get API Key',
    '        -- BEGIN',
    '            select ST.API_KEY INTO l_token',
    '            from cgct_project_master PM',
    '            JOIN CGCT_SHEETS S ON PM.SHEET_ID = S.sheet_ID',
    '            JOIN CGCT_SMARTSHEET_TOKENS ST ON S.USER_ID = ST.api_id ',
    '            WHERE PM.ID = p_project_id',
    '            AND ROWNUM = 1;',
    '        -- EXCEPTION',
    '        --     WHEN OTHERS THEN',
    '        --         apex_debug.message(''Error Fetching API Key: '' || SQLERRM);',
    '        -- END;',
    '',
    '        -- Step 3: Get ROW ID',
    '        -- BEGIN',
    '            SELECT ROW_ID INTO l_row_id',
    '            FROM CGCT_PP_PLAN_LINE',
    '            WHERE PROJECT_PLAN_LINE_ID = :P1053_PROJECT_PLAN_LINE_ID;',
    '        -- EXCEPTION',
    '        --     WHEN OTHERS THEN',
    '        --         apex_debug.message(''Error Fetching ROW ID: '' || SQLERRM);',
    '        -- END;',
    '  ',
    '  ',
    unistr('        -- \D83D\DD0D Lookup column IDs from table'),
    '        -- BEGIN',
    '            ',
    '            SELECT col_id INTO l_col_predecessors',
    '            FROM CGCT_SMARTSHEET_COLUMN',
    '            WHERE SHEET_ID = l_sheet_id AND COL_TITLE = ''predecessors'';',
    '        ',
    '        -- EXCEPTION',
    '        --     WHEN OTHERS THEN',
    '        --         apex_debug.message(''Error Fetching Column ID : '' || SQLERRM);',
    '        -- END;',
    '',
    unistr('        -- \D83C\DF10 Construct Smartsheet API URL'),
    '        -- BEGIN',
    '            l_url := ''https://api.smartsheet.com/2.0/sheets/'' || l_sheet_id || ''/rows'';',
    '',
    unistr('            -- \D83E\DDF1 Build JSON payload '),
    '            l_payload := ''{'' ||',
    '                ''"id": '' || l_row_id || '','' ||',
    '                ''"cells": ['' ||',
    '                    ''{ "columnId": '' || l_col_predecessors || '', "value": "" }'';',
    '            ',
    '            l_payload := l_payload || ''] }'';',
    '        -- EXCEPTION',
    '        --     WHEN OTHERS THEN',
    '        --         apex_debug.message(''Error Constructing URL/Payload: '' || SQLERRM);',
    '        -- END;',
    '',
    unistr('        -- \D83D\DEE1\FE0F Set authorization header'),
    '        -- BEGIN',
    '            apex_web_service.g_request_headers(1).name := ''Authorization'';',
    '            apex_web_service.g_request_headers(1).value := ''Bearer '' || l_token;',
    '            apex_web_service.g_request_headers(2).name := ''Content-Type'';',
    '            apex_web_service.g_request_headers(2).value := ''application/json'';',
    '',
    unistr('            -- \D83D\DE80 Make PUT request to Smartsheet'),
    '            l_response := apex_web_service.make_rest_request(',
    '              p_url         => l_url,',
    '              p_http_method => ''PUT'',',
    '              p_body        => l_payload',
    '            );',
    '        -- EXCEPTION',
    '        --     WHEN OTHERS THEN',
    '        --         apex_debug.message(''Error API Called Failed: '' || SQLERRM);',
    '        -- END;',
    '',
    '        apex_json.parse(l_response);',
    '        apex_debug.message(''Smartsheet Response: '' || l_response);',
    '        COMMIT;',
    '    END IF;',
    '',
    '    UPDATE CGCT_PP_PLAN_LINE',
    '    SET PREDECESSORS =''''',
    '    WHERE PROJECT_PLAN_LINE_ID =:P1053_PROJECT_PLAN_LINE_ID;',
    '',
    '    debug_proc(''Inside REMOVING PREDECESSORS'' || TO_CHAR(SYSTIMESTAMP, ''HH24:MI:SS.FF3''), ''End'');',
    'END;')),
