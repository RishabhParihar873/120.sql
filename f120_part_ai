'    -- apex_web_service.g_request_headers(1).value := ''application/json'';',
'',
'    -- l_response_pipeline := apex_web_service.make_rest_request(',
'    --     p_url => ''https://cwkfvo65cuzpsk4g3zddt4rqhu.apigateway.us-ashburn-1.oci.customer-oci.com/api/v1/pipeline/''',
