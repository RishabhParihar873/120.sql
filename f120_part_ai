,p_process_name=>'RUN_DOC_PROCESS'
,p_static_id=>'run-doc-process'
,p_process_sql_clob=>wwv_flow_string.join(wwv_flow_t_varchar2(
'DECLARE',
'    l_response            CLOB;',
'    l_response_pipeline   CLOB;',
'    l_body                CLOB;',
'    l_body_pipeline       CLOB;',
'    l_project_id          VARCHAR2(100);',
'    l_project_code        VARCHAR2(100);',
'',
'    l_blob         BLOB;',
'    l_filename     VARCHAR2(255);',
'    l_mime_type    VARCHAR2(255);',
'    l_doc_type     VARCHAR2(100);',
'',
'    l_request_body BLOB;',
'    l_boundary     VARCHAR2(50) := ''----WebKitFormBoundary7MA4YWxkTrZu0gW'';',
'    l_part         RAW(32767);',
'    ',
'    l_url VARCHAR2(4000);',
'    l_pipeline_status VARCHAR2(50);',
'    l_pct_complete    NUMBER;',
'',
'    l_attempts          NUMBER := 0;',
'    l_max_attempts      NUMBER := 120; -- 120 * 10 seconds = 20 minutes max wait',
'',
'BEGIN',
'',
'    ------------------------------------------------------------',
'    -- 1. CREATE PROJECT',
'    ------------------------------------------------------------',
'    SELECT ''ICT-'' || ICT_PROJECT_SEQ.NEXTVAL',
'    INTO l_project_code',
'    FROM dual;',
'',
'    l_body := JSON_OBJECT(',
'        ''project_code'' VALUE l_project_code,',
'        ''project_name'' VALUE ''ICT_PROJECT'',',
'        ''project_type'' VALUE ''INTEGRATION'',',
'        ''fsd_template_code'' VALUE ''HCM_INTEGRATION_V1''',
'    );',
'',
'    apex_web_service.g_request_headers.DELETE;',
'    apex_web_service.g_request_headers(1).name  := ''Content-Type'';',
'    apex_web_service.g_request_headers(1).value := ''application/json'';',
'',
'    l_response := apex_web_service.make_rest_request(',
'        p_url => ''https://cwkfvo65cuzpsk4g3zddt4rqhu.apigateway.us-ashburn-1.oci.customer-oci.com/api/v1/projects'',',
'        p_http_method => ''POST'',',
'        p_body => l_body',
'    );',
'',
'    -- SELECT project_id',
'    -- INTO l_project_id',
'    -- FROM JSON_TABLE(',
'    --     l_response,',
'    --     ''$''',
'    --     COLUMNS (project_id VARCHAR2(100) PATH ''$.project_id'')',
'    -- );',
'',
'    l_project_id := 1095;',
'    :P1052_GENERATED_PROJECT_ID := l_project_id;',
'',
'    ------------------------------------------------------------',
'    -- 2. UPLOAD FILE',
'    ------------------------------------------------------------',
'    SELECT blob_content, filename, mime_type',
'    INTO l_blob, l_filename, l_mime_type',
'    FROM FILE_UPLOAD_TST',
'    WHERE ID = 3;',
'',
'    IF INSTR(l_filename, ''.'') = 0 THEN',
'        l_filename := l_filename || ''.xlsx'';',
'    END IF;',
'',
'    l_mime_type := ''application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'';',
'    l_doc_type  := ''EXCEL'';',
'',
'    DBMS_LOB.CREATETEMPORARY(l_request_body, TRUE);',
'',
'    -- project_id part',
'    l_part := UTL_RAW.CAST_TO_RAW(',
'        ''--'' || l_boundary || CHR(13) || CHR(10) ||',
'        ''Content-Disposition: form-data; name="project_id"'' || CHR(13) || CHR(10) || CHR(13) || CHR(10) ||',
'        l_project_id || CHR(13) || CHR(10)',
'    );',
'    DBMS_LOB.WRITEAPPEND(l_request_body, UTL_RAW.LENGTH(l_part), l_part);',
'',
'    -- doc_type part',
'    l_part := UTL_RAW.CAST_TO_RAW(',
'        ''--'' || l_boundary || CHR(13) || CHR(10) ||',
'        ''Content-Disposition: form-data; name="doc_type"'' || CHR(13) || CHR(10) || CHR(13) || CHR(10) ||',
'        l_doc_type || CHR(13) || CHR(10)',
'    );',
'    DBMS_LOB.WRITEAPPEND(l_request_body, UTL_RAW.LENGTH(l_part), l_part);',
'',
'    -- file part',
'    l_part := UTL_RAW.CAST_TO_RAW(',
'        ''--'' || l_boundary || CHR(13) || CHR(10) ||',
'        ''Content-Disposition: form-data; name="file"; filename="'' || l_filename || ''"'' || CHR(13) || CHR(10) ||',
'        ''Content-Type: '' || l_mime_type || CHR(13) || CHR(10) || CHR(13) || CHR(10)',
'    );',
'    DBMS_LOB.WRITEAPPEND(l_request_body, UTL_RAW.LENGTH(l_part), l_part);',
'',
'    DBMS_LOB.APPEND(l_request_body, l_blob);',
'',
'    -- close boundary',
'    l_part := UTL_RAW.CAST_TO_RAW(',
'        CHR(13) || CHR(10) || ''--'' || l_boundary || ''--'' || CHR(13) || CHR(10)',
'    );',
'    DBMS_LOB.WRITEAPPEND(l_request_body, UTL_RAW.LENGTH(l_part), l_part);',
'',
'    apex_web_service.g_request_headers.DELETE;',
'    apex_web_service.g_request_headers(1).name := ''Content-Type'';',
'    apex_web_service.g_request_headers(1).value :=',
'        ''multipart/form-data; boundary='' || l_boundary;',
'',
'    l_response := apex_web_service.make_rest_request(',
'        p_url => ''https://cwkfvo65cuzpsk4g3zddt4rqhu.apigateway.us-ashburn-1.oci.customer-oci.com/api/v1/documents/upload'',',
'        p_http_method => ''POST'',',
'        p_body_blob => l_request_body',
'    );',
'',
'    ------------------------------------------------------------',
unistr('    -- 3. RUN PIPELINE \2705'),
'    ------------------------------------------------------------',
'    -- l_body_pipeline := JSON_OBJECT(',
'    --     ''mode'' VALUE ''FULL'',',
'    --     ''doc_format'' VALUE ''DOCX''',
'    -- );',
'',
'    -- apex_web_service.g_request_headers.DELETE;',
'    -- apex_web_service.g_request_headers(1).name  := ''Content-Type'';',
'    -- apex_web_service.g_request_headers(1).value := ''application/json'';',
'',
'    -- l_response_pipeline := apex_web_service.make_rest_request(',
'    --     p_url => ''https://cwkfvo65cuzpsk4g3zddt4rqhu.apigateway.us-ashburn-1.oci.customer-oci.com/api/v1/pipeline/''',
'    --              || l_project_id || ''/run'',',
'    --     p_http_method => ''POST'',',
'    --     p_body => l_body_pipeline',
'    -- );',
'',
'    apex_debug.message(''Pipeline created successfully. Waiting for completion...'');',
'',
'    ------------------------------------------------------------',
unistr('    -- WAIT FOR PIPELINE COMPLETION \2705'),
'    ------------------------------------------------------------',
'    LOOP',
'        l_attempts := l_attempts + 1;',
'',
'        apex_web_service.g_request_headers.DELETE;',
'',
'        l_response := apex_web_service.make_rest_request(',
'            p_url => ''https://cwkfvo65cuzpsk4g3zddt4rqhu.apigateway.us-ashburn-1.oci.customer-oci.com/api/v1/pipeline/''',
'                     || l_project_id || ''/status'',',
'            p_http_method => ''GET''',
'        );',
'',
'        SELECT pipeline_status, pct_complete',
'        INTO l_pipeline_status, l_pct_complete',
'        FROM JSON_TABLE(',
'            l_response,',
'            ''$''',
'            COLUMNS (',
'                pipeline_status VARCHAR2(50) PATH ''$.pipeline_status'',',
'                pct_complete    NUMBER       PATH ''$.pct_complete''',
'            )',
'        );',
'',
'        l_pipeline_status := UPPER(TRIM(l_pipeline_status));',
'',
'        apex_debug.message(',
'            ''Pipeline Status: '' || l_pipeline_status ||',
'            '' %: '' || NVL(TO_CHAR(l_pct_complete), ''0'') ||',
'            '' Attempt: '' || l_attempts',
'        );',
'',
'        EXIT WHEN l_pipeline_status = ''COMPLETED'';',
'',
'        IF l_pipeline_status IN (''FAILED'', ''ERROR'', ''CANCELLED'') THEN',
'            RAISE_APPLICATION_ERROR(',
'                -20001,',
'                ''Pipeline failed with status: '' || l_pipeline_status',
'            );',
'        END IF;',
'',
'        IF l_attempts >= l_max_attempts THEN',
'            RAISE_APPLICATION_ERROR(',
'                -20002,',
'                ''Pipeline did not complete within expected time. Last status: ''',
'                || NVL(l_pipeline_status, ''UNKNOWN'')',
'            );',
'        END IF;',
'',
'        DBMS_SESSION.SLEEP(10);',
'    END LOOP;',
'',
'    apex_debug.message(''Pipeline completed successfully.'');',
'',
'    ------------------------------------------------------------',
unistr('    -- 4. VALIDATE \2705'),
'    ------------------------------------------------------------',
'    apex_debug.message(''Pipeline completed. Validation starting...'');',
'',
'    apex_web_service.g_request_headers.DELETE;',
'',
'    l_response := apex_web_service.make_rest_request(',
'        p_url => ''https://cwkfvo65cuzpsk4g3zddt4rqhu.apigateway.us-ashburn-1.oci.customer-oci.com/api/v1/sections/project/''',
'                 || l_project_id || ''/validate-all'',',
'        p_http_method => ''POST''',
'    );',
'',
'    apex_debug.message(''Validation completed, approval starting...'');',
'',
'    ------------------------------------------------------------',
unistr('    -- 5. BULK APPROVE \2705'),
'    ------------------------------------------------------------',
'    apex_web_service.g_request_headers.DELETE;',
'',
'    l_response := apex_web_service.make_rest_request(',
'        p_url => ''https://cwkfvo65cuzpsk4g3zddt4rqhu.apigateway.us-ashburn-1.oci.customer-oci.com/api/v1/approvals/project/''',
'                 || l_project_id || ''/bulk-approve'',',
'        p_http_method => ''POST''',
'    );',
'',
'    apex_debug.message(''Approval completed successfully.'');',
'',
'    ------------------------------------------------------------',
unistr('    -- FINAL RESPONSE \2705'),
'    ------------------------------------------------------------',
'    l_url := apex_page.get_url(',
'        p_page   => 1016,',
'        p_items  => ''P1016_PRJ_ID'',',
'        p_values => l_project_id',
'    );',
'',
'    apex_json.initialize_clob_output;',
'',
'    apex_json.open_object;',
'    apex_json.write(''status'', ''SUCCESS'');',
'    apex_json.write(',
'        ''message'',',
'        ''Pipeline completed successfully. Validation completed successfully. Approval completed successfully.''',
'    );',
'    apex_json.write(''project_id'', l_project_id);',
'    apex_json.write(''redirect_url'', l_url);',
'    apex_json.close_object;',
'',
'    htp.p(apex_json.get_clob_output);',
'    apex_json.free_output;',
'',
'EXCEPTION',
'    WHEN OTHERS THEN',
'        apex_json.initialize_clob_output;',
'',
'        apex_json.open_object;',
'        apex_json.write(''status'', ''ERROR'');',
'        apex_json.write(''message'', SQLERRM);',
'        apex_json.close_object;',
'',
'        htp.p(apex_json.get_clob_output);',
'        apex_json.free_output;',
'END;'))
,p_process_clob_language=>'PLSQL'
,p_internal_uid=>471724279858999409
,p_created_on=>wwv_flow_imp.dz('20260824105056Z')
,p_updated_on=>wwv_flow_imp.dz('20260824105056Z')
,p_created_by=>'DEL_DEV'
,p_updated_by=>'DEL_DEV'
);
