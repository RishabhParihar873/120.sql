    '  } catch (e) {',
    '    console.debug(''min/max not set programmatically; formatter still enforces the range.'', e);',
    '  }',
    '',
    '  if (typeof itemObj.refresh === ''function'') {',
    '    itemObj.refresh();',
    '  }',
    '',
    '  var cur = parseToDate($v(''P1059_PLANNED_START''));',
    '  if (cur) {',
    '    var curWeekend = (cur.getDay() === 0 || cur.getDay() === 6);',
