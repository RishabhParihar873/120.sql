,p_process_sql_clob=>wwv_flow_string.join(wwv_flow_t_varchar2(
'declare',
'    l_base_url constant varchar2(4000) :=',
'        ''https://gs7i2qgix5vgb7s4jhqsu3wllm.apigateway.us-ashburn-1.oci.customer-oci.com/api/v1'';',
'',
'    l_doc_blob      blob;',
'    l_user_api_key  varchar2(4000) := ''udoc_iYyFaS7aeOd2J5oqtzOl5pvkCeRy61a5osWIVBRoBWw'';',
'',
'    -- Supported values: DOCX, XLSX, PPTX',
'    -- l_format        varchar2(10) := ''DOCX'';',
'    l_format        varchar2(10);',
'',
'    -- l_doc_id        varchar2(100) := ''5841e6ce-e463-4a22-b5ff-f3b1ad72b66b'';',
'    l_doc_id        varchar2(100) := :P1016_DOCUMENT_ID;',
'',
'    l_content_type  varchar2(200);',
'    l_filename      varchar2(100);',
'    l_url           varchar2(4000);',
'    ',
'    begin',
'',
'          SELECT ',
'          SUBSTR(template_file_path, INSTR(template_file_path, ''.'', -1) + 1) into l_format',
'      FROM cgct_project_templates ',
'      WHERE id = (',
'          SELECT template_id ',
'          FROM cgct_pp_plan_line ',
'          WHERE project_plan_line_id = :P1016_PROJECT_PLAN_LINE_ID',
'      );',
'',
'',
'    apex_web_service.g_request_headers.delete;',
'',
'    apex_web_service.g_request_headers(1).name  := ''X-API-Key'';',
'    apex_web_service.g_request_headers(1).value := l_user_api_key;',
'',
'    ------------------------------------------------------------------',
'    -- Build URL and MIME type based on requested format',
'    ------------------------------------------------------------------',
'    case upper(l_format)',
'',
'        when ''DOCX'' then',
'            l_url :=',
'                l_base_url',
'                || ''/documents/''',
'                || l_doc_id',
'                || ''/export?format=docx'';',
'',
'            l_content_type :=',
'                ''application/vnd.openxmlformats-officedocument.wordprocessingml.document'';',
'',
'            l_filename := ''Generated_document.docx'';',
'',
'        when ''XLSX'' then',
'            l_url :=',
'                l_base_url',
'                || ''/documents/''',
'                || l_doc_id',
'                || ''/export?format=xlsx'';',
'',
'            l_content_type :=',
'                ''application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'';',
'',
'            l_filename := ''Generated_document.xlsx'';',
'',
'        when ''PPTX'' then',
'            l_url :=',
'                l_base_url',
'                || ''/documents/''',
'                || l_doc_id',
'                || ''/export?format=pptx'';',
'',
'            l_content_type :=',
'                ''application/vnd.openxmlformats-officedocument.presentationml.presentation'';',
'',
'            l_filename := ''Generated_document.pptx'';',
'',
'        else',
'            raise_application_error(',
'                -20001,',
'                ''Unsupported format: '' || l_format',
'            );',
'    end case;',
'',
'    ------------------------------------------------------------------',
'    -- Download document',
'    ------------------------------------------------------------------',
'    l_doc_blob := apex_web_service.make_rest_request_b(',
'        p_url         => l_url,',
'        p_http_method => ''GET''',
'    );',
'',
'    if apex_web_service.g_status_code <> 200 then',
'        raise_application_error(',
'            -20002,',
'            ''Document download failed. HTTP Status: ''',
'            || apex_web_service.g_status_code',
'        );',
'    end if;',
'',
'    if l_doc_blob is null',
'       or dbms_lob.getlength(l_doc_blob) = 0 then',
'        raise_application_error(',
'            -20003,',
'            ''The document service returned an empty file.''',
'        );',
'    end if;',
'',
'    ------------------------------------------------------------------',
'    -- Return file to browser',
'    ------------------------------------------------------------------',
'    sys.htp.init;',
'',
'    owa_util.mime_header(',
'        ccontent_type => l_content_type,',
'        bclose_header => false',
'    );',
'',
'    htp.p(''Content-Length: '' || dbms_lob.getlength(l_doc_blob));',
'    htp.p(''Content-Disposition: attachment; filename="'' || l_filename || ''"'');',
'    htp.p(''Cache-Control: no-store'');',
'',
'    owa_util.http_header_close;',
'',
'    wpg_docload.download_file(l_doc_blob);',
'',
'    apex_application.stop_apex_engine;',
'',
'exception',
'    when apex_application.e_stop_apex_engine then',
'        raise;',
'',
'    when others then',
'        raise;',
