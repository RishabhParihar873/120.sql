,p_process_sql_clob=>wwv_flow_string.join(wwv_flow_t_varchar2(
'DECLARE',
'    l_response    CLOB;',
'    l_doc         CLOB;',
'    l_link        VARCHAR2(4000);',
'    l_file_id     VARCHAR2(4000);',
'    l_status      VARCHAR2(100);',
'    l_message     VARCHAR2(4000);',
'    l_body        CLOB;',
'    l_file_text   CLOB;',
'    l_http_status NUMBER;',
'BEGIN',
'    ------------------------------------------------------------------',
'    -- Step 1: Get uploaded file',
'    ------------------------------------------------------------------',
'    SELECT TO_CLOB(UTL_RAW.CAST_TO_VARCHAR2(BLOB_CONTENT))',
'    INTO l_file_text',
'    FROM APEX_APPLICATION_TEMP_FILES',
'    WHERE NAME = :P1012_CHOOSE_FILE',
'    AND ROWNUM = 1;',
'',
'    ------------------------------------------------------------------',
'    -- CASE 1: MANUAL',
'    ------------------------------------------------------------------',
'    IF UPPER(TRIM(:P1012_TYPE)) = ''MANUAL'' THEN',
'',
'        UPDATE CGCT_DELIVERABLE_API_DOCUMENT',
'        SET ',
'            MARKDOWN_CONTENT = l_file_text,',
'            TYPE = ''Manual''',
'        WHERE DELIVERABLE_ID = :P1012_DELIVARABLE_ID;',
'',
'    ------------------------------------------------------------------',
'    -- CASE 2: AI / AI EDITED',
'    ------------------------------------------------------------------',
'    ELSIF UPPER(TRIM(:P1012_TYPE)) IN (''AI'',''AI EDITED'') THEN',
'',
'        apex_web_service.g_request_headers.delete;',
'',
'        apex_web_service.g_request_headers(1).name  := ''Content-Type'';',
'        apex_web_service.g_request_headers(1).value := ''application/json; charset=UTF-8'';',
'',
'        ------------------------------------------------------------------',
'        -- Build JSON safely',
'        ------------------------------------------------------------------',
'        apex_json.initialize_clob_output;',
'        apex_json.open_object;',
'',
'        apex_json.write(''project_id'', :P1012_PRJ_ID);',
'        apex_json.write(''project_name'', :P1012_TASK_NAME);',
'        apex_json.write(''manual_content'', l_file_text);',
'',
'        apex_json.close_object;',
'',
'        l_body := apex_json.get_clob_output;',
'        apex_json.free_output;',
'',
'        ------------------------------------------------------------------',
'        -- Call API',
'        ------------------------------------------------------------------',
'        l_response := apex_web_service.make_rest_request(',
'            p_url         => ''https://apex-ai-api.onrender.com/generate-doc'',',
'            p_http_method => ''POST'',',
'            p_body        => l_body',
'        );',
'',
'        l_http_status := apex_web_service.g_status_code;',
'',
'        ------------------------------------------------------------------',
unistr('        -- \2705 IMPORTANT: HTTP status validation'),
'        ------------------------------------------------------------------',
'        IF l_http_status <> 200 THEN',
'            :P1012_ERROR_MESSAGE :=',
'                ''HTTP ERROR '' || l_http_status || '' - '' ||',
'                DBMS_LOB.SUBSTR(l_response, 1000, 1);',
'            RETURN;',
'        END IF;',
'',
'        ------------------------------------------------------------------',
'        -- Parse response safely',
'        ------------------------------------------------------------------',
'        apex_json.parse(l_response);',
'',
'        l_status := apex_json.get_varchar2(''status'');',
'',
'        ------------------------------------------------------------------',
unistr('        -- \2705 Handle API failure'),
'        ------------------------------------------------------------------',
'        IF l_status IS NULL OR l_status <> ''SUCCESS'' THEN',
'            l_message := apex_json.get_varchar2(''message'');',
'            :P1012_ERROR_MESSAGE := NVL(l_message, ''API failed'');',
'            RETURN;',
'        END IF;',
'',
'        ------------------------------------------------------------------',
'        -- Get response values',
'        ------------------------------------------------------------------',
'        l_doc     := apex_json.get_clob(''document'');',
'        l_link    := apex_json.get_varchar2(''download_link'');',
'        l_file_id := apex_json.get_varchar2(''file_id'');',
'',
'        ------------------------------------------------------------------',
'        -- Save to DB',
'        ------------------------------------------------------------------',
'        UPDATE CGCT_DELIVERABLE_API_DOCUMENT',
'        SET ',
'            MARKDOWN_CONTENT = l_doc,',
'            LINK             = l_link,',
'            TYPE             = ''AI EDITED''',
'        WHERE DELIVERABLE_ID = :P1012_DELIVARABLE_ID;',
'',
'    END IF;',
'',
'EXCEPTION',
'    WHEN OTHERS THEN',
'        :P1012_ERROR_MESSAGE := SQLERRM;',
'END;',
''))
,p_process_clob_language=>'PLSQL'
,p_error_display_location=>'INLINE_IN_NOTIFICATION'
,p_process_when_button_id=>wwv_flow_imp.id(420310908891561113)
,p_internal_uid=>420311768002561121
,p_created_on=>wwv_flow_imp.dz('20260624103946Z')
,p_updated_on=>wwv_flow_imp.dz('20260624105002Z')
,p_created_by=>'DEL_DEV'
,p_updated_by=>'DEL_DEV'
);
