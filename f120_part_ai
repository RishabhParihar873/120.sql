,p_ajax_items_to_submit=>'P1079_MIN_DATE,P1079_MAX_DATE,P1079_DATE_OFFSET,P1079_D1_LABEL,P1079_D2_LABEL,P1079_D3_LABEL,P1079_D4_LABEL,P1079_D5_LABEL,P1079_NEW,P1079_DATE_RANGE'
,p_fixed_header=>'PAGE'
