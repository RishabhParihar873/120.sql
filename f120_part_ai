'',
'-- LEFT JOIN CGCT_DELIVERABLE_API_DOCUMENT doc',
'--        ON doc.PROJECT_PLAN_LINE_ID = H.PROJECT_PLAN_LINE_ID',
'LEFT JOIN (',
'    SELECT *',
'    FROM (',
'        SELECT d.*,',
'               ROW_NUMBER() OVER (',
'                   PARTITION BY d.project_plan_line_id',
'                --    ORDER BY d.document_id DESC',
'                   ORDER BY d.deliverable_id DESC',
'               ) rn',
'        FROM CGCT_DELIVERABLE_API_DOCUMENT d',
'    )',
'    WHERE rn = 1',
') doc',
'ON doc.project_plan_line_id = H.project_plan_line_id',
'',
'',
'WHERE ( :P1055_WAVE        IS NULL OR H.WAVE_ID    = :P1055_WAVE )',
'AND H.levels > 3',
'-- AND ( :P1055_PHASE_ID       IS NULL OR H.PHASE_ID   in( :P1055_PHASE_ID ))',
'AND ( :P1055_PHASE_ID IS NULL',
'      OR H.PHASE_ID IN (',
'            SELECT TO_NUMBER(column_value)',
'            FROM TABLE(APEX_STRING.SPLIT(:P1055_PHASE_ID, '',''))',
'        )',
'    )',
'',
'AND ( :P1055_SUB_PHASE   IS NULL OR H.SUBPHASE_ID = :P1055_SUB_PHASE )',
'AND ( :P1055_STATUS      IS NULL OR H.STATUS     = :P1055_STATUS ) ',
'AND ( :P1055_WORK_STREAM IS NULL OR H.WORKSTREAM = :P1055_WORK_STREAM )',
