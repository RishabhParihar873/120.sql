,p_use_cache_before_default=>'NO'
,p_prompt=>'Predecessors'
,p_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'WITH src AS (',
'  SELECT project_plan_line_id,',
'         predecessors',
'  FROM cgct_pp_plan_line',
'  WHERE project_plan_line_id = :P1059_PROJECT_PLAN_LINE_ID',
'),',
'tokens AS (',
'  SELECT DISTINCT',
'         TRIM(REGEXP_SUBSTR(s.predecessors, ''[^,]+'', 1, LEVEL)) AS pred_num_text',
'  FROM src s',
'  CONNECT BY REGEXP_SUBSTR(s.predecessors, ''[^,]+'', 1, LEVEL) IS NOT NULL',
'         AND PRIOR s.project_plan_line_id = s.project_plan_line_id',
'         AND PRIOR DBMS_RANDOM.VALUE IS NOT NULL',
')',
'SELECT LISTAGG(',
'         t.TASK_NUMBER || '' - '' || NVL(t.task_name,null),',
'         '', ''',
'       ) WITHIN GROUP (ORDER BY t.TASK_NUMBER) AS predecessors_display',
'FROM tokens tok',
'LEFT JOIN (',
'     SELECT DISTINCT TASK_NUMBER, task_name, ROW_NUMBER',
'     FROM cgct_pp_plan_line',
'     WHERE PROJECT_PLAN_ID =:P1059_PROJECT_PLAN_ID',
' ',
') t',
'   ON t.ROW_NUMBER = TO_NUMBER(tok.pred_num_text);'))
,p_source_type=>'QUERY'
,p_display_as=>'NATIVE_DISPLAY_ONLY'
