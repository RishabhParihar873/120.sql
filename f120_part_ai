wwv_flow_imp_page.create_page_process(
 p_id=>wwv_flow_imp.id(27871501222418078)
,p_process_sequence=>30
,p_process_point=>'AFTER_SUBMIT'
,p_process_type=>'NATIVE_PLSQL'
,p_process_name=>'Creation of  Project_key_id'
,p_static_id=>'creation-of-project-key-id'
,p_process_sql_clob=>wwv_flow_string.join(wwv_flow_t_varchar2(
'DECLARE',
'    l_url          VARCHAR2(1000) :=',
'        ''https://gs7i2qgix5vgb7s4jhqsu3wllm.apigateway.us-ashburn-1.oci.customer-oci.com/api/v1/admin/projects'';',
'',
'    l_json_body    CLOB;',
'    l_response     CLOB;',
'    l_project_id   VARCHAR2(200);',
'    l_prj_key   VARCHAR2(200);',
'    l_status_code  PLS_INTEGER;',
'BEGIN',
'    /*',
'      JSON_OBJECT safely escapes quotation marks, backslashes,',
'      line breaks, and other special characters in the project name.',
'    */',
'    select code into l_prj_key  from CGCT_LOOKUP_VALUES where type_id in (select id from CGCT_LOOKUP_TYPE where LOOKUP_TYPE=''ADMIN_KEY'');',
'    SELECT JSON_OBJECT(',
'               ''name'' VALUE :P1091_PROJECT_NAME,',
'               ''slug'' VALUE LOWER(',
'                   REGEXP_REPLACE(',
'                       TRIM(:P1091_PROJECT_NAME),',
'                       ''[^[:alnum:]]+'',',
'                       ''-''',
'                   )',
'               )',
'               RETURNING CLOB',
'           )',
'      INTO l_json_body',
'      FROM dual;',
'',
'    -- Remove headers left behind by earlier web-service calls.',
'    apex_web_service.g_request_headers.DELETE;',
'',
'    apex_web_service.g_request_headers(1).name  := ''Content-Type'';',
'    apex_web_service.g_request_headers(1).value := ''application/json'';',
'',
'    apex_web_service.g_request_headers(2).name  := ''Accept'';',
'    apex_web_service.g_request_headers(2).value := ''application/json'';',
'',
'    apex_web_service.g_request_headers(3).name  := ''X-ADMIN-Key'';',
'    apex_web_service.g_request_headers(3).value := l_prj_key;',
'',
'    -- Send the POST request and receive the complete response.',
'    l_response := apex_web_service.make_rest_request(',
'        p_url         => l_url,',
'        p_http_method => ''POST'',',
'        p_body         => l_json_body',
'    );',
'',
'    l_status_code := apex_web_service.g_status_code;',
'',
'    -- Accept any successful HTTP 2xx response.',
'    IF l_status_code BETWEEN 200 AND 299 THEN',
'        l_project_id := JSON_VALUE(',
'            l_response,',
'            ''$.id'' RETURNING VARCHAR2',
'            NULL ON EMPTY',
'            ERROR ON ERROR',
'        );',
'',
'        IF l_project_id IS NULL THEN',
'            raise_application_error(',
'                -20001,',
'                ''API succeeded but no project ID was returned. Response: '' ||',
'                DBMS_LOB.SUBSTR(l_response, 2000, 1)',
'            );',
'        END IF;',
'',
'        UPDATE cgct_project_master',
'           SET project_key_id = l_project_id',
'         WHERE id = :P1091_PRJ_ID;',
'',
'        IF SQL%ROWCOUNT = 0 THEN',
'            raise_application_error(',
'                -20002,',
'                ''No project record found for ID '' || :P1091_PRJ_ID',
'            );',
'        END IF;',
'',
'        /*',
'          In an APEX page process, it is normally better to allow APEX',
