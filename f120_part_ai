'',
'                    append_text(NVL(r.col001, '''') || '' | '');',
'                    append_text(NVL(r.col002, '''') || '' | '');',
'                    append_text(NVL(r.col003, '''') || '' | '');',
'                    append_text(NVL(r.col004, '''') || '' | '');',
