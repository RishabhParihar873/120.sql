'        (PROJECT_PLAN_LINE_ID, GENERATED_PROJECT_ID, GENERATION_STATUS,',
'         GENERATED_ON, TYPE, BASELINED, ICTAI_EXECUTION_ID, PROGRESS_PCT)',
'    VALUES',
'        (s.plan_line_id, l_execution_id, ''RECEIVED'',',
'         SYSDATE, ''AI'', ''Y'', l_track_id, 0);',
'',
'    -- -------------------------------------------------------------------------',
'    -- NEW: track in CGCT_ICTAI_PRJUSREXE',
'    -- -------------------------------------------------------------------------',
'    -- USER_ID is a reporting attribute, not a gate. An APP_USER with no row in',
'    -- CGCT_APP_USERS (SSO alias, admin, renamed mailbox) previously produced a',
'    -- silent NULL that collapsed every such execution into one "(no user)"',
'    -- bucket on the P1050 summary. Resolve it explicitly and log the miss.',
'    BEGIN',
'        SELECT USER_ID INTO l_user_id',
'        FROM   CGCT_APP_USERS',
'        -- WHERE  UPPER(USER_ID) = UPPER(:APP_USER)',
'        WHERE UPPER(email_id)=UPPER(:APP_USER) or UPPER(EMPLOYEE_ID)=UPPER(:APP_USER)',
'        FETCH FIRST 1 ROW ONLY;',
'    EXCEPTION',
'        WHEN NO_DATA_FOUND THEN',
'            l_user_id := NULL;',
'            apex_debug.warn(''P1032: no CGCT_APP_USERS row for APP_USER; USER_ID left NULL.'');',
'    END;',
'',
'    INSERT INTO CGCT_ICTAI_PRJUSREXE (',
'        PROJECT_ID,',
'        USER_ID,',
'        TEMPLATE_ID,',
'        EXECUTION_ID,',
'        PROJECT_PLAN_LINE_ID,',
'        STATUS,',
'        PROGRESS_PCT,',
'        OUTPUT_REF,',
'        CREATED_BY,',
'        UPDATED_BY',
'    ) VALUES (',
'        :P1032_PRJ_ID,',
'        l_user_id,',
'        TO_NUMBER(:P1032_TEMPLATE),',
'        l_track_id,',
'        :P1032_PROJECT_PLAN_LINE_ID,',
'        ''RECEIVED'',',
'        0,',
'        UPPER(:P1032_OUTPUT_FORMAT),      -- drives the download filename extension',
'        :APP_USER,',
'        :APP_USER',
'    );',
'',
'    COMMIT;',
'    :P1032_PIPELINE_STATUS := ''RECEIVED'';',
'',
'    free_lobs;',
'EXCEPTION',
'    WHEN OTHERS THEN',
'        free_lobs;',
'        RAISE;',
'END;'))
