'        ''multipart/form-data; boundary='' || l_boundary;',
'',
'    l_response := apex_web_service.make_rest_request(',
'        p_url => ''https://cwkfvo65cuzpsk4g3zddt4rqhu.apigateway.us-ashburn-1.oci.customer-oci.com/api/v1/documents/upload'',',
'        p_http_method => ''POST'',',
'        p_body_blob => l_request_body',
'    );',
'apex_debug.message(''Document Uploaded''||l_response);',
'    ------------------------------------------------------------',
unistr('    -- 3. RUN PIPELINE \2705'),
'    ------------------------------------------------------------',
'    l_body_pipeline := JSON_OBJECT(',
'        ''mode'' VALUE ''FULL'',',
'        ''doc_format'' VALUE ''DOCX''',
'    );',
'',
'    apex_web_service.g_request_headers.DELETE;',
'    apex_web_service.g_request_headers(1).name  := ''Content-Type'';',
'    apex_web_service.g_request_headers(1).value := ''application/json'';',
'',
'    l_response_pipeline := apex_web_service.make_rest_request(',
'        p_url => ''https://cwkfvo65cuzpsk4g3zddt4rqhu.apigateway.us-ashburn-1.oci.customer-oci.com/api/v1/pipeline/''',
'                 || l_project_id || ''/run'',',
'        p_http_method => ''POST'',',
'        p_body => l_body_pipeline',
'    );',
'',
'    -- apex_debug.message(''Pipeline created successfully. Waiting for completion...'');',
'',
'',
'    DBMS_SCHEDULER.create_job (',
'    job_name        => ''JOB_VALIDATE_'' || l_project_id,',
'    job_type        => ''PLSQL_BLOCK'',',
'    job_action      => ''BEGIN run_post_pipeline('''''' || l_project_id || ''''''); END;'',',
'    start_date      => SYSTIMESTAMP + INTERVAL ''5'' MINUTE,',
'    enabled         => TRUE,',
'    auto_drop       => TRUE',
');',
'',
'apex_debug.message(''Scheduler job created for validation/approval'');',
'',
' ',
'',
'    ------------------------------------------------------------',
unistr('    -- 4. VALIDATE \2705'),
'    ------------------------------------------------------------',
'    apex_debug.message(''Pipeline completed. Validation starting...'');',
'',
'    apex_web_service.g_request_headers.DELETE;',
'',
'    l_response_approve := apex_web_service.make_rest_request(',
'        p_url => ''https://cwkfvo65cuzpsk4g3zddt4rqhu.apigateway.us-ashburn-1.oci.customer-oci.com/api/v1/sections/project/''',
'                 || l_project_id || ''/validate-all'',',
'        p_http_method => ''POST''',
'    );',
'',
'    apex_debug.message(''Validation completed, approval starting...'');',
'',
'    ------------------------------------------------------------',
unistr('    -- 5. BULK APPROVE \2705'),
