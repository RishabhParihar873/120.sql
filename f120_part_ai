'WITH phase_data AS (',
'    SELECT',
'        p.project_phase_id,',
unistr('       p.PHASE_DISPLAY_NAME AS phase_status,   -- \D83D\DD34 change if needed'),
'',
'        ROUND(',
'            SUM(CASE ',
'                WHEN l.planned_end < TRUNC(SYSDATE)',
'                 AND UPPER(l.status) != ''COMPLETED''',
'            THEN 1 ELSE 0 END) * 100',
'            / NULLIF(COUNT(l.project_plan_line_id),0)',
'        ,0) AS past_due_pct,',
'',
'        ROUND(',
'            SUM(CASE ',
'                WHEN l.assigned_to IS NULL',
'                 AND l.planned_start < TRUNC(SYSDATE)',
'            THEN 1 ELSE 0 END) * 100',
'            / NULLIF(COUNT(l.project_plan_line_id),0)',
'        ,0) AS unassigned_pct,',
'',
'        ROUND(',
'            SUM(CASE ',
'                WHEN UPPER(l.status) = ''NOT STARTED''',
'                 AND l.planned_start < TRUNC(SYSDATE)',
'            THEN 1 ELSE 0 END) * 100',
'            / NULLIF(COUNT(l.project_plan_line_id),0)',
'        ,0) AS not_started_pct',
'',
'    FROM cgct_pp_project_phase p',
'    LEFT JOIN cgct_pp_plan_line l',
'        ON l.phase_id = p.project_phase_id',
'       AND l.prj_id = :P0_PRJ_ID',
'       AND l.wave_id = :P995_WAVE',
'',
'    WHERE p.project_id = :P0_PRJ_ID',
'      AND p.wave_id = :P995_WAVE',
'      AND p.reference_phase_id IS NULL',
'',
'    GROUP BY p.project_phase_id,p.PHASE_DISPLAY_NAME',
')',
'',
unistr('-- \2705 FINAL OUTPUT'),
'SELECT phase_status, status_dot',
'FROM (',
'',
unistr('    -- \2705 TOP ROW (OVERALL PHASE STATUS)'),
'    SELECT',
'        ''PHASE STATUS'' AS phase_status,',
'',
'        CASE',
'            WHEN MAX(GREATEST(',
'                    NVL(past_due_pct,0),',
'                    NVL(unassigned_pct,0),',
'                    NVL(not_started_pct,0)',
'                 )) <= 10',
'            THEN ''<span class="status-dot status-green"></span>''',
'',
'            WHEN MAX(GREATEST(',
'                    NVL(past_due_pct,0),',
'                    NVL(unassigned_pct,0),',
'                    NVL(not_started_pct,0)',
'                 )) <= 50',
'            THEN ''<span class="status-dot status-yellow"></span>''',
'',
'            ELSE ''<span class="status-dot status-red"></span>''',
'        END AS status_dot,',
'',
'        0 AS sort_order',
'',
'    FROM phase_data',
'',
'    UNION ALL',
'',
unistr('    -- \2705 EACH PHASE ROW'),
'    SELECT',
'        phase_status,',
'',
'        CASE',
'            WHEN GREATEST(',
'                    NVL(past_due_pct,0),',
'                    NVL(unassigned_pct,0),',
'                    NVL(not_started_pct,0)',
'                 ) <= 10',
'            THEN ''<span class="status-dot status-green"></span>''',
'',
'            WHEN GREATEST(',
'                    NVL(past_due_pct,0),',
'                    NVL(unassigned_pct,0),',
'                    NVL(not_started_pct,0)',
'                 ) <= 50',
'            THEN ''<span class="status-dot status-yellow"></span>''',
'',
'            ELSE ''<span class="status-dot status-red"></span>''',
'        END AS status_dot,',
'',
'        1 AS sort_order',
'',
'    FROM phase_data',
')',
'ORDER BY sort_order, phase_status;'))
