'',
'        SELECT',
'            cppl.project_plan_line_id AS id,',
'            cppl.parent_id           AS parent,',
'            cppl.task_name           AS task_name,',
'            cppl.planned_start,',
'            cppl.planned_end,',
'            cppl.levels',
'',
'        FROM cgct_pp_plan_line cppl',
'',
'        WHERE cppl.project_plan_id = (',
'            SELECT project_plan_id',
'            FROM cgct_pp_project_plan',
'            WHERE project_id = :P993_PRJ_ID',
'              AND status = ''Y''',
