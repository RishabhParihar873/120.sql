' * FSD Auto Refresh Logic',
' * Region Static ID must be: Plan',
' ************************************************************/',
'',
'var fsdRefreshTimer = null;',
'var fsdRefreshInterval = 15000; // 15 seconds',
'',
'function hasFsdInProgress() {',
'    return $("#Plan .fsd-loader").length > 0;',
'}',
'',
'function stopFsdRefresh() {',
'    if (fsdRefreshTimer !== null) {',
'        clearInterval(fsdRefreshTimer);',
'        fsdRefreshTimer = null;',
'        console.log("FSD auto-refresh stopped. No IN_PROGRESS rows found.");',
'    }',
'}',
'',
'function startFsdRefresh() {',
'',
'    if (!hasFsdInProgress()) {',
'        console.log("No FSD in progress. Auto-refresh not started.");',
'        stopFsdRefresh();',
'        return;',
'    }',
'',
'    if (fsdRefreshTimer !== null) {',
'        console.log("FSD auto-refresh already running.");',
'        return;',
'    }',
'',
'    console.log("FSD auto-refresh started.");',
'',
'    fsdRefreshTimer = setInterval(function () {',
'',
'        if (hasFsdInProgress()) {',
'            console.log("FSD still in progress. Refreshing Plan region silently...");',
'            apex.region("Plan").refresh();',
'        } else {',
'            stopFsdRefresh();',
