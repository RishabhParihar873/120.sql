,p_static_id=>'user-execution-summary'
,p_region_template_options=>'#DEFAULT#:t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc'
,p_plug_template=>2100526641005906379
,p_plug_display_sequence=>210
,p_plug_item_display_point=>'ABOVE'
,p_query_type=>'SQL'
,p_plug_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'SELECT',
'    NVL(',
'        MAX(u.email_id),',
'        ''(unmapped: '' || e.created_by || '')''',
'    ) AS user_email,',
'',
'    pm.project_name,',
'',
'    COUNT(e.id) AS total_executions,',
'',
'    SUM(',
'      CASE',
'       WHEN e.status=''COMPLETED''',
'       THEN 1',
'       ELSE 0',
'      END',
'    ) AS completed,',
'',
'    SUM(',
'      CASE',
'       WHEN e.status=''FAILED''',
'       THEN 1',
'       ELSE 0',
'      END',
'    ) AS failed,',
'',
'    SUM(',
'      CASE',
'       WHEN e.status NOT IN',
'            (''COMPLETED'',',
'             ''FAILED'',',
'             ''CANCELLED'')',
'       THEN 1',
'       ELSE 0',
'      END',
'    ) AS in_progress,',
'',
'    MAX(e.created_date)',
'        AS last_execution',
'',
'FROM CGCT_ICTAI_PRJUSREXE e',
'',
'LEFT JOIN CGCT_APP_USERS u',
'       ON u.user_id = e.user_id',
'',
'LEFT JOIN CGCT_PROJECT_MASTER pm',
'       ON pm.id = e.project_id',
'',
'GROUP BY',
'    NVL(',
'       u.email_id,',
'       ''(unmapped: ''',
'       || e.created_by',
'       || '')''',
'    ),',
'    e.created_by,',
'    pm.project_name',
'',
'ORDER BY',
'    MAX(e.created_date) DESC;'))
