wwv_flow_imp_page.create_page_da_action(
 p_id=>wwv_flow_imp.id(420519073064503597)
,p_event_id=>wwv_flow_imp.id(420518080924503593)
,p_event_result=>'TRUE'
,p_action_sequence=>90
,p_execute_on_page_init=>'Y'
,p_static_id=>'native-set-value'
,p_action=>'NATIVE_SET_VALUE'
,p_affected_elements_type=>'ITEM'
,p_affected_elements=>'P1019_WAVE_COLOR'
,p_attributes=>wwv_flow_t_plugin_attributes(wwv_flow_t_varchar2(
  'escape_special_characters', 'Y',
  'items_to_submit', 'P0_PROJECT_ID,P1019_WAVE',
  'sql_query', wwv_flow_string.join(wwv_flow_t_varchar2(
    'WITH ws_data AS (',
    '    SELECT',
    '        l.WORKSTREAM,',
    '        ROUND(',
    '            SUM(CASE',
    '                    WHEN l.PLANNED_END < TRUNC(SYSDATE)',
    '                     AND UPPER(l.STATUS) NOT IN (''COMPLETED'',''DESCOPE'',''CANCELLED'')',
    '                     AND l.LEVELS NOT IN (1,2,3)',
    '                THEN 1 ELSE 0',
    '            END) * 100',
    '            / NULLIF(COUNT(l.PROJECT_PLAN_LINE_ID),0)',
    '        ,0) AS past_due_pct,',
    '        ROUND(',
    '            SUM(CASE',
    '                    WHEN l.ASSIGNED_TO IS NULL',
    '                     AND l.PLANNED_START < TRUNC(SYSDATE)',
    '                     AND l.LEVELS NOT IN (1,2,3)',
    '                     AND UPPER(l.STATUS) <> ''COMPLETED''',
    '                THEN 1 ELSE 0',
    '            END) * 100',
    '            / NULLIF(COUNT(l.PROJECT_PLAN_LINE_ID),0)',
    '        ,0) AS unassigned_pct,',
    '        ROUND(',
    '            SUM(CASE WHEN UPPER(l.STATUS) = ''NOT STARTED'' AND l.PLANNED_START < TRUNC(SYSDATE) AND l.LEVELS NOT IN (1,2,3) THEN 1 ELSE 0 END) * 100',
    '            / NULLIF(COUNT(l.PROJECT_PLAN_LINE_ID),0)',
    '        ,0) AS not_started_pct',
    '    FROM CGCT_PP_PROJECT_PHASE p',
    '    LEFT JOIN CGCT_PP_PLAN_LINE l',
    '        ON l.PHASE_ID = p.PROJECT_PHASE_ID',
    '       AND l.PRJ_ID   = :P0_PROJECT_ID',
    '       AND l.WAVE_ID  = :P1019_WAVE',
    '    WHERE p.PROJECT_ID = :P0_PROJECT_ID',
    '      AND p.WAVE_ID    = :P1019_WAVE',
    '      AND p.REFERENCE_PHASE_ID IS NULL',
    '    GROUP BY l.WORKSTREAM',
    '),',
    'ws_status AS (',
    '    SELECT',
    '        CASE',
    '            WHEN MAX(GREATEST(NVL(past_due_pct,0),',
    '                              NVL(unassigned_pct,0),',
    '                              NVL(not_started_pct,0))) <= 10 THEN 1',
    '            WHEN MAX(GREATEST(NVL(past_due_pct,0),',
    '                              NVL(unassigned_pct,0),',
    '                              NVL(not_started_pct,0))) <= 50 THEN 2',
    '            ELSE 3',
    '        END AS ws_score FROM ws_data),',
    'phase_data AS (',
    '    SELECT p.project_phase_id,',
    '                ROUND(',
    '                    SUM(CASE ',
    '                            WHEN l.PLANNED_END < TRUNC(SYSDATE)',
    '                             AND UPPER(l.STATUS) NOT IN (''COMPLETED'',''DESCOPE'',''CANCELLED'')',
    '                             AND l.LEVELS NOT IN (1,2,3)',
    '                            THEN 1 ELSE 0',
    '                        END) * 100 / NULLIF(COUNT(l.PROJECT_PLAN_LINE_ID), 0),',
    '                    0',
    '                ) AS PAST_DUE_PCT,',
    '                ROUND(',
    '                    SUM(CASE ',
    '                            WHEN l.ASSIGNED_TO IS NULL',
    '                             AND l.PLANNED_START < TRUNC(SYSDATE)',
    '                             AND l.LEVELS NOT IN (1,2,3)',
    '                             AND UPPER(l.STATUS) <> ''COMPLETED''',
    '                            THEN 1 ELSE 0',
    '                        END) * 100 / NULLIF(COUNT(l.PROJECT_PLAN_LINE_ID), 0),0) AS UNASSIGNED_PCT,',
    '                ROUND(SUM(CASE  WHEN UPPER(l.STATUS) = ''NOT STARTED'' AND l.PLANNED_START < TRUNC(SYSDATE) AND l.LEVELS NOT IN (1,2,3) THEN 1 ELSE 0',
    '                        END) * 100 / NULLIF(COUNT(l.PROJECT_PLAN_LINE_ID), 0),0) AS NOT_STARTED_PCT',
    '    FROM cgct_pp_project_phase p',
    '    LEFT JOIN cgct_pp_plan_line l',
    '        ON l.phase_id = p.project_phase_id',
    '       AND l.prj_id   = :P0_PROJECT_ID',
    '       AND l.wave_id  = :P1019_WAVE',
    '    WHERE p.project_id = :P0_PROJECT_ID',
    '      AND p.wave_id    = :P1019_WAVE',
    '      AND p.reference_phase_id IS NULL',
    '    GROUP BY p.project_phase_id',
    '),',
    'phase_status AS (',
    '    SELECT',
    '        CASE',
    '            WHEN MAX(GREATEST(NVL(past_due_pct,0),',
    '                              NVL(unassigned_pct,0),',
    '                              NVL(not_started_pct,0))) <= 10 THEN 1',
    '            WHEN MAX(GREATEST(NVL(past_due_pct,0),',
    '                              NVL(unassigned_pct,0),',
    '                              NVL(not_started_pct,0))) <= 50 THEN 2',
    '            ELSE 3',
    '        END AS phase_score',
    '    FROM phase_data',
    ')',
    unistr('-- \2705 FINAL OVERALL STATUS'),
    'SELECT',
    '    CASE GREATEST(ws_score, phase_score)',
    '        WHEN 1 THEN ''green''',
    '        WHEN 2 THEN ''yellow''',
    '        ELSE ''red''',
    '    END AS overall_status',
    'FROM ws_status, phase_status;')),
  'suppress_change_event', 'N',
  'type', 'SQL_STATEMENT')).to_clob
,p_wait_for_result=>'Y'
,p_created_on=>wwv_flow_imp.dz('20260623104838Z')
,p_updated_on=>wwv_flow_imp.dz('20260623113652Z')
,p_created_by=>'DEL_DEV'
,p_updated_by=>'DEL_DEV'
);
