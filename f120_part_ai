wwv_flow_imp_page.create_page_process(
 p_id=>wwv_flow_imp.id(481201512003260929)
,p_process_sequence=>10
,p_process_point=>'AFTER_SUBMIT'
,p_process_type=>'NATIVE_PLSQL'
,p_process_name=>'New'
,p_static_id=>'new'
,p_process_sql_clob=>wwv_flow_string.join(wwv_flow_t_varchar2(
'DECLARE',
'  L_L1_ID        NUMBER;',
'  L_L2_ID        NUMBER;',
'  L_L3_ID        NUMBER;',
'  L_DOMAIN_ID    NUMBER;',
'  L_MODULE_IDS   VARCHAR2(1000);',
'  L_APP_ID       NUMBER := :P0_APP_ID;',
'  L_PRJ_ID      NUMBER := :P0_PRJ_ID;',
'  L_PRODUCT_ID   NUMBER;',
'  c1             NUMBER;',
'  L_MESSAGE      VARCHAR2(32000);',
'  V_PHASE        VARCHAR2(20); -- Normalized DISCOVERY/DESIGN',
'',
'  CURSOR c_data IS',
'    SELECT',
'      P.COL001 DOMAIN,',
'      P.COL002 MODULE,',
'      P.COL003 L1_NAME,',
'      P.COL004 L2_NAME,',
'      P.COL005 L3_NAME,',
'      P.COL006 PROCESS_SPECIFIC_QUESTION,',
'      P.COL007 PURPOSE,',
'      P.COL008 DISCOVERY,',
'      P.LINE_NUMBER AS LINE_NUMBER',
'    FROM apex_application_temp_files f,',
'         TABLE(',
'           apex_data_parser.parse(',
'             p_content      => f.blob_content,',
'             p_file_name    => f.filename,',
'             p_file_profile => apex_data_loading.get_file_profile(p_static_id => ''Load_Data''),',
'             p_max_rows     => 1000',
'           )',
'         ) p',
'    WHERE f.name = :P269_FILE',
'      AND p.line_number != 1;',
'',
'BEGIN',
'  ----------------------------------------------------------------------',
'  -- Fetch Product ID',
'  ----------------------------------------------------------------------',
'  BEGIN',
'    SELECT ID INTO L_PRODUCT_ID',
'    FROM CGCT_PRODUCT_MASTER',
'    WHERE PRODUCT_NAME = ''Blueprint''',
'      AND NVL(ACTIVE_FLAG,''N'') = ''Y'';',
'  EXCEPTION',
'    WHEN NO_DATA_FOUND THEN',
'      L_MESSAGE := ''Blueprint product not found or inactive in CGCT_PRODUCT_MASTER'';',
'      RAISE_APPLICATION_ERROR(-20020, L_MESSAGE);',
'  END;',
'',
'  ----------------------------------------------------------------------',
'  -- PROCESS EACH ROW',
'  ----------------------------------------------------------------------',
'  FOR i IN c_data LOOP',
'',
'  if i.DOMAIN is not null then',
'',
'    --------------------------------------------------------------------',
unistr('    -- 1\FE0F\20E3 FIRST VALIDATION: MUST BE RUN BEFORE ANY LOOKUP'),
'    -- Discovery MUST NOT have any L1/L2/L3',
'    --------------------------------------------------------------------',
'    V_PHASE := UPPER(TRIM(i.DISCOVERY));',
'',
'    -- Validate value present and valid',
'    IF V_PHASE IS NULL THEN',
'      RAISE_APPLICATION_ERROR(-20031,',
'        ''Discovery/Design must be provided (Line: ''||i.LINE_NUMBER||'')'');',
'    ELSIF V_PHASE NOT IN (''DISCOVERY'',''DESIGN'') THEN',
'      RAISE_APPLICATION_ERROR(-20033,',
'        ''Invalid Discovery/Design value "''||i.DISCOVERY||',
'        ''" (Line: ''||i.LINE_NUMBER||'')'');',
'    END IF;',
'',
'    -- Discovery rule: L1/L2/L3 MUST be empty',
'    IF V_PHASE = ''DISCOVERY'' THEN',
'      IF TRIM(i.L1_NAME) IS NOT NULL',
'         OR TRIM(i.L2_NAME) IS NOT NULL',
'         OR TRIM(i.L3_NAME) IS NOT NULL THEN',
'',
'        RAISE_APPLICATION_ERROR(-20032,',
'          ''For "Discovery", L1/L2/L3 must be blank (Line: ''||i.LINE_NUMBER||'')'');',
'      END IF;',
'    END IF;',
'',
'',
'    --------------------------------------------------------------------',
unistr('    -- 2\FE0F\20E3 DOMAIN LOOKUP'),
'    --------------------------------------------------------------------',
'    BEGIN',
'      SELECT DOMAIN_ID INTO L_DOMAIN_ID',
'        FROM CGCT_DOMAIN_PROCESS_MAP_V',
'       WHERE UPPER(TRIM(DOMAIN_SHORT_NAME)) = UPPER(TRIM(i.DOMAIN))',
'         AND ROWNUM = 1;',
'    EXCEPTION',
'      WHEN NO_DATA_FOUND THEN',
'        RAISE_APPLICATION_ERROR(-20001,',
'          ''Domain not found: ''||i.DOMAIN||'' (Line: ''||i.LINE_NUMBER||'')'');',
'    END;',
'',
'    --------------------------------------------------------------------',
unistr('    -- 3\FE0F\20E3 MODULE LOOKUP'),
'    --------------------------------------------------------------------',
'    L_MODULE_IDS := NULL;',
'',
'    FOR M IN (SELECT COLUMN_VALUE AS MODULE_NAME',
'                FROM TABLE(APEX_STRING.SPLIT(i.MODULE, '',''))) LOOP',
'      BEGIN',
'        DECLARE V_TEMP_ID NUMBER;',
'        BEGIN',
'          SELECT mod.MODULE_ID',
'            INTO V_TEMP_ID',
'          FROM CGCT_MODULE_MASTER mod',
'          JOIN CGCT_DOMAIN_MODULE_MAPPING dmm',
'            ON dmm.MODULE_ID = mod.MODULE_ID',
'          WHERE UPPER(TRIM(mod.MODULE_NAME)) = UPPER(TRIM(M.MODULE_NAME))',
'            AND dmm.DOMAIN_ID   = L_DOMAIN_ID',
'            AND dmm.PRODUCT_ID  = L_PRODUCT_ID',
'            AND mod.APPLICATION_ID = L_APP_ID',
'            AND NVL(dmm.ACTIVE_FLAG,''N'') = ''Y''',
'            AND NVL(mod.ACTIVE_FLAG,''N'') = ''Y'';',
'',
'          IF L_MODULE_IDS IS NULL THEN',
'            L_MODULE_IDS := V_TEMP_ID;',
'          ELSE',
'            L_MODULE_IDS := L_MODULE_IDS || '':'' || V_TEMP_ID;',
'          END IF;',
'        END;',
'      EXCEPTION',
'        WHEN NO_DATA_FOUND THEN',
'          RAISE_APPLICATION_ERROR(-20002,',
'            ''Module not found: ''||M.MODULE_NAME||'' (Line: ''||i.LINE_NUMBER||'')'');',
'      END;',
'    END LOOP;',
'',
'',
'    --------------------------------------------------------------------',
unistr('    -- 4\FE0F\20E3 DISCOVERY UPSERT (no L levels allowed)'),
'    --------------------------------------------------------------------',
