'SELECT ''Total Tasks'' title,',
'       COUNT(*) value,',
'       ''this week'' subtitle,',
'       ''fa fa-clock-o'' icon,',
'       ''blue'' color_class',
'FROM CGCT_PP_PLAN_LINE',
'WHERE PRJ_ID=:P0_PRJ_ID',
'',
'UNION ALL',
'',
'SELECT ''Completed'',',
'       COUNT(*),',
'       ''vs last week'',',
'       ''fa fa-check-circle'',',
'       ''green''',
'FROM CGCT_PP_PLAN_LINE',
'WHERE PRJ_ID=:P0_PRJ_ID',
'AND status = ''COMPLETED''',
'',
'UNION ALL',
'',
'SELECT ''In Progress'',',
'       COUNT(*),',
'       ''active tasks'',',
'       ''fa fa-trend-up'',',
'       ''primary''',
'FROM CGCT_PP_PLAN_LINE',
'WHERE PRJ_ID=:P0_PRJ_ID',
'AND status IN (''WIP'',''IN PROGRESS'')',
'',
'UNION ALL',
'',
'SELECT ''Delayed'',',
'       COUNT(*),',
'       ''vs target'',',
'       ''fa fa-trend-down'',',
'       ''red''',
'FROM CGCT_PP_PLAN_LINE',
'WHERE PRJ_ID=:P0_PRJ_ID',
'AND planned_end < SYSDATE',
'AND status != ''COMPLETED''',
'',
'UNION ALL',
'',
'SELECT ''At Risk'',',
'       COUNT(*),',
'       ''flagged items'',',
'       ''fa fa-warning'',',
'       ''orange''',
'FROM CGCT_PP_PLAN_LINE',
'WHERE PRJ_ID=:P0_PRJ_ID',
'AND status = ''AT RISK'''))
