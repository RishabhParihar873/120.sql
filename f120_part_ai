,p_process_sql_clob=>wwv_flow_string.join(wwv_flow_t_varchar2(
'DECLARE',
'    l_date           DATE;',
'    l_start_date     DATE := TO_DATE(:P1057_ACTUAL_START, ''DD-MM-YYYY'');',
'    l_end_date       DATE := TO_DATE(:P1057_ACTUAL_END, ''DD-MM-YYYY'');',
'    l_existing_end   DATE;',
'    efforts_str      CLOB;',
'    existing_str     CLOB;',
'    updated_str      CLOB;',
'    current_key      VARCHAR2(30);',
'    rec_count        INTEGER;',
'BEGIN',
'    FOR user_rec IN (',
'        SELECT EMPLOYEE_ID FROM CGCT_PP_TASK_ASSIGNMENT WHERE PROJECT_PLAN_LINE_ID = :P1057_PROJECT_PLAN_LINE_ID',
'    ) LOOP',
'        SELECT COUNT(*) INTO rec_count',
'        FROM CGCT_TASK_EFFORTS',
'        WHERE TASK_ID = :P1057_PROJECT_PLAN_LINE_ID',
'        AND UPDATED_BY = user_rec.EMPLOYEE_ID;',
'',
'        IF rec_count = 0 THEN',
'            efforts_str := ''{'';',
'            l_date := l_start_date;',
'            WHILE l_date <= l_end_date LOOP',
'                efforts_str := efforts_str || ''"'' || TO_CHAR(l_date, ''DD-MON-YYYY'') || ''": 0, '';',
'                l_date := l_date + 1;',
'            END LOOP;',
'            efforts_str := RTRIM(efforts_str, '', '') || ''}'';',
'',
'            INSERT INTO CGCT_TASK_EFFORTS (TASK_ID, UPDATED_BY, EFFORTS)',
'            VALUES (:P1057_PROJECT_PLAN_LINE_ID, user_rec.EMPLOYEE_ID, efforts_str);',
'',
'        ELSE',
'            SELECT ACTUAL_END INTO l_existing_end',
'            FROM CGCT_PP_PLAN_LINE WHERE PROJECT_PLAN_LINE_ID = :P1057_PROJECT_PLAN_LINE_ID;',
'',
'            IF l_end_date > l_existing_end THEN',
'                SELECT EFFORTS INTO existing_str',
'                FROM CGCT_TASK_EFFORTS',
'                WHERE TASK_ID = :P1057_PROJECT_PLAN_LINE_ID AND UPDATED_BY = user_rec.EMPLOYEE_ID;',
'',
'                updated_str := RTRIM(existing_str, ''}'');',
'                l_date := l_existing_end + 1;',
'',
'                WHILE l_date <= l_end_date LOOP',
'                    current_key := ''"'' || TO_CHAR(l_date, ''DD-MON-YYYY'') || ''":'';',
'                    IF INSTR(existing_str, current_key) = 0 THEN',
'                        updated_str := updated_str || '', '' || current_key || '' 0'';',
'                    END IF;',
'                    l_date := l_date + 1;',
'                END LOOP;',
'',
'                updated_str := updated_str || ''}'';',
'                UPDATE CGCT_TASK_EFFORTS',
'                SET EFFORTS = updated_str,',
'                    UPDATED_BY = :P0_USER_ID_EMAIL,',
'                    UPDATED_DATE = SYSDATE',
'                WHERE TASK_ID = :P1057_PROJECT_PLAN_LINE_ID AND UPDATED_BY = user_rec.EMPLOYEE_ID;',
'            END IF;',
'        END IF;',
'    END LOOP;',
'END;'))
