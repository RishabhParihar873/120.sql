'INSERT INTO CGCT_PRJ_PRODUCT_MASTER(PRODUCT_NAME,ACTIVE_FLAG,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATE_BY,INDUSTRY_TYPE,PRJ_ID)',
