'SELECT ID INTO P_PROD_ID FROM CGCT_TMP_PRODUCT_MASTER WHERE PRJ_ID =:P0_PRJ_ID;',
'DEBUG_PROC(''SCOPE'',P_PROD_ID);',
'END IF;',
'EXCEPTION',
'WHEN NO_DATA_FOUND THEN',
'SELECT ID INTO P_PROD_ID',
'FROM CGCT_PRODUCT_MASTER WHERE PRODUCT_NAME = (SELECT PRODUCT_NAME FROM CGCT_PRJ_PRODUCT_MASTER WHERE PRJ_ID=:P0_PRJ_ID);',
'DEBUG_PROC(''SCOPE'',P_PROD_ID);',
