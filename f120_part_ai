'       c.ENTITY_TAG,',
'       ''<span aria-hidden="true" class="fa fa-upload"></span>'' AS UPLOAD,',
'        CASE ',
'            WHEN c.FILE_PATH IS NULL THEN ''<span style="color:#bc5090" aria-hidden="true" class="fa fa-remove"></span>'' ',
'            ELSE ''<span aria-hidden="true" class="fa fa-download"></span>'' ',
'        END AS DOWNLOAD,',
'        CASE',
'    WHEN c.FILE_PATH IS NULL THEN',
'        ''<span style="color:#bc5090" aria-hidden="true" class="fa fa-remove"></span>''',
