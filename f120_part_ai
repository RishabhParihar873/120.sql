wwv_flow_imp_page.create_page_validation(
 p_id=>wwv_flow_imp.id(479888979700957365)
,p_validation_name=>'Decision Owner'
,p_static_id=>'decision-owner'
,p_validation_sequence=>120
,p_validation=>wwv_flow_string.join(wwv_flow_t_varchar2(
'DECLARE',
'    -- Variable declarations',
'    p_id             VARCHAR2(10000);',
'    L_PROJECT_code   VARCHAR2(1000);',
'    L_Phase_id       VARCHAR2(1000);',
'    L_L3_name        VARCHAR2(1000);',
'    v_line_number    NUMBER;',
'    l_str            VARCHAR2(1000);',
'    l_cnt            NUMBER := 0;',
'',
'     CURSOR c_data IS',
'        -- Cursor definition',
'        SELECT',
'            p.col001,  -- l1_name,',
'            p.col002,  -- l2_name,',
'            p.col003, -- l3_name,',
'            p.col004, -- topic_name,',
'            p.col005, -- description,',
'            p.col006, -- guideline,',
'            p.col007, -- decision_agreed,',
'            p.col008, -- decision_owner,',
'            p.col009, -- ID,',
'            p.line_number AS line_number  -- Include line_number in cursor',
'        FROM',
'            apex_application_temp_files f,',
'            TABLE(apex_data_parser.parse(',
'                p_content     => f.blob_content,',
'                p_file_name   => f.filename,',
'                p_file_profile => apex_data_loading.get_file_profile(p_static_id => ''Load_Data''),',
'                p_max_rows    => 1000',
'            )) p',
'        WHERE',
'            f.name = :P1070_FILE',
'            AND p.line_number != 1',
'        ORDER BY p.col004;',
'',
'BEGIN',
'    l_str := NULL;',
'',
'    FOR i IN c_data LOOP',
'        BEGIN',
'            -- Check the existence of the combination',
'            if i.col008 is not null then',
'           SELECT COUNT(*)',
'            INTO L_L3_name',
'            FROM CGCT_PROJECT_MEMBERS pm',
'            WHERE UPPER(TRIM(pm.PROJECT_MEMBER)) = UPPER(TRIM(i.col008))',
'              AND pm.PRoject_ID = :P1070_PRJ_ID;',
'                ',
'            IF L_L3_NAME = 0 THEN',
'                -- Append line number to the string if invalid combination',
'                IF l_str IS NOT NULL THEN',
'                    l_str := l_str || '', '' || i.line_number;',
'                ELSE',
'                    l_str := i.line_number;',
'                END IF;',
'                l_cnt := l_cnt + 1;',
'            END IF;',
'            end if;',
'        EXCEPTION',
'            WHEN OTHERS THEN',
'                -- Handle exceptions here if needed',
'                NULL;  -- Do nothing or handle exception as required',
'        END;',
'    END LOOP;',
'',
'    -- After loop, check if there were any errors and return result',
'    IF l_cnt > 0 THEN',
'        return ''Invalid decision owner at lines'' || l_str;',
'    END IF;',
'END;'))
,p_validation2=>'PLSQL'
,p_validation_type=>'FUNC_BODY_RETURNING_ERR_TEXT'
,p_always_execute=>'Y'
,p_when_button_pressed=>wwv_flow_imp.id(479880773658957311)
,p_error_display_location=>'INLINE_WITH_FIELD_AND_NOTIFICATION'
,p_required_patch=>wwv_flow_imp.id(338452639215822408)
