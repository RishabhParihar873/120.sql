    '',
    '    ROUND(SUM(CASE WHEN UPPER(l.STATUS)=''NOT STARTED''',
    '    AND l.PLANNED_START<TRUNC(SYSDATE)',
    'AND l.LEVELS NOT IN(1,2,3)',
    'THEN 1 ELSE 0 END)*100/NULLIF(COUNT(l.PROJECT_PLAN_LINE_ID),0),0) not_started_pct',
    '',
    'FROM CGCT_PP_PROJECT_PHASE p',
    'LEFT JOIN CGCT_PP_PLAN_LINE l',
    'ON l.PHASE_ID=p.PROJECT_PHASE_ID',
    'AND l.PRJ_ID=:P0_PROJECT_ID',
    'AND l.WAVE_ID IN(',
    'SELECT COLUMN_VALUE',
    'FROM TABLE(apex_string.split(:P1022_WAVE,'':''))',
    ')',
    '',
    'WHERE p.PROJECT_ID=:P0_PROJECT_ID',
    'AND p.WAVE_ID IN(',
    'SELECT COLUMN_VALUE',
    'FROM TABLE(apex_string.split(:P1022_WAVE,'':''))',
    ')',
    'AND p.REFERENCE_PHASE_ID IS NULL',
    '',
    'GROUP BY p.PROJECT_PHASE_ID',
    '),',
    '',
    'phase_status AS(',
    'SELECT CASE',
    'WHEN MAX(GREATEST(NVL(past_due_pct,0),NVL(unassigned_pct,0),NVL(not_started_pct,0)))<=10 THEN 1',
