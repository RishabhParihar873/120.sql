'    ------------------------------------------------------------------',
'    -- Append Text To Blob',
'    ------------------------------------------------------------------',
'    procedure append_text(',
'        p_blob in out nocopy blob,',
'        p_text varchar2',
'    )',
'    is',
'        l_raw raw(32767);',
'    begin',
'        l_raw := utl_raw.cast_to_raw(p_text);',
'',
'        dbms_lob.writeappend(',
'            p_blob,',
'            utl_raw.length(l_raw),',
'            l_raw',
'        );',
'    end append_text;',
'',
'    ------------------------------------------------------------------',
'    -- Append Blob To Blob',
'    ------------------------------------------------------------------',
'    procedure append_blob(',
'        p_blob in out nocopy blob,',
'        p_content blob',
'    )',
'    is',
'        l_dest_offset integer;',
'        l_src_offset integer;',
'    begin',
'',
'        l_dest_offset := dbms_lob.getlength(p_blob) + 1;',
'        l_src_offset  := 1;',
'',
