  'items_to_submit', 'P1035_PRJ_ID,P1035_WORKSTREAM,P1035_ROLE,P1035_TEMPLATE,P1035_PHASE,P1035_SUB_PHASE',
  'language', 'PLSQL',
  'plsql_code', wwv_flow_string.join(wwv_flow_t_varchar2(
    'SELECT',
    '    client_status,',
    '    project_status,',
    '    workstream_status,',
    '    role_status,',
    '    template_status,',
    '    component_status,',
    '    predecessor_status,',
    '    phase_subphase_status',
    'INTO',
    '    :P1035_CLIENT_STATUS,',
    '    :P1035_PROJECT_STATUS,',
    '    :P1035_WORKSTREAM_STATUS,',
    '    :P1035_ROLE_STATUS,',
    '    :P1035_TEMPLATE_STATUS,',
    '    :P1035_COMPONENT_STATUS,',
    '    :P1035_PREDECESSOR_STATUS,',
    '    :P1035_PHASE_SUBPHASE_STATUS',
    'FROM (',
    '    SELECT',
    '        /* Client Status */',
    '        (',
    '            SELECT CASE',
    '                     WHEN CLIENT_PROMPT IS NULL OR LENGTH(TRIM(CLIENT_PROMPT)) = 0 THEN ''Red''',
    '                     WHEN LENGTH(CLIENT_PROMPT) >= 100 THEN ''Green''',
    '                     ELSE ''Yellow''',
    '                   END',
    '            FROM CGCT_PROJECT_MASTER',
    '            WHERE ID = :P1035_PRJ_ID',
    '            FETCH FIRST 1 ROW ONLY',
    '        ) client_status,',
    '',
    '        /* Project Status */',
    '        (',
    '            SELECT CASE',
    '                     WHEN PRJ_PROMPT IS NULL OR LENGTH(TRIM(PRJ_PROMPT)) = 0 THEN ''Red''',
    '                     WHEN LENGTH(PRJ_PROMPT) >= 100 THEN ''Green''',
    '                     ELSE ''Yellow''',
    '                   END',
    '            FROM CGCT_PROJECT_MASTER',
    '            WHERE ID = :P1035_PRJ_ID',
    '            FETCH FIRST 1 ROW ONLY',
    '        ) project_status,',
    '',
    '        /* Workstream Status */',
    '        (',
    '            SELECT CASE',
    '                     WHEN PROMPT IS NULL OR LENGTH(TRIM(PROMPT)) = 0 THEN ''Red''',
    '                     WHEN LENGTH(PROMPT) >= 100 THEN ''Green''',
    '                     ELSE ''Yellow''',
    '                   END',
    '            FROM CGCT_PP_WORKSTREAM_PROMPT',
    '            WHERE UPPER(WORKSTREAM) = UPPER(:P1035_WORKSTREAM)',
    '            FETCH FIRST 1 ROW ONLY',
    '        ) workstream_status,',
    '',
    '        /* Role Status */',
    '        (',
    '            SELECT CASE',
    '                     WHEN PROMPT IS NULL OR LENGTH(TRIM(PROMPT)) = 0 THEN ''Red''',
    '                     WHEN LENGTH(PROMPT) >= 100 THEN ''Green''',
    '                     ELSE ''Yellow''',
    '                   END',
    '            FROM CGCT_PP_ROLES_PROMPT',
    '            WHERE UPPER(ROLES) = UPPER(:P1035_ROLE)',
    '            FETCH FIRST 1 ROW ONLY',
    '        ) role_status,',
    '',
    '        /* Template Status */',
    '        (    SELECT CASE',
    '                     WHEN PROMPT IS NULL OR LENGTH(TRIM(PROMPT)) = 0 THEN ''Red''',
    '                     WHEN LENGTH(PROMPT) >= 100 THEN ''Green''',
    '                     ELSE ''Yellow''',
    '                   END',
    '            FROM CGCT_PROJECT_TEMPLATES',
    '            WHERE UPPER(TEMPLATE_CODE) = UPPER(:P1035_TEMPLATE)',
    '            FETCH FIRST 1 ROW ONLY',
    '        ) template_status,',
    '        ''Green'' component_status,',
    '        ''Green'' predecessor_status,',
    '',
    '        /* Phase & Subphase Status */',
    '        (',
    '            SELECT CASE',
    '                     WHEN phase_color = ''Red'' OR subphase_color = ''Red'' THEN ''Red''',
    '                     WHEN phase_color = ''Yellow'' OR subphase_color = ''Yellow'' THEN ''Yellow'' ELSE ''Green''',
    '                   END',
    '            FROM',
    '            (',
    '                SELECT',
    '                    (',
    '                        SELECT CASE',
    '                                 WHEN prompt IS NULL',
    '                                      OR LENGTH(TRIM(prompt)) = 0 THEN ''Red'' WHEN LENGTH(prompt) >= 100 THEN ''Green'' ELSE ''Yellow''',
    '                               END',
    '                        FROM CGCT_PHASE_TYPE',
    '                        WHERE UPPER(PHASE_TYPE) = UPPER(:P1035_PHASE)',
    '                        FETCH FIRST 1 ROW ONLY',
    '                    ) AS phase_color,',
    '                    (',
    '                        SELECT CASE',
    '                                 WHEN prompt IS NULL OR LENGTH(TRIM(prompt)) = 0 THEN ''Red'' WHEN LENGTH(prompt) >= 100 THEN ''Green'' ELSE ''Yellow'' END',
    '                        FROM CGCT_PHASE_TYPE WHERE UPPER(PHASE_TYPE) = UPPER(:P1035_SUB_PHASE)',
    '                          AND PARENT_PHASE_ID IS NULL',
    '                        FETCH FIRST 1 ROW ONLY',
    '                    ) AS subphase_color',
    '                FROM dual',
    '            )',
    '        ) AS phase_subphase_status',
    '    FROM dual',
    ');')),
  'show_processing', 'Y',
  'suppress_change_event', 'N')).to_clob
,p_wait_for_result=>'Y'
