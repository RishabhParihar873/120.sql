wwv_flow_imp_page.create_report_region(
 p_id=>wwv_flow_imp.id(823762689374589554)
,p_name=>'Workstream'
,p_static_id=>'workstream'
,p_region_name=>'workstream_data'
,p_parent_plug_id=>wwv_flow_imp.id(831159748213610438)
,p_template=>2072724515482255512
,p_display_sequence=>250
,p_region_template_options=>'#DEFAULT#:t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc'
,p_component_template_options=>'#DEFAULT#:t-Report--altRowsDefault:t-Report--rowHighlight'
,p_new_grid_row=>false
,p_display_point=>'SUB_REGIONS'
,p_source_type=>'NATIVE_SQL_REPORT'
,p_query_type=>'SQL'
,p_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'WITH main_data AS (',
'    SELECT',
'        WORKSTREAM,',
'        CASE',
'            WHEN MAX_PCT <= 10 THEN ''<span class="status-dot status-green"></span>''',
'            WHEN MAX_PCT <= 50 THEN ''<span class="status-dot status-yellow"></span>''',
'            ELSE ''<span class="status-dot status-red"></span>''',
'        END AS STATUS_DOT',
'    FROM (',
'        SELECT',
'            t.*,',
'            GREATEST(',
'                NVL(t.PAST_DUE_PCT, 0),',
'                NVL(t.UNASSIGNED_PCT, 0),',
'                NVL(t.NOT_STARTED_PCT, 0)',
'            ) AS MAX_PCT,',
'            ROW_NUMBER() OVER (',
'                PARTITION BY t.WORKSTREAM',
'                ORDER BY',
'                    GREATEST(',
'                        NVL(t.PAST_DUE_PCT, 0),',
'                        NVL(t.UNASSIGNED_PCT, 0),',
'                        NVL(t.NOT_STARTED_PCT, 0)',
'                    ) DESC,',
'                    t.PROJECT_PHASE_ID',
'            ) AS RN',
'        FROM (',
'            SELECT',
'                p.PHASE_DISPLAY_NAME AS PHASE_NAME,',
'                l.WORKSTREAM,',
'                p.PROJECT_PHASE_ID,',
'',
'                ',
'                ROUND(',
'                    SUM(CASE ',
'                            WHEN l.PLANNED_END < TRUNC(SYSDATE)',
'                             AND UPPER(l.STATUS) NOT IN (''COMPLETED'',''DESCOPE'',''CANCELLED'')',
'                             AND l.LEVELS NOT IN (1,2,3)',
'                            THEN 1 ELSE 0',
'                        END) * 100 / NULLIF(COUNT(l.PROJECT_PLAN_LINE_ID), 0),',
'                    0',
'                ) AS PAST_DUE_PCT,',
' ',
'                ROUND(',
'                    SUM(CASE ',
'                            WHEN l.ASSIGNED_TO IS NULL',
'                             AND l.PLANNED_START < TRUNC(SYSDATE)',
'                             AND l.LEVELS NOT IN (1,2,3)',
'                             AND UPPER(l.STATUS) <> ''COMPLETED''',
'                            THEN 1 ELSE 0',
'                        END) * 100 / NULLIF(COUNT(l.PROJECT_PLAN_LINE_ID), 0),',
'                    0',
'                ) AS UNASSIGNED_PCT,',
' ',
'                ROUND(',
'                    SUM(CASE ',
'                            WHEN UPPER(l.STATUS) = ''NOT STARTED''',
'                             AND l.PLANNED_START < TRUNC(SYSDATE)',
'                             AND l.LEVELS NOT IN (1,2,3)',
'                            THEN 1 ELSE 0',
'                        END) * 100 / NULLIF(COUNT(l.PROJECT_PLAN_LINE_ID), 0),',
'                    0',
'                ) AS NOT_STARTED_PCT',
'',
'            FROM CGCT_PP_PROJECT_PHASE p',
'            LEFT JOIN CGCT_PP_PLAN_LINE l',
'                ON l.PHASE_ID = p.PROJECT_PHASE_ID',
'               AND l.PROJECT_PLAN_ID IN (',
'                    SELECT PROJECT_PLAN_ID',
'                    FROM CGCT_PP_PROJECT_PLAN',
'                    WHERE STATUS = ''Y''',
'               )',
'               AND l.LEVELS > 3',
'               AND NOT EXISTS (',
'                    SELECT 1',
'                    FROM CGCT_PP_PLAN_LINE child',
'                    WHERE child.PARENT_ID = l.PROJECT_PLAN_LINE_ID',
'               )',
'               AND l.PRJ_ID = :P0_PROJECT_ID',
'               AND l.WAVE_ID = :P1019_WAVE',
'',
'            WHERE p.PROJECT_ID = :P0_PROJECT_ID',
'              AND p.WAVE_ID = :P1019_WAVE',
'              AND p.REFERENCE_PHASE_ID IS NULL',
'',
'            GROUP BY',
'                p.PHASE_DISPLAY_NAME,',
'                l.WORKSTREAM,',
'                p.PROJECT_PHASE_ID',
'        ) t',
'    )',
'    WHERE RN = 1',
'),',
'numbered_data AS (',
'    SELECT',
'        ROW_NUMBER() OVER (ORDER BY WORKSTREAM) AS seq_no,',
'        WORKSTREAM,',
'        STATUS_DOT',
'    FROM main_data',
')',
'SELECT',
'    CEIL(seq_no / 2) AS grp,',
'    MAX(CASE WHEN MOD(seq_no, 2) = 1 THEN WORKSTREAM END) AS col1_workstream,',
'    MAX(CASE WHEN MOD(seq_no, 2) = 1 THEN STATUS_DOT END) AS col1_status,',
'    MAX(CASE WHEN MOD(seq_no, 2) = 0 THEN WORKSTREAM END) AS col2_workstream,',
'    MAX(CASE WHEN MOD(seq_no, 2) = 0 THEN STATUS_DOT END) AS col2_status',
'FROM numbered_data',
'GROUP BY CEIL(seq_no / 2)',
'ORDER BY grp;'))
