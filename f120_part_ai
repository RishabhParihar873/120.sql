'    l_custom_prompt clob;',
'    l_extension varchar2(20);',
'    l_body          clob;',
'    l_deliverable_id CGCT_DELIVERABLE_API_DOCUMENT.deliverable_id%TYPE;',
'',
'    ------------------------------------------------------------------',
'    -- Append Text To Blob',
'    ------------------------------------------------------------------',
'    procedure append_text(',
'        p_blob in out nocopy blob,',
'        p_text varchar2',
'    )',
'    is',
'        l_raw raw(32767);',
'    begin',
'        l_raw := utl_raw.cast_to_raw(p_text);',
'',
'        dbms_lob.writeappend(',
'            p_blob,',
'            utl_raw.length(l_raw),',
'            l_raw',
'        );',
'    end append_text;',
'',
'    ------------------------------------------------------------------',
'    -- Append Blob To Blob',
'    ------------------------------------------------------------------',
'    procedure append_blob(',
'        p_blob in out nocopy blob,',
'        p_content blob',
'    )',
'    is',
'        l_dest_offset integer;',
'        l_src_offset integer;',
'    begin',
'',
'        l_dest_offset := dbms_lob.getlength(p_blob) + 1;',
'        l_src_offset  := 1;',
'',
'        dbms_lob.copy(',
'            dest_lob    => p_blob,',
'            src_lob     => p_content,',
'            amount      => dbms_lob.getlength(p_content),',
'            dest_offset => l_dest_offset,',
'            src_offset  => l_src_offset',
'        );',
'',
'    end append_blob;',
'',
'begin',
'    ------------------------------------------------------------------',
'    -- Set GEN AI KEY',
'    ------------------------------------------------------------------',
'    select USER_API_KEY ',
'    into l_user_api_key ',
'    from CGCT_PROJECT_MEMBERS ',
'    where PROJECT_ID =:P0_PROJECT_ID ',
'    and EMP_ID =(Select EMPLOYEE_ID FROM CGCT_APP_USERS WHERE USER_ID=:P0_USER_ID_EMAIL);',
'',
'              BEGIN',
