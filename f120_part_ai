 p_id=>wwv_flow_imp.id(1440693796170625411)
,p_plug_name=>'User Stories'
,p_static_id=>'user-stories'
,p_region_name=>'my_grid'
,p_parent_plug_id=>wwv_flow_imp.id(1534097799939749444)
,p_region_template_options=>'#DEFAULT#:t-IRR-region--noBorders:t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc'
,p_plug_template=>2100526641005906379
,p_plug_display_sequence=>50
,p_plug_display_point=>'SUB_REGIONS'
,p_plug_item_display_point=>'ABOVE'
,p_query_type=>'SQL'
,p_plug_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'SELECT ',
'  DISTINCT ',
'  ''E'' as Edit,',
'  us.ID,',
'  us.STORY_ID,',
'  us.PRJ_ID,',
'  us.NAME,',
'--   us.SUMMARY,',
' ''<span class="hover-text" title="'' || us.SUMMARY || ''">'' || us.SUMMARY || ''</span>'' AS SUMMARY,',
'--   us.DETAIL,',
' ''<span class="hover-text" title="'' || us.DETAIL || ''">'' || us.DETAIL || ''</span>'' AS DETAIL,',
'  us.ESTIMATION_HOURS,',
'--   us.L3_ID,',
'--   us.L1_ID,',
' ''<span class="hover-text" title="'' || m.l1_name || ''">'' || m.l1_name || ''</span>'' AS L1_ID,',
'--   us.L2_ID,',
' ''<span class="hover-text" title="'' || m.l2_name || ''">'' || m.l2_name || ''</span>'' AS L2_ID,',
'--   us.L4_ID,',
' ''<span class="hover-text" title="'' || L4.l4_name || ''">'' || L4.l4_name || ''</span>'' AS L4_ID,',
'  ''<span class="hover-text" title="'' || m.l3_name || ''">'' || m.l3_name || ''</span>'' AS L3_ID,',
'--   us.REQUIREMENT_ID,',
'''<span class="hover-text" title="'' ||',
'    (SELECT detail',
'       FROM cgct_prj_requirement',
'      WHERE id = us.requirement_id)',
'    || ''">'' || us.requirement_id || ''</span>'' AS requirement_id,',
'--   us.PERSONA_ID,',
'''<span class="hover-text" title="'' ||',
'        NVL((',
'            SELECT LISTAGG(p.TOPIC_NAME, '', '') WITHIN GROUP (ORDER BY p.TOPIC_NAME)',
'              FROM CGCT_PRJ_PERSONA p',
'             WHERE INSTR('':'' || US.PERSONA_ID || '':'', '':'' || p.ID || '':'') > 0',
'        ), ''No Persona'')',
'    || ''">'' || US.PERSONA_ID || ''</span>'' AS PERSONA_ID,',
'--   us.ACCEPTANCE_CRITERIA,',
' ''<span class="hover-text" title="'' || us.ACCEPTANCE_CRITERIA || ''">'' || us.ACCEPTANCE_CRITERIA || ''</span>'' AS ACCEPTANCE_CRITERIA,',
'--   hy.L3_NAME,',
'  us.WORKSTREAM_ID,',
'  us.COMPONENT_ID,',
'  us.ACTIVE_FLAG,',
'  us.CREATION_DATE,',
'  us.CREATED_BY,',
'  us.LAST_UPDATE_DATE,',
'  us.LAST_UPDATED_BY,',
'  us.STORY_POINTS,',
'  us.SIZING,',
'  us.COPY_FLAG,',
'  us.SPRINT_ID,',
'  us.INTF_STATUS,',
'  us.STATUS_ID,',
'  us.INTF_TOTAL_HOURS,',
'  us.KDD_ID,',
' ''<span class="hover-text" title="'' || us.ENTITY_TAG || ''">'' || us.ENTITY_TAG || ''</span>'' AS ENTITY_TAG,',
'--   us.ENTITY_TAG,',
'   ''<span class="hover-text" title="'' || us.HIERARCHY_TAG || ''">'' || us.HIERARCHY_TAG || ''</span>'' AS HIERARCHY_TAG,',
' -- us.HIERARCHY_TAG,',
'  m.DOMAIN_NAME,   ',
'  us.module_id,',
'  br.INDUSTRY AS INDUSTRY,',
'  br.COUNTRIES AS COUNTRIES    ',
'--   m.MODULE_SHORT_NAME         ',
'',
'FROM ',
'  CGCT_PRJ_USER_STORY us',
'-- JOIN ',
'--   (SELECT L3.L3_ID, L3.L3_CODE, L1.L1_NAME, L2.L2_NAME, L3.L3_NAME',
'--    FROM CGCT_PROCESS_L1 L1',
'--    JOIN CGCT_PROCESS_L2 L2 ON L2.L1_ID = L1.L1_ID',
'--    JOIN CGCT_PROCESS_L3 L3 ON L3.L2_ID = L2.L2_ID',
'--    WHERE L1.L1_ACTIVE = ''Y''',
'--      AND L2.L2_ACTIVE = ''Y''',
'--      AND L3.L3_ACTIVE = ''Y'') hy ON hy.L3_ID = us.L3_ID',
'-- JOIN ',
'--   CGCT_PRJ_DOMAIN_PROCESS_MAP_V m ON m.L3_ID = us.L3_ID',
' LEFT JOIN CGCT_PRJ_DOMAIN_PROCESS_MAP_V m ON US.L1_ID = m.L1_ID',
'    AND (US.L3_ID = m.L3_ID OR US.L3_ID IS NULL)',
'    AND US.PRJ_ID=M.PRJ_ID',
'    LEFT JOIN CGCT_PRJ_REQUIREMENT r',
'    ON us.REQUIREMENT_ID = r.ID',
'    LEFT JOIN CGCT_PRJ_BUSINESS_REQUIREMENTS br',
'    ON r.BUSINESS_REQUIREMENT = br.ID',
'    AND US.PRJ_ID=M.PRJ_ID ',
'    JOIN CGCT_PRJ_PROCESS_L4 L4 ON  us.L4_ID=L4.L4_ID',
'    AND M.PRJ_ID=L4.PRJ_ID',
'',
'WHERE ',
'  us.ACTIVE_FLAG = ''Y''',
'  AND us.PRJ_ID = :P0_PROJECT_ID',
' -- AND us.PHASE_ID = :P1076_PHASE_ID',
'  AND us.Application_id =:P0_APP_ID',
'',
'    AND (:P1076_L1_PROCESS IS NULL OR US.L1_ID = :P1076_L1_PROCESS)',
'    AND (:P1076_L2_PROCESS IS NULL OR US.L2_ID = :P1076_L2_PROCESS)',
'    AND (:P1076_L3_PROCESS IS NULL OR US.L3_ID = :P1076_L3_PROCESS)',
'    AND (:P1076_L4_PROCESS IS NULL OR US.L4_ID = :P1076_L4_PROCESS) ',
'  ',
'AND (:P1076_DOMAIN IS NULL OR m.DOMAIN_ID = :P1076_DOMAIN)',
'AND (',
'  :P1076_DOMAIN IS NULL ',
'  OR m.DOMAIN_ID IN (',
'    SELECT REGEXP_SUBSTR(:P1076_DOMAIN, ''[^:]+'', 1, LEVEL)',
'    FROM DUAL',
'    CONNECT BY REGEXP_SUBSTR(:P1076_DOMAIN, ''[^:]+'', 1, LEVEL) IS NOT NULL',
'  )',
')',
'',
'-- AND (',
'--   :P1076_L1_PROCESS IS NULL ',
'--   OR m.L1_ID IN (',
'--     SELECT REGEXP_SUBSTR(:P1076_L1_PROCESS, ''[^:]+'', 1, LEVEL)',
'--     FROM DUAL',
'--     CONNECT BY REGEXP_SUBSTR(:P1076_L1_PROCESS, ''[^:]+'', 1, LEVEL) IS NOT NULL',
'--   )',
'-- )',
'',
'-- AND (',
'--   :P1076_L2_PROCESS IS NULL ',
'--   OR m.L2_ID IN (',
'--     SELECT REGEXP_SUBSTR(:P1076_L2_PROCESS, ''[^:]+'', 1, LEVEL)',
'--     FROM DUAL',
'--     CONNECT BY REGEXP_SUBSTR(:P1076_L2_PROCESS, ''[^:]+'', 1, LEVEL) IS NOT NULL',
'--   )',
'-- )',
'',
'-- AND (',
'--   :P1076_L3_PROCESS IS NULL ',
'--   OR m.L3_ID IN (',
'--     SELECT REGEXP_SUBSTR(:P1076_L3_PROCESS, ''[^:]+'', 1, LEVEL)',
'--     FROM DUAL',
'--     CONNECT BY REGEXP_SUBSTR(:P1076_L3_PROCESS, ''[^:]+'', 1, LEVEL) IS NOT NULL',
'--   )',
'-- )',
'',
'AND (',
'  :P1076_MODULES IS NULL ',
'  OR m.MODULE_ID IN (',
'    SELECT REGEXP_SUBSTR(:P1076_MODULES, ''[^:]+'', 1, LEVEL)',
'    FROM DUAL',
'    CONNECT BY REGEXP_SUBSTR(:P1076_MODULES, ''[^:]+'', 1, LEVEL) IS NOT NULL',
'  )',
')',
'AND (:P1076_INDUSTRY IS NULL OR EXISTS (',
'    SELECT 1',
'    FROM APEX_STRING.SPLIT(BR.INDUSTRY, '':'') ind',
'    WHERE ind.COLUMN_VALUE IN (',
'        SELECT COLUMN_VALUE',
'        FROM APEX_STRING.SPLIT(:P1076_INDUSTRY, '':'')',
'    )',
'))',
'',
'  AND (:P1076_COUNTRY IS NULL OR ',
'EXISTS (',
'    SELECT 1',
'      FROM APEX_STRING.SPLIT(BR.COUNTRIES, '':'') brc',
'     WHERE brc.COLUMN_VALUE IN (',
'               SELECT COLUMN_VALUE',
'                 FROM APEX_STRING.SPLIT(:P1076_COUNTRY, '':'')',
'           )',
'))',
'      AND m.L1_active_flag = ''Y''',
'      AND m.L2_active_flag = ''Y''',
'      AND m.L3_active_flag = ''Y'''))
,p_plug_source_type=>'NATIVE_IG'
