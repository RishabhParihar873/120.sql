'  l_mail_id    NUMBER;',
'  l_feedback_id NUMBER;',
'  l_blob       BLOB;',
'  l_filename   VARCHAR2(2550);',
'  l_mime       VARCHAR2(2550);',
'  l_name        VARCHAR2(2550);',
'BEGIN',
'  --GET USER NAME',
'  SELECT EMPLOYEE_NAME',
'  INTO l_name',
'  FROM CGCT_APP_USERS',
'  WHERE EMPLOYEE_ID = TO_CHAR(:P0_USER_ID);',
'',
'  -- Get latest feedback ID',
'  SELECT feedback_id',
'    INTO l_feedback_id',
'    FROM apex_team_feedback',
'   WHERE lower(created_by) = lower(to_char(l_name))',
'   AND application_id    = :APP_ID',
'   ORDER BY created_on DESC',
'   FETCH FIRST 1 ROW ONLY;',
'',
'  -- Fetch single attachment details (latest file for that feedback)',
'  SELECT file_blob, filename, file_mimetype',
'    INTO l_blob, l_filename, l_mime',
'    FROM apex$team_dev_files',
'   WHERE component_type = ''FEEDBACK''',
'     AND component_id   = l_feedback_id;',
'',
'  -- Send email',
'  l_mail_id := APEX_MAIL.SEND(',
'    p_to        => ''durgesh.h@capgemini.com'',',
