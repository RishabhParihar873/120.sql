'                    append_text(NVL(r.col007, '''') || '' | '');',
'                    append_text(NVL(r.col008, '''') || '' | '');',
'                    append_text(NVL(r.col009, '''') || '' | '');',
'                    append_text(NVL(r.col010, '''') || '' | '');',
'                    append_text(NVL(r.col011, '''') || '' | '');',
'                    append_text(NVL(r.col012, '''') || '' | '');',
'                    append_text(NVL(r.col013, '''') || '' | '');',
'                    append_text(NVL(r.col014, '''') || '' | '');',
