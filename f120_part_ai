,p_name=>' Lock Planned Start to Parent Window(Ashish Decided to Remove this logic) '
,p_static_id=>'lock-planned-start-to-parent-window-ashish-decided-to-remove-this-logic'
,p_action=>'NATIVE_JAVASCRIPT_CODE'
,p_attributes=>wwv_flow_t_plugin_attributes(wwv_flow_t_varchar2(
  'js_code', wwv_flow_string.join(wwv_flow_t_varchar2(
    '(function () {',
    '  var sStart = $v(''P1053_PARENT_START_DATE''); ',
    '  var sEnd   = $v(''P1053_PARENT_END_DATE''); ',
    '',
    '  var itemObj = apex.items && apex.items.P1053_PLANNED_START;',
    '  if (!itemObj) { console.warn(''P1053_PLANNED_START not found.''); return; }',
    '',
    '  function parseToDate(str) {',
    '    if (!str) return null;',
    '    var t = String(str).trim().toUpperCase();',
    '',
    '    var m1 = t.match(/^(\d{2})-([A-Z]{3})-(\d{4})$/);',
    '    if (m1) {',
    '      var dd = +m1[1], mon = m1[2], yyyy = +m1[3];',
    '      var MONTHS = {JAN:0,FEB:1,MAR:2,APR:3,MAY:4,JUN:5,JUL:6,AUG:7,SEP:8,OCT:9,NOV:10,DEC:11};',
    '      var mm = MONTHS[mon];',
    '      var d1 = new Date(yyyy, mm, dd);',
    '      return isNaN(d1) ? null : d1;',
    '    }',
    '',
    '    var m2 = t.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);',
    '    if (m2) {',
    '      var mm2 = +m2[1], dd2 = +m2[2], yyyy2 = +m2[3];',
    '      var d2 = new Date(yyyy2, mm2 - 1, dd2);',
    '      return isNaN(d2) ? null : d2;',
    '    }',
    '',
    '    return null;',
    '  }',
    '',
    '  var start = parseToDate(sStart);',
    '  var end   = parseToDate(sEnd);',
    '  if (!start || !end) {',
    '    console.warn(''Parent start/end not available yet:'', sStart, sEnd);',
    '    return;',
    '  }',
    '  start.setHours(0,0,0,0);',
    '  end.setHours(0,0,0,0);',
    '',
    '  itemObj.dayFormatter = function (iso) {',
    '    var d = new Date(iso);',
    '    d.setHours(0,0,0,0);',
    '',
    '    var inRange  = (d >= start && d <= end);',
    '    var isWeekend = (d.getDay() === 0 || d.getDay() === 6); // Sun=0, Sat=6',
    '',
    '    var enabled = inRange && !isWeekend;',
    '',
    '    return {',
    '      disabled: !enabled,',
    '      class: enabled ? null : ''is-disabled-date'',',
    '      tooltip: enabled ? null : (isWeekend ? ''Weekend disabled'' : ''Date not allowed'')',
    '    };',
    '  };',
    '',
    '  function toISO(d) {',
    '    var mm = String(d.getMonth()+1).padStart(2,''0'');',
    '    var dd = String(d.getDate()).padStart(2,''0'');',
    '    return d.getFullYear() + ''-'' + mm + ''-'' + dd;',
    '  }',
    '  try {',
    '    if (typeof itemObj.setMinMax === ''function'') {',
    '      itemObj.setMinMax(toISO(start), toISO(end));',
    '    } else if (typeof itemObj.set === ''function'') {',
    '      itemObj.set(''min'', toISO(start));',
    '      itemObj.set(''max'', toISO(end));',
    '    }',
    '  } catch (e) {',
    '    console.debug(''min/max not set programmatically; formatter still enforces the range.'', e);',
    '  }',
    '',
    '  if (typeof itemObj.refresh === ''function'') {',
    '    itemObj.refresh();',
    '  }',
    '',
    '  var cur = parseToDate($v(''P1053_PLANNED_START''));',
    '  if (cur) {',
    '    var curWeekend = (cur.getDay() === 0 || cur.getDay() === 6);',
    '    if (cur < start || cur > end || curWeekend) {',
    '      $s(''P1053_PLANNED_START'', '''');',
    '    }',
    '  }',
    '})();',
    '')))).to_clob
