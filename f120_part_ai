'    FROM CGCT_PHASE_TYPE P',
'    WHERE P.PARENT_PHASE_ID IS NULL',
' ',
'    UNION ALL',
' ',
'    -- Subphase rows',
'    SELECT ',
'        C.ID AS ID,',
'        P.PHASE_TYPE AS PHASE,',
'        C.PHASE_TYPE AS SUBPHASE,',
'        C.DESCRIPTION AS DESCRIPTION,',
'        C.PROMPT AS PROMPT,',
'        1 AS SORT_FLAG',
'    FROM CGCT_PHASE_TYPE P',
'    JOIN CGCT_PHASE_TYPE C',
'        ON C.PARENT_PHASE_ID = P.ID',
