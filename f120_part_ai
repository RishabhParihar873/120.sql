'            ''--'' || l_boundary || chr(13)||chr(10)',
'        );',
'        ',
'        append_text(',
'            l_body_blob,',
'            ''Content-Disposition: form-data; name="max_critic_retries"'' ||',
'            chr(13)||chr(10)||chr(13)||chr(10)',
'        );',
'        ',
'        append_text(',
'            l_body_blob,',
'            ''3''',
'        );',
'    ------------------------------------------------------------------',
'    -- End Boundary',
'    ------------------------------------------------------------------',
'    append_text(',
'        l_body_blob,',
'        chr(13)||chr(10)||',
'        ''--'' || l_boundary || ''--'' ||',
'        chr(13)||chr(10)',
'    );',
'',
'    ------------------------------------------------------------------',
'    -- Headers',
'    ------------------------------------------------------------------',
'    apex_web_service.g_request_headers.delete;',
'',
'    apex_web_service.g_request_headers(1).name :=''X-API-Key'';',
'    apex_web_service.g_request_headers(1).value :=l_user_api_key;',
'   ',
'    apex_web_service.g_request_headers(2).name :=''Content-Type'';',
'    apex_web_service.g_request_headers(2).value :=''multipart/form-data; boundary='' || l_boundary;',
'',
'    ------------------------------------------------------------------',
'    -- Call API',
'    ------------------------------------------------------------------',
'    l_response :=',
'        apex_web_service.make_rest_request(',
'            p_url =>',
'                l_base_url ||',
'                ''/api/v3/generate/''',
'                ||l_extension',
'                ||''/async'',',
'            p_http_method =>',
'                ''POST'',',
'            p_body_blob =>',
'                l_body_blob',
'        );',
'',
'    apex_debug.message(',
'        ''Generate Status='' ||',
'        apex_web_service.g_status_code',
'    );',
'',
'    apex_debug.message(',
'        ''Generate Response='' ||',
'        dbms_lob.substr(l_response,4000,1)',
'    );',
'',
'    ------------------------------------------------------------------',
'    -- Validation',
'    ------------------------------------------------------------------',
'    if apex_web_service.g_status_code not in',
'       (200,201,202)',
'    then',
'',
'        raise_application_error(',
'            -20012,',
'            ''Generation Failed. HTTP='' ||',
'            apex_web_service.g_status_code ||',
'            '' Response='' ||',
'            dbms_lob.substr(l_response,4000,1)',
'        );',
'',
'    end if;',
'',
'    ------------------------------------------------------------------',
'    -- Parse Response',
'    ------------------------------------------------------------------',
'    begin',
'',
'        select json_value(l_response,''$.job_id''),',
'               json_value(l_response,''$.document_id'')',
'          into l_job_id,',
'               l_document_id',
'          from dual;',
'',
'    exception',
'        when others then',
'            null;',
'    end;',
'',
'    ------------------------------------------------------------------',
'    -- Insert Data',
'    ------------------------------------------------------------------',
'',
'',
'    BEGIN',
'            INSERT INTO CGCT_DELIVERABLE_API_DOCUMENT',
'            (',
'                deliverable_id,',
'                job_id,',
'                document_id,',
'                generation_status,',
'                PROJECT_PLAN_LINE_ID,',
'                TYPE,',
'                CREATED_BY,',
'                generated_on',
'            )',
'            VALUES',
'            (',
'                null,',
'                l_job_id,',
'                l_document_id,',
'                ''IN_PROGRESS'',',
'                :P1045_PROJECT_PLAN_LINE_ID,',
'                ''AI'',',
'                :P0_USER_ID_EMAIL,',
'                SYSDATE',
'            )',
'            RETURNING deliverable_id',
'            INTO l_deliverable_id;',
'       END;',
'',
'',
'    ------------------------------------------------------------------',
'    ------------------------------------------------------------------',
'',
'',
'    ------------------------------------------------------------------',
'    -- Success Message',
'    ------------------------------------------------------------------',
'    ',
'    DBMS_SCHEDULER.create_job (',
'    job_name        => ''JOB_VALIDATE_'' || TO_CHAR(SYSTIMESTAMP,''YYYYMMDDHH24MISSFF3''),',
'    job_type        => ''PLSQL_BLOCK'',',
'    job_action => ''BEGIN RUN_POST_JOB_STATUS(''''''',
'                  || l_job_id|| '''''',''',
'                  || l_deliverable_id|| '',''''''',
'                  || l_user_api_key',
'                  || ''''''); END;'',',
'    start_date      => SYSTIMESTAMP + INTERVAL ''5'' MINUTE,',
'    enabled         => TRUE,',
'    auto_drop       => TRUE',
'    );',
'',
'',
'    ------------------------------------------------------------------',
'    -- Cleanup',
'    ------------------------------------------------------------------',
'    if l_body_blob is not null',
'       and dbms_lob.istemporary(l_body_blob)=1',
'    then',
'        dbms_lob.freetemporary(l_body_blob);',
'    end if;',
'',
'exception',
'    when others then',
'',
'        if l_body_blob is not null',
