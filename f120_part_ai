'    r.SOURCE,',
'    r.TYPE_LOV,',
'    r.APPLICATION_ID,',
'    r.ENTITY_TAG,',
'    r.HIERARCHY_TAG,',
'    -- br.COUNTRIES,',
'    -- br.INDUSTRY',
'',
unistr('    /* \2705 COUNTRIES (codes \2192 names) */'),
'    (',
'        SELECT LISTAGG(c.country_name, '', '')',
'               WITHIN GROUP (ORDER BY c.country_name)',
'        FROM cgct_prj_country c',
'        WHERE c.country_code IN (',
'            SELECT REGEXP_SUBSTR(br.COUNTRIES, ''[^:]+'', 1, LEVEL)',
'            FROM dual',
'            CONNECT BY REGEXP_SUBSTR(br.COUNTRIES, ''[^:]+'', 1, LEVEL) IS NOT NULL',
'        )',
'    ) AS COUNTRIES,',
'',
unistr('    /* \2705 INDUSTRY (IDs \2192 names) */'),
'    (',
'        SELECT LISTAGG(lv.DESCRIPTION, '', '')',
'               WITHIN GROUP (ORDER BY lv.DESCRIPTION)',
'        FROM CGCT_LOOKUP_VALUES lv',
'        WHERE lv.ID IN (',
'            SELECT REGEXP_SUBSTR(br.INDUSTRY, ''[^:]+'', 1, LEVEL)',
'            FROM dual',
'            CONNECT BY REGEXP_SUBSTR(br.INDUSTRY, ''[^:]+'', 1, LEVEL) IS NOT NULL',
'        )',
'        AND lv.TYPE_ID IN (',
'            SELECT ID',
'            FROM CGCT_LOOKUP_TYPE',
'            WHERE LOOKUP_TYPE = ''INDUSTRY_TYPE''',
