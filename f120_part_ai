  'language', 'PLSQL',
  'plsql_code', wwv_flow_string.join(wwv_flow_t_varchar2(
    'DECLARE',
    '  v_max_date DATE := :P1079_MAX_DATE;',
    '  v_offset   NUMBER := NVL(:P1079_DATE_OFFSET, 0);',
    '  v_base     DATE := TRUNC(SYSDATE);',
    '  v_count    NUMBER := 0;',
    '  v_last_day DATE := NULL;',
    'BEGIN',
    '  -- Step 1: Skip weekdays based on offset',
    '  WHILE v_count < v_offset LOOP',
    '    IF TO_CHAR(v_base, ''DY'', ''NLS_DATE_LANGUAGE=ENGLISH'') NOT IN (''SAT'', ''SUN'') THEN',
    '      v_count := v_count + 1;',
    '    END IF;',
    '    v_base := v_base + 1;',
    '  END LOOP;',
    '',
    '  -- Step 2: Collect up to 5 weekdays (but not beyond max date)',
    '  v_count := 0;',
