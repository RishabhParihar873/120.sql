wwv_flow_imp_page.create_page_validation(
 p_id=>wwv_flow_imp.id(478795016331126620)
,p_validation_name=>'Planned Start dependency'
,p_static_id=>'planned-start-dependency'
,p_validation_sequence=>10
,p_validation=>wwv_flow_string.join(wwv_flow_t_varchar2(
'DECLARE',
'    v_status          VARCHAR2(50);',
'    v_task_number     VARCHAR2(50);',
'    v_predecessors    VARCHAR2(4000);',
'    v_dependency      VARCHAR2(50);',
'    v_planned_start   varchar2(100);',
'    v_index           NUMBER := 1;',
'    v_incomplete_list VARCHAR2(4000) := '''';',
'BEGIN',
'    -- Get current task number',
'    SELECT task_number',
'    INTO v_task_number',
'    FROM cgct_pp_plan_line',
'    WHERE project_plan_line_id = :P1059_PROJECT_PLAN_LINE_ID;',
'',
'    -- Get comma-separated predecessors',
'    SELECT PREDECESSORS',
'    INTO v_predecessors',
'    FROM cgct_pp_plan_line',
'    WHERE project_plan_line_id = :P1059_PROJECT_PLAN_LINE_ID;',
'',
'    -- Get current planned start date from DB',
'    SELECT TO_CHAR(PLANNED_START, ''MM/DD/YYYY'')',
'    INTO v_planned_start',
'    FROM cgct_pp_plan_line',
'    WHERE project_plan_line_id = :P1059_PROJECT_PLAN_LINE_ID;',
'',
'    -- Only proceed if the start date has changed',
'    IF v_planned_start != :P1059_PLANNED_START THEN',
'        -- Loop through each predecessor',
'        LOOP',
'            v_dependency := REGEXP_SUBSTR(v_predecessors, ''[^,]+'', 1, v_index);',
'            EXIT WHEN v_dependency IS NULL;',
'',
'            BEGIN',
'                SELECT status',
'                INTO v_status',
'                FROM cgct_pp_plan_line',
'                WHERE task_number = TO_NUMBER(TRIM(v_dependency))',
'                  AND PRJ_ID = :P1059_PRJ_ID;',
'',
'                IF v_status != ''COMPLETED'' THEN',
'                    IF v_incomplete_list IS NULL THEN',
'                        v_incomplete_list := TRIM(v_dependency);',
'                    ELSE',
'                        v_incomplete_list := v_incomplete_list || '','' || TRIM(v_dependency);',
'                    END IF;',
'                END IF;',
'            EXCEPTION',
'                WHEN NO_DATA_FOUND THEN',
'                    NULL;',
'                WHEN VALUE_ERROR THEN',
'                    NULL;',
'            END;',
'',
'            v_index := v_index + 1;',
'        END LOOP;',
'',
'        -- Return message if any incomplete dependencies found',
'        IF v_incomplete_list IS NOT NULL THEN',
'            RETURN ''Start Date for Task no: '' || v_task_number || '',cannot be changed until the Dependency task: ('' || v_incomplete_list || '') is not completed.'';',
'        END IF;',
'    END IF;',
'',
'    RETURN NULL;',
'',
'EXCEPTION',
'    WHEN OTHERS THEN',
'        RETURN ''Unexpected error: '' || SQLERRM;',
'END;'))
,p_validation2=>'PLSQL'
,p_validation_type=>'FUNC_BODY_RETURNING_ERR_TEXT'
,p_when_button_pressed=>wwv_flow_imp.id(478740493779126353)
