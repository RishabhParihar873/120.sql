  'dml_plsql_code', wwv_flow_string.join(wwv_flow_t_varchar2(
    'MERGE INTO CGCT_PRJ_CONFIG_WORKBOOK_MASTER T',
    'USING (',
    '    SELECT ',
    '        :CONFIG_WORKBOOK_ID   AS CONFIG_WORKBOOK_ID,',
    '        :CONFIG_WORKBOOK_NAME AS CONFIG_WORKBOOK_NAME,',
    '        :MODULE_ID            AS MODULE_ID,',
    '        :CONFIG_WORKBOOK_TASK_NAME AS CONFIG_WORKBOOK_TASK_NAME,',
    '        :NAVIGATION_PATH      AS NAVIGATION_PATH,',
    '        :CONFIG_CATEGORY      AS CONFIG_CATEGORY,',
    '        :SEQUENCE             AS SEQUENCE,',
    '        :DEPENDENCY           AS DEPENDENCY,',
    '        :P0_APP_ID            AS APPLICATION_ID,',
    '        :P0_PRJ_ID           AS PRJ_ID,',
    '        -- :P0_USER_ID           AS USER_ID',
    '        :P0_USER_ID_EMAIL           AS USER_ID',
    '    FROM DUAL',
    ') S',
    'ON (T.CONFIG_WORKBOOK_ID = S.CONFIG_WORKBOOK_ID)',
    'WHEN MATCHED THEN',
    '    UPDATE SET ',
    '        T.CONFIG_WORKBOOK_NAME     = S.CONFIG_WORKBOOK_NAME,',
    '        T.MODULE_ID                = S.MODULE_ID,',
    '        T.CONFIG_WORKBOOK_TASK_NAME = S.CONFIG_WORKBOOK_TASK_NAME,',
    '        T.NAVIGATION_PATH          = S.NAVIGATION_PATH,',
    '        T.CONFIG_CATEGORY          = S.CONFIG_CATEGORY,',
    '        T.SEQUENCE                 = S.SEQUENCE,',
    '        T.DEPENDENCY               = S.DEPENDENCY,',
    '        T.UPDATED_BY               = S.USER_ID,',
    '        T.UPDATED_DATE             = SYSDATE',
    'WHEN NOT MATCHED THEN',
    '    INSERT (',
    '        CONFIG_WORKBOOK_ID,',
    '        CONFIG_WORKBOOK_NAME,',
