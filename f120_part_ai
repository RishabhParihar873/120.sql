,p_title=>'Search Result'
,p_parent_plug_id=>wwv_flow_imp.id(579219604759413202)
,p_template=>4072358936313175081
,p_display_sequence=>60
,p_region_template_options=>'#DEFAULT#:t-Region--removeHeader js-removeLandmark:t-Region--scrollBody'
,p_component_template_options=>'#DEFAULT#:t-Report--stretch:t-Report--staticRowColors:t-Report--rowHighlight'
,p_new_grid_row=>false
,p_display_point=>'SUB_REGIONS'
,p_source_type=>'NATIVE_SQL_REPORT'
,p_query_type=>'FUNC_BODY_RETURNING_SQL'
,p_function_body_language=>'PLSQL'
,p_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'DECLARE',
'    v_dates       SYS.ODCIDATELIST := SYS.ODCIDATELIST();',
'    v_sql         CLOB := '''';',
'    v_base_date   DATE;',
'    v_start_date  DATE;',
'    v_end_date    DATE := TRUNC(SYSDATE + 1);',
'    v_offset      NUMBER := NVL(:P1079_DATE_OFFSET,0);',
'    v_temp_date   DATE;',
'    v_count       NUMBER := 0;',
'    v_min_date    DATE;',
'BEGIN',
'',
'    /* Find base date */',
'    v_temp_date := TRUNC(SYSDATE);',
'',
'    WHILE v_count < 5 LOOP',
'        v_temp_date := v_temp_date - 1;',
'',
'        IF TO_CHAR(',
'               v_temp_date,',
'               ''DY'',',
'               ''NLS_DATE_LANGUAGE=ENGLISH''',
'           ) NOT IN (''SAT'',''SUN'')',
'        THEN',
'            v_count := v_count + 1;',
'        END IF;',
'    END LOOP;',
'',
'    v_base_date := v_temp_date + 1;',
'',
'    /* Minimum Date */',
'    SELECT NVL(MIN(ct.ACTUAL_START),SYSDATE)',
'    INTO v_min_date',
'    FROM CGCT_PP_PLAN_LINE ct',
'         JOIN CGCT_PROJECT_GRANT pg',
'           ON pg.project_id = ct.prj_id',
'    WHERE pg.GRANT_ID IN',
'          (',
'            SELECT GRANT_ID',
'            FROM CGCT_PROJECT_GRANT',
'            WHERE USER_ID IN',
'                  (',
'                    SELECT USER_ID',
'                    FROM CGCT_APP_USERS',
'                  )',
'          )',
'    AND pg.PROJECT_ID IN',
'        (',
'            SELECT PROJECT_ID',
'            FROM CGCT_PROJECT_GRANT',
'            WHERE USER_ID IN',
'                  (',
'                    SELECT USER_ID',
'                    FROM CGCT_APP_USERS',
'                  )',
'            AND RESOURCE_LEVEL = ''Y''',
'        )',
'    AND ct.ACTUAL_START IS NOT NULL;',
'',
'    :P1079_MIN_DATE := v_min_date;',
'',
'    v_start_date := TRUNC(v_min_date);',
'',
'    /* Apply Offset */',
'    v_temp_date := v_base_date;',
'    v_count := 0;',
'',
'    WHILE v_count < ABS(v_offset) LOOP',
'',
'        v_temp_date :=',
'            v_temp_date +',
'            CASE',
'                WHEN v_offset > 0 THEN 1',
'                ELSE -1',
'            END;',
'',
'        IF v_temp_date < v_start_date',
'           OR v_temp_date > v_end_date',
'        THEN',
'            EXIT;',
'        END IF;',
'',
'        IF TO_CHAR(',
'               v_temp_date,',
'               ''DY'',',
'               ''NLS_DATE_LANGUAGE=ENGLISH''',
'           ) NOT IN (''SAT'',''SUN'')',
'        THEN',
'            v_count := v_count + 1;',
'        END IF;',
'',
'    END LOOP;',
'',
'    IF v_temp_date < v_start_date THEN',
'        v_temp_date := v_start_date;',
'    END IF;',
'',
'    /* Get 5 Weekdays */',
'    v_base_date := v_temp_date;',
'    v_count := 0;',
'',
'    WHILE v_count < 5',
'      AND v_base_date <= v_end_date LOOP',
'',
'        IF TO_CHAR(',
'               v_base_date,',
'               ''DY'',',
'               ''NLS_DATE_LANGUAGE=ENGLISH''',
'           ) NOT IN (''SAT'',''SUN'')',
'        THEN',
'            v_dates.EXTEND;',
'            v_dates(v_dates.COUNT) := v_base_date;',
'            v_count := v_count + 1;',
'        END IF;',
'',
'        v_base_date := v_base_date + 1;',
'',
'    END LOOP;',
'',
'    /* Set Labels */',
'    :P1079_D1_LABEL := NULL;',
'    :P1079_D2_LABEL := NULL;',
'    :P1079_D3_LABEL := NULL;',
'    :P1079_D4_LABEL := NULL;',
'    :P1079_D5_LABEL := NULL;',
'',
'    IF v_dates.COUNT >= 1 THEN',
'        :P1079_D1_LABEL := TO_CHAR(v_dates(1),''DD-MM-YYYY'');',
'    END IF;',
'',
'    IF v_dates.COUNT >= 2 THEN',
'        :P1079_D2_LABEL := TO_CHAR(v_dates(2),''DD-MM-YYYY'');',
'    END IF;',
'',
'    IF v_dates.COUNT >= 3 THEN',
'        :P1079_D3_LABEL := TO_CHAR(v_dates(3),''DD-MM-YYYY'');',
'    END IF;',
'',
'    IF v_dates.COUNT >= 4 THEN',
'        :P1079_D4_LABEL := TO_CHAR(v_dates(4),''DD-MM-YYYY'');',
'    END IF;',
'',
'    IF v_dates.COUNT >= 5 THEN',
'        :P1079_D5_LABEL := TO_CHAR(v_dates(5),''DD-MM-YYYY'');',
'    END IF;',
'',
'/* Date Range */',
'',
'IF v_dates.COUNT > 0 THEN',
':P1079_DATE_RANGE :=',
'TO_CHAR(v_dates(1),''DD-MM-YYYY'')',
'|| '' - '' ||',
'TO_CHAR(v_dates(v_dates.COUNT),''DD-MM-YYYY'');',
'END IF;',
'    /* Build Dynamic SQL */',
'',
'    v_sql :=',
'        ''SELECT DISTINCT',
'            pm.project_id       AS PROJECT_ID,',
'            pm.project_id       AS PROJECT_NAME,',
'            pm.project_member   AS PROJECT_MEMBER,',
'            pm.emp_id           AS EMP_ID'';',
'',
'    FOR i IN 1 .. v_dates.COUNT LOOP',
'',
'        v_sql := v_sql ||',
'        '',',
'        (',
'            SELECT CASE',
'                     WHEN NVL(effort_val,0) > 9 THEN',
'                       ''''<span class="effort-box high">''''||',
'                       NVL(TO_CHAR(effort_val),''''0'''')||',
'                       ''''</span>''''',
'                     ELSE',
'                       ''''<span class="effort-box">''''||',
'                       NVL(TO_CHAR(effort_val),''''0'''')||',
'                       ''''</span>''''',
'                   END',
'            FROM',
'            (',
'                SELECT SUM(eff.effort_hours) effort_val',
'                FROM cgct_pp_plan_line ct',
'                     JOIN cgct_task_effort eff',
'                       ON eff.task_id = ct.project_plan_line_id',
'                WHERE ct.project_plan_id =',
'                      (',
'                          SELECT project_plan_id',
'                          FROM cgct_pp_project_plan',
'                          WHERE project_id = :P1079_NEW',
'                          AND status = ''''Y''''',
'                      )',
'                AND ct.prj_id = :P1079_NEW',
'                AND UPPER(eff.user_id) =',
'                    UPPER(pm.project_member)',
'                AND eff.effort_date =',
'                    TO_DATE(''''''||',
'                        TO_CHAR(v_dates(i),''YYYY-MM-DD'')||',
'                    '''''',''''YYYY-MM-DD'''')',
'            )',
'        ) AS D'' || i;',
'',
'    END LOOP;',
'',
'    v_sql := v_sql ||',
'    ''',
'      FROM cgct_project_members pm',
'     WHERE pm.project_id = :P1079_NEW'';',
'',
'    RETURN v_sql;',
'',
'END;'))
