  'language', 'PLSQL',
  'plsql_code', wwv_flow_string.join(wwv_flow_t_varchar2(
    'DECLARE',
    '    l_url               VARCHAR2(4000);',
    '    l_token             VARCHAR2(100);',
    '    l_sheet_id          NUMBER;',
    '    l_payload           CLOB;',
    '    l_response          CLOB;',
    '    l_col_assigned_to   VARCHAR2(50);',
    '    v_email_id          VARCHAR2(100); -- Single user email',
    '    p_project_id        NUMBER := :P1047_PRJ_ID;',
    '    l_emp_id            VARCHAR2(50);',
    '    l_result            varchar2(255);',
    '',
    'BEGIN',
    '    debug_proc(''Inside LINE_ASSIGN_TO_SMARTSHEET'' || TO_CHAR(SYSTIMESTAMP, ''HH24:MI:SS.FF3''), ''Start'');',
    '    -- Step 1: Get Sheet ID',
    '    BEGIN',
    '        SELECT SHEET_ID INTO l_sheet_id',
    '        FROM CGCT_PROJECT_MASTER',
    '        WHERE ID = p_project_id;',
    '    EXCEPTION',
    '        WHEN OTHERS THEN',
    '            apex_debug.message(''Error Fetching Sheet ID: '' || SQLERRM);',
    '    END;',
    '',
    '    IF l_sheet_id IS NOT NULL THEN',
    '        -- Step 2: Get API Key',
    '        BEGIN',
    '            select ST.API_KEY INTO l_token',
    '            from cgct_project_master PM',
    '            JOIN CGCT_SHEETS S ON PM.SHEET_ID = S.sheet_ID',
    '            JOIN CGCT_SMARTSHEET_TOKENS ST ON S.USER_ID = ST.api_id ',
    '            WHERE PM.ID = p_project_id',
    '            AND ROWNUM = 1;',
    '        EXCEPTION',
    '            WHEN OTHERS THEN',
    '                apex_debug.message(''Error Fetching API Key: '' || SQLERRM);',
    '        END;',
    '',
    '        -- Step 3: Get Column ID for ''assigned_to''',
    '        BEGIN',
    '            SELECT col_id INTO l_col_assigned_to',
    '            FROM CGCT_SMARTSHEET_COLUMN',
    '            WHERE SHEET_ID = l_sheet_id AND col_title = ''assigned_to'';',
    '        EXCEPTION',
    '            WHEN OTHERS THEN',
    '                apex_debug.message(''Error Fetching Column ID : '' || SQLERRM);',
    '        END;',
    '',
    '        -- Step 4: Get Email ID',
    '        BEGIN',
    '            SELECT email_id INTO v_email_id FROM CGCT_APP_USERS WHERE employee_id = :P1047_ASSIGN;',
    '        EXCEPTION',
    '            WHEN OTHERS THEN',
    '                apex_debug.message(''Error Fetching Email ID : '' || SQLERRM);',
    '        END;',
    '',
    '        -- Step 5: Loop through multiple tasks',
    '        BEGIN',
    '            FOR task_rec IN (',
    '                SELECT ROW_ID',
    '                FROM CGCT_PP_PLAN_LINE',
    '                WHERE PROJECT_PLAN_LINE_ID IN (',
    '                    SELECT TO_NUMBER(TRIM(COLUMN_VALUE))',
    '                    FROM TABLE(apex_string.split(:P1047_SELECTED_IDS, '':'')) -- Colon-separated task IDs',
    '                    )',
    '                ) LOOP',
    '                -- Step 6: Construct URL and Payload',
    '                l_url := ''https://api.smartsheet.com/2.0/sheets/'' || l_sheet_id || ''/rows'';',
    '',
    '                l_payload := ''{'' ||',
    '                    ''"id": '' || task_rec.ROW_ID || '','' ||',
    '                    ''"cells": ['' ||',
    '                    ''{ "columnId": '' || l_col_assigned_to || '', "objectValue": { "objectType": "MULTI_CONTACT", "values": ['' ||',
    '                        ''{ "objectType": "CONTACT", "email": "'' || v_email_id || ''" }'' ||',
    '                    ''] } }'' ||',
    '                ''] }'';',
    '',
    '                -- Step 7: Set Headers and Make API Call',
    '                apex_web_service.g_request_headers(1).name := ''Authorization'';',
    '                apex_web_service.g_request_headers(1).value := ''Bearer '' || l_token;',
    '                apex_web_service.g_request_headers(2).name := ''Content-Type'';',
    '                apex_web_service.g_request_headers(2).value := ''application/json'';',
    '',
    '                l_response := apex_web_service.make_rest_request(',
    '                  p_url         => l_url,',
    '                  p_http_method => ''PUT'',',
    '                  p_body        => l_payload',
    '                );',
    '            END LOOP;',
    '        EXCEPTION',
    '            WHEN OTHERS THEN',
    '                apex_debug.message(''Error constructing URL/payload/API CALL FAILED : '' || SQLERRM);',
    '        END;',
    '        apex_json.parse(l_response);',
    '        apex_debug.message(''Smartsheet Response: '' || l_response);',
    '    END IF;',
    '    debug_proc(''Inside LINE_ASSIGN_TO_SMARTSHEET'' || TO_CHAR(SYSTIMESTAMP, ''HH24:MI:SS.FF3''), ''End'');',
    'END;')),
  'show_processing', 'N')).to_clob
