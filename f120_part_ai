'',
'                    append_text(CHR(10));',
'                END LOOP;',
'',
'            EXCEPTION',
'                WHEN OTHERS THEN',
'                    append_text(CHR(10));',
'                    append_text(''Worksheet skipped: '' || s.sheet_display_name || CHR(10));',
'                    append_text(''Reason: '' || SQLERRM || CHR(10));',
'            END;',
'        END LOOP;',
'',
'        :P1024_FILE_CONTENT_PREVIEW := DBMS_LOB.SUBSTR(l_extracted_text, 32000, 1);',
'',
'        IF l_any_data_found THEN',
'            :P1024_STATUS := ''BLOB converted to readable Excel text. Some worksheets may have been skipped.'';',
'        ELSE',
'            :P1024_STATUS := ''BLOB received, but no readable Excel data found. Check File Content Preview.'';',
'        END IF;',
'',
'    ------------------------------------------------------------------',
'    -- Case 2: Text-readable files',
'    ------------------------------------------------------------------',
'    ELSIF LOWER(:P1024_FILE_NAME) LIKE ''%.txt''',
'       OR LOWER(:P1024_FILE_NAME) LIKE ''%.csv''',
'       OR LOWER(:P1024_FILE_NAME) LIKE ''%.json''',
'       OR LOWER(:P1024_FILE_NAME) LIKE ''%.xml''',
'       OR LOWER(:P1024_FILE_NAME) LIKE ''%.html''',
'       OR LOWER(:P1024_FILE_NAME) LIKE ''%.htm''',
'       OR LOWER(:P1024_FILE_NAME) LIKE ''%.log''',
'       OR LOWER(:P1024_FILE_NAME) LIKE ''%.sql''',
'       OR LOWER(:P1024_FILE_NAME) LIKE ''%.md''',
'    THEN',
'',
'        blob_to_clob(l_file_blob, l_text_clob);',
'',
'        :P1024_FILE_CONTENT_PREVIEW := DBMS_LOB.SUBSTR(l_text_clob, 32000, 1);',
'',
'        :P1024_STATUS := ''Text file converted from BLOB to readable text.'';',
'',
'    ------------------------------------------------------------------',
'    -- Case 3: DOCX basic extraction',
'    ------------------------------------------------------------------',
'    ELSIF LOWER(:P1024_FILE_NAME) LIKE ''%.docx''',
'    THEN',
'',
'        BEGIN',
'            l_docx_xml_blob := APEX_ZIP.GET_FILE_CONTENT(',
'                p_zipped_blob => l_file_blob,',
'                p_file_name   => ''word/document.xml''',
'            );',
'',
'            IF l_docx_xml_blob IS NULL OR DBMS_LOB.GETLENGTH(l_docx_xml_blob) = 0 THEN',
'                :P1024_FILE_CONTENT_PREVIEW :=',
'                    ''DOCX BLOB received, but word/document.xml was not found.'';',
'                :P1024_STATUS := ''DOCX received, but text extraction failed.'';',
'                RETURN;',
'            END IF;',
'',
'            blob_to_clob(l_docx_xml_blob, l_docx_xml_clob);',
'',
'            l_docx_xml_clob := REGEXP_REPLACE(l_docx_xml_clob, ''<[^>]+>'', '' '');',
'            l_docx_xml_clob := REPLACE(l_docx_xml_clob, ''&amp;'', ''&'');',
'            l_docx_xml_clob := REPLACE(l_docx_xml_clob, ''&lt;'', ''<'');',
'            l_docx_xml_clob := REPLACE(l_docx_xml_clob, ''&gt;'', ''>'');',
'            l_docx_xml_clob := REPLACE(l_docx_xml_clob, ''&quot;'', ''"'');',
'            l_docx_xml_clob := REPLACE(l_docx_xml_clob, ''&apos;'', '''''''');',
'',
'            :P1024_FILE_CONTENT_PREVIEW := DBMS_LOB.SUBSTR(l_docx_xml_clob, 32000, 1);',
'            :P1024_STATUS := ''DOCX converted from BLOB to rough readable text.'';',
'',
'        EXCEPTION',
'            WHEN OTHERS THEN',
'                :P1024_FILE_CONTENT_PREVIEW :=',
'                    ''DOCX BLOB received, but DOCX extraction failed.'' || CHR(10) ||',
'                    ''Reason: '' || SQLERRM;',
'                :P1024_STATUS := ''DOCX received, but extraction failed.'';',
'        END;',
'',
'    ------------------------------------------------------------------',
'    -- Case 4: PDF/PPTX/Image/unknown binary',
'    ------------------------------------------------------------------',
'    ELSE',
'',
'        l_base64_clob := apex_web_service.blob2clobbase64(l_file_blob);',
'',
'        :P1024_FILE_CONTENT_PREVIEW :=',
