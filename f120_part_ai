  'items_to_submit', 'P1021_PRJ_ID,P1021_WORKSTREAM,P1021_ROLE,P1021_TEMPLATE,P1021_PHASE,P1021_SUB_PHASE,P1021_PROJECT_PLAN_LINE_ID',
  'language', 'PLSQL',
  'plsql_code', wwv_flow_string.join(wwv_flow_t_varchar2(
    'SELECT client_status,project_status,workstream_status,role_status,',
    '       template_status_prompt,template_status_avl,component_status,',
    '       predecessor_status, phase_status, subphase_status',
    'INTO :P1021_CLIENT_STATUS,:P1021_PROJECT_STATUS,:P1021_WORKSTREAM_STATUS,',
    '     :P1021_ROLE_STATUS,:P1021_TEMPLATE_STATUS_PROMPT,:P1021_TEMPLATE_STATUS_AVL,',
    '     :P1021_COMPONENT_STATUS,:P1021_PREDECESSOR_STATUS,',
    '     :P1021_PHASE_STATUS, :P1021_SUBPHASE_STATUS',
    'FROM(',
    'SELECT',
    '(SELECT CASE WHEN CLIENT_PROMPT IS NULL OR LENGTH(TRIM(CLIENT_PROMPT))=0 THEN ''Red''',
    '             WHEN LENGTH(CLIENT_PROMPT)>=100 THEN ''Green''',
    '             ELSE ''Yellow'' END',
    ' FROM CGCT_PROJECT_MASTER',
    ' WHERE ID=:P1021_PRJ_ID FETCH FIRST 1 ROW ONLY) client_status,',
    '',
    '(SELECT CASE WHEN PRJ_PROMPT IS NULL OR LENGTH(TRIM(PRJ_PROMPT))=0 THEN ''Red''',
    '             WHEN LENGTH(PRJ_PROMPT)>=100 THEN ''Green''',
    '             ELSE ''Yellow'' END',
    ' FROM CGCT_PROJECT_MASTER',
    ' WHERE ID=:P1021_PRJ_ID FETCH FIRST 1 ROW ONLY) project_status,',
    '',
    '(SELECT CASE WHEN PROMPT IS NULL OR LENGTH(TRIM(PROMPT))=0 THEN ''Red''',
    '             WHEN LENGTH(PROMPT)>=100 THEN ''Green''',
    '             ELSE ''Yellow'' END',
    ' FROM CGCT_PP_WORKSTREAM_PROMPT',
    ' WHERE UPPER(WORKSTREAM)=UPPER(:P1021_WORKSTREAM)',
    ' FETCH FIRST 1 ROW ONLY) workstream_status,',
    '',
    '(SELECT CASE WHEN PROMPT IS NULL OR LENGTH(TRIM(PROMPT))=0 THEN ''Red''',
    '             WHEN LENGTH(PROMPT)>=100 THEN ''Green''',
    '             ELSE ''Yellow'' END',
    ' FROM CGCT_PP_ROLES_PROMPT',
    ' WHERE UPPER(ROLES)=UPPER(:P1021_ROLE)',
    ' FETCH FIRST 1 ROW ONLY) role_status,',
    '',
    '(SELECT CASE WHEN PROMPT IS NULL OR LENGTH(TRIM(PROMPT))=0 THEN ''Red''',
    '             WHEN LENGTH(PROMPT)>=100 THEN ''Green''',
    '             ELSE ''Yellow'' END',
    ' FROM CGCT_PROJECT_TEMPLATES',
    ' WHERE UPPER(TEMPLATE_CODE)=UPPER(:P1021_TEMPLATE)',
    ' FETCH FIRST 1 ROW ONLY) template_status_prompt,',
    '',
    'CASE WHEN :P1021_TEMPLATE IS NULL THEN ''Red'' ELSE ''Green'' END template_status_avl,',
    '',
    '(SELECT CASE WHEN COMPONENT_PROMPT IS NULL OR LENGTH(TRIM(COMPONENT_PROMPT))=0 THEN ''Red''',
    '             WHEN LENGTH(COMPONENT_PROMPT)>=100 THEN ''Green''',
    '             ELSE ''Yellow'' END',
    ' FROM CGCT_PP_PLAN_LINE',
    ' WHERE PROJECT_PLAN_LINE_ID=:P1021_PROJECT_PLAN_LINE_ID',
    ' FETCH FIRST 1 ROW ONLY) component_status,',
    '',
    '(',
    'SELECT CASE',
    '         WHEN EXISTS (',
    '              SELECT 1',
    '              FROM cgct_pp_plan_line H',
    '              JOIN CGCT_PP_PROJECT_PLAN P',
    '                ON P.project_plan_id = H.project_plan_id',
    '               AND P.project_id      = :P0_PROJECT_ID',
    '               AND P.status          = ''Y''',
    '              WHERE (H.CATEGORY IN (''Deliverable'',''Internal Deliverable''))',
    '                AND H.ROW_NUMBER IN (',
    '                    SELECT TO_NUMBER(TRIM(REGEXP_SUBSTR(predecessors,''[^,]+'',1,LEVEL)))',
    '                    FROM CGCT_PP_PLAN_LINE',
    '                    WHERE PROJECT_PLAN_LINE_ID = :P1021_PROJECT_PLAN_LINE_ID',
    '                    CONNECT BY REGEXP_SUBSTR(predecessors,''[^,]+'',1,LEVEL) IS NOT NULL',
    '                           AND PRIOR PROJECT_PLAN_LINE_ID = PROJECT_PLAN_LINE_ID',
    '                           AND PRIOR SYS_GUID() IS NOT NULL',
    '                )',
    '                -- and H.template_id is not null',
    '          )',
    '         THEN ''Green''',
    '         ELSE ''Red''',
    '       END',
    'FROM dual',
    ') predecessor_status,',
    '',
    '(SELECT CASE WHEN PROMPT IS NULL OR LENGTH(TRIM(PROMPT))=0 THEN ''Red''',
    '             WHEN LENGTH(PROMPT)>=100 THEN ''Green''',
    '             ELSE ''Yellow'' END',
    '    FROM CGCT_PHASE_TYPE',
    '    WHERE UPPER(PHASE_TYPE)=UPPER(:P1021_PHASE)',
    '    AND PARENT_PHASE_ID IS NULL',
    '    FETCH FIRST 1 ROW ONLY) phase_status, ',
    '',
    '(SELECT CASE WHEN PROMPT IS NULL OR LENGTH(TRIM(PROMPT))=0 THEN ''Red''',
    '             WHEN LENGTH(PROMPT)>=100 THEN ''Green''',
    '             ELSE ''Yellow'' END',
    '    FROM CGCT_PHASE_TYPE',
    '    WHERE UPPER(PHASE_TYPE)=UPPER(:P1021_SUB_PHASE)',
    '    AND PARENT_PHASE_ID IS NOT NULL',
    '    FETCH FIRST 1 ROW ONLY) subphase_status',
    'FROM dual);')),
  'show_processing', 'Y',
  'suppress_change_event', 'N')).to_clob
