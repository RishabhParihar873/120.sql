'',
'        -- AND  cppl.task_name  IS NOT NULL',
'        -- AND cppl.levels <= 6',
'',
'        -- ORDER BY cppl.task_number',
'        ',
'        START WITH cppl.parent_id IS NULL',
'        CONNECT BY PRIOR cppl.project_plan_line_id = cppl.parent_id',
'        ORDER SIBLINGS BY cppl.task_number',
'',
'',
'    )',
'    LOOP',
'',
'        HTP.PRN(',
'            ''<task '' ||',
'',
'            ''id="'' || r.id || ''" '' ||',
'            ''parent="'' || NVL(r.parent, '''') || ''" '' ||',
'',
'            ''text="'' ||',
'            REPLACE(REPLACE(REPLACE(REPLACE(',
'                r.task_name,',
'                ''&'',''&amp;''),',
'                ''<'',''&lt;''),',
'                ''>'',''&gt;''),',
'                ''"'',''&quot;'') ||',
'            ''" '' ||',
'',
unistr('            -- \2705 HANDLE NULL DATES SAFELY'),
'            ',
'            ''start_date="'' ||',
'            TO_CHAR(r.planned_start,''YYYY-MM-DD'')',
'            || ''" '' ||',
'',
'            ''end_date="'' ||',
'            TO_CHAR(r.planned_end,''YYYY-MM-DD'')',
'            || ''" '' ||',
'',
'            ''level="'' ||',
'            r.levels ||',
'            ''" />''',
'        );',
'',
'    END LOOP;',
'',
'    HTP.PRN(''</data>'');',
'',
'END;'))
