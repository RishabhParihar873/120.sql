wwv_flow_imp_page.create_page_plug(
 p_id=>wwv_flow_imp.id(475817248333819421)
,p_plug_name=>'Choose for Document Selection'
,p_static_id=>'choose-for-document-selection'
,p_region_template_options=>'#DEFAULT#:t-Region--scrollBody'
,p_plug_template=>4072358936313175081
,p_plug_display_sequence=>560
,p_plug_item_display_point=>'ABOVE'
,p_query_type=>'SQL'
,p_plug_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'WITH H AS (',
'    SELECT /*+ parallel(cppl 8) */',
'           cppl.*',
'      FROM cgct_pp_plan_line cppl',
'),',
'',
'PREDECESSOR_EDGES AS (',
'    SELECT cppl.project_plan_line_id AS child_line_id,',
'           cppl.project_plan_id,',
'           TO_NUMBER(',
'               TRIM(',
'                   REGEXP_SUBSTR(',
'                       cppl.predecessors,',
'                       ''[^,]+'',',
'                       1,',
'                       LEVEL',
'                   )',
'               )',
'           ) AS predecessor_row_number',
'      FROM cgct_pp_plan_line cppl',
'     WHERE REGEXP_SUBSTR(',
'               cppl.predecessors,',
'               ''[^,]+'',',
'               1,',
'               LEVEL',
'           ) IS NOT NULL',
'   CONNECT BY',
'          REGEXP_SUBSTR(',
'              cppl.predecessors,',
'              ''[^,]+'',',
'              1,',
'              LEVEL',
'          ) IS NOT NULL',
'      AND PRIOR cppl.project_plan_line_id =',
'          cppl.project_plan_line_id',
'      AND PRIOR SYS_GUID() IS NOT NULL',
'),',
'',
'PREDECESSOR_TREE (',
'    project_plan_line_id,',
'    project_plan_id,',
'    row_number,',
'    visited_path',
') AS (',
'    SELECT start_line.project_plan_line_id,',
'           start_line.project_plan_id,',
'           start_line.row_number,',
'           CAST(',
'               ''/'' || start_line.project_plan_line_id || ''/''',
'               AS VARCHAR2(4000)',
'           ) AS visited_path',
'      FROM cgct_pp_plan_line start_line',
'     WHERE start_line.project_plan_line_id =',
'           :P1021_PROJECT_PLAN_LINE_ID',
'',
'    UNION ALL',
'',
'    SELECT predecessor_line.project_plan_line_id,',
'           predecessor_line.project_plan_id,',
'           predecessor_line.row_number,',
'           CAST(',
'               predecessor_tree.visited_path',
'               || predecessor_line.project_plan_line_id',
'               || ''/''',
'               AS VARCHAR2(4000)',
'           ) AS visited_path',
'      FROM PREDECESSOR_TREE predecessor_tree',
'      JOIN PREDECESSOR_EDGES edge',
'        ON edge.child_line_id =',
'           predecessor_tree.project_plan_line_id',
'       AND edge.project_plan_id =',
'           predecessor_tree.project_plan_id',
'      JOIN cgct_pp_plan_line predecessor_line',
'        ON predecessor_line.project_plan_id =',
'           predecessor_tree.project_plan_id',
'       AND predecessor_line.row_number =',
'           edge.predecessor_row_number',
'     WHERE INSTR(',
'               predecessor_tree.visited_path,',
'               ''/'' || predecessor_line.project_plan_line_id || ''/''',
'           ) = 0',
'),',
'',
'ALL_PREDECESSORS AS (',
'    SELECT DISTINCT',
'           predecessor_tree.project_plan_line_id',
'      FROM PREDECESSOR_TREE predecessor_tree',
'     WHERE predecessor_tree.project_plan_line_id <>',
'           :P1021_PROJECT_PLAN_LINE_ID',
'),',
'',
'DOC_COUNT AS (',
'    SELECT d.project_plan_line_id,',
'           COUNT(*) AS attachment_count',
'      FROM cgct_deliverable_api_document d',
'     GROUP BY d.project_plan_line_id',
'),',
'',
'BASELINED_DOCUMENTS AS (',
'    SELECT d.deliverable_id,',
'           d.project_plan_line_id,',
'           d.generation_status,',
'           d.job_id',
'      FROM cgct_deliverable_api_document d',
'     WHERE d.baselined = ''Y''',
')',
'',
'SELECT',
'       H.project_plan_line_id,',
'',
'       H.task_name,',
'',
'       DEL.deliverable_id AS document_id,',
'',
'       DEL.generation_status AS document_generation_status,',
'',
'       DEL.job_id AS document_job_id,',
'',
'       CASE',
'           WHEN NVL(D.attachment_count, 0) > 0',
'           THEN',
'               APEX_PAGE.GET_URL(',
'                   p_page        => 1066,',
'                   p_items       => ''P1066_PROJECT_PLAN_LINE_ID'',',
'                   p_values      => H.project_plan_line_id,',
'                   p_clear_cache => ''1066''',
'               )',
'           ELSE',
'               NULL',
'       END AS attachment_url,',
'',
'       CASE',
'           WHEN NVL(D.attachment_count, 0) > 0',
'           THEN',
'                  ''<span class="fa fa-eye" ''',
'               || ''title="View Attachments" ''',
'               || ''aria-label="View Attachments"></span>''',
'           ELSE',
'                  ''<span class="fa fa-times" ''',
'               || ''style="color:#d63b25;" ''',
'               || ''title="No Attachment" ''',
'               || ''aria-label="No Attachment"></span>''',
'       END AS view_attachment,',
'',
'       CASE',
'           WHEN UPPER(TRIM(DEL.generation_status)) = ''COMPLETED''',
'           THEN',
'                  ''<span class="fa fa-download js-download" ''',
'               || ''data-document-id="''',
'               || DEL.deliverable_id',
'               || ''" ''',
'               || ''data-plan-id="''',
'               || H.project_plan_line_id',
'               || ''" ''',
'               || ''data-project-id="''',
'               || DEL.job_id',
'               || ''" ''',
'               || ''style="cursor:pointer; font-size:18px;" ''',
'               || ''title="Download Attachment" ''',
'               || ''aria-label="Download Document"></span>''',
'',
'           WHEN UPPER(TRIM(DEL.generation_status)) = ''FAILED''',
'           THEN',
'                  ''<span class="fa fa-times" ''',
'               || ''style="color:#d63b25; font-size:18px;" ''',
'               || ''title="Document Generation Failed" ''',
'               || ''aria-label="Document Generation Failed"></span>''',
'',
'           WHEN UPPER(TRIM(DEL.generation_status)) IN (',
'                    ''PENDING'',',
'                    ''IN PROGRESS'',',
'                    ''IN_PROGRESS'',',
'                    ''PROCESSING''',
'                )',
'           THEN',
'                  ''<span class="fa fa-spinner fa-spin" ''',
'               || ''style="color:#f0ad4e; font-size:18px;" ''',
'               || ''title="Document Generation in Progress" ''',
'               || ''aria-label="Document Generation in Progress"></span>''',
'',
'           ELSE',
'                  ''<span class="fa fa-minus" ''',
'               || ''style="color:#808080; font-size:18px;" ''',
'               || ''title="Document Not Generated" ''',
'               || ''aria-label="Document Not Generated"></span>''',
'       END AS fsd_download,',
'',
'       MAX(',
'           CASE',
'               WHEN DEL.deliverable_id IS NOT NULL THEN 1',
'               ELSE 0',
'           END',
'       ) OVER () AS has_any_document,',
'',
'       APEX_ITEM.CHECKBOX2(',
'           p_idx        => 1,',
'           p_value      => H.project_plan_line_id,',
'           p_attributes =>',
'                  ''class="start-checkbox" ''',
'               || ''title="Select Document" ''',
'               || ''data-enable="''',
'               || CASE',
'                      WHEN NOT EXISTS (',
'                               SELECT 1',
'                                 FROM cgct_pp_plan_line child',
'                                WHERE child.parent_id =',
'                                      H.project_plan_line_id',
'                           )',
'                      THEN ''Y''',
'                      ELSE ''N''',
'                  END',
'               || ''" ''',
'               || ''data-task="''',
'               || NVL(',
'                      REPLACE(',
'                          H.task_number,',
'                          ''"'',',
'                          ''&quot;''',
'                      ),',
'                      ''''',
'                  )',
'               || ''"''',
'       ) AS start_sel',
'',
'  FROM H',
'',
'  JOIN cgct_pp_project_plan P',
'    ON P.project_plan_id = H.project_plan_id',
'   AND P.project_id      = :P0_PROJECT_ID',
'   AND P.status          = ''Y''',
'',
'  JOIN ALL_PREDECESSORS AP',
'    ON AP.project_plan_line_id = H.project_plan_line_id',
'',
'  LEFT JOIN cgct_project_templates TM',
'    ON TM.id = H.template_id',
'',
'  LEFT JOIN DOC_COUNT D',
'    ON D.project_plan_line_id = H.project_plan_line_id',
'',
'  LEFT JOIN BASELINED_DOCUMENTS DEL',
'    ON DEL.project_plan_line_id = H.project_plan_line_id',
'',
' WHERE H.category IN (',
'           ''Deliverable'',',
'           ''Internal Deliverable''',
'       );'))
,p_plug_source_type=>'NATIVE_IG'
,p_ajax_items_to_submit=>'P1021_PROJECT_PLAN_LINE_ID'
