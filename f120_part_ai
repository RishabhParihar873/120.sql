,p_validation_condition=>wwv_flow_string.join(wwv_flow_t_varchar2(
'DECLARE',
'    l_clean_ids   VARCHAR2(4000);',
'    l_has_child   NUMBER := 0;',
'BEGIN',
'    l_clean_ids := TRIM(BOTH '':'' FROM :P1047_SELECTED_IDS);',
'',
'    FOR rec IN (',
'        SELECT REGEXP_SUBSTR(l_clean_ids, ''[^:]+'', 1, LEVEL) AS task_id',
'        FROM dual',
'        CONNECT BY REGEXP_SUBSTR(l_clean_ids, ''[^:]+'', 1, LEVEL) IS NOT NULL',
'    )',
'    LOOP',
'        -- Check if the task has children',
'        SELECT COUNT(1)',
'        INTO l_has_child',
'        FROM cgct_pp_plan_line',
'        WHERE parent_id = rec.task_id;',
'',
'        -- If any task is a parent, skip validation',
'        IF l_has_child > 0 THEN',
'            RETURN FALSE;',
'        END IF;',
'    END LOOP;',
'',
'    -- No parent tasks found, run the validation',
'    RETURN TRUE;',
'END;'))
