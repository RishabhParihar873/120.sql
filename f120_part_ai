'    :P1034_ACCESS_TOKEN := l_access_token;',
'',
'    :P1034_FILE_URL :=',
'        ''https://ybft8bl4darvpgg-oblatp23ai.adb.us-ashburn-1.oraclecloudapps.com/ords/del_dev/visio/file/''',
'        || l_file_id',
'        || ''/''',
'        || l_access_token;',
'',
'exception',
'    when no_data_found then',
'        raise_application_error(-20003, ''Uploaded file was not found in APEX temporary files.'');',
'end;'))
