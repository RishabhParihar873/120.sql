'                end rating_icon,',
'          lower(created_by) || '' - '' || apex_util.get_since(created_on) filed,',
'          feedback,',
'          public_response,',
'          feedback_status,',
'          http_user_agent',
'     from apex_team_feedback',
'    where feedback_id = :P10214_ID )',
'loop',
'   :P10214_PAGE_ID         := l_feedback.page_id||''. ''||l_feedback.page_name;',
'   :P10214_FILED           := l_feedback.filed;',
'   :P10214_RATING_ICON     := l_feedback.rating_icon;',
'   :P10214_FEEDBACK        := l_feedback.feedback;',
'   :P10214_RESPONSE        := l_feedback.public_response;',
'   :P10214_FEEDBACK_STATUS := l_feedback.feedback_status;',
'   :P10214_USER_AGENT      := l_feedback.http_user_agent;',
