,p_action_sequence=>90
,p_execute_on_page_init=>'N'
,p_name=>'For new_1_1 item'
,p_static_id=>'for-new-1-1-item'
,p_action=>'NATIVE_SET_VALUE'
,p_affected_elements_type=>'ITEM'
,p_affected_elements=>'P993_NEW_1_1'
,p_attributes=>wwv_flow_t_plugin_attributes(wwv_flow_t_varchar2(
  'escape_special_characters', 'N',
  'items_to_submit', 'P993_PROJECT_PLAN_DETAILS,P993_WAVE_1,P993_PROJECT_PHASE_1,P993_PROJECT_SUB_PHASE_1',
  'sql_query', wwv_flow_string.join(wwv_flow_t_varchar2(
    'select count(1) from(SELECT  ',
    '    PROJECT_PLAN_LINE_ID,',
    '    TASK_NUMBER,',
    '    CASE ',
    '        WHEN LEVELS = 1 THEN TASK_NAME',
    '        WHEN LEVELS = 2 THEN ''30...'' || TASK_NAME',
    '        WHEN LEVELS = 3 THEN ''60...'' || TASK_NAME',
    '        WHEN LEVELS = 4 THEN ''90...'' || TASK_NAME',
    '        WHEN LEVELS = 5 THEN ''120...'' || TASK_NAME',
    '        WHEN LEVELS = 6 THEN ''150...'' || TASK_NAME',
    '        ELSE ''    '' || TASK_NAME',
    '    END AS TASK_NAME,',
    '    PLANNED_START,',
    '    PLANNED_END,',
    '    LEVELS,',
    '    -- MIN(PLANNED_START) AS MIN_START,',
    '    -- MAX(PLANNED_END) AS MAX_END,',
    '         MIN(PLANNED_START) OVER (PARTITION BY PROJECT_PLAN_ID) AS MIN_START,',
    '    MAX(PLANNED_END) OVER (PARTITION BY PROJECT_PLAN_ID) AS MAX_END,',
    '    PROJECT_PLAN_ID',
    'FROM CGCT_PP_PLAN_LINE cppl',
    'WHERE PROJECT_PLAN_ID = :P993_PROJECT_PLAN_DETAILS',
    '  AND LEVELS IN (1, 2, 3, 4, 5, 6)',
    'AND (',
    '    (:P993_WAVE_1 IS NULL AND :P993_PROJECT_PHASE_1 IS NULL AND :P993_PROJECT_SUB_PHASE_1 IS NULL)',
    '    OR cppl.PROJECT_PLAN_LINE_ID IN (',
    '        -- 1. Get selected node and all its children',
    '        SELECT PROJECT_PLAN_LINE_ID',
    '        FROM CGCT_PP_PLAN_LINE',
    '        CONNECT BY PRIOR PROJECT_PLAN_LINE_ID = PARENT_ID',
    '        START WITH PROJECT_PLAN_LINE_ID = ',
    '            CASE ',
    '                WHEN :P993_PROJECT_SUB_PHASE_1 IS NOT NULL THEN :P993_PROJECT_SUB_PHASE_1',
    '                WHEN :P993_PROJECT_PHASE_1 IS NOT NULL THEN :P993_PROJECT_PHASE_1',
    '                WHEN :P993_WAVE_1 IS NOT NULL THEN :P993_WAVE_1',
    '            END',
    '',
    '        UNION',
    '        -- 2. Get ancestors (parent and grandparent)',
    '        SELECT PROJECT_PLAN_LINE_ID',
    '        FROM CGCT_PP_PLAN_LINE',
    '        CONNECT BY PROJECT_PLAN_LINE_ID = PRIOR PARENT_ID',
    '        START WITH PROJECT_PLAN_LINE_ID = ',
    '            CASE ',
    '                WHEN :P993_PROJECT_SUB_PHASE_1 IS NOT NULL THEN :P993_PROJECT_SUB_PHASE_1',
    '                WHEN :P993_PROJECT_PHASE_1 IS NOT NULL THEN :P993_PROJECT_PHASE_1',
    '                WHEN :P993_WAVE_1 IS NOT NULL THEN :P993_WAVE_1',
    '            END',
    '    )',
    ')',
    'GROUP BY ',
    '    PROJECT_PLAN_LINE_ID,',
    '    TASK_NUMBER,',
    '    CASE ',
    '        WHEN LEVELS = 1 THEN TASK_NAME',
    '        WHEN LEVELS = 2 THEN ''30...'' || TASK_NAME',
    '        WHEN LEVELS = 3 THEN ''60...'' || TASK_NAME',
    '        WHEN LEVELS = 4 THEN ''90...'' || TASK_NAME',
    '        WHEN LEVELS = 5 THEN ''120...'' || TASK_NAME',
    '        WHEN LEVELS = 6 THEN ''150...'' || TASK_NAME',
    '        ELSE ''    '' || TASK_NAME',
    '    END,',
    '    PLANNED_START,',
    '    PLANNED_END,',
    '    LEVELS,',
    '    PROJECT_PLAN_ID',
    'ORDER BY PROJECT_PLAN_LINE_ID)')),
  'suppress_change_event', 'N',
  'type', 'SQL_STATEMENT')).to_clob
,p_wait_for_result=>'Y'
