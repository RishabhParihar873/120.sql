,p_process_sql_clob=>wwv_flow_string.join(wwv_flow_t_varchar2(
'DECLARE',
'    l_response            CLOB;',
'    l_response_pipeline   CLOB;',
'    l_response_bulk       CLOB;',
'    l_response_approve    CLOB;',
'    l_body                CLOB;',
'    l_body_pipeline       CLOB;',
'    l_project_id          VARCHAR2(100);',
'    l_project_code        VARCHAR2(100);',
'    l_task_name           VARCHAR2(200);',
'    l_created_by          VARCHAR2(200);',
'',
'    l_blob                BLOB;',
'    l_filename            VARCHAR2(255);',
'    l_mime_type           VARCHAR2(255);',
'    l_doc_type            VARCHAR2(100);',
'',
'    l_request_body        BLOB;',
'    l_boundary            VARCHAR2(50) := ''----WebKitFormBoundary7MA4YWxkTrZu0gW'';',
'    l_part                RAW(32767);',
'    ',
'    l_url                 VARCHAR2(4000);',
'    l_pipeline_status     VARCHAR2(50);',
'    l_pct_complete        NUMBER;',
'',
'    l_attempts          NUMBER := 0;',
'    l_max_attempts      NUMBER := 120; -- 120 * 10 seconds = 20 minutes max wait',
'    l_count NUMBER;',
'',
'BEGIN',
'',
'    ------------------------------------------------------------',
'    -- 1. CREATE PROJECT',
'    ------------------------------------------------------------',
'    SELECT ''ICT1-'' || ICT_PROJECT_SEQ.NEXTVAL',
'    INTO l_project_code',
'    FROM dual;',
'',
'    l_task_name := :P1045_TASK_NAME;',
'    -- select EMPLOYEE_NAME into l_created_by from CGCT_APP_USERS where USER_ID=:P0_USER_ID_EMAIL;',
'',
'    l_body := JSON_OBJECT(',
'        ''project_code'' VALUE l_project_code,',
'        -- ''project_name'' VALUE ''ICT_PROJECT'',',
'        -- ''project_name'' VALUE :P1045_TASK_NAME,',
'        ''project_name'' VALUE l_task_name,',
'        ''project_type'' VALUE ''INTEGRATION'',',
'        ''fsd_template_code'' VALUE ''HCM_INTEGRATION_V1''',
'    );',
'    --    ,''created_by'' VALUE l_created_by',
'',
'    apex_web_service.g_request_headers.DELETE;',
'    apex_web_service.g_request_headers(1).name  := ''Content-Type'';',
'    apex_web_service.g_request_headers(1).value := ''application/json'';',
'',
'    l_response := apex_web_service.make_rest_request(',
'        p_url => ''https://cwkfvo65cuzpsk4g3zddt4rqhu.apigateway.us-ashburn-1.oci.customer-oci.com/api/v1/projects'',',
'        p_http_method => ''POST'',',
'        p_body => l_body',
'    );',
'',
'    SELECT project_id',
'    INTO l_project_id',
'    FROM JSON_TABLE(',
'        l_response,',
'        ''$''',
'        COLUMNS (project_id VARCHAR2(100) PATH ''$.project_id'')',
'    );',
'',
'    -- l_project_id := l_response;',
'    -- l_project_id := 1212;',
'    :P1045_GENERATED_PROJECT_ID := l_project_id;',
'    apex_debug.message(''Project created''||l_project_id);',
'',
'    --------------------------------------------------',
'    --Insertion Generated Project ID--',
'    --------------------------------------------------',
'    -- SELECT COUNT(*)',
'    -- INTO l_count',
'    -- FROM CGCT_DELIVERABLE_API_DOCUMENT',
'    -- WHERE PROJECT_PLAN_LINE_ID =:P1045_PROJECT_PLAN_LINE_ID;',
' ',
'    -- IF l_count > 0 THEN',
unistr('    --     -- Record exists \2192 UPDATE'),
'    --     UPDATE CGCT_DELIVERABLE_API_DOCUMENT',
'    --     SET GENERATED_PROJECT_ID = l_project_id',
'    --     WHERE PROJECT_PLAN_LINE_ID =:P1045_PROJECT_PLAN_LINE_ID;',
' ',
'    -- ELSE',
unistr('    --     -- Record does not exist \2192 INSERT'),
'    --     INSERT INTO CGCT_DELIVERABLE_API_DOCUMENT',
'    --     (PROJECT_PLAN_LINE_ID, GENERATED_PROJECT_ID)',
'    --     VALUES (:P1045_PROJECT_PLAN_LINE_ID, l_project_id);',
'    -- END IF;',
'    ',
'        MERGE INTO CGCT_DELIVERABLE_API_DOCUMENT t',
'    USING (',
'        SELECT ',
'            :P1045_PROJECT_PLAN_LINE_ID AS PROJECT_PLAN_LINE_ID,',
'            l_project_id AS GENERATED_PROJECT_ID',
'        FROM dual',
'    ) s',
'    ON (',
'        t.PROJECT_PLAN_LINE_ID = s.PROJECT_PLAN_LINE_ID',
'    )',
'    WHEN MATCHED THEN',
'        UPDATE SET ',
'            t.GENERATED_PROJECT_ID = s.GENERATED_PROJECT_ID,',
'            t.GENERATION_STATUS = ''IN_PROGRESS'',',
'            t.GENERATED_ON = SYSDATE,',
'            t.COMPLETED_ON = NULL,',
'            t.TYPE = ''AI'',',
'            t.BASELINED = ''Y''',
'    WHEN NOT MATCHED THEN',
'        INSERT (',
'            PROJECT_PLAN_LINE_ID,',
'            GENERATED_PROJECT_ID,',
'            GENERATION_STATUS,',
'            GENERATED_ON,',
'            COMPLETED_ON,',
'            TYPE,',
'            BASELINED',
'        )',
'        VALUES (',
'            s.PROJECT_PLAN_LINE_ID,',
'            s.GENERATED_PROJECT_ID,',
'            ''IN_PROGRESS'',',
'            SYSDATE,',
'            NULL,',
'            ''AI'',',
'            ''Y''',
'        );',
'    ',
'    COMMIT;',
'',
'    ------------------------------------------------------------',
'    -- 2. UPLOAD FILE',
'    ------------------------------------------------------------',
'',
'',
'',
'    SELECT filename,',
'       blob_content,',
'       mime_type',
'INTO   l_filename,',
'       l_blob,',
'       l_mime_type',
'FROM   apex_application_temp_files',
'WHERE  name =:P1045_BLOB_CONTENT or filename =:P1045_BLOB_CONTENT;',
'',
'insert into FILE_UPLOAD_TST(FILENAME,MIME_TYPE,BLOB_CONTENT)',
'values(l_filename,l_mime_type,l_blob);',
'commit;',
'',
'    ',
'    l_doc_type  := ''BRD'';',
'',
'    DBMS_LOB.CREATETEMPORARY(l_request_body, TRUE);',
'',
'    -- project_id part',
'    l_part := UTL_RAW.CAST_TO_RAW(',
'        ''--'' || l_boundary || CHR(13) || CHR(10) ||',
'        ''Content-Disposition: form-data; name="project_id"'' || CHR(13) || CHR(10) || CHR(13) || CHR(10) ||',
'        l_project_id || CHR(13) || CHR(10)',
'    );',
'    DBMS_LOB.WRITEAPPEND(l_request_body, UTL_RAW.LENGTH(l_part), l_part);',
'',
'    -- doc_type part',
'    l_part := UTL_RAW.CAST_TO_RAW(',
'        ''--'' || l_boundary || CHR(13) || CHR(10) ||',
'        ''Content-Disposition: form-data; name="doc_type"'' || CHR(13) || CHR(10) || CHR(13) || CHR(10) ||',
'        l_doc_type || CHR(13) || CHR(10)',
'    );',
'    DBMS_LOB.WRITEAPPEND(l_request_body, UTL_RAW.LENGTH(l_part), l_part);',
'',
'    -- file part',
'    l_part := UTL_RAW.CAST_TO_RAW(',
'        ''--'' || l_boundary || CHR(13) || CHR(10) ||',
'        ''Content-Disposition: form-data; name="file"; filename="'' || l_filename || ''"'' || CHR(13) || CHR(10) ||',
'        ''Content-Type: '' || l_mime_type || CHR(13) || CHR(10) || CHR(13) || CHR(10)',
'    );',
'    DBMS_LOB.WRITEAPPEND(l_request_body, UTL_RAW.LENGTH(l_part), l_part);',
'',
'    DBMS_LOB.APPEND(l_request_body, l_blob);',
'',
'    -- close boundary',
'    l_part := UTL_RAW.CAST_TO_RAW(',
'        CHR(13) || CHR(10) || ''--'' || l_boundary || ''--'' || CHR(13) || CHR(10)',
'    );',
'    DBMS_LOB.WRITEAPPEND(l_request_body, UTL_RAW.LENGTH(l_part), l_part);',
'',
'    apex_web_service.g_request_headers.DELETE;',
'    apex_web_service.g_request_headers(1).name := ''Content-Type'';',
'    apex_web_service.g_request_headers(1).value :=',
'        ''multipart/form-data; boundary='' || l_boundary;',
'',
'    l_response := apex_web_service.make_rest_request(',
'        p_url => ''https://cwkfvo65cuzpsk4g3zddt4rqhu.apigateway.us-ashburn-1.oci.customer-oci.com/api/v1/documents/upload'',',
'        p_http_method => ''POST'',',
'        p_body_blob => l_request_body',
'    );',
'apex_debug.message(''Document Uploaded''||l_response);',
'    ------------------------------------------------------------',
unistr('    -- 3. RUN PIPELINE \2705'),
'    ------------------------------------------------------------',
'    l_body_pipeline := JSON_OBJECT(',
'        ''mode'' VALUE ''FULL'',',
'        ''doc_format'' VALUE ''DOCX''',
'    );',
'',
'    apex_web_service.g_request_headers.DELETE;',
'    apex_web_service.g_request_headers(1).name  := ''Content-Type'';',
'    apex_web_service.g_request_headers(1).value := ''application/json'';',
'',
'    l_response_pipeline := apex_web_service.make_rest_request(',
'        p_url => ''https://cwkfvo65cuzpsk4g3zddt4rqhu.apigateway.us-ashburn-1.oci.customer-oci.com/api/v1/pipeline/''',
'                 || l_project_id || ''/run'',',
'        p_http_method => ''POST'',',
'        p_body => l_body_pipeline',
'    );',
'',
'    -- apex_debug.message(''Pipeline created successfully. Waiting for completion...'');',
'',
'',
'    DBMS_SCHEDULER.create_job (',
'    job_name        => ''JOB_VALIDATE_'' || l_project_id,',
'    job_type        => ''PLSQL_BLOCK'',',
'    job_action      => ''BEGIN run_post_pipeline('''''' || l_project_id || ''''''); END;'',',
'    start_date      => SYSTIMESTAMP + INTERVAL ''5'' MINUTE,',
'    enabled         => TRUE,',
'    auto_drop       => TRUE',
');',
'',
'apex_debug.message(''Scheduler job created for validation/approval'');',
'',
' ',
'',
'    ------------------------------------------------------------',
unistr('    -- 4. VALIDATE \2705'),
'    ------------------------------------------------------------',
'    apex_debug.message(''Pipeline completed. Validation starting...'');',
'',
'    apex_web_service.g_request_headers.DELETE;',
'',
'    l_response_approve := apex_web_service.make_rest_request(',
'        p_url => ''https://cwkfvo65cuzpsk4g3zddt4rqhu.apigateway.us-ashburn-1.oci.customer-oci.com/api/v1/sections/project/''',
'                 || l_project_id || ''/validate-all'',',
'        p_http_method => ''POST''',
'    );',
'',
'    apex_debug.message(''Validation completed, approval starting...'');',
'',
