'SELECT DISTINCT',
'       c.ID,',
'       (SELECT ',
'        ''<span class="hover-text" title="'' || TOPIC_NAME || ''">'' || ',
'            CASE ',
'              WHEN LENGTH(TOPIC_NAME) > 50',
'              THEN SUBSTR(TOPIC_NAME, 1, INSTR(TOPIC_NAME || '' '', '' '', ROUND(LENGTH(TOPIC_NAME) / 2)) - 1) || ''<br>'' || ',
'                   SUBSTR(TOPIC_NAME, INSTR(TOPIC_NAME || '' '', '' '', ROUND(LENGTH(TOPIC_NAME) / 2)) + 1) ',
'              ELSE ',
'              TOPIC_NAME ',
'            END || ''</span>''',
'        FROM CGCT_PRJ_KEY_DECISION_DOCS k ',
'        WHERE k.ID = c.ID ',
'          AND ACTIVE_FLAG = ''Y'') AS TOPIC_NAME,',
'    --    ''<span class="hover-text" title="'' || c.TOPIC_NAME || ''">'' || c.TOPIC_NAME || ''</span>'' AS TOPIC_NAME,',
'       ''<span class="hover-text" title="'' || c.DESCRIPTION || ''">'' || c.DESCRIPTION || ''</span>'' AS Decision_Description,',
'    --    c.DESCRIPTION,',
'       c.GUIDELINE_NOTE,',
'       c.MILESTONE_NAME,',
'       c.CAPGEMINI_RECOMMENDATION,',
'       c.CREATION_DATE,',
'       c.CREATED_BY,',
'       c.LAST_UPDATE_DATE,',
'       c.LAST_UPDATE_BY,',
