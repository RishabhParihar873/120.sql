  'plsql_function_body', wwv_flow_string.join(wwv_flow_t_varchar2(
    'DECLARE',
    '    duration1 NUMBER;',
    '    duration2 NUMBER;',
    '    duration3 NUMBER;',
    '    M_NEW NUMBER;',
    '    final_duration NUMBER;',
    'BEGIN',
    '    -- Fetch the original duration',
    '    SELECT duration ',
    '    INTO duration1 ',
    '    FROM cgct_pp_plan_line ',
    '    WHERE PROJECT_PLAN_LINE_ID = :P1053_PROJECT_PLAN_LINE_ID;',
    '    --3',
    ' ',
    '    -- Calculate the new duration',
    '    SELECT NVL(MORE_EFFORTS,0)',
    '    INTO M_NEW ',
    '    FROM cgct_more_efforts',
    '    WHERE PROJECT_PLAN_LINE_ID = :P1053_PROJECT_PLAN_LINE_ID;',
    '    --9',
    '',
    '    SELECT original_duration ',
    '    INTO duration2',
    '    FROM cgct_more_efforts',
    '    WHERE PROJECT_PLAN_LINE_ID = :P1053_PROJECT_PLAN_LINE_ID;',
    '    --2',
    '',
    '    if m_new!=0 then',
    '',
    '    -- if duration2 =:P1053_DURATION  then',
    '',
    '      duration3 := duration2;',
    '      M_NEW:=0;',
    '      final_duration := duration2 + ROUND((CEIL(ABS(M_NEW - :P1053_MORE_EFFORTS_REQUIRED) / 9) * 9) / (9 * (:P1053_ALLOCATION_PERCENTAGE / 100)), 0);',
    '   ',
    '      ',
    '    -- end if;',
    '    else ',
    '',
    '    final_duration := duration1 + ROUND((CEIL(ABS(M_NEW - :P1053_MORE_EFFORTS_REQUIRED) / 9) * 9) / (9 * (:P1053_ALLOCATION_PERCENTAGE / 100)), 0);',
    '   ',
    '',
    '    end if;',
    ' ',
    '',
    '      ',
    '    -- Return the result (for example, via DBMS_OUTPUT or OUT parameter)',
    '    return final_duration;',
    'END;')),
  'suppress_change_event', 'N',
  'type', 'FUNCTION_BODY')).to_clob
