'        onclick="DropdownHandler.toggle(this)">',
'  </span>',
'</div>',
'',
'<div id="globalDropdown" class="custom-dropdown" style="',
'  display:none;',
'  position:fixed;',
'  background:#fff;',
'  border:1px solid #ccc;',
'  border-radius:5px;',
'  box-shadow:0 2px 6px rgba(0,0,0,0.2);',
'  padding:5px;',
'  z-index:9999;',
'  min-width:200px;',
'  white-space:nowrap;',
'  overflow:hidden;',
'  text-overflow:ellipsis;">',
'  <div style="padding:8px 12px;cursor:pointer;" onclick="DropdownHandler.openModal(''VIEW_TEMPLATE'')">View Template</div>',
'  <div style="padding:8px 12px;cursor:pointer;" onclick="DropdownHandler.openModal(''DOWNLOAD_DELIVERABLES'')">Download Deliverables</div>',
'</div>',
'',
'<script>',
'window.DropdownHandler = (function() {',
'  let _data = {};',
'',
'  function toggle(icon) {',
'    const dd = document.getElementById(''globalDropdown'');',
'    if (dd.style.display === ''block'') {',
'      dd.style.display = ''none'';',
'      return;',
'    }',
'',
'    _data = {',
'      templateId: icon.getAttribute(''data-template-id''),',
'      fileName: icon.getAttribute(''data-file-name''),',
'      filePath: icon.getAttribute(''data-file-path''),',
'      projectPlanLineId: icon.getAttribute(''data-project-plan-line-id'')',
'    };',
'',
'    dd.style.visibility = ''hidden'';',
'    dd.style.display = ''block'';',
'',
'    const r = icon.getBoundingClientRect();',
'    const dw = dd.offsetWidth, dh = dd.offsetHeight;',
'    const sb = window.innerHeight - r.bottom, sa = r.top;',
'    const sr = window.innerWidth - r.right, sl = r.left;',
'',
'    const top = (sb < dh && sa > dh) ? r.top - dh : r.bottom;',
'    const left = (sr < dw && sl > dw) ? r.left - dw : r.right;',
'',
'    dd.style.top = top + ''px'';',
'    dd.style.left = left + ''px'';',
'    dd.style.visibility = ''visible'';',
'  }',
'',
'  function openModal(action) {',
'    if (!_data.templateId && !_data.projectPlanLineId) {',
