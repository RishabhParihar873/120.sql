wwv_flow_imp_page.create_report_region(
 p_id=>wwv_flow_imp.id(635641959103255396)
,p_name=>'Search_Result'
,p_static_id=>'search-result'
,p_title=>'Search Result'
,p_template=>4072358936313175081
,p_display_sequence=>100
,p_region_template_options=>'#DEFAULT#:t-Region--scrollBody'
,p_component_template_options=>'#DEFAULT#:t-Report--altRowsDefault:t-Report--rowHighlight'
,p_new_grid_row=>false
,p_source_type=>'NATIVE_SQL_REPORT'
,p_query_type=>'SQL'
,p_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'WITH input_params AS (',
'    SELECT ',
'        TRUNC(SYSDATE) AS base_date,',
'        :P1079_MAX_DATE AS max_date,',
'        NVL(:P1079_DATE_OFFSET, 0) AS offset',
'    FROM DUAL',
'),',
'offset_dates AS (',
'    SELECT ip.base_date + LEVEL - 1 AS candidate_date',
'    FROM input_params ip',
'    CONNECT BY LEVEL <= 100',
'),',
'skipped_offset AS (',
'    SELECT candidate_date',
'    FROM offset_dates, input_params',
'    WHERE TO_CHAR(candidate_date, ''DY'', ''NLS_DATE_LANGUAGE=ENGLISH'') NOT IN (''SAT'', ''SUN'')',
'    AND ROWNUM <= input_params.offset',
'),',
'start_date AS (',
'    SELECT NVL(MAX(candidate_date), TRUNC(SYSDATE)) + 1 AS start_date',
'    FROM skipped_offset',
'),',
'next_weekdays AS (',
'    SELECT candidate_date AS work_date, ROWNUM AS day_num',
'    FROM (',
'        SELECT sd.start_date + LEVEL - 1 AS candidate_date',
'        FROM start_date sd',
'        CONNECT BY LEVEL <= 30',
'    )',
'    WHERE TO_CHAR(candidate_date, ''DY'', ''NLS_DATE_LANGUAGE=ENGLISH'') NOT IN (''SAT'', ''SUN'')',
'      AND candidate_date <= (SELECT max_date FROM input_params)',
'    AND ROWNUM <= 5',
'),',
'project_data AS (',
'    SELECT ',
'        pm.ID AS project_id,',
'        pm.ID AS project_name,',
'        au.EMPLOYEE_NAME,',
'        wd.work_date,',
'        wd.day_num,',
'        ROUND(SUM((ct.HOURS + ct.MORE_EFFORTS_REQUIRED) /',
'            (SELECT COUNT(*) FROM (',
'                SELECT TRUNC(ct.ESTIMATED__START_DATE + LEVEL - 1) AS work_day',
'                FROM DUAL',
'                CONNECT BY LEVEL <= ct.ESTIMATED_END__DATE - ct.ESTIMATED__START_DATE + 1',
'            )',
'            WHERE TO_CHAR(work_day, ''DY'', ''NLS_DATE_LANGUAGE=ENGLISH'') NOT IN (''SAT'', ''SUN''))), 0) AS effort',
'    FROM next_weekdays wd',
'    JOIN CGCT_PROJECT_GRANT pg ON 1=1',
'    JOIN CGCT_APP_USERS au ON pg.USER_ID = au.USER_ID',
'    JOIN CGCT_PROJECT_MASTER pm ON pg.PROJECT_ID = pm.ID',
'    LEFT JOIN CGCT_TASKS ct ',
'        ON REGEXP_LIKE(ct.EMP_ID, ''(^|,)'' || au.EMPLOYEE_ID || ''(,|$)'')',
'        AND ct.PRJ_ID = pm.ID',
'        AND wd.work_date BETWEEN ct.ESTIMATED__START_DATE AND ct.ESTIMATED_END__DATE',
'    WHERE ',
'        (:P1079_PROJECT_NAME IS NULL OR pm.ID = :P1079_PROJECT_NAME)',
'        AND (:P1079_EMPLOYEE_NAME IS NULL OR au.EMPLOYEE_NAME = :P1079_EMPLOYEE_NAME)',
'    GROUP BY pm.ID, au.EMPLOYEE_NAME, wd.work_date, wd.day_num',
')',
'SELECT ',
'    project_id,',
'    project_name,',
'    EMPLOYEE_NAME,',
'    MAX(CASE WHEN day_num = 1 THEN effort END) AS D1,',
'    MAX(CASE WHEN day_num = 2 THEN effort END) AS D2,',
'    MAX(CASE WHEN day_num = 3 THEN effort END) AS D3,',
'    MAX(CASE WHEN day_num = 4 THEN effort END) AS D4,',
'    MAX(CASE WHEN day_num = 5 THEN effort END) AS D5',
'FROM project_data',
'GROUP BY project_id, project_name, EMPLOYEE_NAME;',
''))
