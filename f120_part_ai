,p_plug_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'SELECT',
'    w.ID,',
'    DMM.DOMAIN_ID,',
'    m.MODULE_ID,',
'    w.CREATION_DATE,',
'    w.CREATED_BY,',
'    w.LAST_UPDATE_DATE,',
'    w.LAST_UPDATED_BY,',
'    w.APPLICATION_ID,',
'    w.PRJ_ID,',
'    w.ACTIVE_FLAG,',
'    w.FILE_NAME,',
'    w.FILE_PATH,',
'    ''<span class="fa fa-upload upload-btn"></span>'' AS UPLOAD,',
'    CASE ',
'        WHEN w.FILE_PATH IS NULL THEN ',
'            ''<span style="color:#bc5090" class="fa fa-remove"></span>''',
'        ELSE ',
'            ''<span class="fa fa-download"></span>''',
'    END AS DOWNLOAD',
'FROM CGCT_PRJ_MODULE_MASTER m',
'JOIN CGCT_PRJ_DOMAIN_MODULE_MAPPING DMM',
'    ON DMM.MODULE_ID = m.MODULE_ID',
'LEFT JOIN CGCT_PRJ_WORKSHOP1 w',
'    ON DMM.DOMAIN_ID = w.DOMAIN_ID',
'   AND DMM.MODULE_ID = w.MODULE_ID',
'   AND w.APPLICATION_ID = :P0_APP_ID',
'   AND w.PRJ_ID = :P0_PRJ_ID',
'WHERE',
'    m.APPLICATION_ID = :P0_APP_ID',
'AND DMM.PROJECT_ID = :P0_PRJ_ID',
'AND m.ACTIVE_FLAG = ''Y''',
'',
'  AND (',
'    :P1000_DOMAIN IS NULL ',
'    OR DMM.DOMAIN_ID IN (',
'      SELECT REGEXP_SUBSTR(:P1000_DOMAIN, ''[^:]+'', 1, LEVEL)',
'      FROM DUAL',
'      CONNECT BY REGEXP_SUBSTR(:P1000_DOMAIN, ''[^:]+'', 1, LEVEL) IS NOT NULL',
