'DELETE FROM TMP_PRJ_REQUIREMENT;',
'',
'',
'-------PROD_ID ',
'BEGIN',
'SELECT ID INTO P_ID ',
'FROM CGCT_TMP_PRODUCT_MASTER WHERE PRJ_ID=:P0_PRJ_ID;',
'IF P_ID>0 THEN',
'SELECT ID INTO P_PROD_ID FROM CGCT_TMP_PRODUCT_MASTER WHERE PRJ_ID =:P0_PRJ_ID;',
'',
'END IF;',
'EXCEPTION',
'WHEN NO_DATA_FOUND THEN',
'SELECT ID INTO P_PROD_ID',
'FROM CGCT_PRODUCT_MASTER WHERE PRODUCT_NAME = (SELECT PRODUCT_NAME FROM CGCT_PRJ_PRODUCT_MASTER WHERE PRJ_ID=:P0_PRJ_ID);',
'END;',
'',
'-------PRODUCT DETAILS ',
'INSERT INTO CGCT_PRJ_PRODUCT_MASTER(PRODUCT_NAME,ACTIVE_FLAG,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATE_BY,INDUSTRY_TYPE,PRJ_ID)',
'(SELECT P.PRODUCT_NAME,''Y'',SYSDATE,:P0_USER_ID,SYSDATE,:P0_USER_ID,P.INDUSTRY_TYPE,:P0_PRJ_ID',
'FROM CGCT_TMP_PRODUCT_MASTER P ',
'WHERE PRJ_ID=:P0_PRJ_ID);',
'delete from CGCT_TMP_PRODUCT_MASTER where PRJ_ID=:P0_PRJ_ID;',
'',
'----------DOMAIN_MODULE DETAILS',
'INSERT INTO CGCT_PRJ_DOMAIN_MODULE_MAPPING(PROJECT_ID,DOMAIN_ID,MODULE_ID,ACTIVE_FLAG,CREATED_BY,CREATION_DATE,UPDATED_BY,UPDATED_DATE)',
'(',
'    SELECT :P0_PRJ_ID,D.DOMAIN_ID,D.MODULE_ID,''Y'',:P0_USER_ID,SYSDATE,:P0_USER_ID,SYSDATE',
'    FROM CGCT_TMP_DOMAIN_MODULE_MAPPING D',
'    WHERE PROJECT_ID=:P0_PRJ_ID',
'      AND NOT EXISTS (',
'        SELECT 1',
'        FROM CGCT_PRJ_DOMAIN_MODULE_MAPPING T',
'        WHERE T.DOMAIN_ID = D.DOMAIN_ID',
'          AND T.MODULE_ID=D.MODULE_ID',
'          AND T.PROJECT_ID=D.PROJECT_ID',
'     )',
' ',
');',
'',
'----------BUSINESS REQUIREMENTS',
'delete from TMP_BUSINESS_REQUIREMENT;',
' FOR B IN ( SELECT *',
'    FROM CGCT_TMP_BUSINESS_REQUIREMENTS D',
'    WHERE PRJ_ID=:P0_PRJ_ID',
'    AND NOT EXISTS (',
'        SELECT 1',
'        FROM CGCT_PRJ_BUSINESS_REQUIREMENTS T',
'        WHERE t.TOPIC_NAME=D.TOPIC_NAME',
'          AND T.PRJ_ID=:PRJ_FOR_access',
'     ))',
'    LOOP',
'        DECLARE  V_NEW_ID NUMBER;',
'        BEGIN',
'            SELECT CGCT_PRJ_BUSINESS_REQUIREMENTS_SEQ.NEXTVAL INTO V_NEW_ID FROM DUAL;',
'',
'INSERT INTO CGCT_PRJ_BUSINESS_REQUIREMENTS(TOPIC_NAME,DESCRIPTION,SOURCE,COUNTRIES,KDD, ENTITY_TAG, APPLICATION_ID,PRJ_ID,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATED_BY,ACTIVE_FLAG)',
'VALUES(',
'     B.TOPIC_NAME,B.DESCRIPTION,B.SOURCE,B.COUNTRIES,B.KDD, ''Standard'', :P0_APP_ID,:P0_PRJ_ID,SYSDATE,:P0_USER_ID,SYSDATE,:P0_USER_ID,''Y''',
'    ',
');',
'INSERT INTO TMP_BUSINESS_REQUIREMENT (OLD_ID, NEW_ID)',
'VALUES (B.ID, V_NEW_ID);',
'    END;',
'    END LOOP;',
'',
'',
'---------L1 DETAILS',
'delete from CGCT_PRJ_PROCESS_L1 where PRJ_ID=:P0_PRJ_ID;',
'INSERT INTO CGCT_PRJ_PROCESS_L1(L1_ID,L1_CODE,L1_NAME,L1_SHORTNAME,L1_ACTIVE,ORACLE_CODE,COPY_FLAG,APPLICATION_ID,PRJ_ID,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATED_BY)',
'(',
'    SELECT L1.L1_ID,L1.L1_CODE,L1.L1_NAME,L1.L1_SHORTNAME,''Y'',L1.ORACLE_CODE,''Y'',:P0_APP_ID,:P0_PRJ_ID,SYSDATE,:P0_USER_ID,SYSDATE,:P0_USER_ID',
'    FROM CGCT_PROCESS_L1 L1',
'    WHERE PROD_ID=P_PROD_ID',
');',
'delete from CGCT_TMP_PROCESS_L1 where PRJ_ID=:P0_PRJ_ID;',
'',
'-------------L2 DETAILS',
'delete from CGCT_PRJ_PROCESS_L2 where PRJ_ID=:P0_PRJ_ID;',
'INSERT INTO CGCT_PRJ_PROCESS_L2(L2_ID,L2_CODE,L2_NAME,L1_ID,L2_ACTIVE,ORACLE_CODE,L2_MODULE,COPY_FLAG,APPLICATION_ID,PRJ_ID,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATED_BY)',
'(',
'    SELECT L2.L2_ID,L2.L2_CODE,L2.L2_NAME,L2.L1_ID,''Y'',L2.ORACLE_CODE,L2.L2_MODULE,''Y'',:P0_APP_ID,:P0_PRJ_ID,SYSDATE,:P0_USER_ID,SYSDATE,:P0_USER_ID',
'    FROM CGCT_PROCESS_L2 L2',
'    WHERE PROD_ID=P_PROD_ID',
');',
'',
'------------L3 DETAILS',
'INSERT INTO CGCT_PRJ_PROCESS_L3',
'    ( L3_ID , L3_CODE , L3_NAME , L2_ID , L3_ACTIVE , ORACLE_CODE , L3_MODULE , COPY_FLAG , APPLICATION_ID',
'    , PRJ_ID , CREATION_DATE , CREATED_BY , LAST_UPDATE_DATE , LAST_UPDATED_BY )',
'SELECT',
'      L3.L3_ID , L3.L3_CODE , L3.L3_NAME , L3.L2_ID , ''Y'' , L3.ORACLE_CODE , L3.L3_MODULE , ''Y''             ',
'    , :P0_APP_ID , :P0_PRJ_ID , SYSDATE , :P0_USER_ID , SYSDATE , :P0_USER_ID         ',
'FROM CGCT_PROCESS_L3 L3',
'WHERE L3.PROD_ID = P_PROD_ID',
'  AND EXISTS (',
'        SELECT 1',
'        FROM CGCT_TMP_DOMAIN_MODULE_MAPPING M',
'        WHERE M.MODULE_ID = L3.L3_MODULE',
'          AND M.PROJECT_ID = :P0_PRJ_ID',
'     )',
'  AND NOT EXISTS (',
'        SELECT 1',
'        FROM CGCT_PRJ_PROCESS_L3 T',
'        WHERE T.L3_NAME = L3.L3_NAME',
'          AND T.PRJ_ID = :P0_PRJ_ID',
'     );',
'',
'    CGCT_COMMON_PKG.Normalize_prj_process_map(',
'        p_prj_id  => :P0_PRJ_ID,',
'        p_APPLICATION_ID  => :P0_APP_ID,',
'        p_l3_id   => NULL,',
'        p_user_id => P_USER_ID',
'    );',
'',
'-------------L4 DETAILS-------------------------------',
'delete from CGCT_PRJ_PROCESS_L4 where PRJ_ID=:P0_PRJ_ID;',
'INSERT INTO CGCT_PRJ_PROCESS_L4(L4_ID,L4_CODE,L4_NAME,L3_ID,L4_ACTIVE,COPY_FLAG,APPLICATION_ID,PRJ_ID,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATED_BY)',
'(',
'    SELECT L4.L4_ID,L4.L4_CODE,L4.L4_NAME,L4.L3_ID,''Y'',''Y'',:P0_APP_ID,:P0_PRJ_ID,SYSDATE,:P0_USER_ID,SYSDATE,:P0_USER_ID',
'    FROM CGCT_PROCESS_L4 L4',
'    WHERE PROD_ID=P_PROD_ID',
'    AND EXISTS (',
'        SELECT 1',
'        FROM CGCT_PRJ_PROCESS_L3 T',
'        WHERE T.L3_ID = L4.L3_ID',
'          AND T.PRJ_ID = :P0_PRJ_ID',
'     )',
');',
'',
'---------------------SYSTEM REQUIREMENTS--------------------',
'-- delete from CGCT_PRJ_REQUIREMENT where PRJ_ID=:P0_PRJ_ID;',
'FOR R IN (SELECT * FROM CGCT_REQUIREMENT WHERE PROD_ID =P_PROD_ID',
'    -- AND   APPLICATION_ID = P_APPLICATION_ID',
'    and BUSINESS_REQUIREMENT in (SELECT ID FROM CGCT_TMP_BUSINESS_REQUIREMENTS WHERE PRJ_ID=:P0_PRJ_ID))',
'    LOOP',
'    DECLARE  V_NEW_ID NUMBER;',
'        BEGIN',
'            SELECT CGCT_PRJ_REQUIREMENT_SEQ.NEXTVAL INTO V_NEW_ID FROM DUAL;',
'INSERT INTO CGCT_PRJ_REQUIREMENT(DESCRIPTION,DETAIL,L1_ID,L2_ID,L3_ID,L4_ID,COPY_FLAG,COUNTRIES,LOC_ENABLED,BUSINESS_REQUIREMENT,SOURCE,TYPE_LOV,APPLICATION_ID,PRJ_ID,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATED_BY,ACTIVE_FLAG,ENTITY_TAG)',
'VALUES (',
'  R.DESCRIPTION,R.DETAIL,R.L1_ID,R.L2_ID,R.L3_ID,R.L4_ID,''Y'',R.COUNTRIES,R.LOC_ENABLED,(SELECT NEW_ID FROM TMP_BUSINESS_REQUIREMENT WHERE OLD_ID=R.BUSINESS_REQUIREMENT),R.SOURCE,R.TYPE_LOV,:P0_APP_ID,:P0_PRJ_ID,SYSDATE,:P0_USER_ID,SYSDATE,:P0_USER_ID'
||',''Y'',''Standard''',
');',
'INSERT INTO TMP_PRJ_REQUIREMENT (OLD_ID, NEW_ID)',
'VALUES (R.ID, V_NEW_ID);',
'END;',
'END LOOP;',
'',
'',
'---------------------PERSONA----------------------------',
'FOR R IN (SELECT *',
'FROM CGCT_PERSONA p',
'WHERE p.prod_id = P_PROD_ID',
'AND REGEXP_LIKE(',
'      '':'' || p.module_id || '':'',',
'      '':(?:'' || (',
'         SELECT LISTAGG(REGEXP_REPLACE(module_id, ''([.^$*+?()|[\]{}\\])'', ''\\\1''), ''|'')',
'                WITHIN GROUP (ORDER BY module_id)',
'         FROM CGCT_TMP_DOMAIN_MODULE_MAPPING',
'         WHERE project_id = :P0_PRJ_ID',
'      ) || ''):''',
'    )',
')',
'    LOOP',
'     DECLARE  V_NEW_ID NUMBER;',
'     BEGIN',
'     SELECT CGCT_PRJ_PERSONA_SEQ.NEXTVAL INTO V_NEW_ID FROM DUAL;',
'    ',
'    INSERT INTO CGCT_PRJ_PERSONA',
'    (',
'        ID,TOPIC_NAME,DESCRIPTION, PRJ_ID, APPLICATION_ID,',
'        GUIDELINE_NOTE,MILESTONE_NAME,STORY_POINTS,ESTIMATION_HOURS,SIZING,',
'        PERSONA_ID,CAPGEMINI_RECOMMENDATION,FILE_NAME,FILE_PATH,DOMAIN_ID,MODULE_ID,INDUSTRY,',
'PERSONA_SHORT_CODE,PERSONA_CATEGORY,',
'        ACTIVE_FLAG, COPY_FLAG,',
'        CREATION_DATE, CREATED_BY,',
'        LAST_UPDATE_DATE, LAST_UPDATED_BY',
'    )',
'    VALUES(',
'        V_NEW_ID,R.TOPIC_NAME,R.DESCRIPTION, P_PROJECT_ID, P_APPLICATION_ID,',
'        R.GUIDELINE_NOTE,R.MILESTONE_NAME,R.STORY_POINTS,',
'        R.ESTIMATION_HOURS,R.SIZING,R.PERSONA_ID,R.CAPGEMINI_RECOMMENDATION,',
'        R.FILE_NAME,R.FILE_PATH,R.DOMAIN_ID,R.MODULE_ID,R.INDUSTRY,R.PERSONA_SHORT_CODE,R.PERSONA_CATEGORY,',
'        R.ACTIVE_FLAG, ''Y'',',
'        SYSDATE, P_USER_ID,',
'        SYSDATE, P_USER_ID',
'    );',
'    INSERT INTO TMP_PRJ_PERSONA(OLD_ID,NEW_ID) VALUES(R.ID,V_NEW_ID);',
'    END;',
'    END LOOP;',
'    ',
'-------------------------USER STORY---------------------',
'FOR US IN (SELECT * FROM CGCT_USER_STORY WHERE PROD_ID = P_PROD_ID',
'    AND REQUIREMENT_ID IN (SELECT OLD_ID FROM TMP_PRJ_requirement))',
'    LOOP',
'    DECLARE  V_NEW_ID NUMBER;',
'     BEGIN',
'     SELECT CGCT_PRJ_USER_STORY_SEQ.NEXTVAL INTO V_NEW_ID FROM DUAL;',
'    INSERT INTO CGCT_PRJ_USER_STORY',
'    (',
'        ID, PRJ_ID, APPLICATION_ID,',
'        NAME, DETAIL, L3_ID,STORY_POINTS, WORKSTREAM_ID,COMPONENT_ID,',
'        SIZING,ESTIMATION_HOURS,SUMMARY,L1_ID,L2_ID,MODULE_ID,',
'        L4_ID,REQUIREMENT_ID,PERSONA_ID,ACCEPTANCE_CRITERIA,',
'        ACTIVE_FLAG, COPY_FLAG,',
'        CREATION_DATE, CREATED_BY,',
'        LAST_UPDATE_DATE, LAST_UPDATED_BY,ENTITY_TAG',
'    )',
'    VALUES(',
'        V_NEW_ID, P_PROJECT_ID, P_APPLICATION_ID,',
'        US.NAME, US.DETAIL, US.L3_ID,US.STORY_POINTS,US.WORKSTREAM_ID,US.COMPONENT_ID,',
'           US.SIZING, US.ESTIMATION_HOURS, US.SUMMARY, US.L1_ID, US.L2_ID, US.MODULE_ID, ',
'          US.L4_ID, (SELECT NEW_ID FROM TMP_PRJ_REQUIREMENT WHERE OLD_ID=US.REQUIREMENT_ID),',
'(',
'    SELECT LISTAGG(NVL(TO_CHAR(p.new_id), ''0''), '':'') WITHIN GROUP (ORDER BY s.pos)',
'    FROM (',
'      SELECT column_value AS token, ROWNUM AS pos',
'      FROM TABLE(apex_string.split(us.PERSONA_ID, '':''))',
'    ) s',
'    LEFT JOIN TMP_PRJ_PERSONA p',
'           ON p.old_id = TO_NUMBER(s.token)',
'  )',
',',
'US.ACCEPTANCE_CRITERIA,',
'        US.ACTIVE_FLAG, ''Y'',',
'        SYSDATE, P_USER_ID,',
'        SYSDATE, P_USER_ID,''Standard'');',
'        INSERT INTO TMP_PRJ_USER_STORY(OLD_ID,NEW_ID) VALUES(US.ID,V_NEW_ID);',
'        END;',
'        END LOOP;',
'',
'-----------------TEST CASES---------------------------',
' INSERT INTO CGCT_PRJ_TEST_CASES',
'    (',
'        ID, CASE_ID, PRJ_ID, APPLICATION_ID,',
'        NAME,DETAIL,ESTIMATION_HOURS, L3_ID,AUTOMATION,TEST_CODE,',
'        SIZING,STORY_POINTS,L1_ID,L2_ID,USER_STORY_ID,L4_ID,',
'        ACTIVE_FLAG, COPY_FLAG,',
'        CREATION_DATE, CREATED_BY,',
'        LAST_UPDATE_DATE, LAST_UPDATED_BY,ENTITY_TAG',
'    )',
'    SELECT',
'        NULL, TC.ID, P_PROJECT_ID, P_APPLICATION_ID,',
'        TC.NAME,TC.DETAIL,TC.ESTIMATION_HOURS, TC.L3_ID, TC.AUTOMATION, ',
'        TC.TEST_CODE, TC.SIZING, TC.STORY_POINTS, TC.L1_ID, TC.L2_ID, (SELECT NEW_ID FROM TMP_PRJ_USER_STORY WHERE OLD_ID=TC.USER_STORY_ID), TC.L4_ID,',
'        TC.ACTIVE_FLAG, ''Y'',',
'        SYSDATE, P_USER_ID,',
'        SYSDATE, P_USER_ID,''Standard''',
'    FROM CGCT_TEST_CASES TC',
'    WHERE TC.PROD_ID = P_PROD_ID',
'    AND   TC.USER_STORY_ID IN (SELECT OLD_ID FROM TMP_PRJ_USER_STORY );',
'',
'',
'--lete from CGCT_TMP_TEST_CASES where PRJ_ID=:P0_PRJ_ID;',
'',
'-- delete from CGCT_PRJ_TEST_CASE_STEP where PRJ_ID=:P0_PRJ_ID;',
'-- INSERT INTO CGCT_PRJ_TEST_CASE_STEP(STEP,TEST_CASE_ID,STEP_NO,EXPECTED_RESULT,COPY_FLAG,APPLICATION_ID,PRJ_ID,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATED_BY,ACTIVE_FLAG)',
'-- (',
'--     SELECT TC.STEP,TC.TEST_CASE_ID,TC.STEP_NO,TC.EXPECTED_RESULT,''Y'',:P0_APP_ID,:P0_PRJ_ID,SYSDATE,:P0_USER_ID,SYSDATE,:P0_USER_ID,''Y''',
'--     FROM CGCT_TEST_CASE_STEP TC',
'--     WHERE PROD_ID=P_PROD_ID',
'-- );',
'',
'delete from CGCT_TMP_DOMAIN_MODULE_MAPPING where PROJECT_ID=:P0_PRJ_ID;',
'delete from CGCT_TMP_BUSINESS_REQUIREMENTS where PRJ_ID=:P0_PRJ_ID;',
'',
'END;'))
