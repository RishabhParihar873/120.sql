wwv_flow_imp_page.create_page(
 p_id=>1064
,p_name=>unistr('ICT AI \2014 Execution Status')
,p_alias=>'ICT-AI-EXECUTION-STATUS'
,p_step_title=>unistr('ICT AI \2014 Execution Status')
,p_autocomplete_on_off=>'OFF'
,p_javascript_code=>wwv_flow_string.join(wwv_flow_t_varchar2(
'var ictaiPollTimer = null;',
'var ictaiPollBusy  = false;',
'',
'// Download the generated document.',
'//',
'// This navigates to the DOWNLOAD_ICTAI_FILE application process, which streams',
'// the bytes back through the authenticated APEX session. It replaces the old',
'// fetch() + URL.createObjectURL() handler that requested the OCI gateway URL',
unistr('// directly \2014 that call had no X-API-Key header (and must never be given one),'),
'// so it returned 401 for every user.',
'//',
'// The session id comes from $v(''pInstance'') at runtime; it is never written into',
'// page source, a report column, or this file.',
'function ictaiDownload(execId) {',
'    if (!execId) { return; }',
'    window.location.href = ''f?p='' + $v(''pFlowId'') + '':0:'' + $v(''pInstance'')',
'        + '':APPLICATION_PROCESS=DOWNLOAD_ICTAI_FILE:::''',
'        + ''G_ICTAI_EXEC_ID:'' + encodeURIComponent(execId);',
'}',
'',
'function ictaiStopPolling() {',
'    if (ictaiPollTimer) {',
'        clearInterval(ictaiPollTimer);',
'        ictaiPollTimer = null;',
'    }',
'}',
'',
'function ictaiPollTick() {',
'    if (ictaiPollBusy) { return; }          // no overlapping requests',
'    ictaiPollBusy = true;',
'',
'    apex.server.process(''POLL_ICTAI_STATUS'', {}, {',
'        dataType: ''json'',',
'        success: function (d) {',
'            ictaiPollBusy = false;',
'',
unistr('            // Refresh the two regions in place. No location.reload() \2014 a full'),
'            // page reload every 5s would restart this timer, lose the user''s IR',
'            // filters and scroll position, and re-run every region on the page.',
'            if (d && d.changed) {',
'                apex.region(''current-executions'').refresh();',
'                apex.region(''execution-history'').refresh();',
'            }',
'            if (!d || !d.has_active) {',
'                ictaiStopPolling();',
'            }',
'        },',
'        error: function (jqXHR, status) {',
'            ictaiPollBusy = false;',
'            ictaiStopPolling();',
'            apex.message.showErrors([{',
'                type: ''error'',',
'                location: ''page'',',
'                message: ''Lost contact with the status service. Reload the page to resume tracking.'',',
'                unsafe: false',
'            }]);',
'        }',
'    });',
'}',
'',
'function ictaiStartPolling() {',
'    if (ictaiPollTimer) { return; }',
'    ictaiPollTimer = setInterval(ictaiPollTick, 5000);',
'}',
''))
,p_javascript_code_onload=>wwv_flow_string.join(wwv_flow_t_varchar2(
'',
'// Only poll when this project actually has something running. The server is the',
'// authority: the first tick returns has_active and stops the timer if not.',
'if ($v(''P1064_PRJ_ID'')) {',
'    ictaiPollTick();        // immediate first read, no 5s dead wait',
'    ictaiStartPolling();',
'}',
'',
'// Stop polling when the tab is hidden; resume on return. Cuts pointless REST',
'// traffic from tabs left open overnight.',
'document.addEventListener(''visibilitychange'', function () {',
'    if (document.hidden) {',
'        ictaiStopPolling();',
'    } else if ($v(''P1064_PRJ_ID'')) {',
'        ictaiPollTick();',
'        ictaiStartPolling();',
'    }',
'});',
''))
