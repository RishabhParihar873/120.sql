wwv_flow_imp_page.create_page_plug(
 p_id=>wwv_flow_imp.id(929591355538340165)
,p_plug_name=>'Update Effort'
,p_static_id=>'update-effort'
,p_region_name=>'bottomRegion'
,p_parent_plug_id=>wwv_flow_imp.id(929590429125340155)
,p_region_template_options=>'#DEFAULT#:t-Region--removeHeader js-removeLandmark:t-Region--noUI:t-Region--scrollBody'
