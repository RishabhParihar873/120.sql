,p_column_html_expression=>wwv_flow_string.join(wwv_flow_t_varchar2(
'<!-- Dropdown Trigger -->',
'<div class="dropdown-wrapper" style="display: inline-block;">',
'  <span class="t-Icon fa fa-ellipsis-h"',
'        style="cursor:pointer;"',
'        data-phase-id="#PROJECT_PHASE_ID#"',
'        data-project-id="#PROJECT_ID#"',
'        data-phase-type-id="#PHASE_TYPE_ID#"',
'        data-wave-id="#WAVE_ID#"',
'        data-pwave="#PWAVE#"',
'        onclick="DropdownHandler.toggle(this)">',
'  </span>',
'</div>',
'',
'<!-- Dropdown Menu -->',
'<div id="subphaseDropdown" class="custom-dropdown" style="',
'  display:none;',
'  position:fixed;',
'  background:#fff;',
'  border:1px solid #ccc;',
'  border-radius:5px;',
'  box-shadow:0 2px 6px rgba(0,0,0,0.2);',
'  padding:3px;',
'  z-index:9999;',
'  min-width:210px;',
'">',
'  <div style="padding:8px 12px; cursor:pointer; text-align: left;" onclick="DropdownHandler.openModal(''SUBPHASE'')">View Subphase</div>',
'</div>',
'',
'<script>',
'window.DropdownHandler = (function() {',
'  let _data = {};',
'',
'  function toggle(icon) {',
'    const dropdown = document.getElementById(''subphaseDropdown'');',
'    const isVisible = dropdown.style.display === ''block'';',
'',
'    if (isVisible) {',
'      dropdown.style.display = ''none'';',
'      return;',
'    }',
'',
'    _data = {',
'      phaseId: icon.getAttribute(''data-phase-id''),',
'      projectId: icon.getAttribute(''data-project-id''),',
'      phaseTypeId: icon.getAttribute(''data-phase-type-id''),',
'      waveId: icon.getAttribute(''data-wave-id''),',
'      pwave: icon.getAttribute(''data-pwave'')',
'    };',
'',
'    console.log("Dropdown Data:");',
'    console.log("phaseId:", _data.phaseId);',
'    console.log("projectId:", _data.projectId);',
'    console.log("phaseTypeId:", _data.phaseTypeId);',
'    console.log("waveId:", _data.waveId);',
'    console.log("pwave:", _data.pwave);',
'',
'    dropdown.style.visibility = ''hidden'';',
'    dropdown.style.display = ''block'';',
'',
'    const rect = icon.getBoundingClientRect();',
'    const dropdownWidth = dropdown.offsetWidth;',
'    const dropdownHeight = dropdown.offsetHeight;',
'',
'    let top = rect.bottom;',
'    let left = rect.right-130;',
'',
'    dropdown.style.top = `${top}px`;',
'    dropdown.style.left = `${left}px`;',
'    dropdown.style.visibility = ''visible'';',
'  }',
'',
'  function openModal(action) {',
'    if (action !== ''SUBPHASE'') return;',
'',
'    const { phaseId, projectId, phaseTypeId, waveId, pwave } = _data;',
'',
'    if (!phaseId || !projectId || !waveId || !pwave) {',
'      console.error("Missing required values:", { phaseId, projectId, waveId, pwave });',
'      apex.message.alert(''Required data missing.'');',
'      return;',
'    }',
'',
'    // Optional: log null phaseTypeId',
'    if (!phaseTypeId) {',
'      console.warn("phaseTypeId is null or missing, continuing anyway.");',
'    }',
'',
'    document.getElementById(''subphaseDropdown'').style.display = ''none'';',
'',
'    apex.server.process(',
'      ''GET_MODAL_URL'',',
'      {',
'        x01: phaseId,',
'        x02: projectId,',
'        x03: phaseTypeId || '''', // pass empty string if null',
'        x04: waveId,',
'        x05: pwave',
'      },',
'      {',
'        dataType: ''text'',',
'        success: function(pUrl) {',
'          if (pUrl) {',
'            apex.navigation.redirect(pUrl);',
'          } else {',
'            apex.message.alert(''No URL returned.'');',
'          }',
'        },',
'        error: function() {',
'          apex.message.alert(''Failed to open modal.'');',
'        }',
'      }',
'    );',
'  }',
'',
'  document.addEventListener(''click'', function(event) {',
'    const isIcon = event.target.classList.contains(''fa-ellipsis-h'');',
'    const isInsideDropdown = event.target.closest(''.custom-dropdown'');',
'',
'    if (!isIcon && !isInsideDropdown) {',
'      document.getElementById(''subphaseDropdown'').style.display = ''none'';',
'    }',
'  });',
'',
'  return {',
'    toggle,',
'    openModal',
'  };',
'})();',
'</script>'))
