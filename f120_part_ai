'DECLARE',
'    l_clean_ids VARCHAR2(4000);',
'BEGIN',
'    l_clean_ids := TRIM(BOTH '':'' FROM :P1052_SELECTED_IDS);',
'    FOR rec IN (',
'        SELECT REGEXP_SUBSTR(l_clean_ids, ''[^:]+'', 1, LEVEL) AS task_id',
'        FROM dual',
'        CONNECT BY REGEXP_SUBSTR(l_clean_ids, ''[^:]+'', 1, LEVEL) IS NOT NULL',
'    )',
'    LOOP',
'        -- Only process numeric task IDs',
'        IF REGEXP_LIKE(rec.task_id, ''^\d+$'') THEN',
'            UPDATE cgct_pp_plan_line',
'               SET assigned_to    = :P1052_ASSIGN,',
'                   updated_by     = :P0_USER_ID_EMAIL,',
'                   updation_date  = SYSDATE',
'             WHERE project_plan_line_id = rec.task_id;',
'        END IF;',
'    END LOOP;',
'    -- Return JSON success message',
'    apex_json.open_object;',
