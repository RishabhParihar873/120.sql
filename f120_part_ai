,p_use_cache_before_default=>'NO'
,p_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'WITH nodes AS (',
'    SELECT w.wave_id AS id, CAST(NULL AS NUMBER) AS parent_id, 1 AS node_type,',
'           w.task_number, w.wave_name AS task_name, w.start_date, w.end_date',
'    FROM cgct_pp_project_wave w',
'    WHERE w.prj_id = :P999_PRJ_ID',
'',
'    UNION ALL',
'',
'    SELECT p.project_phase_id AS id, p.wave_id AS parent_id, 2 AS node_type,',
'           p.task_number, p.phase_display_name AS task_name, p.start_date, p.end_date',
'    FROM cgct_pp_project_phase p',
'    WHERE p.project_id = :P999_PRJ_ID',
'      AND p.reference_phase_id IS NULL',
'',
'    UNION ALL',
'',
'    SELECT sp.project_phase_id AS id, sp.reference_phase_id AS parent_id, 3 AS node_type,',
'           sp.task_number, sp.phase_display_name AS task_name, sp.start_date, sp.end_date',
'    FROM cgct_pp_project_phase sp',
'    WHERE sp.project_id = :P999_PRJ_ID',
'      AND sp.reference_phase_id IS NOT NULL',
'),',
'hier AS (',
'    SELECT id, parent_id, LEVEL AS lvl, node_type',
'    FROM nodes',
'    START WITH parent_id IS NULL',
'    CONNECT BY NOCYCLE PRIOR id = parent_id',
')',
'SELECT COUNT(*) AS total_nodes',
'FROM hier;'))
