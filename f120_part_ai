'            ''Base64 Start: '' || DBMS_LOB.SUBSTR(l_base64_clob, 1000, 1);',
'',
'        :P1024_STATUS := ''BLOB received successfully. Binary preview shown.'';',
'',
'    END IF;',
'',
'    ------------------------------------------------------------------',
'    -- Cleanup',
'    ------------------------------------------------------------------',
'    IF l_extracted_text IS NOT NULL AND DBMS_LOB.ISTEMPORARY(l_extracted_text) = 1 THEN',
'        DBMS_LOB.FREETEMPORARY(l_extracted_text);',
'    END IF;',
'',
'    IF l_text_clob IS NOT NULL AND DBMS_LOB.ISTEMPORARY(l_text_clob) = 1 THEN',
'        DBMS_LOB.FREETEMPORARY(l_text_clob);',
'    END IF;',
'',
'    IF l_docx_xml_clob IS NOT NULL AND DBMS_LOB.ISTEMPORARY(l_docx_xml_clob) = 1 THEN',
