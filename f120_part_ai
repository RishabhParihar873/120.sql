,p_execute_on_page_init=>'Y'
,p_static_id=>'native-set-value'
,p_action=>'NATIVE_SET_VALUE'
,p_affected_elements_type=>'ITEM'
,p_affected_elements=>'P1001_WORKSTREAM_COLOR'
,p_attributes=>wwv_flow_t_plugin_attributes(wwv_flow_t_varchar2(
  'escape_special_characters', 'Y',
  'items_to_submit', 'P1001_WAVE_ID,,P0_PRJ_ID',
  'sql_query', wwv_flow_string.join(wwv_flow_t_varchar2(
    'WITH ws_data AS (',
    '    SELECT',
    '        l.WORKSTREAM,',
    ' ',
    '                ROUND(',
    '                    SUM(CASE ',
    '                            WHEN l.PLANNED_END < TRUNC(SYSDATE)',
    '                             AND UPPER(l.STATUS) NOT IN (''COMPLETED'',''DESCOPE'',''CANCELLED'')',
    '                             AND l.LEVELS NOT IN (1,2,3)',
    '                            THEN 1 ELSE 0',
    '                        END) * 100 / NULLIF(COUNT(l.PROJECT_PLAN_LINE_ID), 0),',
    '                    0',
    '                ) AS PAST_DUE_PCT,',
    '',
    '                ROUND(',
    '                    SUM(CASE ',
    '                            WHEN l.ASSIGNED_TO IS NULL',
    '                             AND l.PLANNED_START < TRUNC(SYSDATE)',
    '                             AND l.LEVELS NOT IN (1,2,3)',
    '                             AND UPPER(l.STATUS) <> ''COMPLETED''',
    '                            THEN 1 ELSE 0',
    '                        END) * 100 / NULLIF(COUNT(l.PROJECT_PLAN_LINE_ID), 0),',
    '                    0',
    '                ) AS UNASSIGNED_PCT,',
    '',
    '                ROUND(',
    '                    SUM(CASE ',
    '                            WHEN UPPER(l.STATUS) = ''NOT STARTED''',
    '                             AND l.PLANNED_START < TRUNC(SYSDATE)',
    '                             AND l.LEVELS NOT IN (1,2,3)',
    '                            THEN 1 ELSE 0',
    '                        END) * 100 / NULLIF(COUNT(l.PROJECT_PLAN_LINE_ID), 0),',
    '                    0',
    '                ) AS NOT_STARTED_PCT',
    ' ',
    '    FROM CGCT_PP_PROJECT_PHASE p',
    '    LEFT JOIN CGCT_PP_PLAN_LINE l',
    '        ON l.PHASE_ID = p.PROJECT_PHASE_ID',
    '       AND l.PROJECT_PLAN_ID IN (',
    '            SELECT PROJECT_PLAN_ID',
    '            FROM CGCT_PP_PROJECT_PLAN',
    '            WHERE STATUS = ''Y''',
    '       )',
    '       AND l.LEVELS > 3',
    '       AND NOT EXISTS (',
    '            SELECT 1',
    '            FROM CGCT_PP_PLAN_LINE child',
    '            WHERE child.PARENT_ID = l.PROJECT_PLAN_LINE_ID',
    '       )',
    '       AND l.PRJ_ID = :P0_PRJ_ID',
    '       AND l.WAVE_ID = :P1001_WAVE_ID',
    ' ',
    '    WHERE p.PROJECT_ID = :P0_PRJ_ID',
    '      AND p.WAVE_ID = :P1001_WAVE_ID',
    '      AND p.REFERENCE_PHASE_ID IS NULL',
    ' ',
    '    GROUP BY l.WORKSTREAM',
    ')',
    ' ',
    unistr('-- \2705 ONLY OVERALL WORKSTREAM STATUS (like phase)'),
    'SELECT',
    '    CASE',
    '        WHEN MAX(GREATEST(',
    '                NVL(past_due_pct,0),',
    '                NVL(unassigned_pct,0),',
    '                NVL(not_started_pct,0)',
    '             )) <= 10',
    '        THEN ''green''',
    '        WHEN MAX(GREATEST(',
    '                NVL(past_due_pct,0),',
    '                NVL(unassigned_pct,0),',
    '                NVL(not_started_pct,0)',
    '             )) <= 50',
    '        THEN ''yellow''',
    '        ELSE ''red''',
    '    END AS status_dot',
    'FROM ws_data;')),
  'suppress_change_event', 'N',
  'type', 'SQL_STATEMENT')).to_clob
,p_wait_for_result=>'Y'
