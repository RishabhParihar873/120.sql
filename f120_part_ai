,p_display_sequence=>240
,p_region_template_options=>'#DEFAULT#:t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc'
,p_component_template_options=>'#DEFAULT#:t-Report--altRowsDefault:t-Report--rowHighlight'
,p_display_point=>'SUB_REGIONS'
,p_source_type=>'NATIVE_SQL_REPORT'
,p_query_type=>'SQL'
,p_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'WITH phase_data AS (',
'    SELECT',
'        p.PROJECT_PHASE_ID AS ID,',
'        p.PHASE_DISPLAY_NAME AS phase_status,',
'',
'                ',
'                ROUND(',
'                    SUM(CASE ',
'                            WHEN l.PLANNED_END < TRUNC(SYSDATE)',
'                             AND UPPER(l.STATUS) NOT IN (''COMPLETED'',''DESCOPE'',''CANCELLED'')',
'                             AND l.LEVELS NOT IN (1,2,3)',
'                            THEN 1 ELSE 0',
'                        END) * 100 / NULLIF(COUNT(l.PROJECT_PLAN_LINE_ID), 0),',
'                    0',
'                ) AS PAST_DUE_PCT,',
' ',
'                ROUND(',
'                    SUM(CASE ',
'                            WHEN l.ASSIGNED_TO IS NULL',
'                             AND l.PLANNED_START < TRUNC(SYSDATE)',
'                             AND l.LEVELS NOT IN (1,2,3)',
'                             AND UPPER(l.STATUS) <> ''COMPLETED''',
'                            THEN 1 ELSE 0',
'                        END) * 100 / NULLIF(COUNT(l.PROJECT_PLAN_LINE_ID), 0),',
'                    0',
'                ) AS UNASSIGNED_PCT,',
' ',
'                ROUND(',
'                    SUM(CASE ',
'                            WHEN UPPER(l.STATUS) = ''NOT STARTED''',
'                             AND l.PLANNED_START < TRUNC(SYSDATE)',
'                             AND l.LEVELS NOT IN (1,2,3)',
'                            THEN 1 ELSE 0',
'                        END) * 100 / NULLIF(COUNT(l.PROJECT_PLAN_LINE_ID), 0),',
'                    0',
'                ) AS NOT_STARTED_PCT',
'',
'    FROM cgct_pp_project_phase p',
'    LEFT JOIN cgct_pp_plan_line l',
'        ON l.phase_id = p.project_phase_id',
'       AND l.prj_id = :P0_PROJECT_ID',
'       AND l.wave_id =:P1019_WAVE',
'',
'    WHERE p.project_id = :P0_PROJECT_ID',
'      AND p.wave_id =:P1019_WAVE',
'      AND p.reference_phase_id IS NULL',
'',
'    GROUP BY p.project_phase_id, p.PHASE_DISPLAY_NAME,p.WAVE_ID',
')',
'',
unistr('-- \2705 FINAL OUTPUT (NO "PHASE STATUS" ROW)'),
'SELECT ',
'    ID,',
'    phase_status,',
'    CASE',
'        WHEN GREATEST(',
'                NVL(past_due_pct,0),',
'                NVL(unassigned_pct,0),',
'                NVL(not_started_pct,0)',
'             ) <= 10',
'        THEN ''<span class="status-dot status-green"></span>''',
'',
'        WHEN GREATEST(',
'                NVL(past_due_pct,0),',
'                NVL(unassigned_pct,0),',
'                NVL(not_started_pct,0)',
'             ) <= 50',
'        THEN ''<span class="status-dot status-yellow"></span>''',
'',
'        ELSE ''<span class="status-dot status-red"></span>''',
'    END AS status_dot',
'',
'FROM phase_data',
'ORDER BY ID;'))
