'DECLARE',
'    ------------------------------------------------------------------',
'    -- API configuration',
'    ------------------------------------------------------------------',
'    l_base_url CONSTANT VARCHAR2(4000) :=''https://gs7i2qgix5vgb7s4jhqsu3wllm.apigateway.us-ashburn-1.oci.customer-oci.com'';',
'    l_user_api_key VARCHAR2(4000);',
'    l_response     CLOB;',
'',
'    ------------------------------------------------------------------',
'    -- Predecessor',
'    ------------------------------------------------------------------',
'    l_predecessor_document_id CGCT_PP_PLAN_LINE.PREDECESSOR_DOCUMENT_ID%TYPE;',
'    l_predecessor_job_id CGCT_DELIVERABLE_API_DOCUMENT.JOB_ID%TYPE;',
'    l_use_predecessor BOOLEAN := FALSE;',
'    ------------------------------------------------------------------',
'    -- Source file',
'    ------------------------------------------------------------------',
'    l_source_id           VARCHAR2(200);',
'    l_file_name           VARCHAR2(4000);',
'    l_mime_type           VARCHAR2(4000);',
'    l_file_blob           BLOB;',
'    l_content_disposition VARCHAR2(4000);',
'    ------------------------------------------------------------------',
'    -- Template',
'    ------------------------------------------------------------------',
'    l_template_name VARCHAR2(4000);',
'    l_tmp_url       VARCHAR2(4000);',
'    l_template_mime VARCHAR2(4000);',
'    l_template_blob BLOB;',
'    l_extension     VARCHAR2(20);',
'    ------------------------------------------------------------------',
'    -- Multipart body',
'    ------------------------------------------------------------------',
'    l_body_blob BLOB;',
'    l_boundary  VARCHAR2(200);',
'    ------------------------------------------------------------------',
'    -- Generation response',
'    ------------------------------------------------------------------',
'    l_job_id      VARCHAR2(200);',
'    l_document_id VARCHAR2(200);',
'    ------------------------------------------------------------------',
'    -- GenAI key',
'    ------------------------------------------------------------------',
'    l_genai_key CGCT_APP_USERS.GEN_AI_KEY%TYPE;',
'    ------------------------------------------------------------------',
'    -- Prompt and JSON request',
'    ------------------------------------------------------------------',
'    l_custom_prompt CLOB;',
'    l_body          CLOB;',
'    ------------------------------------------------------------------',
'    -- Deliverable',
'    ------------------------------------------------------------------',
'    l_deliverable_id CGCT_DELIVERABLE_API_DOCUMENT.DELIVERABLE_ID%TYPE;',
'    ------------------------------------------------------------------',
'    -- Helper: append VARCHAR2 text to a BLOB',
'    ------------------------------------------------------------------',
'    PROCEDURE append_text (',
'        p_blob IN OUT NOCOPY BLOB,',
'        p_text IN VARCHAR2',
'    )',
'    IS',
'        l_raw RAW(32767);',
'    BEGIN',
'        IF p_text IS NOT NULL THEN',
'            l_raw := UTL_RAW.CAST_TO_RAW(p_text);',
'',
'            DBMS_LOB.WRITEAPPEND(',
'                lob_loc => p_blob,',
'                amount  => UTL_RAW.LENGTH(l_raw),',
'                buffer  => l_raw',
'            );',
'        END IF;',
'    END append_text;',
'',
'    ------------------------------------------------------------------',
'    -- Helper: append one BLOB to another BLOB',
'    ------------------------------------------------------------------',
'    PROCEDURE append_blob (',
'        p_blob    IN OUT NOCOPY BLOB,',
'        p_content IN BLOB',
'    )',
'    IS',
'        l_dest_offset INTEGER;',
'        l_src_offset  INTEGER;',
'    BEGIN',
'        IF p_content IS NOT NULL',
'           AND DBMS_LOB.GETLENGTH(p_content) > 0',
'        THEN',
'            l_dest_offset := DBMS_LOB.GETLENGTH(p_blob) + 1;',
'            l_src_offset  := 1;',
'',
'            DBMS_LOB.COPY(',
'                dest_lob    => p_blob,',
'                src_lob     => p_content,',
'                amount      => DBMS_LOB.GETLENGTH(p_content),',
'                dest_offset => l_dest_offset,',
'                src_offset  => l_src_offset',
'            );',
'        END IF;',
'    END append_blob;',
'',
'    ------------------------------------------------------------------',
'    -- Helper: free a temporary multipart BLOB',
'    ------------------------------------------------------------------',
'    PROCEDURE free_body_blob',
'    IS',
'    BEGIN',
'        IF l_body_blob IS NOT NULL',
'           AND DBMS_LOB.ISTEMPORARY(l_body_blob) = 1',
'        THEN',
'            DBMS_LOB.FREETEMPORARY(l_body_blob);',
'        END IF;',
'    EXCEPTION',
'        WHEN OTHERS THEN',
'            NULL;',
'    END free_body_blob;',
'',
'BEGIN',
'    ------------------------------------------------------------------',
'    -- 1. Get the current user''s API key',
'    ------------------------------------------------------------------',
'    BEGIN',
'        SELECT pm.USER_API_KEY',
'          INTO l_user_api_key',
'          FROM CGCT_PROJECT_MEMBERS pm',
'         WHERE pm.PROJECT_ID = :P0_PROJECT_ID',
'           AND pm.EMP_ID = (',
'                   SELECT au.EMPLOYEE_ID',
'                     FROM CGCT_APP_USERS au',
'                    WHERE au.USER_ID = :P0_USER_ID_EMAIL',
'               );',
'',
'    EXCEPTION',
'        WHEN NO_DATA_FOUND THEN',
'            RAISE_APPLICATION_ERROR(',
'                -20002,',
'                ''No API key was found for the current project member.''',
'            );',
'    END;',
'    ------------------------------------------------------------------',
'    -- 2. Get GenAI key from the user',
'    ------------------------------------------------------------------',
'    BEGIN',
'        SELECT au.GEN_AI_KEY',
'          INTO l_genai_key',
'          FROM CGCT_APP_USERS au',
'         WHERE au.USER_ID = :P0_USER_ID_EMAIL;',
'    END;',
'',
'    ------------------------------------------------------------------',
'    -- 3. If the user key is unavailable, use the project GenAI key',
'    ------------------------------------------------------------------',
'    IF l_genai_key IS NULL THEN',
'        BEGIN',
'            SELECT pm.PROJECT_GEN_API_KEY',
'              INTO l_genai_key',
'              FROM CGCT_PROJECT_MASTER pm',
'             WHERE pm.ID = :P0_PRJ_ID;',
'',
'        EXCEPTION',
'            WHEN NO_DATA_FOUND THEN',
'                l_genai_key := NULL;',
'',
'            WHEN TOO_MANY_ROWS THEN',
'                RAISE_APPLICATION_ERROR(',
'                    -20006,',
'                    ''Multiple project records were found.''',
'                );',
'        END;',
'    END IF;',
'',
'    IF l_genai_key IS NULL THEN',
'        RAISE_APPLICATION_ERROR(',
'            -20007,',
'            ''No GenAI key is configured for the user or project.''',
'        );',
'    END IF;',
'',
'    ------------------------------------------------------------------',
'    -- 4. Find the predecessor configured for the current plan line',
'    ------------------------------------------------------------------',
'    BEGIN',
'        -- SELECT p.PREDECESSOR_DOCUMENT_ID',
'        --   INTO l_predecessor_document_id',
'        --   FROM CGCT_PP_PLAN_LINE p',
'        --  WHERE p.PROJECT_PLAN_LINE_ID =',
'        --        :P1021_PROJECT_PLAN_LINE_ID;',
'',
'        l_predecessor_document_id:= :P1021_DOCUMENT_ID;',
'',
'    EXCEPTION',
'        WHEN NO_DATA_FOUND THEN',
'            RAISE_APPLICATION_ERROR(',
'                -20008,',
'                ''Project plan line was not found: '' ||',
'                :P1021_PROJECT_PLAN_LINE_ID',
'            );',
'    END;',
'',
'    ------------------------------------------------------------------',
'    -- 5A. A predecessor exists',
'    ------------------------------------------------------------------',
'    IF l_predecessor_document_id IS NOT NULL THEN',
'        l_use_predecessor := TRUE;',
'',
'        APEX_DEBUG.MESSAGE(',
'            ''Using predecessor deliverable ID='' ||',
'            l_predecessor_document_id',
'        );',
'',
'        --------------------------------------------------------------',
'        -- Get the latest valid job ID for the predecessor',
'        --------------------------------------------------------------',
'        BEGIN',
'            SELECT job_id',
'              INTO l_predecessor_job_id',
'              FROM (',
'                    SELECT d.JOB_ID',
'                      FROM CGCT_DELIVERABLE_API_DOCUMENT d',
'                     WHERE d.DELIVERABLE_ID =',
'                           l_predecessor_document_id',
'                       AND d.JOB_ID IS NOT NULL',
'                     ORDER BY d.GENERATED_ON DESC NULLS LAST,',
'                              d.DELIVERABLE_ID DESC',
'                   )',
'             WHERE ROWNUM = 1;',
'',
'        EXCEPTION',
'            WHEN NO_DATA_FOUND THEN',
'                RAISE_APPLICATION_ERROR(',
'                    -20010,',
'                    ''No generated job was found for predecessor '' ||',
'                    ''deliverable ID '' ||',
'                    l_predecessor_document_id || ''.''',
'                );',
'        END;',
'',
'        APEX_DEBUG.MESSAGE(',
'            ''Predecessor JOB_ID='' ||',
'            l_predecessor_job_id',
'        );',
'',
'        --------------------------------------------------------------',
'        -- Download the predecessor job result',
'        --------------------------------------------------------------',
'        APEX_WEB_SERVICE.G_REQUEST_HEADERS.DELETE;',
'        APEX_WEB_SERVICE.G_REQUEST_HEADERS(1).NAME :=''X-API-Key'';',
'        APEX_WEB_SERVICE.G_REQUEST_HEADERS(1).VALUE :=l_user_api_key;',
'',
'        l_file_blob :=',
'            APEX_WEB_SERVICE.MAKE_REST_REQUEST_B(',
'                p_url =>',
'                    l_base_url ||',
'                    ''/api/v1/jobs/'' ||',
'                    UTL_URL.ESCAPE(',
'                        l_predecessor_job_id,',
'                        TRUE,',
'                        ''UTF-8''',
'                    ) ||',
'                    ''/download'',',
'                p_http_method => ''GET''',
'            );',
'',
'        --------------------------------------------------------------',
'        -- Validate the predecessor download',
'        --------------------------------------------------------------',
'        IF APEX_WEB_SERVICE.G_STATUS_CODE <> 200 THEN',
'            RAISE_APPLICATION_ERROR(',
'                -20011,',
'                ''Predecessor download failed. HTTP status: '' ||',
'                APEX_WEB_SERVICE.G_STATUS_CODE ||',
'                ''. Job ID: '' ||',
'                l_predecessor_job_id',
'            );',
'        END IF;',
'',
'        IF l_file_blob IS NULL',
'           OR DBMS_LOB.GETLENGTH(l_file_blob) = 0',
'        THEN',
'            RAISE_APPLICATION_ERROR(',
'                -20012,',
'                ''The predecessor download returned an empty file. '' ||',
'                ''Job ID: '' ||',
'                l_predecessor_job_id',
'            );',
'        END IF;',
'',
'        --------------------------------------------------------------',
'        -- Read the download response headers',
'        --------------------------------------------------------------',
'        l_file_name            := NULL;',
'        l_mime_type            := NULL;',
'        l_content_disposition  := NULL;',
'',
'        IF APEX_WEB_SERVICE.G_HEADERS.COUNT > 0 THEN',
'            FOR i IN 1 .. APEX_WEB_SERVICE.G_HEADERS.COUNT LOOP',
'                IF LOWER(APEX_WEB_SERVICE.G_HEADERS(i).NAME) =',
'                   ''content-type''',
'                THEN',
'                    l_mime_type :=',
'                        APEX_WEB_SERVICE.G_HEADERS(i).VALUE;',
'                ELSIF LOWER(APEX_WEB_SERVICE.G_HEADERS(i).NAME) =',
'                      ''content-disposition''',
'                THEN',
'                    l_content_disposition :=',
'                        APEX_WEB_SERVICE.G_HEADERS(i).VALUE;',
'                END IF;',
'            END LOOP;',
'        END IF;',
'',
'        --------------------------------------------------------------',
'        -- Extract filename from Content-Disposition',
'        --------------------------------------------------------------',
'        IF l_content_disposition IS NOT NULL THEN',
'            l_file_name :=REGEXP_SUBSTR(l_content_disposition,''filename="([^"]+)"'',1,1,''i'',1);',
'',
'            IF l_file_name IS NULL THEN',
'                l_file_name :=REGEXP_SUBSTR(l_content_disposition,''filename=([^;]+)'',1,1,''i'',1);',
'',
'                l_file_name :=',
'                    TRIM(BOTH ''"'' FROM TRIM(l_file_name));',
'            END IF;',
'        END IF;',
'',
'        --------------------------------------------------------------',
'        -- Fallback filename',
'        --------------------------------------------------------------',
'        IF l_file_name IS NULL THEN',
'            l_file_name :=',
'                ''predecessor_'' ||',
'                REPLACE(l_predecessor_job_id, ''/'', ''_'') ||',
'                ''.bin'';',
'        END IF;',
'',
'        --------------------------------------------------------------',
'        -- Strip unsafe quote characters from filename',
'        --------------------------------------------------------------',
'        l_file_name :=REPLACE(REPLACE(REPLACE(l_file_name, ''"'', ''''),CHR(13),''''),CHR(10),'''');',
'        --------------------------------------------------------------',
'        -- Fallback MIME type',
'        --------------------------------------------------------------',
'        IF l_mime_type IS NULL THEN',
'            l_mime_type := ''application/octet-stream'';',
'        END IF;',
'',
'        APEX_DEBUG.MESSAGE(''Predecessor filename='' || l_file_name);',
'',
'        APEX_DEBUG.MESSAGE(''Predecessor MIME type='' || l_mime_type);',
'',
'        APEX_DEBUG.MESSAGE(''Predecessor file size='' || DBMS_LOB.GETLENGTH(l_file_blob));',
'',
'    ------------------------------------------------------------------',
'    -- 5B. No predecessor exists',
'    ------------------------------------------------------------------',
'    ELSE',
'        l_use_predecessor := FALSE;',
'',
'        APEX_DEBUG.MESSAGE(''No predecessor exists. Use a manually uploaded source.'');',
'',
'        --------------------------------------------------------------',
'        -- Validate manual source selection',
'        --------------------------------------------------------------',
'        IF :P1021_BLOB_CONTENT IS NULL THEN',
'            RAISE_APPLICATION_ERROR(',
'                -20013,',
'                ''Please upload a source document because this task '' ||',
'                ''does not have a predecessor document.''',
'            );',
'        END IF;',
'',
'        --------------------------------------------------------------',
'        -- Read the manually uploaded source file',
'        --------------------------------------------------------------',
'        BEGIN',
'            SELECT tf.FILENAME,',
'                   NVL(',
'                       tf.MIME_TYPE,',
'                       ''application/octet-stream''',
'                   ),',
'                   tf.BLOB_CONTENT',
'              INTO l_file_name,',
'                   l_mime_type,',
'                   l_file_blob',
'              FROM APEX_APPLICATION_TEMP_FILES tf',
'             WHERE tf.NAME = :P1021_BLOB_CONTENT;',
'',
'        EXCEPTION',
'            WHEN NO_DATA_FOUND THEN',
'                BEGIN',
'                    SELECT tf.FILENAME,',
'                           NVL(tf.MIME_TYPE,''application/octet-stream''),',
'                           tf.BLOB_CONTENT',
'                      INTO l_file_name,',
'                           l_mime_type,',
'                           l_file_blob',
'                      FROM APEX_APPLICATION_TEMP_FILES tf',
'                     WHERE tf.FILENAME =',
'                           :P1021_BLOB_CONTENT;',
'',
'                EXCEPTION',
'                    WHEN NO_DATA_FOUND THEN',
'                        RAISE_APPLICATION_ERROR(',
'                            -20014,',
'                            ''The manually uploaded source document '' ||',
'                            ''was not found.''',
'                        );',
'                END;',
'',
'            WHEN TOO_MANY_ROWS THEN',
'                RAISE_APPLICATION_ERROR(-20016,''Multiple uploaded source documents were found.'');',
'        END;',
'',
'        IF l_file_blob IS NULL',
'           OR DBMS_LOB.GETLENGTH(l_file_blob) = 0',
'        THEN',
'            RAISE_APPLICATION_ERROR(-20017,''The manually uploaded source document is empty.'');',
'        END IF;',
'',
'        l_file_name :=REPLACE(REPLACE(REPLACE(l_file_name, ''"'', ''''),CHR(13),''''),CHR(10),'''');',
'',
'        APEX_DEBUG.MESSAGE(''Manual source filename='' || l_file_name);',
'        APEX_DEBUG.MESSAGE(''Manual source MIME type='' || l_mime_type);',
'        APEX_DEBUG.MESSAGE(''Manual source size='' ||DBMS_LOB.GETLENGTH(l_file_blob));',
'    END IF;',
'',
'    ------------------------------------------------------------------',
'    -- 6. Upload the selected source file to /api/v1/source',
'    ------------------------------------------------------------------',
'    l_boundary :=',
'        ''----APEX_SOURCE_'' ||',
'        RAWTOHEX(SYS_GUID());',
'',
'    DBMS_LOB.CREATETEMPORARY(',
'        lob_loc => l_body_blob,',
'        cache   => TRUE,',
'        dur     => DBMS_LOB.CALL',
'    );',
'',
'    append_text(',
'        l_body_blob,',
'        ''--'' || l_boundary ||',
'        CHR(13) || CHR(10)',
'    );',
'',
'    append_text(',
'        l_body_blob,',
'        ''Content-Disposition: form-data; name="file"; filename="'' ||',
'        l_file_name || ''"'' ||',
'        CHR(13) || CHR(10)',
'    );',
'',
'    append_text(',
'        l_body_blob,',
'        ''Content-Type: '' || l_mime_type ||',
'        CHR(13) || CHR(10) ||',
'        CHR(13) || CHR(10)',
'    );',
'',
'    append_blob(',
'        l_body_blob,',
'        l_file_blob',
'    );',
'',
'    append_text(',
'        l_body_blob,',
'        CHR(13) || CHR(10) ||',
'        ''--'' || l_boundary || ''--'' ||',
'        CHR(13) || CHR(10)',
'    );',
'',
'    APEX_WEB_SERVICE.G_REQUEST_HEADERS.DELETE;',
'    APEX_WEB_SERVICE.G_REQUEST_HEADERS(1).NAME :=''X-API-Key'';',
'    APEX_WEB_SERVICE.G_REQUEST_HEADERS(1).VALUE :=l_user_api_key;',
'    APEX_WEB_SERVICE.G_REQUEST_HEADERS(2).NAME :=''Content-Type'';',
'',
'    APEX_WEB_SERVICE.G_REQUEST_HEADERS(2).VALUE :=''multipart/form-data; boundary='' ||l_boundary;',
'',
'    l_response :=',
'        APEX_WEB_SERVICE.MAKE_REST_REQUEST(',
'            p_url         => l_base_url || ''/api/v1/sources'',',
'            p_http_method => ''POST'',',
'            p_body_blob   => l_body_blob',
'        );',
'',
'    APEX_DEBUG.MESSAGE(',
'        ''Source upload HTTP status='' ||',
'        APEX_WEB_SERVICE.G_STATUS_CODE',
'    );',
'',
'    APEX_DEBUG.MESSAGE(',
'        ''Source upload response='' ||',
'        DBMS_LOB.SUBSTR(l_response, 4000, 1)',
'    );',
'',
'    free_body_blob;',
'',
'    ------------------------------------------------------------------',
'    -- 7. Validate source upload',
'    ------------------------------------------------------------------',
'    IF APEX_WEB_SERVICE.G_STATUS_CODE NOT IN (200, 201, 202) THEN',
'        RAISE_APPLICATION_ERROR(-20018,''Source upload failed. HTTP status: '' ||APEX_WEB_SERVICE.G_STATUS_CODE ||''. Response: '' ||DBMS_LOB.SUBSTR(l_response, 3000, 1));',
'    END IF;',
'',
'    ------------------------------------------------------------------',
'    -- 8. Extract source ID',
'    ------------------------------------------------------------------',
'    l_source_id :=',
'        JSON_VALUE(',
'            l_response,',
'            ''$.id''',
'            RETURNING VARCHAR2',
'            NULL ON ERROR',
'        );',
'',
'    IF l_source_id IS NULL THEN',
'        l_source_id :=',
'            JSON_VALUE(',
'                l_response,',
'                ''$.source_id''',
'                RETURNING VARCHAR2',
'                NULL ON ERROR',
'            );',
'    END IF;',
'',
'    IF l_source_id IS NULL THEN',
'        l_source_id :=',
'            JSON_VALUE(',
'                l_response,',
'                ''$.data.id''',
'                RETURNING VARCHAR2',
'                NULL ON ERROR',
'            );',
'    END IF;',
'',
'    IF l_source_id IS NULL THEN',
'        RAISE_APPLICATION_ERROR(',
'            -20019,',
'            ''The source was uploaded, but the response did not '' ||',
'            ''contain a source ID. Response: '' ||',
'            DBMS_LOB.SUBSTR(l_response, 3000, 1)',
'        );',
'    END IF;',
'',
'    APEX_DEBUG.MESSAGE(',
'        ''Source ID='' || l_source_id',
'    );',
'',
'    ------------------------------------------------------------------',
'    -- 9. Get the template URL for the current plan line',
'    ------------------------------------------------------------------',
'    BEGIN',
'        SELECT ''https://objectstorage.us-ashburn-1.oraclecloud.com/'' || ''n/capnaop2/b/ICT_Templates/o/'' || t.TEMPLATE_FILE_PATH',
'          INTO l_tmp_url FROM CGCT_PROJECT_TEMPLATES t',
'         WHERE t.ID = ( SELECT p.TEMPLATE_ID FROM CGCT_PP_PLAN_LINE p WHERE p.PROJECT_PLAN_LINE_ID =:P1021_PROJECT_PLAN_LINE_ID);',
'',
'    EXCEPTION',
'        WHEN NO_DATA_FOUND THEN',
'            RAISE_APPLICATION_ERROR(',
'                -20020,',
'                ''No template was found for project plan line '' ||',
'                :P1021_PROJECT_PLAN_LINE_ID',
'            );',
'    END;',
'',
'    ------------------------------------------------------------------',
'    -- 10. Get the template name',
'    ------------------------------------------------------------------',
'    l_template_name := SUBSTR(l_tmp_url,INSTR(l_tmp_url, ''/'', -1) + 1);',
'',
'    IF l_template_name IS NULL THEN',
'        RAISE_APPLICATION_ERROR(-20022,''The template filename could not be determined.'');',
'    END IF;',
'',
'    ------------------------------------------------------------------',
'    -- 11. Determine output format from template extension',
'    ------------------------------------------------------------------',
'    l_extension :=LOWER(REGEXP_SUBSTR(l_template_name,''[^.]+$''));',
'',
'    IF l_extension NOT IN (''docx'', ''pptx'', ''xlsx'') THEN',
'        RAISE_APPLICATION_ERROR(',
'            -20023,',
'            ''Unsupported generation template extension: '' ||',
'            NVL(l_extension, ''NULL'')',
'        );',
'    END IF;',
'',
'    ------------------------------------------------------------------',
'    -- 12. Determine template MIME type',
'    ------------------------------------------------------------------',
'    l_template_mime :=',
'        CASE l_extension',
'            WHEN ''pptx'' THEN',
'                ''application/vnd.openxmlformats-officedocument.'' ||',
'                ''presentationml.presentation''',
'            WHEN ''docx'' THEN',
'                ''application/vnd.openxmlformats-officedocument.'' ||',
'                ''wordprocessingml.document''',
'            WHEN ''xlsx'' THEN',
'                ''application/vnd.openxmlformats-officedocument.'' ||',
'                ''spreadsheetml.sheet''',
'            ELSE',
'                ''application/octet-stream''',
'        END;',
'',
'    ------------------------------------------------------------------',
'    -- 13. Download the template',
'    ------------------------------------------------------------------',
'    APEX_WEB_SERVICE.G_REQUEST_HEADERS.DELETE;',
'',
'    l_template_blob :=',
'        APEX_WEB_SERVICE.MAKE_REST_REQUEST_B(',
'            p_url         => l_tmp_url,',
'            p_http_method => ''GET''',
'        );',
'',
'    IF APEX_WEB_SERVICE.G_STATUS_CODE <> 200 THEN',
'        RAISE_APPLICATION_ERROR(',
'            -20024,',
'            ''Template download failed. HTTP status: '' ||',
'            APEX_WEB_SERVICE.G_STATUS_CODE ||',
'            ''. URL: '' ||',
'            SUBSTR(l_tmp_url, 1, 1500)',
'        );',
'    END IF;',
'',
'    IF l_template_blob IS NULL',
'       OR DBMS_LOB.GETLENGTH(l_template_blob) = 0',
'    THEN',
'        RAISE_APPLICATION_ERROR(',
'            -20025,',
'            ''The downloaded template is empty.''',
'        );',
'    END IF;',
'',
'    APEX_DEBUG.MESSAGE(',
'        ''Template name='' || l_template_name',
'    );',
'',
'    APEX_DEBUG.MESSAGE(',
'        ''Template format='' || l_extension',
'    );',
'',
'    APEX_DEBUG.MESSAGE(',
'        ''Template size='' ||',
'        DBMS_LOB.GETLENGTH(l_template_blob)',
'    );',
'',
'    ------------------------------------------------------------------',
'    -- 14. Cache/configure the GenAI key',
'    ------------------------------------------------------------------',
'    APEX_WEB_SERVICE.G_REQUEST_HEADERS.DELETE;',
'    APEX_WEB_SERVICE.G_REQUEST_HEADERS(1).NAME :=''X-API-Key'';',
'    APEX_WEB_SERVICE.G_REQUEST_HEADERS(1).VALUE :=l_user_api_key;',
'    APEX_WEB_SERVICE.G_REQUEST_HEADERS(2).NAME :=''Content-Type'';',
'    APEX_WEB_SERVICE.G_REQUEST_HEADERS(2).VALUE :=''application/json'';',
'    l_body :=',
'        JSON_OBJECT(',
'            ''provider'' VALUE ''genai_gateway'',',
'            ''api_key''  VALUE l_genai_key',
'        );',
'',
'    l_response :=',
'        APEX_WEB_SERVICE.MAKE_REST_REQUEST(',
'            p_url         => l_base_url || ''/api/v1/llm-config/keys'',',
'            p_http_method => ''POST'',',
'            p_body        => l_body',
'        );',
'',
'    IF APEX_WEB_SERVICE.G_STATUS_CODE NOT IN (200, 201, 204) THEN',
'        RAISE_APPLICATION_ERROR( -20026, ''GenAI key configuration failed. HTTP status: '' || APEX_WEB_SERVICE.G_STATUS_CODE || ''. Response: '' || DBMS_LOB.SUBSTR(l_response, 3000, 1));',
'    END IF;',
'',
'    ------------------------------------------------------------------',
'    -- 15. Read the custom prompt',
'    ------------------------------------------------------------------',
'    l_custom_prompt := :P1021_CONSOLIDATED_PROMPT_NOSPACE;',
'',
'    IF l_custom_prompt IS NULL THEN',
'        RAISE_APPLICATION_ERROR(',
'            -20027,',
'            ''The generation prompt is empty.''',
'        );',
'    END IF;',
'',
'    ------------------------------------------------------------------',
'    -- 16. Create multipart body for document generation',
'    ------------------------------------------------------------------',
'    l_boundary :=',
'        ''----APEX_GENERATION_'' ||',
'        RAWTOHEX(SYS_GUID());',
'',
'    DBMS_LOB.CREATETEMPORARY(',
'        lob_loc => l_body_blob,',
'        cache   => TRUE,',
'        dur     => DBMS_LOB.CALL',
'    );',
'',
'    ------------------------------------------------------------------',
'    -- Part 1: template file',
'    ------------------------------------------------------------------',
'    append_text(',
'        l_body_blob,',
'        ''--'' || l_boundary ||',
'        CHR(13) || CHR(10)',
'    );',
'',
'    append_text(',
'        l_body_blob,',
'        ''Content-Disposition: form-data; name="file"; filename="'' ||',
'        REPLACE(l_template_name, ''"'', '''') || ''"'' ||',
'        CHR(13) || CHR(10)',
'    );',
'',
'    append_text(',
'        l_body_blob,',
'        ''Content-Type: '' || l_template_mime ||',
'        CHR(13) || CHR(10) ||',
'        CHR(13) || CHR(10)',
'    );',
'',
'    append_blob(',
'        l_body_blob,',
'        l_template_blob',
'    );',
'',
'    ------------------------------------------------------------------',
'    -- Part 2: source_ids',
'    ------------------------------------------------------------------',
'    append_text(',
'        l_body_blob,',
'        CHR(13) || CHR(10) ||',
'        ''--'' || l_boundary ||',
'        CHR(13) || CHR(10)',
'    );',
'',
'    append_text(',
'        l_body_blob,',
'        ''Content-Disposition: form-data; name="source_ids"'' ||',
'        CHR(13) || CHR(10) ||',
'        CHR(13) || CHR(10)',
'    );',
'',
'    append_text(',
'        l_body_blob,',
'        JSON_ARRAY(',
'            l_source_id',
'            RETURNING VARCHAR2',
'        )',
'    );',
'',
'    ------------------------------------------------------------------',
'    -- Part 3: custom_prompt',
'    ------------------------------------------------------------------',
'    append_text(',
'        l_body_blob,',
'        CHR(13) || CHR(10) ||',
'        ''--'' || l_boundary ||',
'        CHR(13) || CHR(10)',
'    );',
'',
'    append_text(',
'        l_body_blob,',
'        ''Content-Disposition: form-data; name="custom_prompt"'' ||',
'        CHR(13) || CHR(10) ||',
'        CHR(13) || CHR(10)',
'    );',
'',
'    append_text(',
'        l_body_blob,',
'        DBMS_LOB.SUBSTR(',
'            l_custom_prompt,',
'            32767,',
'            1',
'        )',
'    );',
'',
'    ------------------------------------------------------------------',
'    -- Part 4: max_critic_retries',
'    ------------------------------------------------------------------',
'    append_text(',
'        l_body_blob,',
'        CHR(13) || CHR(10) ||',
'        ''--'' || l_boundary ||',
'        CHR(13) || CHR(10)',
'    );',
'',
'    append_text(',
'        l_body_blob,',
'        ''Content-Disposition: form-data; '' ||',
'        ''name="max_critic_retries"'' ||',
'        CHR(13) || CHR(10) ||',
'        CHR(13) || CHR(10)',
'    );',
'',
'    append_text(',
'        l_body_blob,',
'        ''3''',
'    );',
'',
'    ------------------------------------------------------------------',
'    -- End multipart boundary',
'    ------------------------------------------------------------------',
'    append_text(',
'        l_body_blob,',
'        CHR(13) || CHR(10) ||',
'        ''--'' || l_boundary || ''--'' ||',
'        CHR(13) || CHR(10)',
'    );',
'',
'    ------------------------------------------------------------------',
'    -- 17. Set generation request headers',
'    ------------------------------------------------------------------',
'    APEX_WEB_SERVICE.G_REQUEST_HEADERS.DELETE;',
'    APEX_WEB_SERVICE.G_REQUEST_HEADERS(1).NAME :=''X-API-Key'';',
'    APEX_WEB_SERVICE.G_REQUEST_HEADERS(1).VALUE :=l_user_api_key;',
'    APEX_WEB_SERVICE.G_REQUEST_HEADERS(2).NAME :=''Content-Type'';',
'    APEX_WEB_SERVICE.G_REQUEST_HEADERS(2).VALUE :=''multipart/form-data; boundary='' ||',
'        l_boundary;',
'',
'    ------------------------------------------------------------------',
'    -- 18. Submit asynchronous generation',
'    ------------------------------------------------------------------',
'    l_response :=',
'        APEX_WEB_SERVICE.MAKE_REST_REQUEST(',
'            p_url =>',
'                l_base_url ||',
'                ''/api/v3/generate/'' ||',
'                l_extension ||',
'                ''/async'',',
'            p_http_method => ''POST'',',
'            p_body_blob   => l_body_blob',
'        );',
'',
'    APEX_DEBUG.MESSAGE( ''Generate HTTP status='' || APEX_WEB_SERVICE.G_STATUS_CODE);',
'',
'    APEX_DEBUG.MESSAGE( ''Generate response='' || DBMS_LOB.SUBSTR(l_response, 4000, 1));',
'',
'    free_body_blob;',
'',
'    ------------------------------------------------------------------',
'    -- 19. Validate generation submission',
'    ------------------------------------------------------------------',
'    IF APEX_WEB_SERVICE.G_STATUS_CODE NOT IN (200, 201, 202) THEN',
'        RAISE_APPLICATION_ERROR(',
'            -20028,',
'            ''Generation failed. HTTP status: '' ||',
'            APEX_WEB_SERVICE.G_STATUS_CODE ||',
'            ''. Response: '' ||',
'            DBMS_LOB.SUBSTR(l_response, 3000, 1)',
'        );',
'    END IF;',
'',
'    ------------------------------------------------------------------',
'    -- 20. Parse generation response',
'    ------------------------------------------------------------------',
'    l_job_id :=',
'        JSON_VALUE(',
'            l_response,',
'            ''$.job_id''',
'            RETURNING VARCHAR2',
'            NULL ON ERROR',
'        );',
'',
'    l_document_id :=',
'        JSON_VALUE(',
'            l_response,',
'            ''$.document_id''',
'            RETURNING VARCHAR2',
'            NULL ON ERROR',
'        );',
'',
'    IF l_job_id IS NULL THEN',
'        RAISE_APPLICATION_ERROR(',
'            -20029,',
'            ''Generation was submitted, but no JOB_ID was returned. '' ||',
'            ''Response: '' ||',
'            DBMS_LOB.SUBSTR(l_response, 3000, 1)',
'        );',
'    END IF;',
'',
'    ------------------------------------------------------------------',
'    -- 21. Insert new generation record',
'    ------------------------------------------------------------------',
'    INSERT INTO CGCT_DELIVERABLE_API_DOCUMENT',
'    (',
'        DELIVERABLE_ID,',
'        JOB_ID,',
'        DOCUMENT_ID,',
'        GENERATION_STATUS,',
'        PROJECT_PLAN_LINE_ID,',
'        TYPE,',
'        CREATED_BY,',
'        GENERATED_ON',
'    )',
'    VALUES',
'    (',
'        NULL,',
'        l_job_id,',
'        l_document_id,',
'        ''IN_PROGRESS'',',
'        :P1021_PROJECT_PLAN_LINE_ID,',
'        ''AI'',',
'        :P0_USER_ID_EMAIL,',
'        SYSDATE',
'    )',
'    RETURNING DELIVERABLE_ID',
'         INTO l_deliverable_id;',
'',
'    APEX_DEBUG.MESSAGE(',
'        ''Inserted deliverable ID='' ||',
'        l_deliverable_id',
'    );',
'',
'    APEX_DEBUG.MESSAGE(',
'        ''New generation JOB_ID='' ||',
'        l_job_id',
'    );',
'',
'    ------------------------------------------------------------------',
'    -- 22. Create background job to check generation status',
'    ------------------------------------------------------------------',
'    DBMS_SCHEDULER.CREATE_JOB(',
'        job_name =>''JOB_VALIDATE_'' ||TO_CHAR(SYSTIMESTAMP,''YYYYMMDDHH24MISSFF6''),',
'        job_type =>''PLSQL_BLOCK'',',
'        job_action =>',
'            ''BEGIN RUN_POST_JOB_STATUS('' ||',
'            DBMS_ASSERT.ENQUOTE_LITERAL(l_job_id) || '','' ||',
'            TO_CHAR(l_deliverable_id) || '','' ||',
'            DBMS_ASSERT.ENQUOTE_LITERAL(l_user_api_key) ||',
'            ''); END;'',',
'        start_date =>SYSTIMESTAMP,',
'        enabled =>TRUE,',
'        auto_drop =>TRUE',
'    );',
'',
'    ------------------------------------------------------------------',
'    -- 24. Final cleanup',
'    ------------------------------------------------------------------',
'    free_body_blob;',
'',
'EXCEPTION',
'    WHEN OTHERS THEN',
'        free_body_blob;',
'',
'        APEX_DEBUG.ERROR(',
'            ''Generation process failed. SQLCODE='' ||',
'            SQLCODE ||',
'            '', SQLERRM='' ||',
'            SQLERRM ||',
'            '', backtrace='' ||',
'            DBMS_UTILITY.FORMAT_ERROR_BACKTRACE',
'        );',
'',
'        RAISE;',
'END;'))
