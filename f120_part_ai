'              INTO l_genai_key',
'              FROM CGCT_APP_USERS',
'              WHERE USER_ID = :P0_USER_ID_EMAIL;',
'          ',
'          EXCEPTION',
'              WHEN NO_DATA_FOUND THEN',
'                  l_genai_key := NULL;',
'          END;',
'          ',
'          IF l_genai_key IS NULL THEN',
'              BEGIN',
'                  SELECT PROJECT_GEN_API_KEY',
'                  INTO l_genai_key',
'                  FROM CGCT_PROJECT_MASTER',
'                  WHERE ID = :P0_PRJ_ID;',
'              EXCEPTION',
'                  WHEN NO_DATA_FOUND THEN',
'                      l_genai_key := NULL;',
'              END;',
'          END IF;',
'    ',
'    ------------------------------------------------------------------',
'    -- Source Id obtained from /sources upload response',
'    ------------------------------------------------------------------',
'    select filename,',
'           mime_type,',
'           blob_content',
'      into l_file_name,',
'           l_mime_type,',
'           l_file_blob',
'      from apex_application_temp_files',
'     where name = :P1021_BLOB_CONTENT',
'        or filename = :P1021_BLOB_CONTENT;',
'',
'    if l_mime_type is null then',
'        l_mime_type := ''application/octet-stream'';',
'    end if;',
'',
'    dbms_lob.createtemporary(l_body_blob, true);',
'',
'    append_text(',
'        l_body_blob,',
'        ''--'' || l_boundary || chr(13) || chr(10)',
