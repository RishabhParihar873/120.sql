wwv_flow_imp_page.create_page_plug(
 p_id=>wwv_flow_imp.id(475082732644607633)
,p_plug_name=>'Predecessors_updated_view_attachment'
,p_static_id=>'predecessors-updated-view-attachment'
,p_region_name=>'Predecessors_updated_old'
,p_region_template_options=>'#DEFAULT#:t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc'
,p_plug_template=>2100526641005906379
,p_plug_display_sequence=>200
,p_plug_item_display_point=>'ABOVE'
,p_query_type=>'SQL'
,p_plug_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'WITH H AS (',
'    SELECT /*+ parallel(cppl 8) */',
'           cppl.*',
'      FROM cgct_pp_plan_line cppl',
'),',
'DOC_COUNT AS (',
'    SELECT project_plan_line_id,',
'           COUNT(*) AS attachment_count',
'      FROM cgct_deliverable_api_document',
'     GROUP BY project_plan_line_id',
')',
'SELECT DISTINCT',
'       APEX_ITEM.CHECKBOX2(',
'           p_idx        => 1,',
'           p_value      => H.project_plan_line_id,',
'           p_attributes =>',
'                  ''class="ir-start" ''',
'               || ''title="Mark to Start" ''',
'               || ''data-enable="''',
'               || CASE',
'                      WHEN child.project_plan_line_id IS NULL THEN ''Y''',
'                      ELSE ''N''',
'                  END',
'               || ''" ''',
'               || ''data-task="''',
'               || NVL(',
'                      REPLACE(H.task_number, ''"'', ''&quot;''),',
'                      ''''',
'                  )',
'               || ''" ''',
'               || ''onclick="apex.event.trigger(document,''''f01-changed'''');"''',
'       ) AS start_sel,',
'',
'       ---------------------------------------------------------------',
'       -- DOCUMENT DETAILS',
'       ---------------------------------------------------------------',
'       DEL.DELIVERABLE_ID AS DOCUMENT_ID,',
'',
'       H.project_plan_line_id,',
'',
'       H.task_name,',
'',
'',
'       ---------------------------------------------------------------',
'       -- URL',
'       ---------------------------------------------------------------',
'       CASE',
'           WHEN NVL(D.attachment_count, 0) > 0 THEN',
'               APEX_PAGE.GET_URL(',
'                   p_page        => 1066,',
'                   p_items       => ''P1066_PROJECT_PLAN_LINE_ID'',',
'                   p_values      => H.project_plan_line_id,',
'                   p_clear_cache => ''1066''',
'               )',
'           ELSE',
'               NULL',
'       END AS attachment_url,',
'',
'       ---------------------------------------------------------------',
'       -- ICON',
'       ---------------------------------------------------------------',
'       CASE',
'           WHEN NVL(D.attachment_count, 0) > 0 THEN',
'               ''<span class="fa fa-eye" ''',
'               || ''title="View Attachment" ''',
'               || ''aria-label="View Attachment"></span>''',
'           ELSE',
'               ''<span class="fa fa-times" ''',
'               || ''style="color:#d63b25;" ''',
'               || ''title="No Attachment" ''',
'               || ''aria-label="No Attachment"></span>''',
'       END AS view_attachment',
'',
'  FROM H',
'',
'  JOIN cgct_pp_project_plan P',
'    ON P.project_plan_id = H.project_plan_id',
'   AND P.project_id      = :P0_PROJECT_ID',
'   AND P.status          = ''Y''',
'',
'  LEFT JOIN cgct_project_templates TM',
'    ON TM.id = H.template_id',
'',
'  LEFT JOIN cgct_pp_plan_line CHILD',
'    ON CHILD.parent_id = H.project_plan_line_id',
'',
'  LEFT JOIN DOC_COUNT D',
'    ON D.project_plan_line_id = H.project_plan_line_id',
'',
'  -------------------------------------------------------------------',
'  -- DELIVERABLE TABLE JOIN',
'  -------------------------------------------------------------------',
'  LEFT JOIN cgct_deliverable_api_document DEL',
'    ON DEL.PROJECT_PLAN_LINE_ID = H.PROJECT_PLAN_LINE_ID',
'    AND DEL.BASELINED = ''Y''',
'',
' WHERE H.category IN (',
'           ''Deliverable'',',
'           ''Internal Deliverable''',
'       )',
'   AND H.row_number IN (',
'       SELECT TO_NUMBER(',
'                  TRIM(',
'                      REGEXP_SUBSTR(',
'                          predecessors,',
'                          ''[^,]+'',',
'                          1,',
'                          LEVEL',
'                      )',
'                  )',
'              )',
'         FROM cgct_pp_plan_line',
'        WHERE project_plan_line_id =',
'              :P1062_PROJECT_PLAN_LINE_ID',
'      CONNECT BY REGEXP_SUBSTR(',
'                     predecessors,',
'                     ''[^,]+'',',
'                     1,',
'                     LEVEL',
'                 ) IS NOT NULL',
'             AND PRIOR project_plan_line_id =',
'                 project_plan_line_id',
'             AND PRIOR SYS_GUID() IS NOT NULL',
'   );'))
,p_plug_source_type=>'NATIVE_IG'
,p_ajax_items_to_submit=>'P1062_PROJECT_PLAN_LINE_ID'
,p_prn_units=>'INCHES'
