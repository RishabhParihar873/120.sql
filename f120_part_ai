'    l_body        clob;',
'    l_response    clob;',
'    l_status      varchar2(100);',
'    l_message     varchar2(4000);',
'    l_link        clob;',
'    l_http_status number;',
'    l_exists      number;',
'begin',
'    ------------------------------------------------------------------',
'    -- Step 1: Get template info',
'    ------------------------------------------------------------------',
'    select template_file_path,',
'           template_file_name',
'      into l_template_file_path,',
'           l_template_file_name',
'      from cgct_project_templates',
'     where id = :P1055_SELECTED_TEMPLATE_ID;',
'',
'    ------------------------------------------------------------------',
'    -- Step 2: Build Object Storage URL',
'    ------------------------------------------------------------------',
'       SELECT v.DESCRIPTION  ||''/''|| l_template_file_path  ',
'       into l_file_url',
'     FROM CGCT_LOOKUP_V v',
'     WHERE v.lookup_type = ''FILE_INTEGRATION_SETUP''',
'       AND v.CODE = ''ITEM_URL'';',
'',
'    ------------------------------------------------------------------',
'    -- Step 3: Build JSON request',
'    ------------------------------------------------------------------',
'    -- apex_json.initialize_clob_output;',
'    -- apex_json.open_object;',
'',
'    -- apex_json.write(''project_id'', :P1055_SELECTED_PROJECT_ID);',
'    -- apex_json.write(''project_name'', :P1055_SELECTED_TASK_NAME);',
'    -- apex_json.write(''file_url'', l_file_url);',
'    -- -- apex_json.write(''file_name'', l_template_file_name);',
'',
'    -- apex_json.close_object;',
'',
'    -- l_body := apex_json.get_clob_output;',
'    -- apex_json.free_output;',
'',
'    ------------------------------------------------------------------',
'    -- Step 4: Call FastAPI',
'    ------------------------------------------------------------------',
'    apex_web_service.g_request_headers.delete;',
'    apex_web_service.g_request_headers(1).name  := ''Content-Type'';',
'    apex_web_service.g_request_headers(1).value := ''application/json'';',
'',
'    l_response := apex_web_service.make_rest_request(',
'        -- p_url         => ''https://python-document-new-2.onrender.com/generate-doc'',',
'        p_url         => ''https://apex-ai-api.onrender.com/generate-doc'',',
'        p_http_method => ''POST'',',
'         p_body        => ''{ ',
'          "project_id": "'' || :P1055_SELECTED_PROJECT_ID || ''",',
'          "project_name": "'' || :P1055_SELECTED_TASK_NAME || ''",',
'          "file_url": "'' || l_file_url || ''"',
'        }''',
'        -- p_body        => l_body',
'    );',
'',
'    l_http_status := apex_web_service.g_status_code;',
'',
'    ------------------------------------------------------------------',
'    -- Step 5: ALWAYS RETURN JSON (IMPORTANT FIX)',
'    ------------------------------------------------------------------',
'    if l_http_status <> 200 then',
'        apex_json.initialize_clob_output;',
'        apex_json.open_object;',
'',
'        apex_json.write(''status'', ''ERROR'');',
'        apex_json.write(''message'',',
'            ''HTTP '' || l_http_status || '' - '' ||',
'            dbms_lob.substr(l_response, 2000, 1)',
'        );',
'',
'        apex_json.close_object;',
'',
'        htp.p(apex_json.get_clob_output);',
'        apex_json.free_output;',
'        return;',
'    end if;',
'',
'    ------------------------------------------------------------------',
'    -- Step 6: Parse response',
'    ------------------------------------------------------------------',
'    apex_json.parse(l_response);',
'',
'    l_status  := apex_json.get_varchar2(''status'');',
'    l_message := apex_json.get_varchar2(''message'');',
'    l_link    := apex_json.get_varchar2(''download_link'');',
'    l_document:=apex_json.get_clob(''document'');',
'',
'    :P1055_LINK:=l_file_url;',
'',
'    ------------------------------------------------------------------',
'    -- Step 7: Save result',
'    ------------------------------------------------------------------',
'    if l_status = ''SUCCESS'' then',
'',
'        select count(*)',
'          into l_exists',
'          from CGCT_DELIVERABLE_API_DOCUMENT',
'         where project_plan_line_id = :P1055_SELECTED_PLAN_LINE_ID',
'        --    and generation_date_and_time > systimestamp - interval ''20'' second;',
'        ',
'         and (',
'                generation_date_and_time > systimestamp - interval ''10'' second',
'             or generation_date_and_time > systimestamp - interval ''20'' second',
'             or generation_date_and_time > systimestamp - interval ''30'' second',
'             or generation_date_and_time > systimestamp - interval ''40'' second',
'             or generation_date_and_time > systimestamp - interval ''50'' second',
'          );',
'',
'',
'        if l_exists = 0 then',
'            insert into CGCT_DELIVERABLE_API_DOCUMENT (',
'                GENERATION_DATE_AND_TIME,',
'                CREATED_BY,',
'                TYPE,',
'                LINK,',
'                BASELINED,',
'                PROJECT_PLAN_LINE_ID,',
'                MARKDOWN_CONTENT',
'            ) values (',
'                systimestamp,',
'                :P0_USER_ID_EMAIL,',
'                ''AI'',',
'                l_link,',
'                ''N'',',
'                :P1055_SELECTED_PLAN_LINE_ID,',
'                l_document',
'            );',
'',
'            commit;',
'        end if;',
'',
'        apex_json.initialize_clob_output;',
'        apex_json.open_object;',
'',
'        apex_json.write(''status'', ''SUCCESS'');',
'        -- apex_json.write(''message'', ''Document generated successfully'');',
'        apex_json.write(''message'', ''Document generated Successfully, Please wait until page refreshes'');',
'        apex_json.write(''link'', l_link);',
'        -- apex_json.write(''status'', ''SUCCESS'');',
'',
'-- apex_json.write(',
'--     ''message'',',
'--     ''Document generated successfully.<br>'' ||',
'--      ''test->''||:P1055_SELECTED_TASK_NAME ',
'-- );',
'',
'-- apex_json.write(''link'', l_link);',
'',
'    else',
'        apex_json.initialize_clob_output;',
'        apex_json.open_object;',
'',
'        apex_json.write(''status'', ''ERROR'');',
'        apex_json.write(''message'', l_message);',
'    end if;',
'',
'    apex_json.close_object;',
'    htp.p(apex_json.get_clob_output);',
'    apex_json.free_output;',
'',
'exception',
'    when others then',
'        apex_json.initialize_clob_output;',
'        apex_json.open_object;',
'',
'        apex_json.write(''status'', ''ERROR'');',
'        apex_json.write(''message'', sqlerrm);',
'',
'        apex_json.close_object;',
'',
'        htp.p(apex_json.get_clob_output);',
'        apex_json.free_output;',
'end;'))
