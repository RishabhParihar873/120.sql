,p_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'-- SELECT',
'--     ''<a href="javascript:void(0);" ',
'--         class="wave-link" ',
'--         onclick="setPhaseId( )">ALL</a>'' AS d,',
'--     0 AS r   -- ensures ALL appears first',
'-- FROM dual',
'',
'-- UNION ALL',
'',
'-- SELECT',
'--     ''<a href="javascript:void(0);" ',
'--         class="wave-link" ',
'--         onclick="setPhaseId('''''' || ids || '''''')">'' ||',
'--         PHASE_DISPLAY_NAME ||',
'--     ''</a>'' AS d,',
'--     MIN(PROJECT_PHASE_ID) AS r',
'-- FROM (',
'--     SELECT ',
'--         PHASE_DISPLAY_NAME,',
'--         PROJECT_PHASE_ID,',
'--         LISTAGG(PROJECT_PHASE_ID, '','') ',
'--             WITHIN GROUP (ORDER BY PROJECT_PHASE_ID) ',
'--             OVER (PARTITION BY PHASE_DISPLAY_NAME) AS ids',
'--     FROM CGCT_PP_PROJECT_PHASE',
'--     WHERE PROJECT_ID = :P0_PROJECT_ID',
'--       AND (',
'--             :P1055_WAVE IS NULL ',
'--             OR WAVE_ID IS NULL ',
'--             OR WAVE_ID = :P1055_WAVE',
'--           )',
'--       AND REFERENCE_PHASE_ID IS NULL',
'-- )',
'-- GROUP BY PHASE_DISPLAY_NAME, ids',
'-- ORDER BY r;',
unistr('-- \D83D\DD39 ALL option (comes first)'),
'SELECT',
'    ''<a href="javascript:void(0);" ',
'        class="wave-link all-link" ',
'        data-id=""',
'        onclick="setPhaseId('''''''')">ALL</a>'' AS d,',
'    0 AS r',
'FROM dual',
'',
'UNION ALL',
'',
unistr('-- \D83D\DD39 Phase-wise links'),
'SELECT',
'    ''<a href="javascript:void(0);" ',
'        class="wave-link" ',
'        data-id="'' || ids || ''" ',
'        onclick="setPhaseId('''''' || ids || '''''')">'' ||',
'        PHASE_DISPLAY_NAME ||',
'    ''</a>'' AS d,',
'    MIN(PROJECT_PHASE_ID) AS r',
'FROM (',
'    SELECT ',
'        PHASE_DISPLAY_NAME,',
'        PROJECT_PHASE_ID,',
'        LISTAGG(PROJECT_PHASE_ID, '','') ',
'            WITHIN GROUP (ORDER BY PROJECT_PHASE_ID) ',
'            OVER (PARTITION BY PHASE_DISPLAY_NAME) AS ids',
'    FROM CGCT_PP_PROJECT_PHASE',
'    WHERE PROJECT_ID = :P0_PROJECT_ID',
'      AND (',
'            :P1055_WAVE IS NULL ',
'            OR WAVE_ID IS NULL ',
'            OR WAVE_ID = :P1055_WAVE',
'          )',
'      AND REFERENCE_PHASE_ID IS NULL',
'',
')',
'GROUP BY PHASE_DISPLAY_NAME, ids',
'',
'ORDER BY r;'))
,p_ajax_enabled=>'Y'
,p_ajax_items_to_submit=>'P1055_WAVE,P0_PROJECT_ID'
,p_fixed_header=>'PAGE'
,p_lazy_loading=>false
