,p_process_sql_clob=>wwv_flow_string.join(wwv_flow_t_varchar2(
'DECLARE',
'    l_response    CLOB;',
'    l_doc         CLOB;',
'    l_link        VARCHAR2(4000);',
'    l_file_id     VARCHAR2(4000);',
'    l_status      VARCHAR2(100);',
'    l_message     VARCHAR2(4000);',
'    l_body        CLOB;',
'BEGIN',
'    apex_web_service.g_request_headers.delete;',
'',
'    apex_web_service.g_request_headers(1).name  := ''Content-Type'';',
'    apex_web_service.g_request_headers(1).value := ''application/json'';',
'',
'    -- Build JSON safely',
'    apex_json.initialize_clob_output;',
'',
'    apex_json.open_object;',
'    apex_json.write(''project_id'', :P1004_PROJECT_ID);',
'    apex_json.write(''project_name'', :P1004_PROJECT_NAME);',
'    apex_json.write(''manual_content'', :P1004_MARKDOWN_CONTENT);',
'    apex_json.close_object;',
'',
'    l_body := apex_json.get_clob_output;',
'',
'    apex_json.free_output;',
'',
'    -- Call FastAPI',
'    l_response := apex_web_service.make_rest_request(',
'        p_url         => ''https://apex-ai-api.onrender.com/generate-doc'',',
'        p_http_method => ''POST'',',
'        p_body        => l_body',
'    );',
'',
'    apex_json.parse(l_response);',
'',
'    l_status := apex_json.get_varchar2(''status'');',
'',
'    IF l_status <> ''SUCCESS'' THEN',
'        l_message := apex_json.get_varchar2(''message'');',
'',
'        -- Do not wipe existing content/link in DB',
'        :P1004_ERROR_MESSAGE := ''Error: '' || l_message;',
'',
'        RETURN;',
'    END IF;',
'',
'    -- Get response values',
'    l_doc     := apex_json.get_clob(''document'');',
'    l_link    := apex_json.get_varchar2(''download_link'');',
'    l_file_id := apex_json.get_varchar2(''file_id'');',
'',
'    -- Only update page items after success',
'    :P1004_MARKDOWN_CONTENT := l_doc;',
'    :P1004_GENERATED_LINK   := l_link;',
'    :P1004_FILE_ID          := l_file_id;',
'',
'    -- Save only successful generated values',
'    UPDATE CGCT_DELIVERABLE_API_DOCUMENT',
'    SET ',
'        MARKDOWN_CONTENT = l_doc,',
'        LINK             = l_link,',
'        TYPE             = ''AI EDITED''',
'    WHERE DELIVERABLE_ID = :P1004_DOCUMENT_ID;',
'',
'EXCEPTION',
'    WHEN OTHERS THEN',
'        -- Do not overwrite markdown content on exception',
'        :P1004_ERROR_MESSAGE := ''Error: '' || SQLERRM;',
'END;'))
