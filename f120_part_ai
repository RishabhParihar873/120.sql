,p_plug_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'WITH node_tree AS (',
'    SELECT',
'        id,',
'        parent_id,',
'        LEVEL AS level_no,',
'        task_name,',
'        task_number,',
'        start_date,',
'        end_date',
'    FROM (',
'        SELECT',
'            w.wave_id AS id,',
'            CAST(NULL AS NUMBER) AS parent_id,',
'            w.wave_name AS task_name,',
'            w.task_number AS task_number,',
'            w.start_date,',
'            w.end_date',
'        FROM cgct_pp_project_wave w',
'        WHERE w.prj_id = :P999_PRJ_ID',
'',
'        UNION ALL',
'',
'        SELECT',
'            p.project_phase_id AS id,',
'            p.wave_id AS parent_id,',
'            p.phase_display_name AS task_name,',
'            p.task_number,',
'            p.start_date,',
'            p.end_date',
'        FROM cgct_pp_project_phase p',
'        WHERE p.project_id = :P999_PRJ_ID',
'          AND p.reference_phase_id IS NULL',
'',
'        UNION ALL',
'',
'        SELECT',
'            sp.project_phase_id AS id,',
'            sp.reference_phase_id AS parent_id,',
'            sp.phase_display_name AS task_name,',
'            sp.task_number,',
'            sp.start_date,',
'            sp.end_date',
'        FROM cgct_pp_project_phase sp',
'        WHERE sp.project_id = :P999_PRJ_ID',
'          AND sp.reference_phase_id IS NOT NULL',
'    )',
'    START WITH parent_id IS NULL',
'    CONNECT BY PRIOR id = parent_id',
'),',
'tasks AS (',
'    SELECT',
'        XMLELEMENT(',
'            "task",',
'            XMLATTRIBUTES(',
'                id AS "id",',
'                task_name AS "text",',
'                TO_CHAR(start_date, ''yyyy-mm-dd'') AS "start_date",',
'                TO_CHAR(end_date - start_date, ''TM9'',',
'                    ''nls_numeric_characters=''''.,'''''') AS "duration",',
'                NVL(parent_id, 0) AS "parent",',
'                ''true'' AS "open",',
'                task_number AS "task_number",',
'                level_no AS "level"',
'            )',
'        ) AS task_xml',
'    FROM node_tree',
'),',
'links AS (',
'    SELECT NULL AS link_xml FROM dual WHERE 1 = 0',
'),',
'holidays AS (',
'    SELECT NULL AS holiday_xml FROM dual WHERE 1 = 0',
'),',
'special_urls AS (',
'    SELECT',
'        XMLELEMENT(',
'            "task_create_url_no_child",',
'            XMLATTRIBUTES(',
'                apex_util.prepare_url(',
'                    p_url => ''f?p='' || :app_id || '':21:'' || :app_session || '':::21'',',
'                    p_triggering_element => ''apex.jQuery("#my_gantt")''',
'                ) AS "url"',
'            )',
'        ) AS special_url_xml',
'    FROM dual',
')',
'SELECT XMLSERIALIZE(',
'         DOCUMENT',
'         XMLELEMENT(',
'             "data",',
'             (SELECT XMLAGG(task_xml) FROM tasks),',
'             (SELECT XMLAGG(link_xml) FROM links),',
'             (SELECT XMLAGG(holiday_xml) FROM holidays),',
'             (SELECT XMLAGG(special_url_xml) FROM special_urls)',
'         )',
'         INDENT',
'       ) AS single_clob_result',
'FROM dual;'))
