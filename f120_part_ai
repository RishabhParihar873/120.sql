'BEGIN',
'    -- Open the file in write mode',
'    l_file := UTL_FILE.fopen(l_dir, l_filename, ''w'', 32767);',
'    ',
'    -- Write CSV header',
'    UTL_FILE.put_line(l_file, ''Column 1,Column 2,Column 3'');',
'    ',
'    -- Open a cursor to fetch the data',
'    OPEN l_cursor FOR ''SELECT col1, col2, col3 FROM your_table'';',
'    ',
'    -- Loop through the cursor and write each row to the CSV file',
'    LOOP',
'        FETCH l_cursor INTO l_col1, l_col2, l_col3;',
'        EXIT WHEN l_cursor%NOTFOUND;',
'        ',
'        UTL_FILE.put_line(l_file, l_col1 || '','' || l_col2 || '','' || l_col3);',
