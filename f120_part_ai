wwv_flow_imp_page.create_page_plug(
 p_id=>wwv_flow_imp.id(827606640193114479)
,p_plug_name=>'KDD for Workshop'
,p_static_id=>'kdd-for-workshop'
,p_region_name=>'KDD'
,p_parent_plug_id=>wwv_flow_imp.id(1140240630110891390)
,p_region_template_options=>'#DEFAULT#'
,p_plug_template=>2100526641005906379
,p_plug_display_sequence=>70
,p_plug_display_point=>'SUB_REGIONS'
,p_plug_item_display_point=>'ABOVE'
,p_query_type=>'SQL'
,p_plug_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'select ID,',
'       id as id1,',
'       KDD_ID,',
'       PRJ_ID,',
'       TOPIC_NAME,',
'       DESCRIPTION,',
'       GUIDELINE_NOTE,',
'       MILESTONE_NAME,',
'       L3_ID,',
'       (',
'        --    SELECT LISTAGG(WORKSHOP_NAME, '', '') WITHIN GROUP (ORDER BY WORKSHOP_NAME)',
'        -- FROM CGCT_PP_WORKSHOP',
'         SELECT LISTAGG(WORKSHOP_NAME, ''<br>'') WITHIN GROUP (ORDER BY WORKSHOP_NAME)',
'         FROM CGCT_PP_WORKSHOP',
'        WHERE WORKSHOP_ID IN (',
'            SELECT WORKSHOP_ID',
'            FROM CGCT_L3_WORKSHOP',
'            WHERE L3_ID = k.L3_ID',
'              AND PRJ_ID = k.PRJ_ID',
'              AND PHASE_ID = k.PHASE_ID',
'            --   AND UPPER(TRACK) = UPPER(''O2C'')',
'        )) AS Workshop_name,',
'',
'       (SELECT CASE WHEN LENGTH(WORKSHOP_NAME) > 40 THEN SUBSTR(WORKSHOP_NAME, 1, INSTR(WORKSHOP_NAME || '' '', '' '', ROUND(LENGTH(WORKSHOP_NAME) / 2)) - 1) || ''<br>'' || ',
'     SUBSTR(WORKSHOP_NAME, INSTR(WORKSHOP_NAME || '' '', '' '', ROUND(LENGTH(WORKSHOP_NAME) / 2)) + 1) ELSE WORKSHOP_NAME END AS WORKSHOP_NAME_SPLIT FROM CGCT_PP_WORKSHOP where WORKSHOP_ID =k.WORKSHOP_ID) as Workshop_name_for_display,',
'       CREATION_DATE,',
'       CREATED_BY,',
'       LAST_UPDATE_DATE,',
'       LAST_UPDATE_BY,',
'       ACTIVE_FLAG,',
'       PHASE_ID,',
'       STORY_POINTS,',
'       ESTIMATION_HOURS,',
'       SIZING,',
'       COPY_FLAG,',
'       WORKSHOP_ID,',
'       ANSWERS,',
'       DECISION_AGREED,',
'       CAPGEMINI_RECOMMENDATION,',
'      DECISION_OWNER,',
'    --    CGCT_COMMON_PKG.get_kdd_avl(P_CALL_FROM => ''PROJECT'', P_ID => ID) Story_Source,',
'    --    CGCT_COMMON_PKG.get_avl_icon(p_str => CGCT_COMMON_PKG.get_kdd_avl(P_CALL_FROM => ''PROJECT'', P_ID => ID)) icon,',
'',
'    --  case CGCT_COMMON_PKG.get_kdd_avl(P_CALL_FROM => ''PROJECT'', P_ID => ID) ',
'    -- when ''Y_Y_Y''',
'    -- then ',
'    --        null',
'',
'    --        else',
'',
'    --         APEX_PAGE.GET_URL (',
'    --         p_page   => 305,',
'    --         p_items  => ''P305_ID'',',
'    --         p_values => ''''||ID||'''') ',
'  ',
'                     ',
'    --                      end link_url,',
'                     ED_COMPLETION,',
'                                CLIENT_SIGN_OFF',
'',
'  from CGCT_PRJ_KEY_DECISION_DOCS k',
' where PRJ_ID = :P1092_PROJECT_ID',
'AND PHASE_ID = :P1092_PHASE_ID ',
'--AND Application_Id =:P0_APP_ID',
'AND NVL(k.WORKSHOP_ID,:P1092_WORKSHOP_ID) = :P1092_WORKSHOP_ID',
'AND  L3_ID in (SELECT M.L3_ID  ',
'                FROM CGCT_PRJ_DOMAIN_PROCESS_MAP_V M ',
'                WHERE M.L1_ID  = NVL(:P1092_L1_PROCESS,M.L1_ID)',
'                AND   M.L2_ID  = NVL(:P1092_L2_PROCESS,M.L2_ID)',
