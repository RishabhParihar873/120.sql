,p_template=>4072358936313175081
,p_display_sequence=>140
,p_region_template_options=>'#DEFAULT#:t-Region--scrollBody'
,p_component_template_options=>'#DEFAULT#:t-Report--altRowsDefault:t-Report--rowHighlight'
,p_source_type=>'NATIVE_SQL_REPORT'
,p_query_type=>'SQL'
,p_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'WITH stg AS (',
'        SELECT 1 AS ord, ''Validating''    AS nm FROM dual UNION ALL',
'        SELECT 2, ''Initializing''              FROM dual UNION ALL',
'        SELECT 3, ''Parsing''                   FROM dual UNION ALL',
'        SELECT 4, ''KB Creating''               FROM dual UNION ALL',
'        SELECT 5, ''Web Gathering''             FROM dual UNION ALL',
'        SELECT 6, ''Generating''                FROM dual UNION ALL',
'        SELECT 7, ''Evaluating''                FROM dual UNION ALL',
'        SELECT 8, ''Editing''                   FROM dual UNION ALL',
'        SELECT 9, ''Persisting''                FROM dual',
'     ),',
'     ex AS (',
'        -- ponytail: newest 20 only. A project with more concurrent runs than',
'        -- that is not a real workflow; the full list lives in Region 2.',
'        SELECT e.id,',
'               e.execution_id,',
'               e.status,',
'               NVL(e.progress_pct, 0) AS pct,',
'               e.error_message,',
'               e.created_date,',
'               e.updated_date,',
'               -- Current stage ordinal. KB CREATING / WEB GATHERING are',
'               -- display-only (the DB CHECK constraint forbids storing them),',
unistr('               -- so they can never be the current status \2014 they light up purely'),
'               -- by position. FAILED/CANCELLED have no recorded stage, so infer',
'               -- it from progress_pct.',
'               CASE e.status',
'                   WHEN ''RECEIVED''     THEN 0',
'                   WHEN ''VALIDATING''   THEN 1',
'                   WHEN ''INITIALIZING'' THEN 2',
'                   WHEN ''PARSING''      THEN 3',
'                   WHEN ''GENERATING''   THEN 6',
'                   WHEN ''EVALUATING''   THEN 7',
'                   WHEN ''EDITING''      THEN 8',
'                   WHEN ''PERSISTING''   THEN 9',
'                   WHEN ''COMPLETED''    THEN 10',
'                   ELSE GREATEST(1, LEAST(9, CEIL(NVL(e.progress_pct, 0) * 9 / 100)))',
'               END AS cur_ord',
'        FROM   CGCT_ICTAI_PRJUSREXE e',
'        WHERE  e.project_id = :P1064_PRJ_ID',
'        ORDER  BY e.created_date DESC',
'        FETCH FIRST 20 ROWS ONLY',
'     ),',
'     ex2 AS (',
'        SELECT x.*,',
'               CASE WHEN x.status = ''COMPLETED''                THEN ''is-done''',
'                    WHEN x.status IN (''FAILED'',''CANCELLED'')    THEN ''is-fail''',
'                    ELSE ''is-run''',
'               END AS badge_class,',
'               CASE WHEN x.status = ''COMPLETED'' THEN 100 ELSE x.pct END AS bar_pct,',
'               ( SELECT LISTAGG(',
'                          ''<span class="ictai-stage ''',
'                          || CASE',
'                               WHEN x.status = ''COMPLETED''                        THEN ''is-done''',
'                               WHEN x.status IN (''FAILED'',''CANCELLED'')',
'                                    AND s.ord = x.cur_ord                         THEN ''is-failed''',
'                               WHEN x.status IN (''FAILED'',''CANCELLED'')',
'                                    AND s.ord > x.cur_ord                         THEN ''is-pending''',
'                               WHEN s.ord < x.cur_ord                             THEN ''is-done''',
'                               WHEN s.ord = x.cur_ord                             THEN ''is-active''',
'                               ELSE ''is-pending''',
'                             END',
'                          || ''">'' || s.nm || ''</span>''',
'                        ) WITHIN GROUP (ORDER BY s.ord)',
'                 FROM   stg s ) AS stages_html',
'        FROM   ex x',
'     )',
'SELECT id,',
'       execution_id,',
'       status,',
'          ''<div class="ictai-card">''',
'       || ''<div class="ictai-card-head">''',
'       ||   ''<span class="ictai-exec">'' || apex_escape.html(execution_id) || ''</span>''',
'       ||   ''<span class="ictai-badge '' || badge_class || ''">''',
'       ||        apex_escape.html(NVL(status, ''UNKNOWN'')) || ''</span>''',
'       || ''</div>''',
'       || ''<div class="ictai-stages">'' || stages_html || ''</div>''',
'       -- NLS-safe: the CSS width and the label must both use "." as the decimal',
'       -- separator. A session with NLS_NUMERIC_CHARACTERS='',.'' (any European',
'       -- locale) would otherwise emit style="width:42,5%" and every progress',
'       -- bar in the app would silently render at zero width.',
'       || ''<div class="ictai-bar"><div class="ictai-bar-fill ''',
'       ||        CASE WHEN status = ''COMPLETED''             THEN ''is-done''',
'                      WHEN status IN (''FAILED'',''CANCELLED'') THEN ''is-fail''',
'                      ELSE '''' END',
'       ||        ''" style="width:''',
'       ||        TO_CHAR(bar_pct, ''FM990D99'', ''NLS_NUMERIC_CHARACTERS=''''.,'''''')',
'       ||        ''%"></div></div>''',
'       || ''<div class="ictai-meta">''',
'       ||        TO_CHAR(bar_pct, ''FM990D99'', ''NLS_NUMERIC_CHARACTERS=''''.,'''''')',
'       ||        ''% complete &middot; started ''',
'       ||        TO_CHAR(created_date, ''DD-Mon-YYYY HH24:MI'')',
'       ||        CASE WHEN updated_date IS NOT NULL',
'                      THEN '' &middot; updated '' || TO_CHAR(updated_date, ''HH24:MI:SS'')',
'                      ELSE '''' END',
'       || ''</div>''',
'       || CASE WHEN error_message IS NOT NULL',
'               THEN ''<div class="ictai-err">'' || apex_escape.html(error_message) || ''</div>''',
'               ELSE '''' END',
'       || CASE WHEN status = ''COMPLETED''',
'               THEN ''<div class="ictai-dl"><button type="button" class="t-Button t-Button--small t-Button--hot"''',
'                    -- js_literal, not escape_sc: this value lands inside a',
'                    -- single-quoted JavaScript string, not in HTML text. Only',
'                    -- js_literal escapes the backslash and quote sequences that',
'                    -- can terminate that string early.',
'                    || '' onclick="ictaiDownload('' || apex_escape.js_literal(execution_id, '''''''') || '')">''',
'                    || ''Download result</button></div>''',
'               ELSE '''' END',
'       || ''</div>'' AS card_html',
'FROM   ex2',
'ORDER  BY created_date DESC',
''))
