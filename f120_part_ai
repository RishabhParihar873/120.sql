,p_plug_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'SELECT',
'    cppl.Task_number,',
'    cppl.task_name,',
'    cppl.planned_start,',
'    cppl.planned_end,',
'    -- APEX_ESCAPE.HTML(cppl.TASK_NAME) AS ESCAPED_TASK_NAME,',
'    cppl.TASK_NAME AS ESCAPED_TASK_NAME,',
'    cppl.project_plan_line_id,',
'    cppl.project_plan_id,',
'    cppl.Type,',
'    cppl.efforts,',
'    cppl.actual_start,',
'    cppl.actual_end,',
'    cppl.completion_percentage,',
'    ''<div class="ig-progress-wrap">',
'    <div class="ig-progress-track">',
'        <div class="ig-progress-fill" style="width:''||',
'        NVL(cppl.completion_percentage,0)||',
'        ''%;"></div>',
'    </div>',
'    <span class="ig-progress-text">''||',
'    NVL(cppl.completion_percentage,0)||',
'    ''%</span>',
'    </div>'' AS completion_percentages,',
'    cppl.Allocation_percentage,',
'    cppl.duration,',
'    cppl.wave_id,',
'    cppl.prj_id,',
'    cppl.phase_id,',
'    cppl.subphase_id,',
'    cppl.status,',
'    CASE',
'    WHEN cppl.status = ''COMPLETED'' THEN',
'        ''<span class="status-pill completed">COMPLETED</span>''',
'    WHEN cppl.status = ''WIP'' THEN',
'        ''<span class="status-pill wip">WIP</span>''',
'    WHEN cppl.status = ''HOLD'' THEN',
'        ''<span class="status-pill hold">HOLD</span>''',
'    WHEN cppl.status = ''CANCELLED'' THEN',
'        ''<span class="status-pill cancelled">CANCELLED</span>''',
'    WHEN cppl.status = ''NOT STARTED'' THEN',
'        ''<span class="status-pill notstarted">NOT STARTED</span>''',
'    ELSE',
'        cppl.status',
'    END AS pstatus,',
'    --cppl.comments',
'    ''<span class="hover-text" title="'' || cppl.comments || ''">'' || cppl.comments || ''</span>'' AS comments',
'    -- ''NULL'' as TEST_Page',
'FROM',
'    cgct_pp_plan_line cppl',
' ',
'JOIN ',
'    cgct_project_grant G',
'ON',
'    G.PROJECT_ID=cppl.prj_id',
'WHERE ',
'    cppl.project_plan_id = (',
'        SELECT project_plan_id',
'        FROM cgct_pp_project_plan',
'        WHERE project_id =:P1065_NEWS',
'         and status=''Y''',
'    )  and ',
'    G.GRANT_ID IN (SELECT GRANT_ID FROM CGCT_PROJECT_GRANT WHERE USER_ID =(SELECT USER_ID FROM CGCT_APP_USERS WHERE EMPLOYEE_ID =:P0_USER_ID))',
'    AND G.EMPLOYEE = ''Y''',
'    AND '':'' || cppl.assigned_to || '':'' LIKE ''%:'' || :P0_USER_ID || '':%''',
'    AND (',
'       :P1065_TASK_FILTER = ''ALL''',
'    OR (:P1065_TASK_FILTER = ''COMPLETED'' AND cppl.status = ''COMPLETED'')',
'    OR (:P1065_TASK_FILTER = ''WIP'' AND cppl.status = ''WIP'')',
'    OR (:P1065_TASK_FILTER = ''NOT STARTED'' AND cppl.status = ''NOT STARTED'')',
'    OR (:P1065_TASK_FILTER = ''OVERDUE''',
'        AND cppl.planned_end < TRUNC(SYSDATE)',
'        AND NVL(cppl.status,''X'') <> ''COMPLETED'')',
'    OR (:P1065_TASK_FILTER = ''DUE_WEEK''',
'        AND cppl.planned_end BETWEEN TRUNC(SYSDATE) AND TRUNC(SYSDATE)+7)',
')',
''))
