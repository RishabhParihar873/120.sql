,p_process_type=>'NATIVE_PLSQL'
,p_process_name=>'Process form tst_upload(This one Navin)_updated_2'
,p_static_id=>'process-form-tst-upload-this-one-navin-updated-2'
,p_process_sql_clob=>wwv_flow_string.join(wwv_flow_t_varchar2(
'DECLARE',
'    l_base_url     VARCHAR2(4000) := RTRIM(apex_app_setting.get_value(''REST_PIPELINE_BASE_URL''), ''/'');',
'    l_execution_id NUMBER;',
'    l_track_id     VARCHAR2(255);',
'    l_blob         BLOB;',
'    l_filename     VARCHAR2(255);',
'    l_mime_type    VARCHAR2(255);',
'    l_request      BLOB;',
'    l_response     CLOB;',
'    l_upload_ref   VARCHAR2(4000);',
'    l_template_ref VARCHAR2(4000);',
'    l_template_path VARCHAR2(4000);',
'    l_template_name VARCHAR2(4000);',
'    l_template_url VARCHAR2(4000);',
'    l_template_blob BLOB;',
'    l_user_id      NUMBER;',
'    l_body         CLOB;',
'    l_boundary     VARCHAR2(80) := ''----APEX'' || RAWTOHEX(SYS_GUID());',
'    l_part         RAW(32767);',
'    l_api_key      VARCHAR2(4000);',
'    l_session_id   VARCHAR2(255);',
'    l_deliverable_id CGCT_DELIVERABLE_API_DOCUMENT.DELIVERABLE_ID%TYPE;',
'',
'    PROCEDURE free_lobs IS',
'    BEGIN',
'        IF l_request IS NOT NULL AND DBMS_LOB.ISTEMPORARY(l_request) = 1 THEN',
'            DBMS_LOB.FREETEMPORARY(l_request);',
'        END IF;',
'        IF l_template_blob IS NOT NULL AND DBMS_LOB.ISTEMPORARY(l_template_blob) = 1 THEN',
'            DBMS_LOB.FREETEMPORARY(l_template_blob);',
'        END IF;',
'    END free_lobs;',
'BEGIN',
'    IF l_base_url IS NULL THEN',
'        RAISE_APPLICATION_ERROR(-20001, ''Configure REST_PIPELINE_BASE_URL in Application Settings'');',
'    END IF;',
'',
'    -- HARD GATE, and deliberately the first thing this process does.',
'    -- start_llm_session resolves the stored GenAI key (this user first, then the',
'    -- project), exchanges it at POST /api/v1/sessions and returns an opaque',
'    -- session id. It raises:',
unistr('    --   -20301  no key stored for this user or project \2014 "set one, then submit"'),
unistr('    --   -20302  the stored key was rejected by GenAI   \2014 replace it, do not retry'),
'    -- Both fire BEFORE the sequence below, so a missing or dead key costs no',
'    -- sequence value, no upload and no tracking row. The exchange is also free',
'    -- validation: the backend checks the key here instead of 40 minutes into a',
'    -- run that could only ever produce nothing.',
'    l_session_id := cgct_ictai_keys.start_llm_session(:P1032_PRJ_ID, :P0_USER_ID_EMAIL);',
'',
'    -- Caller key for the gateway. Decrypted once per submit and assigned only to',
'    -- a request header.',
'    l_api_key := cgct_ictai_keys.app_key;',
'',
'    SELECT ICT_PROJECT_SEQ.NEXTVAL INTO l_execution_id FROM dual;',
'    :P1032_GENERATED_PROJECT_ID := l_execution_id;',
'',
'    SELECT blob_content, filename, mime_type',
'      INTO l_blob, l_filename, l_mime_type',
'      FROM apex_application_temp_files',
'     WHERE name = :P1032_BLOB_CONTENT OR filename = :P1032_BLOB_CONTENT',
'     FETCH FIRST 1 ROW ONLY;',
'',
'    DBMS_LOB.CREATETEMPORARY(l_request, TRUE);',
'    l_part := UTL_RAW.CAST_TO_RAW(''--'' || l_boundary || CHR(13) || CHR(10) ||',
'        ''Content-Disposition: form-data; name="file"; filename="'' || REPLACE(l_filename, ''"'', '''') || ''"'' || CHR(13) || CHR(10) ||',
'        ''Content-Type: '' || NVL(l_mime_type, ''application/octet-stream'') || CHR(13) || CHR(10) || CHR(13) || CHR(10));',
'    DBMS_LOB.WRITEAPPEND(l_request, UTL_RAW.LENGTH(l_part), l_part);',
'    DBMS_LOB.APPEND(l_request, l_blob);',
'    l_part := UTL_RAW.CAST_TO_RAW(CHR(13) || CHR(10) || ''--'' || l_boundary || ''--'' || CHR(13) || CHR(10));',
'    DBMS_LOB.WRITEAPPEND(l_request, UTL_RAW.LENGTH(l_part), l_part);',
'',
'    apex_web_service.g_request_headers.DELETE;',
'    apex_web_service.g_request_headers(1).name  := ''Content-Type'';',
'    apex_web_service.g_request_headers(1).value := ''multipart/form-data; boundary='' || l_boundary;',
'    apex_web_service.g_request_headers(2).name  := ''X-API-Key'';',
'    apex_web_service.g_request_headers(2).value := l_api_key;',
'    l_response := apex_web_service.make_rest_request(',
'        p_url => l_base_url || ''/api/v1/uploads'', p_http_method => ''POST'', p_body_blob => l_request);',
'    IF apex_web_service.g_status_code <> 201 THEN',
'        RAISE_APPLICATION_ERROR(-20002, ''Upload failed (HTTP '' || apex_web_service.g_status_code || ''): '' || DBMS_LOB.SUBSTR(l_response, 1500, 1));',
'    END IF;',
'    l_upload_ref := JSON_VALUE(l_response, ''$.ref'');',
'',
'    SELECT template_file_path, template_file_name',
'      INTO l_template_path, l_template_name',
'      FROM cgct_project_templates WHERE id = :P1032_TEMPLATE_ID;',
'    SELECT RTRIM(v.description, ''/'') || ''/'' || LTRIM(l_template_path, ''/'')',
'      INTO l_template_url FROM cgct_lookup_v v',
'     WHERE v.lookup_type = ''FILE_INTEGRATION_SETUP'' AND v.code = ''ITEM_URL''',
'     FETCH FIRST 1 ROW ONLY;',
'    -- Object-storage fetch: no ICT AI credential here, this is not the gateway.',
'    apex_web_service.g_request_headers.DELETE;',
'    l_template_blob := apex_web_service.make_rest_request_b(p_url => l_template_url, p_http_method => ''GET'');',
'    IF apex_web_service.g_status_code <> 200 THEN',
'        RAISE_APPLICATION_ERROR(-20003, ''Template download failed (HTTP '' || apex_web_service.g_status_code || '')'');',
'    END IF;',
'',
'    DBMS_LOB.FREETEMPORARY(l_request);',
'    DBMS_LOB.CREATETEMPORARY(l_request, TRUE);',
'    l_boundary := ''----APEX'' || RAWTOHEX(SYS_GUID());',
'    l_part := UTL_RAW.CAST_TO_RAW(''--'' || l_boundary || CHR(13) || CHR(10) ||',
'        ''Content-Disposition: form-data; name="file"; filename="'' || REPLACE(l_template_name, ''"'', '''') || ''"'' || CHR(13) || CHR(10) ||',
'        ''Content-Type: application/octet-stream'' || CHR(13) || CHR(10) || CHR(13) || CHR(10));',
'    DBMS_LOB.WRITEAPPEND(l_request, UTL_RAW.LENGTH(l_part), l_part);',
'    DBMS_LOB.APPEND(l_request, l_template_blob);',
'    l_part := UTL_RAW.CAST_TO_RAW(CHR(13) || CHR(10) || ''--'' || l_boundary || ''--'' || CHR(13) || CHR(10));',
'    DBMS_LOB.WRITEAPPEND(l_request, UTL_RAW.LENGTH(l_part), l_part);',
'    apex_web_service.g_request_headers.DELETE;',
'    apex_web_service.g_request_headers(1).name  := ''Content-Type'';',
'    apex_web_service.g_request_headers(1).value := ''multipart/form-data; boundary='' || l_boundary;',
'    apex_web_service.g_request_headers(2).name  := ''X-API-Key'';',
'    apex_web_service.g_request_headers(2).value := l_api_key;',
'    l_response := apex_web_service.make_rest_request(',
'        p_url => l_base_url || ''/api/v1/uploads'', p_http_method => ''POST'', p_body_blob => l_request);',
'    IF apex_web_service.g_status_code <> 201 THEN',
'        RAISE_APPLICATION_ERROR(-20004, ''Template upload failed (HTTP '' || apex_web_service.g_status_code || ''): '' || DBMS_LOB.SUBSTR(l_response, 1500, 1));',
'    END IF;',
'    l_template_ref := JSON_VALUE(l_response, ''$.ref'');',
'',
'    -- Template bytes are no longer needed once the multipart body is built.',
'    DBMS_LOB.FREETEMPORARY(l_template_blob);',
'',
'    l_body := JSON_OBJECT(',
'        ''execution_id'' VALUE l_execution_id,',
'        ''template_id'' VALUE TO_CHAR(:P1032_TEMPLATE_ID),',
'        ''template_ref'' VALUE l_template_ref,',
'        ''consolidated_prompt'' VALUE JSON_OBJECT(',
'            ''project_id'' VALUE :P1032_PRJ_ID,',
'            ''task'' VALUE :P1032_TASK_NAME,',
'            ''phase'' VALUE :P1032_PHASE,',
'            ''workstream'' VALUE :P1032_WORKSTREAM,',
'            ''role'' VALUE :P1032_ROLE),',
'        ''input_documents'' VALUE JSON_ARRAY(JSON_OBJECT(',
'            ''path'' VALUE l_upload_ref, ''name'' VALUE l_filename, ''mime_type'' VALUE l_mime_type)),',
'        ''session_id'' VALUE l_session_id,',
'        ''options'' VALUE JSON_OBJECT(''output_format'' VALUE ''DOCX'') );',
'',
'    -- The session id was minted at the top of this block. If the orchestrator has',
'    -- restarted since, that id is already dead (its session store is in-process',
'    -- and deliberately not persisted) and this POST returns 401. Re-mint once and',
'    -- retry once; a second 401 is a real failure, not a stale session.',
'    FOR l_attempt IN 1 .. 2 LOOP',
'        apex_web_service.g_request_headers.DELETE;',
'        apex_web_service.g_request_headers(1).name  := ''Content-Type'';',
'        apex_web_service.g_request_headers(1).value := ''application/json'';',
'        apex_web_service.g_request_headers(2).name  := ''X-API-Key'';',
'        apex_web_service.g_request_headers(2).value := l_api_key;',
'',
'        l_response := apex_web_service.make_rest_request(',
'            p_url => l_base_url || ''/api/v1/executions'', p_http_method => ''POST'', p_body => l_body);',
'',
'        EXIT WHEN apex_web_service.g_status_code = 202;',
'',
'        IF apex_web_service.g_status_code = 401 AND l_attempt = 1 THEN',
unistr('            apex_debug.info(''P1032: executions POST returned 401 \2014 re-minting the key session and retrying once.'');'),
'            l_session_id := cgct_ictai_keys.start_llm_session(:P1032_PRJ_ID, :P0_USER_ID_EMAIL);',
'            -- l_body := JSON_TRANSFORM(l_body, SET ''$.session_id'' VALUE l_session_id);',
'            SELECT JSON_TRANSFORM(l_body, SET ''$.session_id'' = l_session_id) ',
'INTO l_body ',
'FROM dual;',
'',
'        ELSE',
'            RAISE_APPLICATION_ERROR(-20005, ''Execution submission failed (HTTP '' || apex_web_service.g_status_code || ''): '' || DBMS_LOB.SUBSTR(l_response, 1500, 1));',
'        END IF;',
'    END LOOP;',
'',
'    -- The whole polling chain keys off whatever id the BACKEND considers',
'    -- authoritative. We propose ICT_PROJECT_SEQ.NEXTVAL in the request body, but',
'    -- if the 202 response carries its own id, that is the one every subsequent',
unistr('    -- GET /api/v1/executions/{id} must use \2014 so prefer it and ignore ours for'),
'    -- tracking. Verify against the live gateway during smoke test (see',
'    -- DEPLOYMENT.md Step 9): if the response id never matches what we sent,',
'    -- the backend is assigning ids and this branch is what makes polling work.',
'    l_track_id := COALESCE(',
'                      JSON_VALUE(l_response, ''$.execution_id''),',
'                      JSON_VALUE(l_response, ''$.id''),',
'                      TO_CHAR(l_execution_id));',
'',
'                      apex_debug.info(',
'    ''P1032 local execution ID: %s'',',
'    TO_CHAR(l_execution_id)',
');',
'',
'apex_debug.info(',
'    ''P1032 backend execution ID: %s'',',
'    l_track_id',
');',
'',
'apex_debug.info(',
'    ''P1032 project plan line ID: %s'',',
'    TO_CHAR(:P1032_PROJECT_PLAN_LINE_ID)',
');',
'',
'    IF l_track_id != TO_CHAR(l_execution_id) THEN',
'        apex_debug.info(''P1032: backend assigned its own execution id; tracking that instead of the sequence value.'');',
'    END IF;',
'',
'    -- -------------------------------------------------------------------------',
'    -- Persist to CGCT_DELIVERABLE_API_DOCUMENT (+ new ICTAI columns)',
'    -- -------------------------------------------------------------------------',
'    -- MERGE INTO CGCT_DELIVERABLE_API_DOCUMENT t',
'    -- USING (SELECT :P1032_PROJECT_PLAN_LINE_ID plan_line_id FROM dual) s',
'    --    ON (t.PROJECT_PLAN_LINE_ID = s.plan_line_id)',
'    -- WHEN MATCHED THEN UPDATE SET',
'    --     t.GENERATED_PROJECT_ID = l_execution_id,',
'    --     t.GENERATION_STATUS    = ''RECEIVED'',',
'    --     t.GENERATED_ON         = SYSDATE,',
'    --     t.COMPLETED_ON         = NULL,',
'    --     t.ICTAI_EXECUTION_ID   = l_track_id,                 -- NEW column',
'    --     t.PROGRESS_PCT         = 0                           -- NEW column',
'    -- WHEN NOT MATCHED THEN INSERT',
'    --     (PROJECT_PLAN_LINE_ID, GENERATED_PROJECT_ID, GENERATION_STATUS,',
'    --      GENERATED_ON, TYPE, BASELINED, ICTAI_EXECUTION_ID, PROGRESS_PCT)',
'    -- VALUES',
'    --     (s.plan_line_id, l_execution_id, ''RECEIVED'',',
'    --      SYSDATE, ''AI'', ''Y'', l_track_id, 0);',
'',
'DECLARE',
'    l_existing_plan_line_id',
'        CGCT_DELIVERABLE_API_DOCUMENT.PROJECT_PLAN_LINE_ID%TYPE;',
'BEGIN',
'    -- Validate the execution ID returned by the API.',
'    IF l_track_id IS NULL THEN',
'        RAISE_APPLICATION_ERROR(',
'            -20006,',
'            ''The API did not return an execution ID.''',
'        );',
'    END IF;',
'',
'    -- ICTAI_EXECUTION_ID is numeric, so reject a non-numeric value.',
'    IF NOT REGEXP_LIKE(l_track_id, ''^[0-9]+$'') THEN',
'        RAISE_APPLICATION_ERROR(',
'            -20007,',
'            ''The API returned an invalid execution ID: '' || l_track_id',
'        );',
'    END IF;',
'',
'    /*',
'      Check whether this API execution ID is already assigned',
'      to a different project-plan line.',
'    */',
'    BEGIN',
'        SELECT PROJECT_PLAN_LINE_ID',
'          INTO l_existing_plan_line_id',
'          FROM CGCT_DELIVERABLE_API_DOCUMENT',
'         WHERE ICTAI_EXECUTION_ID = TO_NUMBER(l_track_id);',
'',
'        IF NVL(l_existing_plan_line_id, -1)',
'           <> NVL(:P1032_PROJECT_PLAN_LINE_ID, -1)',
'        THEN',
'            RAISE_APPLICATION_ERROR(',
'                -20008,',
'                ''Execution ID '' || l_track_id ||',
'                '' is already assigned to project plan line '' ||',
'                l_existing_plan_line_id ||',
'                ''. The API returned a duplicate execution ID.''',
'            );',
'        END IF;',
'',
'    EXCEPTION',
'        WHEN NO_DATA_FOUND THEN',
'            NULL;',
'    END;',
'',
'    MERGE INTO CGCT_DELIVERABLE_API_DOCUMENT t',
'    USING (',
'        SELECT :P1032_PROJECT_PLAN_LINE_ID AS PLAN_LINE_ID',
'          FROM dual',
'    ) s',
'    ON (',
'        -- t.PROJECT_PLAN_LINE_ID = s.PLAN_LINE_ID',
'        t.DELIVERABLE_ID=10000',
'    )',
'    WHEN MATCHED THEN',
'        UPDATE SET',
'            t.GENERATED_PROJECT_ID = l_execution_id,',
'            t.GENERATION_STATUS    = ''RECEIVED'',',
'            t.GENERATED_ON         = SYSDATE,',
'            t.COMPLETED_ON         = NULL,',
'            t.ICTAI_EXECUTION_ID   = TO_NUMBER(l_track_id),',
'            t.PROGRESS_PCT         = 0',
'    WHEN NOT MATCHED THEN',
'        INSERT (',
'            DELIVERABLE_ID,',
'            CREATED_BY,',
'            PROJECT_PLAN_LINE_ID,',
'            GENERATED_PROJECT_ID,',
'            GENERATION_STATUS,',
'            GENERATED_ON,',
'            TYPE,',
'            BASELINED,',
'            ICTAI_EXECUTION_ID,',
'            PROGRESS_PCT',
'        )',
'        VALUES (',
'            NULL,',
'            :P0_USER_ID_EMAIL,',
'            s.PLAN_LINE_ID,',
'            l_execution_id,',
'            ''RECEIVED'',',
'            SYSDATE,',
'            ''AI'',',
'            ''Y'',',
'            TO_NUMBER(l_track_id),',
'            0',
'        )',
'            RETURNING DELIVERABLE_ID',
'         INTO l_deliverable_id;',
'',
'    APEX_DEBUG.MESSAGE(',
'        ''Inserted deliverable ID='' ||',
'        l_deliverable_id',
'    );',
'',
'',
'EXCEPTION',
'    WHEN DUP_VAL_ON_INDEX THEN',
'        RAISE_APPLICATION_ERROR(',
'            -20009,',
'            ''Execution ID '' || l_track_id ||',
'            '' already exists in CGCT_DELIVERABLE_API_DOCUMENT. '' ||',
'            ''Please check whether the backend returned an old execution ID.''',
'        );',
'END;',
'',
'--          raise_application_error(',
'--   -20011,',
'--   dbms_lob.substr(l_response,4000,1)',
'-- );',
'',
'    -- -------------------------------------------------------------------------',
'    -- NEW: track in CGCT_ICTAI_PRJUSREXE',
'    -- -------------------------------------------------------------------------',
'    -- USER_ID is a reporting attribute, not a gate. An APP_USER with no row in',
'    -- CGCT_APP_USERS (SSO alias, admin, renamed mailbox) previously produced a',
'    -- silent NULL that collapsed every such execution into one "(no user)"',
'    -- bucket on the P1050 summary. Resolve it explicitly and log the miss.',
'    BEGIN',
'        SELECT user_id INTO l_user_id',
'        FROM   CGCT_APP_USERS',
'        WHERE  UPPER(USER_ID) = UPPER(:P0_USER_ID_EMAIL)',
'        FETCH FIRST 1 ROW ONLY;',
'    EXCEPTION',
'        WHEN NO_DATA_FOUND THEN',
'            l_user_id := NULL;',
'            apex_debug.warn(''P1032: no CGCT_APP_USERS row for APP_USER; USER_ID left NULL.'');',
'    END;',
'',
'    INSERT INTO CGCT_ICTAI_PRJUSREXE (',
'        PROJECT_ID,',
'        USER_ID,',
'        TEMPLATE_ID,',
'        EXECUTION_ID,',
'        PROJECT_PLAN_LINE_ID,',
'        STATUS,',
'        PROGRESS_PCT,',
'        OUTPUT_REF,',
'        CREATED_BY,',
'        UPDATED_BY',
'    ) VALUES (',
'        :P1032_PRJ_ID,',
'        l_user_id,',
'        :P1032_TEMPLATE_ID,',
'        -- TO_NUMBER(:P1032_TEMPLATE),',
'        l_track_id,',
'        :P1032_PROJECT_PLAN_LINE_ID,',
'        ''RECEIVED'',',
'        0,',
'        UPPER(''DOCX''),      -- drives the download filename extension',
'        :P0_USER_ID_EMAIL,',
'        :P0_USER_ID_EMAIL',
'    );',
'',
'',
' DBMS_SCHEDULER.CREATE_JOB(',
'        job_name =>''JOB_VALIDATE_'' ||TO_CHAR(SYSTIMESTAMP,''YYYYMMDDHH24MISSFF6''),',
'        job_type =>''PLSQL_BLOCK'',',
'        job_action =>',
'            ''BEGIN RUN_POST_JOB_STATUS_UPDATED('' ||',
'            DBMS_ASSERT.ENQUOTE_LITERAL(l_track_id) || '','' ||',
'            TO_CHAR(l_deliverable_id) || '','' ||',
'            DBMS_ASSERT.ENQUOTE_LITERAL(''change-me'') ||',
'            ''); END;'',',
'        start_date =>SYSTIMESTAMP,',
'        enabled =>TRUE,',
'        auto_drop =>TRUE',
'    );',
'',
'    COMMIT;',
'    :P1032_PIPELINE_STATUS := ''RECEIVED'';',
'',
'    free_lobs;',
'EXCEPTION',
'    WHEN OTHERS THEN',
'        free_lobs;',
'        RAISE;',
'END;'))
,p_process_clob_language=>'PLSQL'
,p_error_display_location=>'INLINE_IN_NOTIFICATION'
,p_process_when_button_id=>wwv_flow_imp.id(431919495403907083)
,p_internal_uid=>15171205425153429
