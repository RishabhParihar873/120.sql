,p_process_sql_clob=>wwv_flow_string.join(wwv_flow_t_varchar2(
'DECLARE',
'    l_base_url CONSTANT VARCHAR2(4000) :=',
'        ''https://dh6xwvo4afth5wcsbydajlyyza.apigateway.us-chicago-1.oci.customer-oci.com/api/v1'';',
'',
'    l_doc_blob          BLOB;',
'    l_user_api_key      VARCHAR2(4000);',
'    p_temp_code         VARCHAR2(4000);',
'    p_temp_file_name    VARCHAR2(4000);',
'',
'    -- This must contain the backend execution ID',
'    l_execution_id  VARCHAR2(100) := :P1094_DOCUMENT_ID;',
'    -- l_execution_id  NUMBER := 400;',
'',
'',
'    l_url           VARCHAR2(4000);',
'    l_filename      VARCHAR2(255);',
'',
'BEGIN',
'    ------------------------------------------------------------------',
'    -- Validate execution ID',
'    ------------------------------------------------------------------',
'    IF l_execution_id IS NULL THEN',
'        RAISE_APPLICATION_ERROR(',
'            -20001,',
'            ''Execution ID is missing.''',
'        );',
'    END IF;',
'    ',
'    select TEMPLATE_CODE,TEMPLATE_FILE_NAME into p_temp_code,p_temp_file_name ',
'    FROM CGCT_PROJECT_TEMPLATES ',
'    WHERE ID in (select TEMPLATE_ID from CGCT_PP_PLAN_LINE where PROJECT_PLAN_LINE_ID=:P1094_PROJECT_PLAN_LINE_ID);',
'    ------------------------------------------------------------------',
'    -- Get the user''s API key',
'    ------------------------------------------------------------------',
'    l_user_api_key:=''change-me'';',
'    -- SELECT user_api_key',
'    --   INTO l_user_api_key',
'    --   FROM cgct_project_members',
'    --  WHERE project_id = :P1094_PRJ_ID',
'    --    AND project_member IN (',
'    --            SELECT employee_name',
'    --              FROM cgct_app_users',
'    --             WHERE user_id = :P1094_USER_ID',
'    --        )',
'    --  FETCH FIRST 1 ROW ONLY;',
'',
'    -- IF l_user_api_key IS NULL THEN',
'    --     RAISE_APPLICATION_ERROR(',
'    --         -20002,',
'    --         ''API key is not configured for the selected user.''',
'    --     );',
'    -- END IF;',
'',
'    ------------------------------------------------------------------',
'    -- Construct ZIP download URL',
'    ------------------------------------------------------------------',
'    l_url :=',
'           l_base_url',
'        || ''/executions/''',
'        || apex_util.url_encode(l_execution_id)',
'        || ''/download'';',
'',
'    -- l_filename :=',
'    --     ''Generated_output_'' || l_execution_id || ''.zip'';',
'',
'    -- l_filename :=',
'    --     ''Generated_Document_''|| p_temp_code || ''_'' || REGEXP_REPLACE(p_temp_file_name, ''\.[^.]*$'', '''') || l_execution_id || ''.zip'';',
'',
'    l_filename :=',
'    ''Generated_Document_'' ||',
'    p_temp_code || ''_'' ||',
'    REPLACE(',
'        REGEXP_REPLACE(p_temp_file_name, ''\.[^.]*$'', ''''),',
'        '' '',',
'        ''_''',
'    ) ||',
'    ''_'' ||',
'    l_execution_id ||',
'    ''.zip'';',
'',
'    apex_debug.info(',
'        ''P1094 ZIP download URL: %s'',',
'        l_url',
'    );',
'',
'    ------------------------------------------------------------------',
'    -- Set request headers',
'    ------------------------------------------------------------------',
'    apex_web_service.g_request_headers.DELETE;',
'',
'    apex_web_service.g_request_headers(1).name  := ''X-API-Key'';',
'    apex_web_service.g_request_headers(1).value := l_user_api_key;',
'',
'    apex_web_service.g_request_headers(2).name  := ''Accept'';',
'    apex_web_service.g_request_headers(2).value := ''application/zip'';',
'',
'    ------------------------------------------------------------------',
'    -- Download ZIP file',
'    ------------------------------------------------------------------',
'    l_doc_blob := apex_web_service.make_rest_request_b(',
'        p_url         => l_url,',
'        p_http_method => ''GET''',
'    );',
'',
'    ------------------------------------------------------------------',
'    -- Validate HTTP response',
'    ------------------------------------------------------------------',
'    IF apex_web_service.g_status_code <> 200 THEN',
'        RAISE_APPLICATION_ERROR(',
'            -20003,',
'            ''ZIP download failed. HTTP status: ''',
'            || apex_web_service.g_status_code',
'            || ''. URL: ''',
'            || l_url',
'        );',
'    END IF;',
'',
'    ------------------------------------------------------------------',
'    -- Validate downloaded ZIP',
'    ------------------------------------------------------------------',
'    IF l_doc_blob IS NULL',
'       OR DBMS_LOB.GETLENGTH(l_doc_blob) = 0',
'    THEN',
'        RAISE_APPLICATION_ERROR(',
'            -20004,',
'            ''The document service returned an empty ZIP file.''',
'        );',
'    END IF;',
'',
'    ------------------------------------------------------------------',
'    -- Return ZIP file to browser',
'    ------------------------------------------------------------------',
'    SYS.HTP.INIT;',
'',
'    OWA_UTIL.MIME_HEADER(',
'        ccontent_type => ''application/zip'',',
'        bclose_header => FALSE',
'    );',
'',
'    HTP.P(',
'        ''Content-Length: '' || DBMS_LOB.GETLENGTH(l_doc_blob)',
'    );',
'',
'    HTP.P(',
'        ''Content-Disposition: attachment; filename="''',
'        || l_filename',
'        || ''"''',
'    );',
'',
'    HTP.P(''Cache-Control: no-store, no-cache, must-revalidate'');',
'    HTP.P(''Pragma: no-cache'');',
'',
'    OWA_UTIL.HTTP_HEADER_CLOSE;',
'',
'    WPG_DOCLOAD.DOWNLOAD_FILE(l_doc_blob);',
'',
'    APEX_APPLICATION.STOP_APEX_ENGINE;',
'',
'EXCEPTION',
'    WHEN APEX_APPLICATION.E_STOP_APEX_ENGINE THEN',
'        RAISE;',
'',
'    WHEN NO_DATA_FOUND THEN',
'        RAISE_APPLICATION_ERROR(',
'            -20005,',
'            ''No API key was found for the selected project and user.''',
'        );',
'',
'    WHEN TOO_MANY_ROWS THEN',
'        RAISE_APPLICATION_ERROR(',
'            -20006,',
'            ''Multiple API-key records were found for the selected project and user.''',
'        );',
'',
'    WHEN OTHERS THEN',
'        APEX_DEBUG.ERROR(',
'            ''P1094 ZIP download error: %s'',',
'            SQLERRM',
'        );',
'        RAISE;',
'END;'))
