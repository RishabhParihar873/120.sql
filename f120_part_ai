'',
'apex_web_service.append_to_multipart(p_multipart => l_multipart, p_name => ''data'', p_content_type => ''text'', p_body => ''{ "filename" : "'' || l_full_path || ''", "bucket_name" : "ICT_Templates" }''); ',
' ',
'l_body := apex_web_service.generate_request_body(p_multipart => l_multipart); ',
' ',
'apex_web_service.g_request_headers(1).name := ''Authorization''; ',
' ',
'apex_web_service.g_request_headers(1).value := ''Basic U0NfT0lDVVNSOlNjb2ljcHJvZEBKYW4yMw==''; ',
' ',
'-- Add Content-Type header with value ''multipart/mixed'' ',
'apex_web_service.g_request_headers(2).name := ''Content-Type''; ',
' ',
'apex_web_service.g_request_headers(2).value := ''multipart/mixed''; ',
'   ',
'    l_response := apex_web_service.make_rest_request(',
'        p_url         => ''https://capnaoicprd-capnaop2-ia.integration.ocp.oraclecloud.com/ic/api/integration/v1/flows/rest/OBJFILEU_REST_ICT_APEX/1.0/upload'',',
