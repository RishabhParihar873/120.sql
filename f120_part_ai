'    l_pipeline_status VARCHAR2(50);',
'    l_pct_complete    NUMBER;',
'',
'BEGIN',
'',
'    ------------------------------------------------------------',
'    -- 1. CREATE PROJECT',
'    ------------------------------------------------------------',
'    SELECT ''ICT-'' || ICT_PROJECT_SEQ.NEXTVAL',
'    INTO l_project_code',
'    FROM dual;',
'',
'    l_body := JSON_OBJECT(',
'        ''project_code'' VALUE l_project_code,',
'        ''project_name'' VALUE ''ICT_PROJECT'',',
'        ''project_type'' VALUE ''INTEGRATION'',',
'        ''fsd_template_code'' VALUE ''HCM_INTEGRATION_V1''',
'    );',
'',
'    apex_web_service.g_request_headers.DELETE;',
'    apex_web_service.g_request_headers(1).name  := ''Content-Type'';',
'    apex_web_service.g_request_headers(1).value := ''application/json'';',
'',
'    l_response := apex_web_service.make_rest_request(',
'        p_url => ''https://cwkfvo65cuzpsk4g3zddt4rqhu.apigateway.us-ashburn-1.oci.customer-oci.com/api/v1/projects'',',
'        p_http_method => ''POST'',',
'        p_body => l_body',
'    );',
'',
'    -- SELECT project_id',
'    -- INTO l_project_id',
'    -- FROM JSON_TABLE(',
'    --     l_response,',
'    --     ''$''',
'    --     COLUMNS (project_id VARCHAR2(100) PATH ''$.project_id'')',
'    -- );',
'    l_project_id:=1095;',
'    :P1047_GENERATED_PROJECT_ID:=l_project_id;',
'',
'    ------------------------------------------------------------',
'    -- 2. UPLOAD FILE',
'    ------------------------------------------------------------',
'    SELECT blob_content, filename, mime_type',
'    INTO l_blob, l_filename, l_mime_type',
'    FROM FILE_UPLOAD_TST',
'    WHERE ID = 3;',
'',
'    IF INSTR(l_filename, ''.'') = 0 THEN',
'        l_filename := l_filename || ''.xlsx'';',
'    END IF;',
'',
'    l_mime_type := ''application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'';',
'    l_doc_type  := ''EXCEL'';',
'',
'    DBMS_LOB.CREATETEMPORARY(l_request_body, TRUE);',
'',
'    -- project_id part',
'    l_part := UTL_RAW.CAST_TO_RAW(',
'        ''--''||l_boundary||CHR(13)||CHR(10)||',
'        ''Content-Disposition: form-data; name="project_id"''||CHR(13)||CHR(10)||CHR(13)||CHR(10)||',
'        l_project_id||CHR(13)||CHR(10)',
'    );',
'    DBMS_LOB.WRITEAPPEND(l_request_body,UTL_RAW.LENGTH(l_part),l_part);',
'',
'    -- doc_type part',
'    l_part := UTL_RAW.CAST_TO_RAW(',
'        ''--''||l_boundary||CHR(13)||CHR(10)||',
'        ''Content-Disposition: form-data; name="doc_type"''||CHR(13)||CHR(10)||CHR(13)||CHR(10)||',
'        l_doc_type||CHR(13)||CHR(10)',
'    );',
'    DBMS_LOB.WRITEAPPEND(l_request_body,UTL_RAW.LENGTH(l_part),l_part);',
'',
'    -- file part',
'    l_part := UTL_RAW.CAST_TO_RAW(',
'        ''--''||l_boundary||CHR(13)||CHR(10)||',
'        ''Content-Disposition: form-data; name="file"; filename="''||l_filename||''"''||CHR(13)||CHR(10)||',
'        ''Content-Type: ''||l_mime_type||CHR(13)||CHR(10)||CHR(13)||CHR(10)',
'    );',
'    DBMS_LOB.WRITEAPPEND(l_request_body,UTL_RAW.LENGTH(l_part),l_part);',
'',
'    DBMS_LOB.APPEND(l_request_body,l_blob);',
'',
'    -- close boundary',
'    l_part := UTL_RAW.CAST_TO_RAW(',
'        CHR(13)||CHR(10)||''--''||l_boundary||''--''||CHR(13)||CHR(10)',
