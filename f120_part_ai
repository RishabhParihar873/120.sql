,p_column_html_expression=>wwv_flow_string.join(wwv_flow_t_varchar2(
'<div class="dropdown-wrapper" style="display: inline-block;">',
'  <span class="t-Icon fa fa-ellipsis-h"',
'        style="cursor:pointer;"',
'        data-line-id="#PROJECT_PLAN_LINE_ID#"',
'        data-level="#LEVELS#"',
'        data-deliverable="#HAS_DELIVERABLE#"',
'        onclick="DropdownHandler.toggle(this)">',
'  </span>',
'</div>',
'<div id="actionDropdown" class="custom-dropdown" style="',
'  display:none;',
'  position:fixed;',
'  background:#fff;',
'  border:1px solid #ccc;',
'  border-radius:5px;',
'  box-shadow:0 2px 6px rgba(0,0,0,0.2);',
'  padding:3px;',
'  z-index:9999;',
'  min-width:180px;',
'">',
'<!-- <a class="dd-item" onclick="DropdownHandler.openModal(''TASK'')">Task Name</a>',
'  <a class="dd-item" onclick="DropdownHandler.openModal(''ASSIGN'')">Assign To</a>',
'  <a class="dd-item" onclick="DropdownHandler.openModal(''TEMPLATE'')">Template ID</a>  -->',
'  <a class="dd-item" onclick="DropdownHandler.openModal(''VIEW_DEP'')">View Dependency</a>',
'  <a class="dd-item" data-action="SUBLINE" onclick="DropdownHandler.openModal(''SUBLINE'')">Create Child</a>',
'  <a class="dd-item" data-action="DOWNLOAD" onclick="DropdownHandler.openModal(''DOWNLOAD'')">Download Deliverable</a>',
'</div>',
'',
'<script>',
'window.DropdownHandler = (function() {',
'let _lineId = null;',
'function toggle(icon) {',
'    const dropdown = document.getElementById(''actionDropdown'');',
'    const level = Number(icon.getAttribute(''data-level''));',
'    const createChild = dropdown.querySelector(''[data-action="SUBLINE"]'');',
'    if (level === 6) {',
'        createChild.style.display = ''none'';',
'    } else {',
'        createChild.style.display = ''block'';',
'    }',
'    ',
'const hasDeliverable =(icon.getAttribute(''data-deliverable'') || ''N'').toUpperCase() === ''Y'';',
'',
'    const downloadLink = dropdown.querySelector(''[data-action="DOWNLOAD"]'');',
'    if (downloadLink) {',
'        if (hasDeliverable) {',
'        downloadLink.style.display = ''block'';  // show',
'        } else {',
'        downloadLink.style.display = ''none'';   // hide',
'        }',
'    }',
'    if (dropdown.style.display === ''block'') {',
'      dropdown.style.display = ''none'';',
'      return;',
'    }',
'    _lineId = icon.getAttribute(''data-line-id'');',
'',
'    if (!_lineId) {',
'      apex.message.alert(''Missing Project Plan Line ID for this row.'');',
'      return;',
'    }',
'    const rect = icon.getBoundingClientRect();',
'    dropdown.style.visibility = ''hidden'';',
'    dropdown.style.display = ''block'';',
'    dropdown.style.top = rect.bottom + ''px'';',
'    dropdown.style.left = (rect.right - 150) + ''px'';',
'    // dropdown.style.left = (rect.right - 30) + ''px'';',
'    dropdown.style.visibility = ''visible'';',
'  }',
'',
'  function openModal(action) {',
'    document.getElementById(''actionDropdown'').style.display = ''none'';',
'',
'    if (!_lineId) {',
'      apex.message.alert(''Missing Project Plan Line ID.'');',
'      return;',
'    }',
'    apex.server.process(',
'      ''GET_MODAL_URL'',',
'      {',
'        x01: _lineId,',
'        x03: action',
'      },',
'      {',
'        dataType: ''text'',',
'        success: function(pUrl) {',
'          if (pUrl && pUrl !== ''#'') {',
'            apex.navigation.redirect(pUrl);',
'          } else {',
'            apex.message.alert(''No URL returned.'');',
'          }',
'        },',
'        error: function() {',
'          apex.message.alert(''Failed to open page.'');',
'        }',
'      }',
'    );',
'  }',
'    document.addEventListener(''click'', function(event) {',
'    const isIcon = event.target.classList.contains(''fa-ellipsis-h'');',
'    const isInsideDropdown = event.target.closest(''.custom-dropdown'');',
'    if (!isIcon && !isInsideDropdown) {',
'      document.getElementById(''actionDropdown'').style.display = ''none'';',
'    }',
'  });',
'',
'  window.addEventListener(''resize'', function() {',
'    document.getElementById(''actionDropdown'').style.display = ''none'';',
'  });',
'  window.addEventListener(''scroll'', function() {',
'    document.getElementById(''actionDropdown'').style.display = ''none'';',
'  }, true);',
'',
'  return { toggle, openModal };',
'})();',
'</script>'))
