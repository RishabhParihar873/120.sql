'',
'    END IF;',
'',
'EXCEPTION',
'    WHEN OTHERS THEN',
'        :P1024_STATUS := ''Error: '' || SQLERRM;',
'',
'        IF l_raw_response IS NOT NULL THEN',
'            :P1024_RAW_RESPONSE := DBMS_LOB.SUBSTR(l_raw_response, 32000, 1);',
'        END IF;',
'',
'        :P1024_FILE_CONTENT_PREVIEW := NULL;',
'',
'        IF DBMS_LOB.ISTEMPORARY(l_text_clob) = 1 THEN',
'            DBMS_LOB.FREETEMPORARY(l_text_clob);',
'        END IF;',
'END;'))
