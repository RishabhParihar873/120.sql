'',
'    ------------------------DATA DICTIONARY--------------------------------------------',
'FOR I IN (SELECT *',
'    FROM WKSP_SOLDEV.CGCT_DATA_DICTIONARY_MASTER',
'    WHERE APPLICATION_ID=P_APPLICATION_ID',
'    AND ACTIVE_FLAG=''Y''',
'    AND PROD_ID=P_PROD_ID',
'    AND APPLICATION_ID = P_SOL_APP_ID',
'    AND MODULE IN (SELECT MODULE_ID FROM CGCT_TMP_DOMAIN_MODULE_MAPPING WHERE PROJECT_ID = P_PROJECT_ID))',
'     LOOP',
'        INSERT INTO CGCT_PRJ_DATA_DICTIONARY_MASTER(',
'        SOLUTION_ID,APPLICATION_ID,MODULE,DATA_ENTITY,DATA_SUB_ENTITY,TABLE_NAME,',
'        ACTIVE_FLAG,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATED_BY,PRJ_ID,ENTITY_TAG,UPDATE_SOURCE',
'    )',
'   VALUES  ',
'    (I.MASTER_ID,P_APPLICATION_ID,I.MODULE,I.DATA_ENTITY,I.DATA_SUB_ENTITY,I.TABLE_NAME,''Y'',SYSDATE, :P0_USER_ID_EMAIL,SYSDATE, :P0_USER_ID_EMAIL,P_PROJECT_ID,''Standard'',''SOL_IMPORT'')',
'     RETURNING MASTER_ID INTO v_master_id;',
'     INSERT INTO TMP_PRJ_DATA_DICTIONARY(OLD_ID,NEW_ID) VALUES(I.MASTER_ID,V_MASTER_ID);',
'     END LOOP;',
'    ',
'',
'    INSERT INTO CGCT_PRJ_DATA_DICTIONARY_DETAIL(',
'    SOLUTION_ID,APPLICATION_ID,MASTER_ID,COLUMN_NAME,DATA_TYPE,DATA_LENGTH,PRECISION_VAL,NOT_NULL,PRIMARY_KEY_FLAG,',
'    COLUMN_DESCRIPTION,DATA_SOURCE,LOAD_TYPE,LOAD_METHOD,REUSABLE,COMPLEXITY,ACTIVE_FLAG,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATED_BY,PRJ_ID,ENTITY_TAG,UPDATE_SOURCE',
'    )',
'    SELECT ',
