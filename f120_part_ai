'        p_body_blob    => l_blob_data',
'    );',
'',
'    apex_debug.message(''File appended to multipart'');',
'',
'  ',
'    l_file_path := ''DEV/Workshop'';',
'    l_full_path := l_file_path || ''/'' || l_file_name;',
'',
