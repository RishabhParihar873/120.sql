wwv_flow_imp_page.create_page_item(
 p_id=>wwv_flow_imp.id(858914761771889310)
,p_name=>'P1032_CONSOLIDATED_PROMPT'
,p_item_sequence=>380
,p_use_cache_before_default=>'NO'
,p_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'SELECT',
'       CASE ',
'         WHEN (',
'           SELECT MAX(rp.PROMPT)',
'             FROM CGCT_PP_ROLES_PROMPT rp',
'            WHERE UPPER(rp.ROLES) = UPPER(:P1032_ROLE)',
'         ) IS NOT NULL',
'         THEN RTRIM(TRIM((',
'           SELECT MAX(rp.PROMPT)',
'             FROM CGCT_PP_ROLES_PROMPT rp',
'            WHERE UPPER(rp.ROLES) = UPPER(:P1032_ROLE)',
'         )), ''.'') || ''. '' || CHR(10) || CHR(10)',
'       END ||',
'',
'    --    CASE ',
'    --      WHEN (',
'    --        SELECT MAX(tp.PROMPT)',
'    --          FROM CGCT_PROJECT_TEMPLATES tp',
'    --         WHERE UPPER(tp.TEMPLATE_CODE) = UPPER(:P1032_TEMPLATE)',
'    --      ) IS NOT NULL',
'    --      THEN RTRIM(TRIM((',
'    --        SELECT MAX(tp.PROMPT)',
'    --          FROM CGCT_PROJECT_TEMPLATES tp',
'    --         WHERE UPPER(tp.TEMPLATE_CODE) = UPPER(:P1032_TEMPLATE)',
'    --      )), ''.'') || ''. '' || CHR(10) || CHR(10)',
'    --    END ||',
'CASE',
'  WHEN (',
'    SELECT MAX(tp.TEMPLATE_NAME)',
'      FROM CGCT_PROJECT_TEMPLATES tp',
'     WHERE UPPER(tp.TEMPLATE_CODE) = UPPER(:P1032_TEMPLATE)',
'  ) IS NOT NULL',
'  THEN ''Using attached template and below prompts, I want to generate ''',
'       || (SELECT MAX(tp.TEMPLATE_NAME)',
'             FROM CGCT_PROJECT_TEMPLATES tp',
'            WHERE UPPER(tp.TEMPLATE_CODE) = UPPER(:P1032_TEMPLATE))',
'       || ''.''',
'       || CHR(10) || CHR(10)',
'       || RTRIM(TRIM((',
'            SELECT MAX(tp.PROMPT)',
'              FROM CGCT_PROJECT_TEMPLATES tp',
'             WHERE UPPER(tp.TEMPLATE_CODE) = UPPER(:P1032_TEMPLATE)',
'          )), ''.'')',
'       || ''.''',
'       || CHR(10) || CHR(10)',
'END ||',
'',
'       CASE ',
'         WHEN pm.CLIENT_PROMPT IS NOT NULL ',
'         THEN RTRIM(TRIM(pm.CLIENT_PROMPT), ''.'') || ''. '' || CHR(10) || CHR(10)',
'       END ||',
'',
'       CASE ',
'         WHEN pm.PRJ_PROMPT IS NOT NULL ',
'         THEN RTRIM(TRIM(pm.PRJ_PROMPT), ''.'') || ''. '' || CHR(10) || CHR(10)',
'       END ||',
'',
'       CASE ',
'         WHEN (',
'           SELECT MAX(wp.PROMPT)',
'             FROM CGCT_PP_WORKSTREAM_PROMPT wp',
'            WHERE UPPER(wp.WORKSTREAM) = UPPER(:P1032_WORKSTREAM)',
'         ) IS NOT NULL',
'         THEN RTRIM(TRIM((',
'           SELECT MAX(wp.PROMPT)',
'             FROM CGCT_PP_WORKSTREAM_PROMPT wp',
'            WHERE UPPER(wp.WORKSTREAM) = UPPER(:P1032_WORKSTREAM)',
'         )), ''.'') || ''. '' || CHR(10) || CHR(10)',
'       END ||',
'',
'       CASE ',
'         WHEN (',
'           SELECT MAX(pt.PROMPT)',
'             FROM CGCT_PHASE_TYPE pt',
'            WHERE UPPER(pt.PHASE_TYPE) = UPPER(:P1032_PHASE)',
'              AND pt.PARENT_PHASE_ID IS NULL',
'         ) IS NOT NULL',
'         THEN RTRIM(TRIM((',
'           SELECT MAX(pt.PROMPT)',
'             FROM CGCT_PHASE_TYPE pt',
'            WHERE UPPER(pt.PHASE_TYPE) = UPPER(:P1032_PHASE)',
'              AND pt.PARENT_PHASE_ID IS NULL',
'         )), ''.'') || ''. '' || CHR(10) || CHR(10)',
'       END ||',
'',
'       CASE ',
'         WHEN (',
'           SELECT MAX(spt.PROMPT)',
'             FROM CGCT_PHASE_TYPE spt',
'            WHERE UPPER(spt.PHASE_TYPE) = UPPER(:P1032_SUB_PHASE)',
'              AND spt.PARENT_PHASE_ID IS NOT NULL',
'         ) IS NOT NULL',
'         THEN RTRIM(TRIM((',
'           SELECT MAX(spt.PROMPT)',
'             FROM CGCT_PHASE_TYPE spt',
'            WHERE UPPER(spt.PHASE_TYPE) = UPPER(:P1032_SUB_PHASE)',
'              AND spt.PARENT_PHASE_ID IS NOT NULL',
'         )), ''.'') || ''. '' || CHR(10) || CHR(10)',
'       END ||',
'       ',
'       CASE',
'         WHEN :P1032_COMPONENT IS NOT NULL',
'         THEN RTRIM(TRIM(:P1032_COMPONENT), ''.'') || ''. '' || CHR(10) || CHR(10)',
'',
'   ',
'',
'       END AS FINAL_PROMPT',
'  FROM CGCT_PROJECT_MASTER pm',
' WHERE pm.ID = :P0_PROJECT_ID;'))
,p_source_type=>'QUERY'
,p_display_as=>'NATIVE_HIDDEN'
,p_attributes=>wwv_flow_t_plugin_attributes(wwv_flow_t_varchar2(
  'value_protected', 'N')).to_clob
,p_ai_enabled=>false
,p_created_on=>wwv_flow_imp.dz('20260709152344Z')
,p_updated_on=>wwv_flow_imp.dz('20260709152344Z')
,p_created_by=>'DEL_DEV'
,p_updated_by=>'DEL_DEV'
);
wwv_flow_imp_page.create_page_item(
 p_id=>wwv_flow_imp.id(858651247271759481)
,p_name=>'P1032_CONSOLIDATED_PROMPT_NOSPACE'
,p_item_sequence=>390
,p_use_cache_before_default=>'NO'
,p_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'SELECT REPLACE(',
'         REPLACE(',
'           REPLACE(final_prompt, CHR(13) || CHR(10), ''\n''),',
'           CHR(10), ''\n''',
'         ),',
'         CHR(13), ''\n''',
'       ) AS final_prompt',
'FROM (',
'    SELECT',
'        CASE',
'          WHEN (',
'            SELECT MAX(rp.PROMPT)',
'              FROM CGCT_PP_ROLES_PROMPT rp',
'             WHERE UPPER(rp.ROLES) = UPPER(:P1009_ROLE)',
'          ) IS NOT NULL',
'          THEN RTRIM(TRIM((',
'            SELECT MAX(rp.PROMPT)',
'              FROM CGCT_PP_ROLES_PROMPT rp',
'             WHERE UPPER(rp.ROLES) = UPPER(:P1009_ROLE)',
'          )), ''.'') || ''. '' || CHR(10) || CHR(10)',
'        END ||',
' ',
'        CASE',
'          WHEN (',
'            SELECT MAX(tp.TEMPLATE_NAME)',
'              FROM CGCT_PROJECT_TEMPLATES tp',
'             WHERE UPPER(tp.TEMPLATE_CODE) = UPPER(:P1009_TEMPLATE)',
'          ) IS NOT NULL',
'          THEN ''Using attached template and below prompts, I want to generate ''',
'               || (SELECT MAX(tp.TEMPLATE_NAME)',
'                     FROM CGCT_PROJECT_TEMPLATES tp',
'                    WHERE UPPER(tp.TEMPLATE_CODE) = UPPER(:P1009_TEMPLATE))',
'               || ''.''',
'               || CHR(10) || CHR(10)',
'               || RTRIM(TRIM((',
'                    SELECT MAX(tp.PROMPT)',
'                      FROM CGCT_PROJECT_TEMPLATES tp',
'                     WHERE UPPER(tp.TEMPLATE_CODE) = UPPER(:P1009_TEMPLATE)',
'                  )), ''.'')',
'               || ''.''',
'               || CHR(10) || CHR(10)',
'        END ||',
' ',
'        CASE',
'          WHEN pm.CLIENT_PROMPT IS NOT NULL',
'          THEN RTRIM(TRIM(pm.CLIENT_PROMPT), ''.'') || ''. '' || CHR(10) || CHR(10)',
'        END ||',
' ',
'        CASE',
'          WHEN pm.PRJ_PROMPT IS NOT NULL',
'          THEN RTRIM(TRIM(pm.PRJ_PROMPT), ''.'') || ''. '' || CHR(10) || CHR(10)',
'        END ||',
' ',
'        CASE',
'          WHEN (',
'            SELECT MAX(wp.PROMPT)',
'              FROM CGCT_PP_WORKSTREAM_PROMPT wp',
'             WHERE UPPER(wp.WORKSTREAM) = UPPER(:P1009_WORKSTREAM)',
'          ) IS NOT NULL',
'          THEN RTRIM(TRIM((',
'            SELECT MAX(wp.PROMPT)',
'              FROM CGCT_PP_WORKSTREAM_PROMPT wp',
'             WHERE UPPER(wp.WORKSTREAM) = UPPER(:P1009_WORKSTREAM)',
'          )), ''.'') || ''. '' || CHR(10) || CHR(10)',
'        END ||',
' ',
'        CASE',
'          WHEN (',
'            SELECT MAX(pt.PROMPT)',
'              FROM CGCT_PHASE_TYPE pt',
'             WHERE UPPER(pt.PHASE_TYPE) = UPPER(:P1009_PHASE)',
'               AND pt.PARENT_PHASE_ID IS NULL',
'          ) IS NOT NULL',
'          THEN RTRIM(TRIM((',
'            SELECT MAX(pt.PROMPT)',
'              FROM CGCT_PHASE_TYPE pt',
'             WHERE UPPER(pt.PHASE_TYPE) = UPPER(:P1009_PHASE)',
'               AND pt.PARENT_PHASE_ID IS NULL',
'          )), ''.'') || ''. '' || CHR(10) || CHR(10)',
'        END ||',
' ',
'        CASE',
'          WHEN (',
'            SELECT MAX(spt.PROMPT)',
'              FROM CGCT_PHASE_TYPE spt',
'             WHERE UPPER(spt.PHASE_TYPE) = UPPER(:P1009_SUB_PHASE)',
'               AND spt.PARENT_PHASE_ID IS NOT NULL',
'          ) IS NOT NULL',
'          THEN RTRIM(TRIM((',
'            SELECT MAX(spt.PROMPT)',
'              FROM CGCT_PHASE_TYPE spt',
'             WHERE UPPER(spt.PHASE_TYPE) = UPPER(:P1009_SUB_PHASE)',
'               AND spt.PARENT_PHASE_ID IS NOT NULL',
'          )), ''.'') || ''. '' || CHR(10) || CHR(10)',
'',
'                 END ||',
'       ',
'       CASE',
'         WHEN :P1032_COMPONENT IS NOT NULL',
'         THEN RTRIM(TRIM(:P1032_COMPONENT), ''.'') || ''. '' || CHR(10) || CHR(10)',
'         ',
'        END AS final_prompt',
'    FROM CGCT_PROJECT_MASTER pm',
'    WHERE pm.ID = :P0_PROJECT_ID',
');'))
