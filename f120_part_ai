,p_process_sql_clob=>wwv_flow_string.join(wwv_flow_t_varchar2(
'DECLARE',
'    L_MESSAGE VARCHAR2(32000) := '''';',
'    V_DOMAIN_ID NUMBER;',
'    V_MODULE_ID NUMBER;',
'    V_NAME_COUNT NUMBER;',
'',
'    -- APEX page items',
'    L_FILE_NAME VARCHAR2(100) := :P1070_FILE;',
'    L_WORKSHEET VARCHAR2(100) := :P1070_XLSX_WORKSHEET;',
'        L_APP_ID         NUMBER := :P0_APPLICATION_ID;',
'        L_PRJ_ID NUMBER := :P0_PROJECT_ID;',
'',
'    -- Cursor for data parsing',
'    CURSOR C_DATA IS',
'        SELECT ',
'            --    P.COL001 DECISION, ',
'            --    P.COL002 DECISION_DESCRIPTION,',
'            --    P.COL003 DOMAIN,',
'            --    P.COL004 MODULE,',
'               P.COL001 DOMAIN, ',
'               P.COL002 MODULE,',
'               P.COL003 DECISION,',
'               P.COL004 DECISION_DESCRIPTION,',
'              ',
'               P.LINE_NUMBER AS LINE_NUMBER',
'        FROM APEX_APPLICATION_TEMP_FILES F,',
'             TABLE(APEX_DATA_PARSER.PARSE(',
'                 P_CONTENT => F.BLOB_CONTENT,',
'                 P_FILE_NAME => F.FILENAME,',
'                 P_FILE_PROFILE => APEX_DATA_LOADING.GET_FILE_PROFILE(P_STATIC_ID => ''Load_Data''),',
'                 P_MAX_ROWS => 5000',
'             )) P',
'        WHERE F.NAME = L_FILE_NAME',
'        AND P.LINE_NUMBER != 1;',
'',
'BEGIN',
'',
'--  BEGIN',
'--         SELECT ID',
'--         INTO L_PRODUCT_ID',
'--         FROM CGCT_PRODUCT_MASTER',
'--         WHERE UPPER(TRIM(PRODUCT_NAME)) = ''BLUEPRINT''',
'--           AND NVL(ACTIVE_FLAG,''N'') = ''Y'';',
'--     EXCEPTION',
'--         WHEN NO_DATA_FOUND THEN',
'--             L_MESSAGE := ''Blueprint product not found or inactive in CGCT_PRODUCT_MASTER'';',
'--             APEX_DEBUG.ERROR(L_MESSAGE);',
'--             RAISE_APPLICATION_ERROR(-20020, L_MESSAGE);',
'--     END;',
'    FOR P IN C_DATA LOOP',
'            IF TRIM(p.DOMAIN)  is null THEN',
'                RAISE_APPLICATION_ERROR(-20001, ''Error: Domain is mandatory to process records'');',
'            ELSIF TRIM(p.MODULE)  is null THEN',
'                RAISE_APPLICATION_ERROR(-20002, ''Error: Module is mandatory to process records'');',
'            ELSIF TRIM(p.DECISION)  is null THEN',
'                RAISE_APPLICATION_ERROR(-20003, ''Error: Decision is mandatory to process records'');',
'            ELSIF TRIM(p.DECISION_DESCRIPTION)  is null THEN',
'                RAISE_APPLICATION_ERROR(-20003, ''Error: Decision Description is mandatory to process records'');',
'        else',
'        BEGIN',
'            -- Fetch DOMAIN_ID',
'            SELECT DOMAIN_ID INTO V_DOMAIN_ID',
'            FROM CGCT_PRJ_DOMAIN_PROCESS_MAP_V',
'            --WHERE DOMAIN_SHORT_NAME = P.DOMAIN',
'            WHERE UPPER(TRIM(DOMAIN_SHORT_NAME)) = UPPER(TRIM(P.DOMAIN))',
'            AND ROWNUM = 1;',
'',
'        EXCEPTION',
'            WHEN NO_DATA_FOUND THEN',
'                L_MESSAGE := ''Domain not found: '' || P.DOMAIN;',
'                APEX_DEBUG.ERROR(L_MESSAGE);',
'                RAISE_APPLICATION_ERROR(-20001, L_MESSAGE);',
'        END;',
'',
'        -- Fetch MODULE_ID',
'        -- BEGIN',
'        --     -- SELECT ID INTO V_MODULE_ID',
'        --     -- FROM CGCT_ORACLE_MODULE',
'        --     -- WHERE SHORT_NAME = P.MODULE',
'        --     -- AND DOMAIN_ID =V_DOMAIN_ID;',
'        --     SELECT MODULE_ID INTO V_MODULE_ID',
'        --     FROM CGCT_MODULE_MASTER',
'        --     WHERE MODULE_SHORT_CODE = P.MODULE',
'        --     AND DOMAIN_ID =V_DOMAIN_ID',
'        --     AND PROD_ID IS NULL;',
'',
'        -- EXCEPTION',
'        --     -- WHEN NO_DATA_FOUND THEN',
'        --     --     L_MESSAGE := ''Module not found: '' || P.MODULE;',
'        --     --     APEX_DEBUG.ERROR(L_MESSAGE);',
'        --     --     RAISE_APPLICATION_ERROR(-20002, L_MESSAGE);',
'        --         WHEN NO_DATA_FOUND THEN',
'        --         L_MESSAGE := ''Invalid module '' || p.module ||'' for domain ''||p.domain;',
'        --         APEX_DEBUG.ERROR(L_MESSAGE);',
'        --         RAISE_APPLICATION_ERROR(-20002, L_MESSAGE);',
'        -- END;',
'         BEGIN',
'                SELECT m.MODULE_ID',
'                INTO V_MODULE_ID',
'                FROM CGCT_PRJ_MODULE_MASTER m',
'                JOIN CGCT_PRJ_DOMAIN_MODULE_MAPPING dmm ON dmm.MODULE_ID = m.MODULE_ID',
'                WHERE UPPER(TRIM(m.MODULE_SHORT_CODE)) = UPPER(TRIM(P.MODULE))',
'                  AND dmm.DOMAIN_ID = V_DOMAIN_ID',
'                  AND dmm.PROJECT_ID = L_PRJ_ID',
'                   AND m.APPLICATION_ID =L_APP_ID',
'                  AND NVL(dmm.ACTIVE_FLAG,''N'') = ''Y''',
'                  AND NVL(m.ACTIVE_FLAG,''N'') = ''Y''',
'                  AND ROWNUM = 1;',
'            EXCEPTION',
'                WHEN NO_DATA_FOUND THEN',
'                    L_MESSAGE := ''Invalid module '' || P.MODULE || '' for domain '' || P.DOMAIN || '' (Line: '' || P.LINE_NUMBER || '')'';',
'                    APEX_DEBUG.ERROR(L_MESSAGE);',
'                    RAISE_APPLICATION_ERROR(-20002, L_MESSAGE);',
'            END;',
'',
'        -- Check if the decision document already exists',
'        SELECT COUNT(*) INTO V_NAME_COUNT',
'        FROM CGCT_PRJ_KEY_DECISION_DOCS',
'        WHERE TOPIC_NAME = P.DECISION',
'        AND MODULE_ID = V_MODULE_ID',
'        AND DOMAIN_ID = V_DOMAIN_ID',
'        and APPLICATION_ID=L_APP_ID',
'        AND PRJ_ID=:P0_PROJECT_ID;',
