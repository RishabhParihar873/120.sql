'      <p>If additional information is required, please reach out to the user directly.</p>',
'      <p>Regards,<br>',
'      ICT Support Team</p>''',
'    );',
'',
'  -- Attach the actual file',
'  APEX_MAIL.ADD_ATTACHMENT(',
'    p_mail_id    => l_mail_id,',
