,p_process_sql_clob=>wwv_flow_string.join(wwv_flow_t_varchar2(
'DECLARE',
'    l_response            CLOB;',
'    l_response_pipeline   CLOB;',
'    l_response_bulk       CLOB;',
'    l_response_approve    CLOB;',
'    l_body                CLOB;',
