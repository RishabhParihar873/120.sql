,p_plug_display_sequence=>90
,p_plug_item_display_point=>'ABOVE'
,p_location=>null
,p_function_body_language=>'PLSQL'
,p_plug_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'DECLARE',
'    v_html         CLOB := '''';',
'    v_dates        SYS.ODCIDATELIST := SYS.ODCIDATELIST();',
'    v_offset       NUMBER := NVL(:P1057_WEEKDAY_OFFSET, 0);',
'    -- v_start_date   DATE := TO_DATE(:P272_ESTIMATED_START_DATE, ''DD-MM-YYYY'');',
'    v_start_date   DATE := TO_DATE(:P1057_DATE, ''DD-MM-YYYY'');',
'    -- v_start_date   DATE := TO_DATE(''11-09-2025'', ''DD-MM-YYYY'');',
'    -- v_end_date     DATE := TO_DATE(:P272_ESTIMATED_END_DATE, ''DD-MM-YYYY'');',
'    v_end_date     DATE := TRUNC(SYSDATE);',
'    v_base_date    DATE := TRUNC(SYSDATE);',
'    v_temp_date    DATE;',
'    v_count        NUMBER := 0;',
'    v_effort       number;',
'BEGIN',
' -- Navigation: shift by 5 weekdays from SYSDATE',
'-- v_temp_date := v_base_date;',
'-- v_count := 0;',
'',
'-- -- Shift base date by 5 weekdays',
'-- WHILE v_count < ABS(v_offset) LOOP',
'--     IF v_offset > 0 THEN',
'--         v_temp_date := v_temp_date + 1;',
'--     ELSE',
'--         v_temp_date := v_temp_date - 1;',
'--     END IF;',
'',
'--     IF v_temp_date < v_start_date OR v_temp_date > v_end_date THEN',
'--         EXIT;',
'--     END IF;',
'',
'--     IF TO_CHAR(v_temp_date, ''DY'', ''NLS_DATE_LANGUAGE=ENGLISH'') NOT IN (''SAT'', ''SUN'') THEN',
'--         v_count := v_count + 1;',
'--     END IF;',
'-- END LOOP;',
'',
'-- -- Clamp base date to start date if it went too far back',
'-- IF v_temp_date < v_start_date THEN',
'--     v_temp_date := v_start_date;',
'-- END IF;',
'',
'-- -- Collect 5 weekdays from clamped base date',
'-- v_base_date := v_temp_date;',
'-- v_count := 0;',
'-- -- WHILE v_count < 5 AND v_base_date <= v_end_date LOOP',
'-- WHILE v_count < 5 AND v_base_date >= v_start_date LOOP',
'--     IF TO_CHAR(v_base_date, ''DY'', ''NLS_DATE_LANGUAGE=ENGLISH'') NOT IN (''SAT'', ''SUN'') THEN',
'--         v_dates.EXTEND;',
'--         v_dates(v_dates.COUNT) := v_base_date;',
'--         v_count := v_count + 1;',
'--     END IF;',
'--     v_base_date := v_base_date - 1;',
'-- END LOOP;',
'',
'v_temp_date := TRUNC(SYSDATE);',
'  v_count := 0;',
'  WHILE v_count < 5 LOOP',
'    v_temp_date := v_temp_date - 1;',
'    IF TO_CHAR(v_temp_date, ''DY'', ''NLS_DATE_LANGUAGE=ENGLISH'') NOT IN (''SAT'', ''SUN'') THEN',
'      v_count := v_count + 1;',
'    END IF;',
'  END LOOP;',
'  v_base_date := v_temp_date + 1;',
'',
unistr('  -- \D83D\DCC5 Step 2: Adjust base date by offset (weekdays only)'),
'  v_temp_date := v_base_date;',
'  v_count := 0;',
'  WHILE v_count < ABS(v_offset) LOOP',
'    v_temp_date := v_temp_date + CASE WHEN v_offset > 0 THEN 1 ELSE -1 END;',
'    IF v_temp_date < v_start_date OR v_temp_date > v_end_date THEN',
'      EXIT;',
'    END IF;',
'    IF TO_CHAR(v_temp_date, ''DY'', ''NLS_DATE_LANGUAGE=ENGLISH'') NOT IN (''SAT'', ''SUN'') THEN',
'      v_count := v_count + 1;',
'    END IF;',
'  END LOOP;',
'  -- Clamp to min date if needed',
'  IF v_temp_date < v_start_date THEN',
'    v_temp_date := v_start_date;',
'  END IF;',
unistr('  -- \D83D\DCC6 Step 3: Collect next 5 weekdays from adjusted base date'),
'  v_base_date := v_temp_date;',
'  v_count := 0;',
'  WHILE v_count < 5 AND v_base_date <= v_end_date LOOP',
'    IF TO_CHAR(v_base_date, ''DY'', ''NLS_DATE_LANGUAGE=ENGLISH'') NOT IN (''SAT'', ''SUN'') THEN',
'      v_dates.EXTEND;',
'      v_dates(v_dates.COUNT) := v_base_date;',
'      v_count := v_count + 1;',
'    END IF;',
'    v_base_date := v_base_date + 1;',
'  END LOOP;',
'',
'',
'',
'',
'    -- Build HTML table',
'    ',
'v_html := ''<table class="t-Report-report" border="1" style="width: 100%; table-layout: fixed;"><tr><th style="width: 150px; text-align: left;">Date</th>'';',
'    FOR i IN 1 .. v_dates.COUNT LOOP',
'',
'v_html := v_html || ''<th style="width: 150px;">'' || TO_CHAR(v_dates(i), ''DD-Mon-YYYY'') || ''</th>'';',
'END LOOP;',
'v_html := v_html || ''</tr>'';',
'  ',
'    -- Row 2: EFFORT SPENT',
'v_html := v_html || ''<tr><td><b>Effort Spent</b></td>'';',
'FOR i IN 1 .. v_dates.COUNT LOOP',
'  BEGIN',
'    SELECT effort_hours',
'    INTO v_effort',
'    FROM CGCT_TASK_EFFORT',
'    WHERE task_name =:P1057_TASK_NAME',
'    and task_id=:P1057_LINE_ID',
'    -- and task_id=:P1057_PROJECT_PLAN_LINE_ID',
'    --newly added',
'      AND effort_date = v_dates(i)',
'    AND user_id = :APP_USER',
'    FETCH FIRST ROW ONLY;',
'  EXCEPTION',
'    WHEN NO_DATA_FOUND THEN',
'      v_effort := NULL;',
'  END;',
'',
'--   v_html := v_html || ''<td><input type="text" name="effort_'' || TO_CHAR(v_dates(i), ''YYYYMMDD'') ||',
'--             ''" value="'' || NVL(TO_CHAR(v_effort), '''') || ''" pattern="\d*" inputmode="numeric" style="width: 60px;"></td>'';',
'',
'v_html := v_html || ''<td><div style="text-align: center;"><input type="text" name="effort_'' || TO_CHAR(v_dates(i), ''YYYYMMDD'') ||',
'        ''" value="'' || NVL(TO_CHAR(v_effort), '''') || ''" pattern="\d*" inputmode="numeric" style="width: 100px; text-align: center;"></td>'';',
'',
'END LOOP;',
'v_html := v_html || ''</tr>'';',
'',
' -------------close the table',
'    v_html := v_html || ''</table>'';',
'',
'',
'-- Return the final HTML',
'RETURN v_html;',
'',
'',
'',
'',
'END;',
'',
''))
,p_lazy_loading=>false
,p_plug_source_type=>'NATIVE_DYNAMIC_CONTENT'
,p_ajax_items_to_submit=>'P1057_WEEKDAY_OFFSET,P1057_DATE,P1057_LINE_ID,P1057_TASK_NAME'
