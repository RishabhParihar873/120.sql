'        dbms_lob.copy(',
'            dest_lob    => p_blob,',
'            src_lob     => p_content,',
'            amount      => l_amount,',
'            dest_offset => l_dest_offset,',
'            src_offset  => l_src_offset',
'        );',
'    end append_blob;',
