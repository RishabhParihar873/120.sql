'    apex_web_service.g_request_headers.DELETE;',
'',
'    l_response_bulk := apex_web_service.make_rest_request(',
'        p_url => ''https://cwkfvo65cuzpsk4g3zddt4rqhu.apigateway.us-ashburn-1.oci.customer-oci.com/api/v1/approvals/project/''',
'                 || l_project_id || ''/bulk-approve'',',
'        p_http_method => ''POST''',
