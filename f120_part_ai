    '        "The download URL could not be generated."',
    '    );',
    '',
    '    throw new Error("P1060_DOWNLOAD_URL is empty.");',
    '}',
    '',
    'if (',
    '    !downloadUrl.toLowerCase().startsWith("https://") &&',
    '    !downloadUrl.toLowerCase().startsWith("http://")',
