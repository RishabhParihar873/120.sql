wwv_flow_imp_page.create_page_plug(
 p_id=>wwv_flow_imp.id(1607621899291334336)
,p_plug_name=>'Plan'
,p_static_id=>'plan'
,p_region_name=>'Plan'
,p_parent_plug_id=>wwv_flow_imp.id(1619758218604865263)
,p_region_template_options=>'#DEFAULT#:t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc'
,p_plug_template=>2100526641005906379
,p_plug_display_sequence=>20
,p_plug_display_point=>'SUB_REGIONS'
,p_plug_item_display_point=>'ABOVE'
,p_query_type=>'SQL'
,p_plug_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'WITH H AS (',
'    SELECT /*+ parallel(cppl 8) */',
'           cppl.*,',
'           p1.display_sequence AS p1_seq,',
'           p2.display_sequence AS p2_seq,',
'           p3.display_sequence AS p3_seq,',
'           p4.display_sequence AS p4_seq,',
'           p5.display_sequence AS p5_seq,',
'           p6.display_sequence AS p6_seq',
'    FROM cgct_pp_plan_line cppl',
'    LEFT JOIN cgct_pp_plan_line p1 ON p1.project_plan_line_id = cppl.parent_id',
'    LEFT JOIN cgct_pp_plan_line p2 ON p2.project_plan_line_id = p1.parent_id',
'    LEFT JOIN cgct_pp_plan_line p3 ON p3.project_plan_line_id = p2.parent_id',
'    LEFT JOIN cgct_pp_plan_line p4 ON p4.project_plan_line_id = p3.parent_id',
'    LEFT JOIN cgct_pp_plan_line p5 ON p5.project_plan_line_id = p4.parent_id',
'    LEFT JOIN cgct_pp_plan_line p6 ON p6.project_plan_line_id = p5.parent_id',
')',
'SELECT DISTINCT',
'    --------------------------------------------------------------------',
'    -- Checkbox',
'    --------------------------------------------------------------------',
'',
'    -- APEX_ITEM.CHECKBOX2(',
'    --     p_idx        => 1,',
'    --     p_value      => H.project_plan_line_id,',
'    --     p_attributes =>',
'    --           ''class="ir-start" ''',
'    --        || ''title="Mark to Start" ''',
'    --        || ''data-enable="'' || CASE WHEN child.project_plan_line_id IS NULL THEN ''Y'' ELSE ''N'' END || ''" ''',
'    --        || ''data-task="''   || NVL(REPLACE(H.task_number,''"'',''&quot;''),'''') || ''" ''',
'    --        || ''onclick="apex.event.trigger(document,''''f01-changed'''');"''',
'    -- ) AS start_sel,',
'',
'    --------------------------------------------------------------------',
'    -- ORIGINAL COLUMNS',
'    --------------------------------------------------------------------',
'    H.project_plan_line_id,',
'    H.task_number,',
'    H.category,',
'    H.template_id,',
'',
'    CASE ',
'        WHEN H.template_id = tm.id ',
'        THEN COALESCE(tm.template_code, ''Missing Template'')',
'        ELSE NULL',
'    END AS templates_id,',
'',
'    CASE ',
'        WHEN H.category IN (''Internal Deliverable'',''Deliverable'',''Client Deliverable'')',
'        THEN ''Y''',
'        ELSE ''N''',
'    END AS HAS_DELIVERABLE,',
'',
'',
'    H.wbs_id,',
'    H.prj_id,',
'    TO_CHAR(H.planned_end,''DD-MM-YYYY'') AS planned_end_str,',
'',
'    -- ''<span class="hover-text" title="'' || H.task_name || ''">'' ||',
'    --     H.task_name || ''</span>'' AS task_name,',
'',
'--     ''<span class="hover-text" title="'' || H.TASK_NAME || ''">''',
'-- || REPLACE(RPAD('' '', (H.levels-4)*2),'' '',''&nbsp;'') || H.task_name AS task_name,',
'    H.task_name AS task_name,',
'',
'    H.parent_id,',
'',
'    REPLACE(H.assigned_to, '':'', '','') AS assigned_to,',
'',
'    CASE',
'        WHEN child.project_plan_line_id IS NULL ',
'        THEN NVL(split_and_map_employee_ids(H.assigned_to, '':''), ''Unassigned'')',
'        ELSE ''<span class="apex_disabled"></span>''',
'    END AS project_members,',
'',
'    CASE ',
'        WHEN child.project_plan_line_id IS NULL THEN ''Y'' ',
'        ELSE ''N'' ',
'    END AS enable_row_selector,',
'',
'    H.allocation_percentage,',
'    H.display_sequence,',
'    H.role,',
'    H.status,',
'    H.planned_start,',
'    H.planned_end,',
'    H.task_progress,',
'    H.predecessors,',
'    H.duration,',
'    H.efforts,',
'    H.type,',
'    H.workstream,',
'',
'    ''<span class="hover-text" title="'' || H.comments || ''">'' ||',
'        H.comments || ''</span>'' AS comments,',
'',
'    H.completion_percentage,',
'    H.levels,',
'    H.creation_date,',
'    H.created_by,',
'    H.ordering,',
'    H.project_plan_id,',
'    H.ACTUAL_START,',
'    H.ACTUAL_END,',
'',
'    CASE ',
'        WHEN H.active_flag = ''Y'' ',
'        THEN ''<span class="fa fa-check-square fa-x" style="color:green"></span>''',
'        ELSE ''<span class="fa fa-times-square fa-x" style="color:red"></span>''',
'    END AS active_flag,',
'',
'    --------------------------------------------------------------------',
'    -- HIERARCHICAL DISPLAY SEQUENCES (lev1..lev6)',
'    --------------------------------------------------------------------',
'    CASE ',
'        WHEN H.levels = 1 THEN H.display_sequence',
'        WHEN H.levels = 2 THEN H.p1_seq',
'        WHEN H.levels = 3 THEN H.p2_seq',
'        WHEN H.levels = 4 THEN H.p3_seq',
'        WHEN H.levels = 5 THEN H.p4_seq',
'        WHEN H.levels = 6 THEN H.p5_seq',
'        ELSE 0',
'    END AS lev1_display_seq,',
'',
'    CASE',
'        WHEN H.levels < 2 THEN 0',
'        WHEN H.levels = 2 THEN H.display_sequence',
'        WHEN H.levels = 3 THEN H.p1_seq',
'        WHEN H.levels = 4 THEN H.p2_seq',
'        WHEN H.levels = 5 THEN H.p3_seq',
'        WHEN H.levels = 6 THEN H.p4_seq',
'        ELSE 0',
'    END AS lev2_display_seq,',
'',
'    CASE',
'        WHEN H.levels < 3 THEN 0',
'        WHEN H.levels = 3 THEN H.display_sequence',
'        WHEN H.levels = 4 THEN H.p1_seq',
'        WHEN H.levels = 5 THEN H.p2_seq',
'        WHEN H.levels = 6 THEN H.p3_seq',
'        ELSE 0',
'    END AS lev3_display_seq,',
'',
'    CASE',
'        WHEN H.levels < 4 THEN 0',
'        WHEN H.levels = 4 THEN H.display_sequence',
'        WHEN H.levels = 5 THEN H.p1_seq',
'        WHEN H.levels = 6 THEN H.p2_seq',
'        ELSE 0',
'    END AS lev4_display_seq,',
'',
'    CASE',
'        WHEN H.levels < 5 THEN 0',
'        WHEN H.levels = 5 THEN H.display_sequence',
'        WHEN H.levels = 6 THEN H.p1_seq',
'        ELSE 0',
'    END AS lev5_display_seq,',
'',
'    CASE',
'        WHEN H.levels < 6 THEN 0',
'        WHEN H.levels = 6 THEN H.display_sequence',
'        ELSE 0',
'    END AS lev6_display_seq,',
'',
'    --------------------------------------------------------------------',
'    -- EXTRA COLUMNS',
'    --------------------------------------------------------------------',
'    H.wave_id,',
'    null as AI_Generation,',
'   CASE',
'',
'  WHEN H.TEMPLATE_ID IS NOT NULL',
'   AND H.CATEGORY IN (''Deliverable'',''Internal Deliverable'')',
'   AND child.project_plan_line_id IS NULL',
'  THEN',
'   CASE',
'            WHEN NVL(doc.GENERATION_STATUS, ''NOT_STARTED'') = ''IN_PROGRESS''',
'            THEN',
'                ''<span class="fsd-loader" ''',
'                || ''title="Document generation in progress"></span>''',
'            ELSE',
'                ''<span class="fa fa-play-circle js-generate-doc" ''',
'                || ''style="color: green; cursor: pointer;" ''',
'                || ''title="Generate Document" ''',
'                || ''data-plan-line="'' || H.PROJECT_PLAN_LINE_ID || ''" ''',
'                || ''data-template="''  || H.TEMPLATE_ID || ''" ''',
'                || ''data-project="''   || H.PRJ_ID || ''" ''',
'                || ''data-task="'' ',
'                || apex_escape.html_attribute(H.TASK_NAME) || ''">''',
'                || ''</span>''',
'        END',
'    ELSE',
'        ''<span class="fa fa-play-circle" ''',
'        || ''style="color: lightgray;"></span>''',
'        ',
'            ',
'        --       ''<span class="fa fa-play-circle js-generate-doc" '' ||',
'        --       ''style="color: green; cursor: pointer;" '' ||',
'        --       ''title="Generate Document" '' ||',
'        --       ''data-plan-line="'' || H.PROJECT_PLAN_LINE_ID || ''" '' ||',
'        --       ''data-template="''  || H.TEMPLATE_ID || ''" '' ||',
'        --       ''data-project="''   || H.PRJ_ID || ''" '' ||',
'        --       ''data-task="''      || apex_escape.html_attribute(H.TASK_NAME) || ''">'' ||',
'        --       ''</span>''',
'        --  ELSE',
'        --       ''<span class="fa fa-play-circle" style="color: lightgray;"></span>''',
'    END AS AI_Generation_new,',
'    (select count(*) ',
'       FROM CGCT_DELIVERABLE_API_DOCUMENT ',
'       WHERE project_plan_line_id=H.project_plan_line_id)',
'    -- ''1'' ',
'    as total_deliverables,',
'    CASE',
'      WHEN H.COMPONENT_PROMPT IS NULL THEN ',
'        ''<span style="color:#bc5090" class="fa fa-times"></span>''',
'        -- ''<span style="color:#321D2A" class="fa fa-plus-square"></span>''',
'      ELSE ',
'        ''<span class="fa fa-eye"></span>''',
'    END AS VIEW_PROMPT,',
'    CASE',
'    WHEN H.COMPONENT_PROMPT IS NOT NULL THEN',
'        ''f?p=&APP_ID.:1063:&SESSION.::NO::P1063_PROJECT_PLAN_LINE_ID,P1063_MODE:''',
'        || H.PROJECT_PLAN_LINE_ID',
'        || '',VIEW''',
'    ELSE',
'        ''f?p=&APP_ID.:1063:&SESSION.::NO::P1063_PROJECT_PLAN_LINE_ID,P1063_MODE:''',
'        || H.PROJECT_PLAN_LINE_ID',
'        || '',CREATE''',
'    END AS URL,',
'    null as Baselined,',
'    null as Download_FSD,',
'    ',
'    doc.GENERATED_PROJECT_ID,',
'    NVL(doc.GENERATION_STATUS, ''NOT_STARTED'') AS GENERATION_STATUS,',
'',
'    -- CASE ',
'    --     WHEN EXISTS (',
'    --         SELECT 1',
'    --         FROM CGCT_DELIVERABLE_API_DOCUMENT D',
'    --         WHERE D.PROJECT_PLAN_LINE_ID = H.PROJECT_PLAN_LINE_ID',
'    --     )',
'    --     THEN ',
'    -- ''<span class="fa fa-download js-download" ',
'    --   data-plan-id="'' || H.PROJECT_PLAN_LINE_ID || ''" ',
'    --   style="cursor:pointer; font-size:18px;"',
'    --   title="Download"></span>''',
'    ',
'    --------------------------------------------------------------------',
'    -- MAIN FSD DOWNLOAD LOGIC',
'    --------------------------------------------------------------------',
'',
'    CASE',
'    WHEN EXISTS (',
'        SELECT 1',
'        FROM CGCT_DELIVERABLE_API_DOCUMENT D',
'        WHERE D.PROJECT_PLAN_LINE_ID = H.PROJECT_PLAN_LINE_ID',
'    )',
'    AND doc.GENERATION_STATUS = ''IN_PROGRESS''',
'    THEN',
'        ''<span class="fsd-loader" title="FSD generation in progress"></span>''',
'',
'    WHEN EXISTS (',
'        SELECT 1',
'        FROM CGCT_DELIVERABLE_API_DOCUMENT D',
'        WHERE D.PROJECT_PLAN_LINE_ID = H.PROJECT_PLAN_LINE_ID',
'    )',
'    AND doc.GENERATION_STATUS = ''COMPLETED''',
'    THEN',
'        ''<span class="fa fa-download js-download" '' ||',
'        ''data-plan-id="'' || H.PROJECT_PLAN_LINE_ID || ''" '' ||',
'        ''data-project-id="'' || doc.GENERATED_PROJECT_ID || ''" '' ||',
'        ''data-document-id="'' || doc.DOCUMENT_ID || ''" '' ||',
'        ''style="cursor:pointer; font-size:18px;" '' ||',
'        ''title="Download FSD"></span>''',
'',
'    WHEN EXISTS (',
'        SELECT 1',
'        FROM CGCT_DELIVERABLE_API_DOCUMENT D',
'        WHERE D.PROJECT_PLAN_LINE_ID = H.PROJECT_PLAN_LINE_ID',
'    )',
'    AND doc.GENERATION_STATUS = ''FAILED''',
'    THEN',
'        ''<span class="fa fa-exclamation-triangle fsd-failed" '' ||',
'        ''title="FSD generation failed"></span>''',
'',
'    ELSE',
'        NULL',
'        ',
'-- END AS FSD_DOWNLOAD,',
'--     CASE',
'--         WHEN doc.GENERATION_STATUS = ''IN_PROGRESS'' THEN',
'--             ''<span class="fsd-loader" title="FSD generation in progress"></span>''',
'',
'--         WHEN doc.GENERATION_STATUS = ''COMPLETED'' THEN',
'--             ''<span class="fa fa-download js-download" '' ||',
'--             ''data-plan-id="'' || H.PROJECT_PLAN_LINE_ID || ''" '' ||',
'--             ''data-project-id="'' || doc.GENERATED_PROJECT_ID || ''" '' ||',
'--             ''style="cursor:pointer; font-size:18px;" '' ||',
'--             ''title="Download FSD"></span>''',
'',
'--         WHEN doc.GENERATION_STATUS = ''FAILED'' THEN',
'--             ''<span class="fa fa-exclamation-triangle fsd-failed" '' ||',
'--             ''title="FSD generation failed"></span>''',
'',
'--         ELSE',
'--             ''<span class="fa fa-download download-disabled" '' ||',
'--             ''style="font-size:18px;" '' ||',
'--             ''title="FSD not generated yet"></span>''',
'',
'      END AS FSD_DOWNLOAD,',
'',
'      -------------------------------------------------------',
'',
'CASE',
'    ------------------------------------------------------------------',
'    -- IN PROGRESS: show loader; no navigation to Page 1021',
'    ------------------------------------------------------------------',
'    WHEN H.TEMPLATE_ID IS NOT NULL',
'    --  AND H.CATEGORY IN (''Deliverable'', ''Internal Deliverable'')',
'     AND child.PROJECT_PLAN_LINE_ID IS NULL',
'     AND NVL(doc.GENERATION_STATUS, ''NOT_STARTED'') = ''IN_PROGRESS''',
'    THEN',
'        ''<span class="fsd-loader" '' ||',
'        ''title="Document generation in progress"></span>''',
'',
'    ------------------------------------------------------------------',
'    -- NOT STARTED / FAILED: show clickable green icon and open 1021',
'    ------------------------------------------------------------------',
'    WHEN H.TEMPLATE_ID IS NOT NULL',
'    --  AND H.CATEGORY IN (''Deliverable'', ''Internal Deliverable'')',
'    --  AND child.PROJECT_PLAN_LINE_ID IS NULL',
'     AND NVL(doc.GENERATION_STATUS, ''NOT_STARTED'')',
'         IN (''NOT_STARTED'', ''FAILED'',''COMPLETED'')',
'    THEN',
'        ''<a href="'' ||APEX_PAGE.GET_URL(',
'            p_page   => 1021,',
'            p_clear_cache => ''1021'',',
'            p_items       => ',
'                ''P1021_PROJECT_PLAN_LINE_ID,'' ||',
'                ''P1021_TASK_NAME,'' ||',
'                ''P1021_TEMPLATE_ID,'' ',
'                -- || ''P1021_PROJECT_ID''',
'                ,',
'            p_values      =>',
'                TO_CHAR(H.PROJECT_PLAN_LINE_ID) || '','' ||',
'                REPLACE(',
'                    REPLACE(',
'                        REPLACE(H.TASK_NAME, '','', '' ''),',
'                        CHR(10),',
'                        '' ''',
'                    ),',
'                    CHR(13),',
'                    '' ''',
'                ) || '','' ||',
'                TO_CHAR(H.TEMPLATE_ID) ',
'                -- || '','' ||',
'                -- TO_CHAR(H.PRJ_ID)',
'        ) ||',
'        ''">'' ||',
'        ''<span class="fa fa-play-circle" '' ||',
'        ''style="color:green;cursor:pointer;font-size:20px;" '' ||',
'        ''title="'' ||',
'        CASE',
'            WHEN doc.GENERATION_STATUS = ''FAILED''',
'            THEN ''Retry Document Generation''',
'            ELSE ''Generate Document''',
'        END ||',
'        ''"></span>'' ||',
'        ''</a>''',
'',
'    ------------------------------------------------------------------',
'    -- COMPLETED: show completed icon; no navigation',
'    ------------------------------------------------------------------',
'    -- WHEN H.TEMPLATE_ID IS NOT NULL',
'    --  AND H.CATEGORY IN (''Deliverable'', ''Internal Deliverable'')',
'    --  AND child.PROJECT_PLAN_LINE_ID IS NULL',
'    --  AND NVL(doc.GENERATION_STATUS, ''NOT_STARTED'') = ''COMPLETED''',
'    -- THEN',
'    --     ''<span class="fa fa-check-circle" '' ||',
'    --     ''style="color:green;font-size:20px;" '' ||',
'    --     ''title="Document Already Generated"></span>''',
'',
'    ------------------------------------------------------------------',
'    -- ROW IS NOT ELIGIBLE',
'    ------------------------------------------------------------------',
'    ELSE',
'        ''<span class="fa fa-play-circle" '' ||',
'        ''style="color:lightgray;cursor:not-allowed;'' ||',
'        ''pointer-events:none;font-size:20px;" '' ||',
'        ''title="Document generation is not available"></span>''',
'       ',
'END AS REPORT_ACTION,',
'',
'      -------------------------------------------------------',
'    (SELECT ''<span class="hover-text" title="'' ||',
'        apex_escape.html_attribute(PHASE_DISPLAY_NAME) || ''">'' ||',
'        apex_escape.html(PHASE_DISPLAY_NAME) ||',
'        ''</span>''',
'   FROM CGCT_PP_PROJECT_PHASE',
'  WHERE project_phase_id = H.phase_id',
') AS phase_id,',
' ',
'    (SELECT ''<span class="hover-text" title="'' ||',
'        apex_escape.html_attribute(PHASE_DISPLAY_NAME) || ''">'' ||',
'        apex_escape.html(PHASE_DISPLAY_NAME) ||',
'        ''</span>''',
'       FROM CGCT_PP_PROJECT_PHASE ',
'      WHERE project_phase_id = H.subphase_id) AS subphase_id,',
'',
'    NULL AS Actions,',
'    NULL AS Action',
'',
'FROM H',
'JOIN CGCT_PP_PROJECT_PLAN P ',
'      ON P.project_plan_id = H.project_plan_id',
'     AND P.project_id      = :P0_PROJECT_ID',
'     AND P.status          = ''Y''',
'LEFT JOIN cgct_project_templates tm ON tm.id = H.template_id',
'LEFT JOIN cgct_pp_plan_line child   ON child.parent_id = H.project_plan_line_id',
'',
'',
'-- LEFT JOIN CGCT_DELIVERABLE_API_DOCUMENT doc',
'--        ON doc.PROJECT_PLAN_LINE_ID = H.PROJECT_PLAN_LINE_ID',
'LEFT JOIN (',
'    SELECT *',
'    FROM (',
'        SELECT d.*,',
'               ROW_NUMBER() OVER (',
'                   PARTITION BY d.project_plan_line_id',
'                --    ORDER BY d.document_id DESC',
'                   ORDER BY d.deliverable_id DESC',
'               ) rn',
'        FROM CGCT_DELIVERABLE_API_DOCUMENT d',
'    )',
'    WHERE rn = 1',
') doc',
'ON doc.project_plan_line_id = H.project_plan_line_id',
'',
'',
'WHERE ( :P998_WAVE        IS NULL OR H.WAVE_ID    = :P998_WAVE )',
'AND H.levels > 3',
'-- AND ( :P998_PHASE_ID       IS NULL OR H.PHASE_ID   in( :P998_PHASE_ID ))',
'AND ( :P998_PHASE_ID IS NULL',
'      OR H.PHASE_ID IN (',
'            SELECT TO_NUMBER(column_value)',
'            FROM TABLE(APEX_STRING.SPLIT(:P998_PHASE_ID, '',''))',
'        )',
'    )',
'',
'AND ( :P998_SUB_PHASE   IS NULL OR H.SUBPHASE_ID = :P998_SUB_PHASE )',
'AND ( :P998_STATUS      IS NULL OR H.STATUS     = :P998_STATUS ) ',
'AND ( :P998_WORK_STREAM IS NULL OR H.WORKSTREAM = :P998_WORK_STREAM )',
'AND ( :P998_CATEGORY    IS NULL OR H.CATEGORY   = :P998_CATEGORY )',
'-- AND ( H.CATEGORY IN (''Deliverable'',''Internal Deliverable''))',
'and H.template_id is not null',
'',
'',
'AND (',
'  :P998_TASK_OWNER IS NULL',
'  OR UPPER(TRIM(H.ASSIGNED_TO)) IN (',
'       SELECT UPPER(TRIM(COLUMN_VALUE))',
'       FROM TABLE(APEX_STRING.SPLIT(:P998_TASK_OWNER, '':''))',
'     )',
')',
'',
'AND (',
'  :P998_UNASSIGNED IS NULL',
'  OR (',
'       :P998_UNASSIGNED = ''Unassigned''',
'       AND child.project_plan_line_id IS NULL',
'       AND H.assigned_to IS NULL',
'     )',
')',
'and H.task_number!=9973 --Remove Later',
'--------------------------------------------------------------------',
'-- FULL HIERARCHICAL SORT ORDER',
'--------------------------------------------------------------------',
'ORDER BY',
'    lev1_display_seq,',
'    lev2_display_seq,',
