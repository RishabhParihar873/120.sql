 p_id=>wwv_flow_imp.id(485971076508948251)
,p_process_sequence=>30
,p_parent_process_id=>wwv_flow_imp.id(485971480346948254)
,p_process_type=>'NATIVE_PLSQL'
,p_process_name=>'Refresh Data'
,p_static_id=>'refresh-data'
,p_process_sql_clob=>wwv_flow_string.join(wwv_flow_t_varchar2(
' DECLARE',
'    P_PRJ_ID        NUMBER:=:P0_PROJECT_ID;',
'BEGIN',
'',
'----------------------------BUSINESS REQUIREMENT----------------------------------------------',
'',
'    FOR I IN (SELECT  B.TOPIC_NAME,B.DESCRIPTION,B.SOURCE,B.COUNTRIES,B.KDD,b.id,B.INDUSTRY ',
'              FROM CGCT_BUSINESS_REQUIREMENTS b ',
'              join CGCT_PRJ_BUSINESS_REQUIREMENTS PBR ON PBR.SOLUTION_ID=B.ID ',
'            --   WHERE b.LAST_UPDATE_DATE >= (PBR.LAST_UPDATE_DATE)',
'            WHERE b.LAST_UPDATE_DATE >= PBR.LAST_UPDATE_DATE -- - (1/86400)',
'              AND ',
'              ENTITY_TAG= ''Standard''',
'              AND PBR.PRJ_ID=P_PRJ_ID',
'               ) ',
'    LOOP',
'    UPDATE CGCT_PRJ_BUSINESS_REQUIREMENTS',
'    SET TOPIC_NAME=I.TOPIC_NAME,',
'        DESCRIPTION=I.DESCRIPTION,',
'        SOURCE=I.SOURCE,',
'        COUNTRIES=I.COUNTRIES,',
'        KDD=I.KDD,',
'        INDUSTRY=I.INDUSTRY,',
'        ENTITY_TAG= ''Standard'',',
'        UPDATE_SOURCE=''SOL_REFRESH'',',
'        LAST_UPDATE_DATE=sysdate,',
'        last_updated_by=:P0_USER_ID_EMAIL',
'    WHERE SOLUTION_ID=I.ID',
'   AND PRJ_ID=P_PRJ_ID;',
'',
'    END LOOP;',
'',
'-------------------------------------------SYSTEM REQUIREMENT----------------------------------------------------',
'',
'    FOR req IN (SELECT  R.ID,R.DESCRIPTION,R.DETAIL,R.L1_ID,R.L2_ID,R.L3_ID,R.L4_ID,r.BUSINESS_REQUIREMENT,R.TYPE_LOV',
'              FROM CGCT_REQUIREMENT r ',
'              join CGCT_PRJ_REQUIREMENT PR ON PR.SOLUTION_ID=R.ID ',
'              WHERE R.LAST_UPDATE_DATE >= (PR.LAST_UPDATE_DATE)',
'              AND ',
'              ENTITY_TAG= ''Standard''',
'              AND PR.PRJ_ID=P_PRJ_ID',
'               ) ',
'    LOOP',
'    UPDATE CGCT_PRJ_REQUIREMENT',
'    SET DESCRIPTION=req.DESCRIPTION,',
'        DETAIL=req.DETAIL,',
'        L1_ID=req.L1_ID,',
'        L2_ID=req.L2_ID,',
'        UPDATE_SOURCE=''SOL_REFRESH'',',
'        L3_ID=req.L3_ID,',
'        L4_ID=req.L4_ID,',
'        TYPE_LOV=REQ.TYPE_LOV,',
'        BUSINESS_REQUIREMENT=(select id FROM CGCT_PRJ_BUSINESS_REQUIREMENTS ',
'                                WHERE SOLUTION_ID=REQ.BUSINESS_REQUIREMENT AND PRJ_ID=P_PRJ_ID)',
'    WHERE SOLUTION_ID=REQ.ID',
'   AND PRJ_ID=P_PRJ_ID;',
'    END LOOP;',
'',
'-----------------------------------------PERSONA-------------------------------------------------------',
'    FOR pe IN (SELECT  p.ID,p.TOPIC_NAME,p.DESCRIPTION,P.DOMAIN_ID,P.MODULE_ID,',
'                P.PERSONA_SHORT_CODE,P.PERSONA_CATEGORY',
'              FROM CGCT_PERSONA p',
'              join CGCT_PRJ_PERSONA PR ON PR.SOLUTION_ID=P.ID ',
'              WHERE P.LAST_UPDATE_DATE >= (PR.LAST_UPDATE_DATE)',
'              AND ENTITY_TAG= ''Standard''',
'              AND PR.PRJ_ID=P_PRJ_ID',
'               ) ',
'    LOOP ',
'    UPDATE CGCT_PRJ_PERSONA',
'    SET TOPIC_NAME=PE.TOPIC_NAME,',
'        DESCRIPTION=PE.DESCRIPTION,',
'        DOMAIN_ID=PE.DOMAIN_ID,',
'        UPDATE_SOURCE=''SOL_REFRESH'',',
'        MODULE_ID=PE.MODULE_ID,',
'        PERSONA_SHORT_CODE=PE.PERSONA_SHORT_CODE,',
'        PERSONA_CATEGORY=PE.PERSONA_CATEGORY',
'    WHERE SOLUTION_ID=PE.ID',
'   AND PRJ_ID=P_PRJ_ID;',
'   END LOOP;',
'',
'----------------------------------------USER STORY-------------------------------------------',
'FOR us IN (SELECT  P.ID,P.NAME, P.DETAIL, P.L3_ID, P.WORKSTREAM_ID,P.COMPONENT_ID,',
'        P.SUMMARY,P.L1_ID,P.L2_ID,P.MODULE_ID,',
'        P.L4_ID,P.REQUIREMENT_ID,p.PERSONA_ID,p.ACCEPTANCE_CRITERIA',
'              FROM CGCT_USER_STORY p',
'              join CGCT_PRJ_USER_STORY PR ON PR.STORY_ID=P.ID ',
'              WHERE P.LAST_UPDATE_DATE >= (PR.LAST_UPDATE_DATE)',
'              AND ENTITY_TAG= ''Standard''',
'              AND PR.PRJ_ID=P_PRJ_ID',
'               ) ',
'    LOOP ',
'    UPDATE CGCT_PRJ_USER_STORY',
'    SET NAME=us.NAME,',
'        DETAIL=us.DETAIL,',
'        L3_ID=us.L3_ID,',
'        WORKSTREAM_ID=us.WORKSTREAM_ID,',
'        COMPONENT_ID=us.COMPONENT_ID,',
'        UPDATE_SOURCE=''SOL_REFRESH'',',
'        SUMMARY=us.SUMMARY,',
'        L1_ID=us.L1_ID,',
'        L2_ID=us.L2_ID,',
'        MODULE_ID=us.MODULE_ID,',
'        L4_ID=us.L4_ID,',
'        REQUIREMENT_ID=us.REQUIREMENT_ID,',
'        ACCEPTANCE_CRITERIA=us.ACCEPTANCE_CRITERIA',
'    WHERE STORY_ID=us.ID',
'   AND PRJ_ID=P_PRJ_ID;',
'   END LOOP;',
'',
'----------------------------------------TEST CASES------------------------------------------',
'    FOR TC IN (SELECT  P.ID,P.NAME, P.DETAIL, P.L3_ID, P.TEST_CODE,P.USER_STORY_ID,',
'        P.L1_ID,P.L2_ID,P.L4_ID',
'              FROM CGCT_TEST_CASES p',
'              join CGCT_PRJ_TEST_CASES PR ON PR.CASE_ID=P.ID ',
'              WHERE P.LAST_UPDATE_DATE >= (PR.LAST_UPDATE_DATE)',
'              AND ENTITY_TAG= ''Standard''',
'              AND PR.PRJ_ID=P_PRJ_ID',
'               )',
'    LOOP',
'    UPDATE CGCT_PRJ_TEST_CASES',
'    SET NAME=TC.NAME,',
'        DETAIL=TC.DETAIL,',
'        L3_ID=TC.L3_ID,',
'        TEST_CODE=TC.TEST_CODE,',
'        UPDATE_SOURCE=''SOL_REFRESH'',',
'        USER_STORY_ID=(SELECT ID FROM CGCT_PRJ_USER_STORY WHERE STORY_ID= TC.USER_STORY_ID),',
'        L1_ID=TC.L1_ID,',
'        L2_ID=TC.L2_ID,',
'        L4_ID=TC.L4_ID',
'    WHERE CASE_ID=TC.ID',
'   AND PRJ_ID=P_PRJ_ID;',
'   END LOOP;',
'',
'-------------------------------------TEST CASE STEP------------------------------------------------------',
'    FOR TS IN (SELECT P.ID,P.TEST_CASE_ID,P.STEP_NO,P.STEP,P.EXPECTED_RESULT',
'            FROM CGCT_TEST_CASE_STEP p',
'              join CGCT_PRJ_TEST_CASE_STEP PR ON PR.STEP_ID=P.ID ',
'              WHERE P.LAST_UPDATE_DATE >= (PR.LAST_UPDATE_DATE)',
'              AND ENTITY_TAG= ''Standard''',
'              AND PR.PRJ_ID=P_PRJ_ID)',
'    LOOP',
'    UPDATE CGCT_PRJ_TEST_CASE_STEP',
'    SET STEP_NO=TS.STEP_NO,',
'        STEP=TS.STEP,',
'        EXPECTED_RESULT=TS.EXPECTED_RESULT,',
'        TEST_CASE_ID=(SELECT ID FROM CGCT_PRJ_TEST_CASES WHERE  CASE_ID= TS.TEST_CASE_ID)',
'    WHERE STEP_ID=TS.ID',
