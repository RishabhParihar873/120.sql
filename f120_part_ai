wwv_flow_imp_page.create_page_item(
 p_id=>wwv_flow_imp.id(883033200721185804)
,p_name=>'P1045_CONSOLIDATED_PROMPT'
,p_item_sequence=>380
,p_use_cache_before_default=>'NO'
,p_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'SELECT',
'       CASE ',
'         WHEN (',
'           SELECT MAX(rp.PROMPT)',
'             FROM CGCT_PP_ROLES_PROMPT rp',
'            WHERE UPPER(rp.ROLES) = UPPER(:P1045_ROLE)',
'         ) IS NOT NULL',
'         THEN RTRIM(TRIM((',
'           SELECT MAX(rp.PROMPT)',
'             FROM CGCT_PP_ROLES_PROMPT rp',
'            WHERE UPPER(rp.ROLES) = UPPER(:P1045_ROLE)',
'         )), ''.'') || ''. '' || CHR(10) || CHR(10)',
'       END ||',
'',
'    --    CASE ',
'    --      WHEN (',
'    --        SELECT MAX(tp.PROMPT)',
'    --          FROM CGCT_PROJECT_TEMPLATES tp',
'    --         WHERE UPPER(tp.TEMPLATE_CODE) = UPPER(:P1045_TEMPLATE)',
'    --      ) IS NOT NULL',
'    --      THEN RTRIM(TRIM((',
'    --        SELECT MAX(tp.PROMPT)',
'    --          FROM CGCT_PROJECT_TEMPLATES tp',
'    --         WHERE UPPER(tp.TEMPLATE_CODE) = UPPER(:P1045_TEMPLATE)',
'    --      )), ''.'') || ''. '' || CHR(10) || CHR(10)',
'    --    END ||',
'CASE',
'  WHEN (',
'    SELECT MAX(tp.TEMPLATE_NAME)',
'      FROM CGCT_PROJECT_TEMPLATES tp',
'     WHERE UPPER(tp.TEMPLATE_CODE) = UPPER(:P1045_TEMPLATE)',
'  ) IS NOT NULL',
'  THEN ''Using attached template and below prompts, I want to generate ''',
'       || (SELECT MAX(tp.TEMPLATE_NAME)',
'             FROM CGCT_PROJECT_TEMPLATES tp',
'            WHERE UPPER(tp.TEMPLATE_CODE) = UPPER(:P1045_TEMPLATE))',
'       || ''.''',
'       || CHR(10) || CHR(10)',
'       || RTRIM(TRIM((',
'            SELECT MAX(tp.PROMPT)',
'              FROM CGCT_PROJECT_TEMPLATES tp',
'             WHERE UPPER(tp.TEMPLATE_CODE) = UPPER(:P1045_TEMPLATE)',
'          )), ''.'')',
'       || ''.''',
'       || CHR(10) || CHR(10)',
'END ||',
'',
'       CASE ',
'         WHEN pm.CLIENT_PROMPT IS NOT NULL ',
'         THEN RTRIM(TRIM(pm.CLIENT_PROMPT), ''.'') || ''. '' || CHR(10) || CHR(10)',
'       END ||',
'',
'       CASE ',
'         WHEN pm.PRJ_PROMPT IS NOT NULL ',
'         THEN RTRIM(TRIM(pm.PRJ_PROMPT), ''.'') || ''. '' || CHR(10) || CHR(10)',
'       END ||',
'',
'       CASE ',
'         WHEN (',
'           SELECT MAX(wp.PROMPT)',
'             FROM CGCT_PP_WORKSTREAM_PROMPT wp',
'            WHERE UPPER(wp.WORKSTREAM) = UPPER(:P1045_WORKSTREAM)',
'         ) IS NOT NULL',
'         THEN RTRIM(TRIM((',
'           SELECT MAX(wp.PROMPT)',
'             FROM CGCT_PP_WORKSTREAM_PROMPT wp',
'            WHERE UPPER(wp.WORKSTREAM) = UPPER(:P1045_WORKSTREAM)',
'         )), ''.'') || ''. '' || CHR(10) || CHR(10)',
'       END ||',
'',
'       CASE ',
'         WHEN (',
'           SELECT MAX(pt.PROMPT)',
'             FROM CGCT_PHASE_TYPE pt',
'            WHERE UPPER(pt.PHASE_TYPE) = UPPER(:P1045_PHASE)',
'              AND pt.PARENT_PHASE_ID IS NULL',
'         ) IS NOT NULL',
'         THEN RTRIM(TRIM((',
'           SELECT MAX(pt.PROMPT)',
'             FROM CGCT_PHASE_TYPE pt',
'            WHERE UPPER(pt.PHASE_TYPE) = UPPER(:P1045_PHASE)',
'              AND pt.PARENT_PHASE_ID IS NULL',
'         )), ''.'') || ''. '' || CHR(10) || CHR(10)',
'       END ||',
'',
'       CASE ',
'         WHEN (',
'           SELECT MAX(spt.PROMPT)',
'             FROM CGCT_PHASE_TYPE spt',
'            WHERE UPPER(spt.PHASE_TYPE) = UPPER(:P1045_SUB_PHASE)',
'              AND spt.PARENT_PHASE_ID IS NOT NULL',
'         ) IS NOT NULL',
'         THEN RTRIM(TRIM((',
'           SELECT MAX(spt.PROMPT)',
'             FROM CGCT_PHASE_TYPE spt',
'            WHERE UPPER(spt.PHASE_TYPE) = UPPER(:P1045_SUB_PHASE)',
'              AND spt.PARENT_PHASE_ID IS NOT NULL',
'         )), ''.'') || ''. '' || CHR(10) || CHR(10)',
'       END ||',
'       ',
'       CASE',
'         WHEN :P1045_COMPONENT IS NOT NULL',
'         THEN RTRIM(TRIM(:P1045_COMPONENT), ''.'') || ''. '' || CHR(10) || CHR(10)',
'',
'   ',
'',
'       END AS FINAL_PROMPT',
'  FROM CGCT_PROJECT_MASTER pm',
' WHERE pm.ID = :P0_PROJECT_ID;'))
,p_source_type=>'QUERY'
