'AND ( H.CATEGORY IN (''Deliverable'',''Internal Deliverable''))',
'and H.template_id is not null',
'',
'',
'AND (',
'  :P1055_TASK_OWNER IS NULL',
'  OR UPPER(TRIM(H.ASSIGNED_TO)) IN (',
'       SELECT UPPER(TRIM(COLUMN_VALUE))',
'       FROM TABLE(APEX_STRING.SPLIT(:P1055_TASK_OWNER, '':''))',
'     )',
')',
'',
'AND (',
'  :P1055_UNASSIGNED IS NULL',
'  OR (',
'       :P1055_UNASSIGNED = ''Unassigned''',
'       AND child.project_plan_line_id IS NULL',
'       AND H.assigned_to IS NULL',
'     )',
')',
'--------------------------------------------------------------------',
'-- FULL HIERARCHICAL SORT ORDER',
'--------------------------------------------------------------------',
'ORDER BY',
'    lev1_display_seq,',
'    lev2_display_seq,',
'    lev3_display_seq,',
'    lev4_display_seq,',
'    lev5_display_seq,',
'    lev6_display_seq,',
'     H.template_id DESC',
'-- FETCH FIRST 10 ROWS ONLY',
'; '))
