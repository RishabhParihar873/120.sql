wwv_flow_imp_page.create_page_validation(
 p_id=>wwv_flow_imp.id(479889708579957380)
,p_validation_name=>'Kdd_id validation'
,p_static_id=>'kdd-id-validation'
,p_validation_sequence=>110
,p_validation=>wwv_flow_string.join(wwv_flow_t_varchar2(
'DECLARE',
'    -- Variable declarations',
'    L_L3_NAME        NUMBER;',
'    l_str            VARCHAR2(1000);',
'    l_cnt            NUMBER := 0;',
'    l_id             number;',
'    k_id             NUMBER;',
'',
'    CURSOR c_data IS',
'        -- Cursor definition',
'        SELECT',
'            p.col001,  -- l1_name,',
'            p.col002,  -- l2_name,',
'            p.col003, -- l3_name,',
'            p.col004, -- topic_name,',
'            p.col005, -- description,',
'            p.col006, -- guideline,',
'            p.col007, -- decision_agreed,',
'            p.col008, -- decision_owner,',
'            p.col009, -- ID,',
'            p.line_number AS line_number  -- Include line_number in cursor',
'        FROM',
'            apex_application_temp_files f,',
'            TABLE(apex_data_parser.parse(',
'                p_content     => f.blob_content,',
'                p_file_name   => f.filename,',
'                p_file_profile => apex_data_loading.get_file_profile(p_static_id => ''Load_Data''),',
'                p_max_rows    => 1000',
'            )) p',
'        WHERE',
'            f.name = :P1070_FILE',
'            AND p.line_number != 1',
'        ORDER BY p.col004;',
'',
'BEGIN',
'    l_str := NULL;',
'    l_cnt := 0;',
'',
'    FOR i IN c_data LOOP',
'        -- Only proceed if p.col009 is not null',
'        IF i.col009 IS NOT NULL THEN',
'            -- Fetch L3_ID',
'            SELECT L3_ID INTO l_id ',
'            FROM CGCT_PROCESS_L3 ',
'            WHERE UPPER(L3_NAME) = UPPER(i.col003);',
'            ',
'            -- Check if the KDD ID exists',
'            SELECT COUNT(*) INTO k_id ',
'            FROM CGCT_PRJ_KEY_DECISION_DOCS',
'            WHERE ID = i.col009 ;',
