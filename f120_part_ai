    '    .widget()',
    '    .interactiveGrid("getViews", "grid");',
    ' ',
    'var model = grid.model;',
    'var selectedRecords = this.data.selectedRecords;',
    ' ',
    'if (!selectedRecords || selectedRecords.length === 0) {',
    '    return;',
    '}',
    ' ',
    'var newRecord = selectedRecords[0];',
    ' ',
    'var status = model.getValue(',
    '    newRecord,',
    '    "GENERATION_STATUS"',
    ');',
    ' ',
    '// Failed document - do nothing',
    'if (status === "FAILED") {',
    '    return;',
    '}',
    ' ',
    '// If the selected row is already the baselined row,',
    '// do not show the popup',
    'var baselined = model.getValue(',
    '    newRecord,',
    '    "BASELINED"',
    ');',
    ' ',
    'if (baselined === "Y") {',
    '    return;',
    '}',
    ' ',
    ' ',
    '// Find the previously baselined row',
    'var previousRecord = null;',
    ' ',
    'model.forEach(function(record) {',
    ' ',
    '    var recordBaselined = model.getValue(',
    '        record,',
    '        "BASELINED"',
    '    );',
    ' ',
    '    if (recordBaselined === "Y") {',
    '        previousRecord = record;',
    '    }',
    '});',
    ' ',
    'if (!previousRecord) {',
    '    return;',
    '}',
    ' ',
    ' ',
    '// Show confirmation popup',
    'apex.message.confirm(',
    '    "You are changing the Baselined Document selection.",',
    '    function(ok) {',
    ' ',
    '        if (ok) {',
    ' ',
    '            // OK - keep the newly selected row',
    '            var newDeliverableId = model.getValue(',
    '                newRecord,',
    '                "DELIVERABLE_ID"',
    '            );',
    ' ',
    '            apex.item("P1093_SELECTED_DELIVERABLE_ID")',
    '                .setValue(newDeliverableId);',
    ' ',
    '        } else {',
    ' ',
    '            // Cancel - restore previous baselined row',
    '            grid.setSelectedRecords(',
    '                [previousRecord],',
    '                false,',
    '                true',
    '            );',
    ' ',
    '            var previousDeliverableId = model.getValue(',
    '                previousRecord,',
    '                "DELIVERABLE_ID"',
    '            );',
    ' ',
    '            apex.item("P1093_SELECTED_DELIVERABLE_ID")',
    '                .setValue(previousDeliverableId);',
    '        }',
    '    }',
    ');',
