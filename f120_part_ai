'        apex_debug.message(',
'            ''Pipeline Status: '' || l_pipeline_status ||',
'            '' %: '' || NVL(TO_CHAR(l_pct_complete), ''0'') ||',
'            '' Attempt: '' || l_attempts',
'        );',
'',
'        EXIT WHEN l_pipeline_status = ''COMPLETED'';',
'',
