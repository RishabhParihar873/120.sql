'        ''Content-Type: '' || l_mime_type ||',
'        chr(13) || chr(10) ||',
'        chr(13) || chr(10)',
'    );',
'',
'    append_blob(l_body_blob, l_file_blob);',
'',
'    append_text(',
'        l_body_blob,',
'        chr(13) || chr(10) ||',
'        ''--'' || l_boundary || ''--'' ||',
'        chr(13) || chr(10)',
'    );',
'',
'    apex_web_service.g_request_headers.delete;',
'',
'    apex_web_service.g_request_headers(1).name  := ''X-API-Key'';',
'    apex_web_service.g_request_headers(1).value := l_user_api_key;',
'',
'    apex_web_service.g_request_headers(2).name  := ''Content-Type'';',
'    apex_web_service.g_request_headers(2).value :=',
'        ''multipart/form-data; boundary='' || l_boundary;',
'',
'    l_response := apex_web_service.make_rest_request(',
'        p_url         => l_base_url || ''/sources'',',
'        p_http_method => ''POST'',',
'        p_body_blob   => l_body_blob',
'    );',
'',
'    if apex_web_service.g_status_code not in (200, 201) then',
'        raise_application_error(',
'            -20011,',
'            ''Source upload failed. HTTP Status: '' ||',
'            apex_web_service.g_status_code ||',
'            '' Response: '' || dbms_lob.substr(l_response, 4000, 1)',
'        );',
'    end if;',
'',
'    select json_value(l_response, ''$.id'')',
'      into l_source_id',
'      from dual;',
'',
'    if l_body_blob is not null and dbms_lob.istemporary(l_body_blob) = 1 then',
'        dbms_lob.freetemporary(l_body_blob);',
'    end if;',
'',
'        ----------------------------------------------------------------------------',
'        -- Wait for source processing',
'        ----------------------------------------------------------------------------',
'        apex_debug.message(',
'            ''Source uploaded. Source ID = '' || l_source_id',
'        );',
' ',
'        apex_debug.message(',
'            ''Waiting 30 seconds before generation...''',
'        );',
' ',
'        apex_util.pause(30);',
' ',
'        apex_debug.message(',
'            ''Wait complete. Starting generation.''',
'        );',
'',
'    --------------------------------------------------------------------',
'    -- 4. Generate Document',
'    --------------------------------------------------------------------',
'    apex_web_service.g_request_headers.delete;',
'',
'    apex_web_service.g_request_headers(1).name  := ''X-API-Key'';',
'    apex_web_service.g_request_headers(1).value := l_user_api_key;',
'',
'    apex_web_service.g_request_headers(2).name  := ''Content-Type'';',
'    apex_web_service.g_request_headers(2).value := ''application/json'';',
'',
'    l_body :=',
'        json_object(',
'            ''template_id'' value l_template_id,',
'            ''prompt_id'' value l_prompt_id,',
'            ''source_ids'' value json_array(l_source_id),',
'            ''variables'' value json_object(',
'                ''project_context'' value nvl(',
'                    :P1029_PROJECT_CONTEXT,',
'                    ''TDDforKaizen''',
'                )',
'            ),',
'            ''provider'' value ''genai_gateway''',
'        );',
'',
'    l_response := apex_web_service.make_rest_request(',
'        p_url              => l_base_url || ''/generate'',',
'        p_http_method      => ''POST'',',
'        p_body             => l_body,',
'        p_transfer_timeout => 600',
'    );',
'',
'    if apex_web_service.g_status_code not in (200, 201, 202) then',
'        raise_application_error(',
'            -20012,',
'            ''Document generation failed. HTTP Status: '' ||',
'            apex_web_service.g_status_code ||',
'            '' Response: '' || dbms_lob.substr(l_response, 4000, 1)',
'        );',
'    end if;',
'',
'    select json_value(l_response, ''$.job_id''),',
'           json_value(l_response, ''$.document_id'')',
'      into l_job_id,',
'           l_document_id',
'      from dual;',
'',
'    --------------------------------------------------------------------',
'    -- 5. Set Status Message',
'    --------------------------------------------------------------------',
'    if l_document_id is null then',
'        :P1029_STATUS_MSG :=',
'            ''Prompt created and generation submitted. Prompt ID: '' ||',
'            l_prompt_id ||',
'            '', Job ID: '' ||',
'            l_job_id ||',
'            ''. Please check job status.'';',
'    else',
'        :P1029_STATUS_MSG :=',
'            ''Document generated successfully. Prompt ID: '' ||',
'            l_prompt_id ||',
'            '', Document ID: '' ||',
'            l_document_id;',
'    end if;',
'',
'    apex_debug.message(''JOB_FILE: '' || dbms_lob.substr(l_response, 4000, 1));',
'',
'exception',
'    when others then',
'        if l_body_blob is not null and dbms_lob.istemporary(l_body_blob) = 1 then',
'            dbms_lob.freetemporary(l_body_blob);',
'        end if;',
'',
'        raise;',
'end;'))
