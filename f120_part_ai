'SELECT',
'        CASE',
'        WHEN',
'                connect_by_isleaf = 1',
'        THEN',
'                0',
'        WHEN',
'                level = 1',
'        THEN',
'                1',
'        ELSE',
'                -1',
'        END as status_1,',
'        level          ,',
'        CASE',
'        WHEN',
'                LEVEL = 1',
'        THEN',
'                REPLACE(LPAD(''#'', 0, ''#''), ''#'', ''&nbsp;'') || LINE_DETAIL',
'        WHEN',
'                LEVEL = 2',
'        THEN',
'                REPLACE(LPAD(''#'', 5, ''#''), ''#'', ''&nbsp;'') || LINE_DETAIL',
'        ELSE',
'                REPLACE(LPAD(''#'', 10, ''#''), ''#'', ''&nbsp;'') || LINE_DETAIL',
'        END AS LINE_DETAIL   ,',
'        PROJECT_PLAN_LINE_ID ,',
'        PROJECT_PLAN_ID      ,',
'        PLAN_TEMPLATE_LINE_ID,',
'        PROJECT_PHASE_ID     ,',
'        PROJECT_SUBPHASE_ID  ,',
'        PARENT_ID            ,',
'        DEPENDENCY           ,',
'        EFFORTS              ,',
'        PLANNED_START        ,',
'        PLANNED_END          ,',
'        ACTUAL_START         ,',
'        ACTUAL_END           ,',
'        COMPLETION_PERCENTAGE,',
'        STATUS               ,',
'        ROLE                 ,',
'        TYPE                 ,',
'        CATEGORY             ,',
'          (Case when  ( CATEGORY = ''EXT'' )  then  ',
'        ''<span aria-hidden="true" class="fa fa-download downclob"></span>''',
'       ',
'       ELSe',
'       NULL end    ',
'  ) as  DOWNLOAD_TEMPLATE_ID ,',
' -- DOWNLOAD_TEMPLATE_ID as new,',
'',
'               (SELECT a.TEMPLATE_FILE_PATH FROM CGCT_TEMPLATES a where a.id = cppl.download_template_id and rownum=1) as file_path,',
'        (SELECT a.TEMPLATE_FILE_NAME FROM CGCT_TEMPLATES a where a.id = cppl.download_template_id and rownum=1) as file_name,',
'        SIGN_OFF_STATUS      ,',
'        CREATED_BY     ,',
'        CREATION_DATE  ,',
'        UPDATED_BY     ,',
'        UPDATION_DATE  ,',
'        (',
'                select',
'                        cppp.phase_seq',
'                FROM',
'                        cgct_pp_project_phase cppp',
'                WHERE',
'                        cppp.PROJECT_PHASE_ID=cppl.PROJECT_PHASE_ID) lev1_display_seq,',
'        (',
'                select',
'                        cppp.phase_seq',
'                FROM',
'                        cgct_pp_project_phase cppp',
'                WHERE',
'                        cppp.PROJECT_PHASE_ID=cppl.PROJECT_SUBPHASE_ID) lev2_display_seq,',
'             CASE ',
'        WHEN LEVEL = 1 THEN display_sequence',
'        WHEN LEVEL = 2 THEN ( SELECT',
'                                cppl1.display_sequence',
'                        from',
'                                CGCT_PP_PLAN_LINE cppl1',
'                        where',
'                                cppl1.PROJECT_PLAN_LINE_ID = cppl.PARENT_ID)',
'        when level = 3 then  ( SELECT',
'                                cppl1.display_sequence',
'                        from',
'                                CGCT_PP_PLAN_LINE cppl1',
'                        where',
'                                cppl1.PROJECT_PLAN_LINE_ID =',
'        ( SELECT',
'                                cppl1.display_sequence',
'                        from',
'                                CGCT_PP_PLAN_LINE cppl1',
'                        where',
'                                cppl1.PROJECT_PLAN_LINE_ID =',
'        ( SELECT',
'                                cppl1.display_sequence',
'                        from',
'                                CGCT_PP_PLAN_LINE cppl1',
'                        where',
'                                cppl1.PROJECT_PLAN_LINE_ID = cppl.PARENT_ID)))',
'        ELSE display_sequence',
'    END AS lev3_display_seq,',
'',
'    CASE WHEN LEVEL = 1 THEN 0',
'    when Level =2 then display_sequence',
'    ELSE ( SELECT',
'                                cppl1.display_sequence',
'                        from',
'                                CGCT_PP_PLAN_LINE cppl1',
'                        where',
'                                cppl1.PROJECT_PLAN_LINE_ID = cppl.PARENT_ID) END AS lev4_display_seq,',
'',
'    CASE WHEN LEVEL = 1  THEN 0 ',
'    when LEVEL =2 then 0 ELSE display_sequence END AS lev5_display_seq,',
'        -----',
'',
'(',
'    SELECT',
'        LISTAGG(b.PLAN_WBS_ID_DEPENDENCY, '', '') WITHIN GROUP (ORDER BY b.PLAN_WBS_ID_DEPENDENCY) ',
'    FROM ',
'        CGCT_PLAN_WBS_DEPENDENCY_PP b ',
'    WHERE ',
'        b.PROJECT_PLAN_LINE_ID = cppl.PROJECT_PLAN_LINE_ID',
') AS dependency_plan_wbs,',
'',
'   ------',
'Null as VIEW_DEPENDENCY,',
'    PLAN_WBS_ID,',
'    PLAN_WBS_CODE',
'',
'        ',
' from CGCT_PP_PLAN_LINE cppl where  PROJECT_PLAN_ID=',
'        (',
'                select',
'                        PROJECT_PLAN_ID',
'                FROM',
'                        CGCT_PP_PROJECT_PLAN',
'                WHERE',
'                        Project_id=:P993_PROJECT_NAME',
'                and     Version=:P993_VERSION)',
'and     PROJECT_PHASE_ID   =NVL(:P993_PROJECT_PHASE,PROJECT_PHASE_ID)',
'and     PROJECT_SUBPHASE_ID=NVL(:P993_PROJECT_SUB_PHASE,PROJECT_SUBPHASE_ID)',
'start with NVL(PARENT_ID, 0) =0',
'connect by prior "PROJECT_PLAN_LINE_ID" = "PARENT_ID"',
''))
