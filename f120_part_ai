'                UPDATE CGCT_PRJ_KEY_DECISION_DOCS',
'                SET DESCRIPTION = P.DECISION_DESCRIPTION,',
'                    TOPIC_NAME = P.DECISION,',
'                    LAST_UPDATE_DATE = SYSDATE,',
'                    LAST_UPDATE_BY = :P0_USER_ID_EMAIL,',
'                    APPLICATION_ID= L_APP_ID,',
'                    PRJ_ID = :P0_PROJECT_ID',
'                WHERE TOPIC_NAME = P.DECISION',
'                AND MODULE_ID = V_MODULE_ID',
'                AND DOMAIN_ID = V_DOMAIN_ID',
'                AND APPLICATION_ID=:P0_APPLICATION_ID',
'             AND PRJ_ID=:P0_PROJECT_ID;',
'',
'            ELSE',
'                -- Insert new record',
'                INSERT INTO CGCT_PRJ_KEY_DECISION_DOCS (',
'                    ID, TOPIC_NAME, DESCRIPTION, DOMAIN_ID, MODULE_ID,',
'                    CREATION_DATE, CREATED_BY, ACTIVE_FLAG,APPLICATION_ID,PRJ_ID',
'                ) VALUES (',
'                    NULL, P.DECISION, P.DECISION_DESCRIPTION, V_DOMAIN_ID, V_MODULE_ID,',
'                    SYSDATE, :P0_USER_ID, ''Y'',L_APP_ID,:P0_PROJECT_ID',
'                );',
'            END IF;',
'',
'            COMMIT;',
'',
'        EXCEPTION',
'            WHEN OTHERS THEN',
