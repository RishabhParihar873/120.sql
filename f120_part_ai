'    SELECT :P0_PRJ_ID,D.DOMAIN_ID,D.MODULE_ID,''Y'',:P0_USER_ID,SYSDATE,:P0_USER_ID,SYSDATE',
'    FROM CGCT_TMP_DOMAIN_MODULE_MAPPING D',
'    WHERE PROJECT_ID=:P0_PRJ_ID',
');',
'delete from CGCT_TMP_DOMAIN_MODULE_MAPPING where PROJECT_ID=:P0_PRJ_ID;',
'',
'INSERT INTO CGCT_PRJ_BUSINESS_REQUIREMENTS(TOPIC_NAME,DESCRIPTION,SOURCE,COUNTRIES,KDD,APPLICATION_ID,PRJ_ID,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATED_BY,ACTIVE_FLAG)',
