'DECLARE',
'  v_prj_id    NUMBER := :P0_PRJ_ID;           -- Replace with your page item',
'  v_req_id    NUMBER := :P1071_SYSTEM_REQ;   -- Replace with your page item (System Requirement ID)',
'  v_sr_tag    VARCHAR2(50);',
'BEGIN',
'',
'    SELECT NVL(HIERARCHY_TAG, ''Standard'')',
'      INTO v_sr_tag',
'      FROM CGCT_PRJ_REQUIREMENT',
'     WHERE ID = v_req_id',
'       AND PRJ_ID = v_prj_id;',
'',
'  --IF :APEX$ROW_STATUS = ''I'' THEN',
'',
'   IF UPPER(v_sr_tag) = UPPER(''Standard'') THEN  ',
'    -----------------------------------------------------------',
'    -- 1) Update System Requirement (parent)',
'    -----------------------------------------------------------',
'    UPDATE CGCT_PRJ_REQUIREMENT r',
'       SET r.HIERARCHY_TAG = ''STD Modified''',
'     WHERE r.ID = v_req_id',
'       AND r.PRJ_ID = v_prj_id',
'       AND r.HIERARCHY_TAG <> ''STD Modified'';',
'',
'    -----------------------------------------------------------',
'    -- 2) Update Business Requirement (ancestor)',
'    -----------------------------------------------------------',
'    UPDATE CGCT_PRJ_BUSINESS_REQUIREMENTS b',
'       SET b.HIERARCHY_TAG = ''STD Modified''',
'     WHERE b.PRJ_ID = v_prj_id',
'       AND b.HIERARCHY_TAG <> ''STD Modified''',
'       AND EXISTS (',
'             SELECT 1',
'               FROM CGCT_PRJ_REQUIREMENT r',
'              WHERE r.ID = v_req_id',
'                AND r.PRJ_ID = v_prj_id',
'                AND r.BUSINESS_REQUIREMENT = b.ID',
'           );',
'   END IF;',
'  --END IF; ',
'END;'))
