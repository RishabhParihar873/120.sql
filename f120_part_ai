'    l_count NUMBER;',
'',
'BEGIN',
'',
'    ------------------------------------------------------------',
'    -- 1. CREATE PROJECT',
'    ------------------------------------------------------------',
'    SELECT ''ICT1-'' || ICT_PROJECT_SEQ.NEXTVAL',
'    INTO l_project_code',
'    FROM dual;',
'',
'    l_task_name := :P1021_TASK_NAME;',
'    -- select EMPLOYEE_NAME into l_created_by from CGCT_APP_USERS where USER_ID=:P0_USER_ID_EMAIL;',
'',
'    l_body := JSON_OBJECT(',
'        ''project_code'' VALUE l_project_code,',
'        -- ''project_name'' VALUE ''ICT_PROJECT'',',
'        -- ''project_name'' VALUE :P1021_TASK_NAME,',
'        ''project_name'' VALUE l_task_name,',
'        ''project_type'' VALUE ''INTEGRATION'',',
'        ''fsd_template_code'' VALUE ''HCM_INTEGRATION_V1''',
