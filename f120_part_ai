,p_plug_display_sequence=>50
,p_plug_display_point=>'SUB_REGIONS'
,p_plug_item_display_point=>'ABOVE'
,p_query_type=>'SQL'
,p_plug_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'WITH req_cte AS (',
'    select distinct(r.ID),',
'     (select listagg(l.description, '', '') within group(order by l.description) ',
'        from cgct_lookup_values l',
'        where instr('':''|| r.countries || '':'', '':'' ||l.id|| '':'')>0',
'        ) as Countries,',
'        ''<span class="hover-text" title="'' || r.DESCRIPTION  || ''">'' || r.DESCRIPTION || ''</span>'' AS DESCRIPTION,',
'        ''<span class="hover-text" title="'' || r.DETAIL  || ''">'' || r.DETAIL || ''</span>'' AS DETAIL,',
'       --r.DESCRIPTION,',
'       r.PRJ_ID,',
'       --r.PHASE_ID,',
'       --r.DETAIL,',
'    --    r.L1_ID,',
'       ''<span class="hover-text" title="'' || m.l1_name || ''">'' || m.l1_name || ''</span>'' AS L1_ID,',
'    --    r.L2_ID,',
'       ''<span class="hover-text" title="'' || m.l2_name || ''">'' || m.l2_name || ''</span>'' AS L2_ID,',
'       ''<span class="hover-text" title="'' || L4.l4_name || ''">'' || l4.l4_name || ''</span>'' AS L4_ID,',
'       ''<span class="hover-text" title="'' || m.l3_name || ''">'' || m.l3_name || ''</span>'' AS L3_ID,',
'    --    r.L3_ID,',
'    --    r.L4_ID,',
'    ''<span class="hover-text" title="'' || (select TOPIC_NAME from cgct_prj_business_requirements where id=business_requirement)|| ''">'' ',
'            || r.BUSINESS_REQUIREMENT ',
'        || ''</span>'' AS BUSINESS_REQUIREMENT,',
'       ',
'       --r.BUSINESS_REQUIREMENT,',
'        r.type_lov,',
'        CASE ',
'            WHEN (r.LOC_ENABLED IS NULL) THEN NULL ',
'            ELSE ''<span aria-hidden="true" class="fa fa-check"></span>'' ',
'        END AS LOC_ENABLED,',
'        r.source,',
'       r.ACTIVE_FLAG,',
'       r.CREATION_DATE,',
'       r.CREATED_BY,',
'       r.LAST_UPDATE_DATE,',
'       r.LAST_UPDATED_BY,',
'       r.COPY_FLAG,',
'       m.DOMAIN_NAME,',
'       m.MODULE_SHORT_NAME,',
'       br.INDUSTRY AS INDUSTRY,',
'       br.COUNTRIES AS BR_COUNTRIES,',
'       r.ENTITY_TAG,',
'       r.HIERARCHY_TAG',
'  from CGCT_PRJ_REQUIREMENT r ',
'  LEFT JOIN CGCT_PRJ_DOMAIN_PROCESS_MAP_V m',
'       ON r.L1_ID = m.L1_ID ',
'       AND (r.L3_ID = m.L3_ID OR r.L3_ID IS NULL)',
'       LEFT JOIN CGCT_PRJ_BUSINESS_REQUIREMENTS br ',
'       ON br.ID = r.BUSINESS_REQUIREMENT',
'         AND R.PRJ_ID=M.PRJ_ID ',
'       JOIN  CGCT_PRJ_PROCESS_L4 L4 ON L4.L4_ID=R.L4_ID',
'         AND L4.PRJ_ID=M.PRJ_ID ',
'        ',
'    WHERE r.ACTIVE_FLAG = ''Y'' and r.PRJ_ID =:P0_PRJ_ID ',
'    --AND r.PHASE_ID = :P1056_PHASE_ID',
'    AND r.APPLICATION_ID =:P0_APP_ID',
'    AND r.PRJ_ID = :P0_PRJ_ID',
'      AND (:p1056_L1_PROCESS IS NULL ',
'           OR r.L1_ID IN (',
'               SELECT REGEXP_SUBSTR(:p1056_L1_PROCESS, ''[^:]+'', 1, LEVEL)',
'               FROM DUAL',
'               CONNECT BY REGEXP_SUBSTR(:p1056_L1_PROCESS, ''[^:]+'', 1, LEVEL) IS NOT NULL',
'           ))',
'      AND (:p1056_L2_PROCESS IS NULL ',
'           OR r.L2_ID IN (',
'               SELECT REGEXP_SUBSTR(:p1056_L2_PROCESS, ''[^:]+'', 1, LEVEL)',
'               FROM DUAL',
'               CONNECT BY REGEXP_SUBSTR(:p1056_L2_PROCESS, ''[^:]+'', 1, LEVEL) IS NOT NULL',
'           ))',
'      AND (:p1056_L3_PROCESS IS NULL ',
'           OR r.L3_ID IN (',
'               SELECT REGEXP_SUBSTR(:p1056_L3_PROCESS, ''[^:]+'', 1, LEVEL)',
'               FROM DUAL',
'               CONNECT BY REGEXP_SUBSTR(:p1056_L3_PROCESS, ''[^:]+'', 1, LEVEL) IS NOT NULL',
'           ))',
'      AND (:p1056_L4_PROCESS IS NULL ',
'           OR r.L4_ID IN (',
'               SELECT REGEXP_SUBSTR(:p1056_L4_PROCESS, ''[^:]+'', 1, LEVEL)',
'               FROM DUAL',
'               CONNECT BY REGEXP_SUBSTR(:p1056_L4_PROCESS, ''[^:]+'', 1, LEVEL) IS NOT NULL',
'           ))',
'      AND (:p1056_MODULES IS NULL ',
'           OR m.MODULE_ID IN (',
'               SELECT REGEXP_SUBSTR(:p1056_MODULES, ''[^:]+'', 1, LEVEL)',
'               FROM DUAL',
'               CONNECT BY REGEXP_SUBSTR(:p1056_MODULES, ''[^:]+'', 1, LEVEL) IS NOT NULL',
'           ))',
'      AND (:p1056_DOMAIN IS NULL ',
'           OR m.DOMAIN_ID IN (',
'               SELECT REGEXP_SUBSTR(:p1056_DOMAIN, ''[^:]+'', 1, LEVEL)',
'               FROM DUAL',
'               CONNECT BY REGEXP_SUBSTR(:p1056_DOMAIN, ''[^:]+'', 1, LEVEL) IS NOT NULL',
'           ))',
'',
'           AND (:P1056_INDUSTRY IS NULL OR EXISTS (',
'    SELECT 1',
'    FROM APEX_STRING.SPLIT(BR.INDUSTRY, '':'') ind',
'    WHERE ind.COLUMN_VALUE IN (',
'        SELECT COLUMN_VALUE',
'        FROM APEX_STRING.SPLIT(:P1056_INDUSTRY, '':'')',
'    )',
'))',
'',
'  AND (:P1056_COUNTRY IS NULL OR ',
'EXISTS (',
'    SELECT 1',
'      FROM APEX_STRING.SPLIT(BR.COUNTRIES, '':'') brc',
'     WHERE brc.COLUMN_VALUE IN (',
'               SELECT COLUMN_VALUE',
'                 FROM APEX_STRING.SPLIT(:P1056_COUNTRY, '':'')',
'           )',
'))',
')',
'SELECT ',
'    ID,',
'    DESCRIPTION,',
'    DETAIL,',
'    PRJ_ID,',
'    L1_ID,',
'    L2_ID,',
'    L3_ID,',
'    L4_ID,',
'    -- Countries,',
'    INDUSTRY,',
'    BR_COUNTRIES,',
'       ',
'    COUNTRIES,',
'    BUSINESS_REQUIREMENT,',
'    TYPE_LOV,',
'    LOC_ENABLED,',
'    SOURCE,',
'    ENTITY_TAG,',
'    HIERARCHY_TAG,',
'    -- L4_ID,',
'    ACTIVE_FLAG,',
'    CREATION_DATE,',
'    CREATED_BY,',
'    LAST_UPDATE_DATE,',
'    LAST_UPDATED_BY,',
'    ''E'' AS Edit',
'FROM req_cte',
'',
'-- WHERE rn = 1;',
' '))
