'       mm.module_name,',
'       c.header_id,',
'       c.file_name,',
'',
'           LTRIM(c.FILE_PATH,''/'') AS FILE_PATH,',
'',
'    ''<span class="fa fa-upload upload-btn"></span>'' AS UPLOAD,',
'    CASE ',
'        WHEN c.FILE_PATH IS NULL THEN ',
'            ''<span style="color:#bc5090" class="fa fa-remove"></span>''',
'        ELSE ',
'            ''<span class="fa fa-download"></span>''',
'    END AS DOWNLOAD,',
'    CASE',
'    WHEN c.FILE_PATH IS NULL THEN',
'        ''<span style="color:#bc5090" aria-hidden="true" class="fa fa-remove"></span>''',
