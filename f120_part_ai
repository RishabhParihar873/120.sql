'      x02: _data.fileName,',
'      x03: action,',
'      x04: _data.filePath,',
'      x05: _data.projectPlanLineId',
'    }, {',
'      dataType: ''text'',',
'      success: function(pUrl) {',
'        if (pUrl) {',
'          apex.navigation.redirect(pUrl);',
'        } else {',
'          apex.message.alert(''No URL returned.'');',
'        }',
'      },',
'      error: function() {',
'        apex.message.alert(''Failed to open modal.'');',
'      }',
'    });',
'  }',
'',
'  document.addEventListener(''click'', function(e) {',
'    const isIcon = e.target.classList.contains(''fa-ellipsis-h'');',
'    const isInside = e.target.closest(''.custom-dropdown'');',
'    if (!isIcon && !isInside) {',
'      document.getElementById(''globalDropdown'').style.display = ''none'';',
