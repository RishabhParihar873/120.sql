wwv_flow_imp_page.create_page_process(
 p_id=>wwv_flow_imp.id(485970610256948248)
,p_process_sequence=>20
,p_parent_process_id=>wwv_flow_imp.id(485971480346948254)
,p_process_type=>'NATIVE_PLSQL'
,p_process_name=>'Import Data'
,p_static_id=>'import-data'
,p_process_sql_clob=>wwv_flow_string.join(wwv_flow_t_varchar2(
'DECLARE ',
'P_PROD_ID       NUMBER;',
'P_ID            NUMBER;',
'P_USER_ID       NUMBER:= :P0_USER_ID_EMAIL;',
'P_APPLICATION_ID    NUMBER := :P0_APP_ID;',
'P_PROJECT_ID        NUMBER := :PRJ_FOR_ACCESS;',
'v_master_id     NUMBER;',
'P_SOL_APP_ID    NUMBER;',
'BEGIN',
'-- DELETE FROM TMP_PRJ_PERSONA;',
'DELETE FROM TMP_PRJ_USER_STORY;',
'DELETE FROM TMP_PRJ_REQUIREMENT;',
'DELETE FROM TMP_PRJ_TEST_CASES;',
'delete from TMP_BUSINESS_REQUIREMENT;',
'DELETE FROM TMP_PRJ_MODULE_MASTER;',
'',
'BEGIN',
'    SELECT APPLICATION_ID ',
'    INTO P_SOL_APP_ID',
'    FROM CGCT_PRODUCT_MASTER',
'    WHERE (PRODUCT_NAME =(SELECT PRODUCT_NAME FROM CGCT_TMP_PRODUCT_MASTER WHERE PRJ_ID=:P0_PROJECT_ID) OR ',
'    (PRODUCT_NAME = (SELECT PRODUCT_NAME FROM CGCT_PRJ_PRODUCT_MASTER WHERE PRJ_ID=:P0_PROJECT_ID)));',
'END;',
'',
'    FOR I IN (SELECT * FROM CGCT_MODULE_MASTER ',
'                WHERE APPLICATION_ID = P_SOL_APP_ID)',
'    LOOP',
'    DECLARE ',
'    P_ID    NUMBER;',
'    BEGIN',
'        SELECT MODULE_ID INTO P_ID',
'        FROM CGCT_PRJ_MODULE_MASTER',
'        WHERE APPLICATION_ID =:P0_APPLICATION_ID',
'        AND MODULE_SHORT_CODE=I.MODULE_SHORT_CODE;',
'',
'        INSERT INTO TMP_PRJ_MODULE_MASTER (OLD_ID,NEW_ID)',
'        VALUES (I.MODULE_ID,P_ID);',
'',
'        END;',
'        END LOOP;',
'',
'-------PROD_ID ',
'BEGIN',
'SELECT ID INTO P_ID ',
'FROM CGCT_TMP_PRODUCT_MASTER WHERE PRJ_ID=P_PROJECT_ID;',
'IF P_ID>0 THEN',
'SELECT ID INTO P_PROD_ID FROM CGCT_TMP_PRODUCT_MASTER WHERE PRJ_ID =P_PROJECT_ID;',
'',
'END IF;',
'EXCEPTION',
'WHEN NO_DATA_FOUND THEN',
'SELECT ID INTO P_PROD_ID',
'FROM CGCT_PRODUCT_MASTER WHERE PRODUCT_NAME = (SELECT PRODUCT_NAME FROM CGCT_PRJ_PRODUCT_MASTER WHERE PRJ_ID=P_PROJECT_ID);',
'END;',
'',
'-------PRODUCT DETAILS ',
'INSERT INTO CGCT_PRJ_PRODUCT_MASTER(PRODUCT_NAME,ACTIVE_FLAG,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATE_BY,INDUSTRY_TYPE,PRJ_ID)',
'(SELECT P.PRODUCT_NAME,''Y'',SYSDATE,:P0_USER_ID_EMAIL,SYSDATE,:P0_USER_ID_EMAIL,P.INDUSTRY_TYPE,P_PROJECT_ID',
'FROM CGCT_TMP_PRODUCT_MASTER P ',
'WHERE PRJ_ID=P_PROJECT_ID);',
'delete from CGCT_TMP_PRODUCT_MASTER where PRJ_ID=P_PROJECT_ID;',
'',
'-- ----------DOMAIN_MODULE DETAILS',
'-- INSERT INTO CGCT_PRJ_DOMAIN_MODULE_MAPPING(PROJECT_ID,DOMAIN_ID,MODULE_ID,ACTIVE_FLAG,CREATED_BY,CREATION_DATE,UPDATED_BY,UPDATED_DATE)',
'-- (',
'--     SELECT P_PROJECT_ID,D.DOMAIN_ID,D.MODULE_ID,''Y'',:P0_USER_ID_EMAIL,SYSDATE,:P0_USER_ID_EMAIL,SYSDATE',
'--     FROM CGCT_TMP_DOMAIN_MODULE_MAPPING D',
'--     WHERE PROJECT_ID=P_PROJECT_ID',
'--       AND NOT EXISTS (',
'--         SELECT 1',
'--         FROM CGCT_PRJ_DOMAIN_MODULE_MAPPING T',
'--         WHERE T.DOMAIN_ID = D.DOMAIN_ID',
'--           AND T.MODULE_ID=D.MODULE_ID',
'--           AND T.PROJECT_ID=D.PROJECT_ID',
'--           AND ACTIVE_FLAG=''Y''',
'--      ));',
'',
'     -------------------INDUSTRY------------------',
'INSERT INTO CGCT_PRJ_INDUSTRY (INDUSTRY_NAME,CREATED_BY,CREATION_DATE,LAST_UPDATED_BY,LAST_UPDATED_DATE,PRJ_ID)',
'(SELECT INDUSTRY_NAME,:P0_USER_ID_EMAIL,SYSDATE,:P0_USER_ID_EMAIL,SYSDATE,:P0_PROJECT_ID ',
'FROM CGCT_TMP_INDUSTRY ',
'WHERE PRJ_ID=:P0_PROJECT_ID);',
'DELETE FROM CGCT_TMP_INDUSTRY WHERE PRJ_ID=:P0_PROJECT_ID;',
'     --------------country---------',
'INSERT INTO CGCT_PRJ_REGION_COUNTRY_MAPPING(REGION,COUNTRY,PRJ_ID)',
'(SELECT REGION,COUNTRY,P_PROJECT_ID FROM',
'CGCT_TMP_REGION_COUNTRY',
'WHERE PRJ_ID=P_PROJECT_ID',
' ',
');',
'DELETE FROM CGCT_TMP_REGION_COUNTRY WHERE PRJ_ID=P_PROJECT_ID;',
'',
'----------BUSINESS REQUIREMENTS',
'',
' FOR B IN ( SELECT *',
'    FROM CGCT_TMP_BUSINESS_REQUIREMENTS D',
'    WHERE PRJ_ID=P_PROJECT_ID',
'    AND NOT EXISTS (',
'        SELECT 1',
'        FROM CGCT_PRJ_BUSINESS_REQUIREMENTS T',
'        WHERE t.TOPIC_NAME=D.TOPIC_NAME',
'          AND T.PRJ_ID=:PRJ_FOR_access',
'     ))',
'    LOOP',
'        DECLARE  V_NEW_ID NUMBER;',
'        BEGIN',
'            SELECT CGCT_PRJ_BUSINESS_REQUIREMENTS_SEQ.NEXTVAL INTO V_NEW_ID FROM DUAL;',
'',
'INSERT INTO CGCT_PRJ_BUSINESS_REQUIREMENTS(ID,TOPIC_NAME,DESCRIPTION,SOURCE,COUNTRIES,KDD, ENTITY_TAG,HIERARCHY_TAG,UPDATE_SOURCE, APPLICATION_ID,PRJ_ID,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATED_BY,ACTIVE_FLAG,SOLUTION_ID)',
'VALUES(',
'    V_NEW_ID, B.TOPIC_NAME,B.DESCRIPTION,B.SOURCE,B.COUNTRIES,B.KDD, ''Standard'',''Standard'',''SOL_IMPORT'' ,:P0_APP_ID,P_PROJECT_ID,SYSDATE,:P0_USER_ID_EMAIL,SYSDATE,:P0_USER_ID_EMAIL,''Y'',B.ID',
'    ',
');',
'INSERT INTO TMP_BUSINESS_REQUIREMENT (OLD_ID, NEW_ID)',
'VALUES (B.ID, V_NEW_ID);',
'    END;',
'    END LOOP;',
'',
'',
'------------L3 DETAILS',
'INSERT INTO CGCT_PRJ_PROCESS_L3',
'    ( L3_ID , L3_CODE , L3_NAME , L2_ID , L3_ACTIVE , ORACLE_CODE , L3_MODULE , COPY_FLAG , APPLICATION_ID',
'    , PRJ_ID , CREATION_DATE , CREATED_BY , LAST_UPDATE_DATE , LAST_UPDATED_BY,ENTITY_TAG,HIERARCHY_TAG,UPDATE_SOURCE )',
'SELECT',
'      L3.L3_ID , L3.L3_CODE , L3.L3_NAME , L3.L2_ID , ''Y'' , L3.ORACLE_CODE , L3.L3_MODULE , ''Y''             ',
'    , :P0_APP_ID , P_PROJECT_ID , SYSDATE , :P0_USER_ID_EMAIL , SYSDATE , :P0_USER_ID_EMAIL ,',
'    ''Standard'',''Standard'',''SOL_IMPORT''        ',
'FROM CGCT_PROCESS_L3 L3',
'WHERE L3.PROD_ID = P_PROD_ID',
'AND APPLICATION_ID = P_SOL_APP_ID',
'AND L3_ACTIVE=''Y''',
'  AND EXISTS (',
'        SELECT 1',
'        FROM CGCT_TMP_DOMAIN_MODULE_MAPPING M',
'        WHERE M.MODULE_ID IN (SELECT COLUMN_VALUE FROM APEX_STRING.SPLIT(L3.L3_MODULE,'':''))',
'          AND M.PROJECT_ID = P_PROJECT_ID',
'     )',
'  AND NOT EXISTS (',
'        SELECT 1',
'        FROM CGCT_PRJ_PROCESS_L3 T',
'        WHERE T.L3_NAME = L3.L3_NAME',
'          AND T.PRJ_ID = P_PROJECT_ID',
'     );',
'',
'    CGCT_COMMON_PKG.Normalize_prj_process_map(',
'        p_prj_id  => P_PROJECT_ID,',
'        p_APPLICATION_ID  => :P0_APP_ID,',
'        p_l3_id   => NULL,',
'        p_user_id => P_USER_ID',
'    );',
'',
'',
'-------------L4 DETAILS-------------------------------',
'-- delete from CGCT_PRJ_PROCESS_L4 where PRJ_ID=P_PROJECT_ID;',
'INSERT INTO CGCT_PRJ_PROCESS_L4(L4_ID,L4_CODE,L4_NAME,L3_ID,L4_ACTIVE,COPY_FLAG,APPLICATION_ID,PRJ_ID,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATED_BY,',
'ENTITY_TAG,UPDATE_SOURCE)',
'(',
'    SELECT L4.L4_ID,L4.L4_CODE,L4.L4_NAME,L4.L3_ID,''Y'',''Y'',:P0_APP_ID,P_PROJECT_ID,SYSDATE,:P0_USER_ID_EMAIL,SYSDATE,:P0_USER_ID_EMAIL,',
'    ''Standard'',''SOL_IMPORT''',
'    FROM CGCT_PROCESS_L4 L4',
'    WHERE PROD_ID=P_PROD_ID',
'    AND APPLICATION_ID = P_SOL_APP_ID',
'    AND L4_ACTIVE=''Y''',
'    AND EXISTS (',
'        SELECT 1',
'        FROM CGCT_PRJ_PROCESS_L3 T',
'        WHERE T.L3_ID = L4.L3_ID',
'          AND T.PRJ_ID = P_PROJECT_ID',
'     )',
'     AND NOT EXISTS (',
'        SELECT 1',
'        FROM CGCT_PRJ_PROCESS_L4 P',
'        WHERE p.L4_ID = L4.L4_ID',
'          AND p.PRJ_ID = P_PROJECT_ID',
'     )',
');',
'-------------L2 DETAILS',
'-- delete from CGCT_PRJ_PROCESS_L2 where PRJ_ID=P_PROJECT_ID;',
'INSERT INTO CGCT_PRJ_PROCESS_L2(L2_ID,L2_CODE,L2_NAME,L1_ID,L2_ACTIVE,ORACLE_CODE,L2_MODULE,COPY_FLAG,APPLICATION_ID,PRJ_ID,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATED_BY',
',ENTITY_TAG,HIERARCHY_TAG,UPDATE_SOURCE)',
'(',
'    SELECT L2.L2_ID,L2.L2_CODE,L2.L2_NAME,L2.L1_ID,''Y'',L2.ORACLE_CODE,L2.L2_MODULE,''Y'',:P0_APP_ID,P_PROJECT_ID,SYSDATE,:P0_USER_ID_EMAIL,SYSDATE,:P0_USER_ID_EMAIL,',
'    ''Standard'',''Standard'',''SOL_IMPORT''',
'    FROM CGCT_PROCESS_L2 L2',
'    WHERE PROD_ID=P_PROD_ID',
'    AND L2_ACTIVE=''Y''',
'    AND APPLICATION_ID = P_SOL_APP_ID',
'    AND L2_ID IN (SELECT L2_ID FROM CGCT_PRJ_PROCESS_L3 WHERE PRJ_ID=P_PROJECT_ID)',
'    AND NOT EXISTS (',
'        SELECT 1',
'        FROM CGCT_PRJ_PROCESS_L2 P',
'        WHERE p.L2_ID = L2.L2_ID',
'          AND p.PRJ_ID = P_PROJECT_ID',
'     )',
');',
'---------L1 DETAILS',
'-- delete from CGCT_PRJ_PROCESS_L1 where PRJ_ID=P_PROJECT_ID;',
'INSERT INTO CGCT_PRJ_PROCESS_L1(L1_ID,L1_CODE,L1_NAME,L1_SHORTNAME,L1_ACTIVE,ORACLE_CODE,COPY_FLAG,APPLICATION_ID,PRJ_ID,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATED_BY,',
'ENTITY_TAG,HIERARCHY_TAG,UPDATE_SOURCE)',
'(',
'    SELECT L1.L1_ID,L1.L1_CODE,L1.L1_NAME,L1.L1_SHORTNAME,''Y'',L1.ORACLE_CODE,''Y'',:P0_APP_ID,P_PROJECT_ID,SYSDATE,:P0_USER_ID_EMAIL,SYSDATE,:P0_USER_ID_EMAIL,',
'    ''Standard'',''Standard'',''SOL_IMPORT''',
'    FROM CGCT_PROCESS_L1 L1',
'    WHERE PROD_ID=P_PROD_ID',
'    AND L1_ACTIVE=''Y''',
'    AND APPLICATION_ID = P_SOL_APP_ID',
'    AND L1_ID IN (SELECT L1_ID FROM CGCT_PRJ_PROCESS_L2 WHERE PRJ_ID=P_PROJECT_ID)',
'    AND NOT EXISTS (',
'        SELECT 1',
'        FROM CGCT_PRJ_PROCESS_L1 P',
'        WHERE p.L1_ID = L1.L1_ID',
'          AND p.PRJ_ID = P_PROJECT_ID',
'     )',
');',
'',
'---------------------SYSTEM REQUIREMENTS--------------------',
'-- delete from CGCT_PRJ_REQUIREMENT where PRJ_ID=P_PROJECT_ID;',
'FOR R IN (SELECT * FROM CGCT_REQUIREMENT WHERE PROD_ID =P_PROD_ID AND ACTIVE_FLAG=''Y''',
'            AND APPLICATION_ID = P_SOL_APP_ID',
'    -- AND   APPLICATION_ID = P_APPLICATION_ID ',
'    and BUSINESS_REQUIREMENT in (SELECT ID FROM CGCT_TMP_BUSINESS_REQUIREMENTS WHERE PRJ_ID=P_PROJECT_ID))',
'    LOOP',
'    DECLARE  V_NEW_ID NUMBER;',
'        BEGIN',
'            SELECT CGCT_PRJ_REQUIREMENT_SEQ.NEXTVAL INTO V_NEW_ID FROM DUAL;',
'INSERT INTO CGCT_PRJ_REQUIREMENT(ID,DESCRIPTION,DETAIL,L1_ID,L2_ID,L3_ID,L4_ID,COPY_FLAG,COUNTRIES,LOC_ENABLED,BUSINESS_REQUIREMENT,SOURCE,TYPE_LOV,APPLICATION_ID,PRJ_ID,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATED_BY,ACTIVE_FLAG,ENTITY_TAG'
||',HIERARCHY_TAG,UPDATE_SOURCE,SOLUTION_ID)',
'VALUES (',
' V_NEW_ID, R.DESCRIPTION,R.DETAIL,R.L1_ID,R.L2_ID,R.L3_ID,R.L4_ID,''Y'',R.COUNTRIES,R.LOC_ENABLED,(SELECT ID FROM CGCT_PRJ_BUSINESS_REQUIREMENTS WHERE SOLUTION_ID=R.BUSINESS_REQUIREMENT),R.SOURCE,R.TYPE_LOV,:P0_APP_ID,P_PROJECT_ID,SYSDATE,:P0_USER_ID_E'
||'MAIL,SYSDATE,:P0_USER_ID_EMAIL,''Y'',''Standard'',''Standard'',''SOL_IMPORT'',R.ID',
');',
'INSERT INTO TMP_PRJ_REQUIREMENT (OLD_ID, NEW_ID)',
'VALUES (R.ID, V_NEW_ID);',
'END;',
'END LOOP;',
'',
'',
'---------------------PERSONA----------------------------',
'FOR R IN (SELECT *',
'FROM CGCT_PERSONA p',
'WHERE p.prod_id = P_PROD_ID',
'AND ACTIVE_FLAG=''Y''',
'AND APPLICATION_ID = P_SOL_APP_ID',
'AND ID IN (',
'    SELECT COLUMN_VALUE',
'      FROM CGCT_USER_STORY US,',
'           TABLE(APEX_STRING.SPLIT(US.PERSONA_ID, '':''))',
'     WHERE US.REQUIREMENT_ID IN (SELECT OLD_ID FROM TMP_PRJ_REQUIREMENT)',
')',
'AND NOT EXISTS (SELECT 1',
'FROM CGCT_PRJ_PERSONA T',
'WHERE T.TOPIC_NAME = P.TOPIC_NAME',
'and prj_id=P_PROJECT_ID)',
'',
')',
'    LOOP',
'     DECLARE  V_NEW_ID NUMBER;',
'     BEGIN',
'     SELECT CGCT_PRJ_PERSONA_SEQ.NEXTVAL INTO V_NEW_ID FROM DUAL;',
'    ',
'    INSERT INTO CGCT_PRJ_PERSONA',
'    (',
'        ID,TOPIC_NAME,DESCRIPTION, PRJ_ID, APPLICATION_ID,',
'        GUIDELINE_NOTE,MILESTONE_NAME,STORY_POINTS,ESTIMATION_HOURS,SIZING,',
'        PERSONA_ID,CAPGEMINI_RECOMMENDATION,DOMAIN_ID,MODULE_ID,',
'PERSONA_SHORT_CODE,PERSONA_CATEGORY,',
'        ACTIVE_FLAG, COPY_FLAG,',
'        CREATION_DATE, CREATED_BY,',
'        LAST_UPDATE_DATE, LAST_UPDATED_BY,ENTITY_TAG,SOLUTION_ID,UPDATE_SOURCE',
'    )',
'    VALUES(',
'        V_NEW_ID,R.TOPIC_NAME,R.DESCRIPTION, P_PROJECT_ID, P_APPLICATION_ID,',
'        R.GUIDELINE_NOTE,R.MILESTONE_NAME,R.STORY_POINTS,',
'        R.ESTIMATION_HOURS,R.SIZING,R.PERSONA_ID,R.CAPGEMINI_RECOMMENDATION,',
'        R.DOMAIN_ID,R.MODULE_ID',
'        ,R.PERSONA_SHORT_CODE,R.PERSONA_CATEGORY,',
'        R.ACTIVE_FLAG, ''Y'',',
'        SYSDATE, :P0_USER_ID_EMAIL,',
'        SYSDATE, :P0_USER_ID_EMAIL,''Standard'',R.ID,''SOL_IMPORT''',
'    );',
'    INSERT INTO TMP_PRJ_PERSONA(OLD_ID,NEW_ID,PRJ_ID) VALUES(R.ID,V_NEW_ID,P_PROJECT_ID);',
'    END;',
'    END LOOP;',
'',
'',
'    FOR PI IN (SELECT *',
'    FROM WKSP_SOLDEV.CGCT_INDUSTRY_PERSONA_MAPPING p',
'    WHERE PERSONA_ID IN ( SELECT OLD_ID FROM TMP_PRJ_PERSONA WHERE PRJ_ID=P_PROJECT_ID)',
'    AND APPLICATION_ID = P_SOL_APP_ID',
'    AND NOT EXISTS (SELECT 1',
'    FROM CGCT_PRJ_INDUSTRY_PERSONA_MAPPING T',
'    WHERE T.INDUSTRY_PERSONA = P.INDUSTRY_PERSONA',
'    AND T.INDUSTRY_ID =P.INDUSTRY_ID',
'    and prj_id=P_PROJECT_ID)',
'',
'    )',
'    LOOP',
'    DECLARE  V_NEW_ID NUMBER;',
'     BEGIN',
'     SELECT CGCT_PRJ_INDUSTRY_PERSONA_MAPPING_SEQ.NEXTVAL INTO V_NEW_ID FROM DUAL;',
'    INSERT INTO CGCT_PRJ_INDUSTRY_PERSONA_MAPPING(',
'        INDUSTRY_MAPPING_ID,PERSONA_ID,INDUSTRY_ID,INDUSTRY_PERSONA,CREATED_BY,CREATION_DATE,PRJ_ID,APPLICATION_ID',
'    ) VALUES(',
'        V_NEW_ID,(SELECT NEW_ID FROM TMP_PRJ_PERSONA WHERE OLD_ID=PI.PERSONA_ID AND PRJ_ID=P_PROJECT_ID),',
'        PI.INDUSTRY_id,PI.INDUSTRY_PERSONA,:P0_USER_ID_EMAIL,SYSDATE,P_PROJECT_ID,P_APPLICATION_ID);',
'        INSERT INTO TMP_PRJ_PERSONA_industry_mapping(OLD_ID,NEW_ID,PRJ_ID) VALUES(pi.INDUSTRY_MAPPING_ID,V_NEW_ID,P_PROJECT_ID);',
'        end;',
'    END LOOP;',
'   ',
'    ',
'-------------------------USER STORY---------------------',
'FOR US IN (SELECT * FROM CGCT_USER_STORY WHERE PROD_ID = P_PROD_ID ',
'            AND ACTIVE_FLAG=''Y''',
'    AND REQUIREMENT_ID IN (SELECT OLD_ID FROM TMP_PRJ_requirement)',
'    AND APPLICATION_ID = P_SOL_APP_ID)',
'    LOOP',
'    DECLARE  V_NEW_ID NUMBER;',
'     BEGIN',
'     SELECT CGCT_PRJ_USER_STORY_SEQ.NEXTVAL INTO V_NEW_ID FROM DUAL;',
'    INSERT INTO CGCT_PRJ_USER_STORY',
'    (',
'        ID, STORY_ID,PRJ_ID, APPLICATION_ID,UPDATE_SOURCE,',
'        NAME, DETAIL, L3_ID,STORY_POINTS, WORKSTREAM_ID,COMPONENT_ID,',
'        SIZING,ESTIMATION_HOURS,SUMMARY,L1_ID,L2_ID,MODULE_ID,',
'        L4_ID,REQUIREMENT_ID,PERSONA_ID,ACCEPTANCE_CRITERIA,',
'        ACTIVE_FLAG, COPY_FLAG,',
'        CREATION_DATE, CREATED_BY,',
'        LAST_UPDATE_DATE, LAST_UPDATED_BY,ENTITY_TAG,HIERARCHY_TAG,PERSONA_INDUSTRY_ID',
'    )',
'    VALUES(',
'        V_NEW_ID,US.ID, P_PROJECT_ID, P_APPLICATION_ID,''SOL_IMPORT'',',
'        US.NAME, US.DETAIL, US.L3_ID,US.STORY_POINTS,US.WORKSTREAM_ID,US.COMPONENT_ID,',
'           US.SIZING, US.ESTIMATION_HOURS, US.SUMMARY, US.L1_ID, US.L2_ID,',
'           US.MODULE_ID , ',
'          US.L4_ID, (SELECT NEW_ID FROM TMP_PRJ_REQUIREMENT WHERE OLD_ID=US.REQUIREMENT_ID),',
'(',
'    SELECT LISTAGG(NVL(TO_CHAR(p.new_id), ''0''), '':'') WITHIN GROUP (ORDER BY s.pos)',
'    FROM (',
'      SELECT column_value AS token, ROWNUM AS pos',
'      FROM TABLE(apex_string.split(us.PERSONA_ID, '':''))',
'    ) s',
'    LEFT JOIN TMP_PRJ_PERSONA p',
'           ON p.old_id = TO_NUMBER(s.token)',
'           AND PRJ_ID=P_PROJECT_ID',
'           AND ROWNUM=1',
'  )',
',',
'US.ACCEPTANCE_CRITERIA,',
'        US.ACTIVE_FLAG, ''Y'',',
'        SYSDATE, :P0_USER_ID_EMAIL,',
'        SYSDATE, :P0_USER_ID_EMAIL,''Standard'',''Standard'',(SELECT LISTAGG(new_id, '':'') WITHIN GROUP (ORDER BY new_id) AS new_ids',
'                                                            FROM TMP_PRJ_PERSONA_industry_mapping',
'                                                            WHERE old_id IN (',
'                                                                SELECT column_value ',
'                                                                FROM TABLE(apex_string.split(us.PERSONA_INDUSTRY_ID, '':''))',
'                                                            )));',
'        INSERT INTO TMP_PRJ_USER_STORY(OLD_ID,NEW_ID) VALUES(US.ID,V_NEW_ID);',
'        END;',
'        END LOOP;',
'',
'-----------------TEST CASES---------------------------',
'',
'FOR TC IN (SELECT * FROM CGCT_TEST_CASES TC',
'    WHERE TC.PROD_ID = P_PROD_ID',
'    AND ACTIVE_FLAG=''Y''',
'    AND APPLICATION_ID = P_SOL_APP_ID',
'    AND   TC.USER_STORY_ID IN (SELECT OLD_ID FROM TMP_PRJ_USER_STORY ))',
'    LOOP',
'    DECLARE',
'    V_NEW_ID NUMBER;',
'    BEGIN',
'  SELECT CGCT_PRJ_TEST_CASES_SEQ.nextval INTO V_NEW_ID FROM DUAL;',
' INSERT INTO CGCT_PRJ_TEST_CASES',
'    (',
'        ID, CASE_ID, PRJ_ID, APPLICATION_ID,UPDATE_SOURCE,',
'        NAME,DETAIL,ESTIMATION_HOURS, L3_ID,AUTOMATION,TEST_CODE,',
'        SIZING,STORY_POINTS,L1_ID,L2_ID,USER_STORY_ID,L4_ID,',
'        ACTIVE_FLAG, COPY_FLAG,',
'        CREATION_DATE, CREATED_BY,',
'        LAST_UPDATE_DATE, LAST_UPDATED_BY,ENTITY_TAG',
'    )',
'    VALUES',
'       ( V_NEW_ID, TC.ID, P_PROJECT_ID, P_APPLICATION_ID,''SOL_IMPORT'',',
'        TC.NAME,TC.DETAIL,TC.ESTIMATION_HOURS, TC.L3_ID, TC.AUTOMATION, ',
'        TC.TEST_CODE, TC.SIZING, TC.STORY_POINTS, TC.L1_ID, TC.L2_ID, (SELECT NEW_ID FROM TMP_PRJ_USER_STORY WHERE OLD_ID=TC.USER_STORY_ID), TC.L4_ID,',
'        TC.ACTIVE_FLAG, ''Y'',',
'        SYSDATE, :P0_USER_ID_EMAIL,',
'        SYSDATE, :P0_USER_ID_EMAIL,''Standard'');',
'        INSERT INTO TMP_PRJ_TEST_CASES(OLD_ID,NEW_ID) VALUES(TC.ID,V_NEW_ID);',
'    END;',
'    END LOOP;',
'',
'',
'--lete from CGCT_TMP_TEST_CASES where PRJ_ID=P_PROJECT_ID;',
'',
'-- delete from CGCT_PRJ_TEST_CASE_STEP where PRJ_ID=P_PROJECT_ID;',
'INSERT INTO CGCT_PRJ_TEST_CASE_STEP(STEP_ID,STEP,TEST_CASE_ID,STEP_NO,EXPECTED_RESULT,COPY_FLAG,APPLICATION_ID,PRJ_ID,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATED_BY,ACTIVE_FLAG,ENTITY_TAG,UPDATE_SOURCE)',
'(',
'    SELECT TC.ID,TC.STEP,(SELECT NEW_ID FROM TMP_PRJ_TEST_CASES WHERE OLD_ID=TC.TEST_CASE_ID),TC.STEP_NO,TC.EXPECTED_RESULT,''Y'',:P0_APP_ID,P_PROJECT_ID,SYSDATE,:P0_USER_ID_EMAIL,SYSDATE,:P0_USER_ID_EMAIL,''Y'',''Standard'',''SOL_IMPORT''',
'    FROM CGCT_TEST_CASE_STEP TC',
'    WHERE PROD_ID=P_PROD_ID',
'    AND ACTIVE_FLAG=''Y''',
'    AND APPLICATION_ID = P_SOL_APP_ID',
'    AND TC.TEST_CASE_ID IN (SELECT OLD_ID FROM TMP_PRJ_TEST_CASES)',
');',
'',
'---------INTEGRATED SYSTEM------------------',
'FOR I IN (SELECT * FROM WKSP_SOLDEV.CGCT_INTEGRATED_SYSTEMS S',
'    WHERE PROD_ID = P_PROD_ID AND ACTIVE_FLAG=''Y'' AND APPLICATION_ID = P_SOL_APP_ID AND ',
'    DOMAIN_ID IN (SELECT DOMAIN_ID FROM CGCT_TMP_DOMAIN_MODULE_MAPPING WHERE PROJECT_ID = P_PROJECT_ID)',
'    AND NOT EXISTS (SELECT 1 FROM CGCT_PRJ_INTEGRATED_SYSTEMS T WHERE T.SOLUTION_ID=S.SYSTEM_ID AND T.PRJ_ID=P_PROJECT_ID) )',
'    LOOP',
'        INSERT INTO CGCT_PRJ_INTEGRATED_SYSTEMS(APPLICATION_ID,SYSTEM_NAME,SYSTEM_DESCRIPTION',
'        ,ACTIVE_FLAG,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATED_BY,PRJ_ID,DOMAIN_ID)',
'        VALUES(P_APPLICATION_ID,I.SYSTEM_NAME,I.SYSTEM_DESCRIPTION,''Y'',SYSDATE,:P0_USER_ID_EMAIL,SYSDATE,:P0_USER_ID_EMAIL,P_PROJECT_ID,I.DOMAIN_ID);',
'END LOOP;',
'-------CONFIG WORKBOOK------------',
'INSERT INTO CGCT_PRJ_CONFIG_WORKBOOK_MASTER(CONFIG_WORKBOOK_NAME,MODULE_ID,ACTIVE,CREATED_BY,CREATED_DATE',
',UPDATED_BY,UPDATED_DATE,APPLICATION_ID,CONFIG_WORKBOOK_TASK_NAME,PRJ_ID,NAVIGATION_PATH,ENTITY_TAG,SOLUTION_ID,UPDATE_SOURCE)',
'(SELECT CONFIG_WORKBOOK_NAME,CM.MODULE_ID,''Y'',:P0_USER_ID_EMAIL,SYSDATE,:P0_USER_ID_EMAIL,SYSDATE,P_APPLICATION_ID,CONFIG_WORKBOOK_TASK_NAME',
',P_PROJECT_ID,NAVIGATION_PATH,''Standard'',CONFIG_WORKBOOK_ID,''SOL_IMPORT''',
' FROM WKSP_SOLDEV.CGCT_CONFIG_WORKBOOK_MASTER CM WHERE PROD_ID=P_PROD_ID',
' AND APPLICATION_ID = P_SOL_APP_ID',
' AND ACTIVE=''Y''',
' AND MODULE_ID IN (SELECT MODULE_ID FROM CGCT_TMP_DOMAIN_MODULE_MAPPING WHERE PROJECT_ID = P_PROJECT_ID));',
'',
' -------INTEGRATION-----------',
' INSERT INTO CGCT_PRJ_INTEGRATION_MASTER_LIST(APPLICATION_ID,INT_NAME,MODULE_ID,INT_DIRECTION,INT_TYPE',
',SOURCE_SYSTEM_ID,TARGET_SYSTEM_ID,INT_METHOD,INT_TRIGGER_TYPE,INT_DATA_FORMAT,INT_REUSABLE_TYPE',
',INT_COMPLEXITY_TYPE,ACTIVE_FLAG,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATED_BY,PRJ_ID,ENTITY_TAG,SOLUTION_ID,UPDATE_SOURCE)',
'(SELECT P_APPLICATION_ID,INT_NAME,I.MODULE_ID,INT_DIRECTION,INT_TYPE,',
'(SELECT SYSTEM_ID FROM CGCT_PRJ_INTEGRATED_SYSTEMS WHERE SOLUTION_ID=SOURCE_SYSTEM_ID AND PRJ_ID=P_PROJECT_ID),',
'(SELECT SYSTEM_ID FROM CGCT_PRJ_INTEGRATED_SYSTEMS WHERE SOLUTION_ID=TARGET_SYSTEM_ID AND PRJ_ID=P_PROJECT_ID)',
',INT_METHOD,INT_TRIGGER_TYPE,INT_DATA_FORMAT,INT_REUSABLE_TYPE,INT_COMPLEXITY_TYPE,''Y'',SYSDATE,',
':P0_USER_ID_EMAIL,SYSDATE,:P0_USER_ID_EMAIL,P_PROJECT_ID,''Standard'',INT_ID,''SOL_IMPORT''',
'FROM WKSP_SOLDEV.CGCT_INTEGRATION_MASTER_LIST I',
'WHERE PROD_ID=P_PROD_ID AND ACTIVE_FLAG=''Y''',
'AND APPLICATION_ID = P_SOL_APP_ID',
' AND MODULE_ID IN (SELECT MODULE_ID FROM CGCT_TMP_DOMAIN_MODULE_MAPPING WHERE PROJECT_ID = P_PROJECT_ID));',
'',
' -----------REPORTS--------------',
'',
'  INSERT INTO CGCT_PRJ_REPORTS_MASTER_LIST(APPLICATION_ID,MODULE_ID,REPORT_NAME,REPORT_TYPE',
',REP_REUSABLE_TYPE,REP_COMPLEXITY_TYPE,ACTIVE,CREATED_BY,CREATED_DATE,UPDATED_BY',
',UPDATED_DATE,REPORT_CATEGORY,PRJ_ID,ENTITY_TAG,SOLUTION_ID,UPDATE_SOURCE)',
'(SELECT P_APPLICATION_ID,R.MODULE_ID,REPORT_NAME,REPORT_TYPE,REP_REUSABLE_TYPE,REP_COMPLEXITY_TYPE',
',''Y'',:P0_USER_ID_EMAIL,SYSDATE,:P0_USER_ID_EMAIL,SYSDATE,REPORT_CATEGORY,P_PROJECT_ID,''Standard'',r.REP_ID,''SOL_IMPORT''',
'FROM WKSP_SOLDEV.CGCT_REPORTS_MASTER_LIST r',
'WHERE PROD_ID=P_PROD_ID AND ACTIVE=''Y''',
'AND APPLICATION_ID = P_SOL_APP_ID',
' AND MODULE_ID IN (SELECT MODULE_ID FROM CGCT_TMP_DOMAIN_MODULE_MAPPING WHERE PROJECT_ID = P_PROJECT_ID));',
'',
'-----------CONVERSION--------------------',
'INSERT INTO CGCT_PRJ_CONVERSIONS_MASTER_LIST(APPLICATION_ID,MODULE_ID,CONV_DATA_ENTITY',
',CONV_DATA_SUB_ENTITY,CONV_DATA_TYPE,CONV_LOAD_TYPE,CONV_LOAD_METHOD',
',CONV_REUSABLE_TYPE,CONV_COMPLEXITY_TYPE,ACTIVE_FLAG,CREATED_BY,CREATION_DATE,LAST_UPDATED_BY',
',LAST_UPDATE_DATE,PRJ_ID,CONV_DEPENDENCIES,CONV_TEMPLATE_FILE_NAME,SHEET_NAME,ENTITY_TAG,SOLUTION_ID,UPDATE_SOURCE)',
'(SELECT P_APPLICATION_ID,CON.MODULE_ID,CONV_DATA_ENTITY,CONV_DATA_SUB_ENTITY,CONV_DATA_TYPE',
',CONV_LOAD_TYPE,CONV_LOAD_METHOD,CONV_REUSABLE_TYPE,CONV_COMPLEXITY_TYPE',
',''Y'',:P0_USER_ID_EMAIL,SYSDATE,:P0_USER_ID_EMAIL,SYSDATE,P_PROJECT_ID,CONV_DEPENDENCIES,CONV_TEMPLATE_FILE_NAME',
',SHEET_NAME,''Standard'',CONV_ID,''SOL_IMPORT''',
'FROM WKSP_SOLDEV.CGCT_CONVERSIONS_MASTER_LIST CON',
'WHERE PROD_ID=P_PROD_ID',
'AND ACTIVE_FLAG=''Y''',
'AND APPLICATION_ID = P_SOL_APP_ID',
' AND MODULE_ID IN (SELECT MODULE_ID FROM CGCT_TMP_DOMAIN_MODULE_MAPPING WHERE PROJECT_ID = P_PROJECT_ID));',
'',
' -------------------------------------------------------------data templates-------------------------------------------',
'',
'INSERT INTO CGCT_PRJ_DATA_TEMPLATE(TEMPLATE_COLUMN_NAME,DATA_MANDATORY,DEFAULT_VALUE,TABLE_NAME,COLUMN_NAME,DATA_TYPE,LENGTH',
',NOT_NULL,VALIDATION,TRANSFORMATION,CREATION_DATE,CREATED_BY,LAST_UPDATE_DATE,LAST_UPDATED_BY,APPLICATION_ID,PRJ_ID,CONV_ID',
',ENTITY_TAG,DATA_PRECISION,PRIMARY_KEY,COLUMN_DESCRIPTION,SOLUTION_ID,UPDATE_SOURCE)',
'(SELECT TEMPLATE_COLUMN_NAME,DATA_MANDATORY,DEFAULT_VALUE,TABLE_NAME,COLUMN_NAME,DATA_TYPE,LENGTH',
',NOT_NULL,VALIDATION,TRANSFORMATION,SYSDATE,:P0_USER_ID_EMAIL,SYSDATE,:P0_USER_ID_EMAIL,P_APPLICATION_ID,P_PROJECT_ID,',
'(SELECT CONV_ID FROM CGCT_PRJ_CONVERSIONS_MASTER_LIST WHERE SOLUTION_ID=t.CONV_ID AND PRJ_ID=P_PROJECT_ID),',
