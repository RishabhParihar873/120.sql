'declare',
'    l_file_id       number;',
'    l_access_token  varchar2(100);',
'',
'    l_file_name     varchar2(255);',
'    l_mime_type     varchar2(255);',
'    l_file_blob     blob;',
'begin',
'    if :P1034_FILE is null then',
'        raise_application_error(-20001, ''Please select a .vsd file.'');',
'    end if;',
'',
'    /*',
'      Get uploaded file from APEX temporary files table',
'    */',
'    select filename,',
'           nvl(mime_type, ''application/vnd.visio''),',
'           blob_content',
'      into l_file_name,',
'           l_mime_type,',
'           l_file_blob',
'      from apex_application_temp_files',
'     where name = :P1034_FILE;',
'',
'    /*',
'      Validate file extension',
'    */',
'    if lower(l_file_name) not like ''%.vsd'' then',
'        raise_application_error(-20002, ''Only .vsd files are allowed.'');',
'    end if;',
'',
'    /*',
'      Generate secure token',
'    */',
'    l_access_token := lower(rawtohex(sys_guid()));',
'',
'    /*',
'      Insert file into your table',
'    */',
'    insert into apex_visio_files (',
'        file_name,',
'        mime_type,',
'        file_blob,',
'        access_token',
'    )',
'    values (',
'        l_file_name,',
'        l_mime_type,',
'        l_file_blob,',
'        l_access_token',
'    )',
'    returning file_id into l_file_id;',
