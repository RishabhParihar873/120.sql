'DECLARE',
'    v_us_id   NUMBER :=:P1074_USER_STORY;',
'    v_prj_id  NUMBER :=:P0_PRJ_ID;',
'    v_us_tag  VARCHAR2(50);',
'BEGIN',
'    SELECT NVL(HIERARCHY_TAG, ''Standard'')',
'      INTO v_us_tag',
'      FROM CGCT_PRJ_USER_STORY',
'     WHERE ID = v_us_id',
'       AND PRJ_ID = v_prj_id;',
'',
'--    IF :APEX$ROW_STATUS = ''I'' THEN',
'    IF UPPER(v_us_tag) = UPPER(''Standard'') THEN',
'',
'        UPDATE CGCT_PRJ_USER_STORY',
'           SET HIERARCHY_TAG = ''STD Modified''',
'         WHERE ID = v_us_id',
'           AND PRJ_ID = v_prj_id',
'           AND HIERARCHY_TAG != ''STD Modified'';',
'',
'        UPDATE CGCT_PRJ_REQUIREMENT',
'           SET HIERARCHY_TAG = ''STD Modified''',
'         WHERE ID = ( SELECT REQUIREMENT_ID',
'                         FROM CGCT_PRJ_USER_STORY',
'                        WHERE ID = v_us_id',
'                          AND PRJ_ID = v_prj_id )',
'           AND PRJ_ID = v_prj_id',
'           AND HIERARCHY_TAG <> ''STD Modified'';',
'',
'        UPDATE CGCT_PRJ_BUSINESS_REQUIREMENTS b',
'           SET b.HIERARCHY_TAG = ''STD Modified''',
'         WHERE b.PRJ_ID = v_prj_id',
'           AND b.HIERARCHY_TAG <> ''STD Modified''',
'           AND EXISTS (',
'                    SELECT 1',
'                      FROM CGCT_PRJ_REQUIREMENT r',
'                     WHERE r.PRJ_ID = v_prj_id',
'                       AND r.BUSINESS_REQUIREMENT = b.ID',
'                       AND r.ID = (',
'                             SELECT REQUIREMENT_ID',
'                               FROM CGCT_PRJ_USER_STORY',
'                              WHERE ID = v_us_id',
'                                AND PRJ_ID = v_prj_id )',
'                   );',
'',
'    END IF;',
'--    END IF; ',
'END;'))
