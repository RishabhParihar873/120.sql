,p_process_sql_clob=>wwv_flow_string.join(wwv_flow_t_varchar2(
'DECLARE',
'    l_file_blob          BLOB;',
'    l_blob_size          NUMBER;',
'    l_raw_response       CLOB;',
'    l_http_status        NUMBER;',
'    l_clean_file_path    VARCHAR2(4000);',
'    l_service_request    CLOB;',
'',
'    l_extracted_text     CLOB;',
'    l_text_clob          CLOB;',
'    l_base64_clob        CLOB;',
'    l_docx_xml_blob      BLOB;',
'    l_docx_xml_clob      CLOB;',
'',
'    l_any_data_found     BOOLEAN := FALSE;',
'',
'    PROCEDURE append_text(p_text IN VARCHAR2) IS',
'    BEGIN',
'        IF p_text IS NOT NULL THEN',
'            DBMS_LOB.WRITEAPPEND(',
'                l_extracted_text,',
'                LENGTH(p_text),',
'                p_text',
'            );',
'        END IF;',
'    END;',
'',
'    PROCEDURE blob_to_clob(',
'        p_blob IN BLOB,',
'        p_clob IN OUT CLOB',
'    ) IS',
'        l_dest_offset  INTEGER := 1;',
'        l_src_offset   INTEGER := 1;',
'        l_lang_context INTEGER := DBMS_LOB.DEFAULT_LANG_CTX;',
'        l_warning      INTEGER;',
'    BEGIN',
'        DBMS_LOB.CREATETEMPORARY(p_clob, TRUE);',
'',
'        DBMS_LOB.CONVERTTOCLOB(',
'            dest_lob     => p_clob,',
'            src_blob     => p_blob,',
'            amount       => DBMS_LOB.LOBMAXSIZE,',
'            dest_offset  => l_dest_offset,',
'            src_offset   => l_src_offset,',
'            blob_csid    => NLS_CHARSET_ID(''AL32UTF8''),',
'            lang_context => l_lang_context,',
'            warning      => l_warning',
'        );',
'    END;',
'',
'BEGIN',
'    ------------------------------------------------------------------',
'    -- Clear page items',
'    ------------------------------------------------------------------',
'    :P1024_STATUS := NULL;',
'    :P1024_BLOB_SIZE := NULL;',
'    :P1024_FILE_CONTENT_PREVIEW := NULL;',
'    :P1024_RAW_RESPONSE := NULL;',
'    :P1024_CLEAN_FILE_PATH := NULL;',
'    :P1024_SERVICE_REQUEST := NULL;',
'',
'    ------------------------------------------------------------------',
'    -- Validate input',
'    ------------------------------------------------------------------',
'    IF :P1024_FILE_PATH IS NULL THEN',
'        :P1024_STATUS := ''Please enter file path.'';',
'        RETURN;',
'    END IF;',
'',
'    IF :P1024_FILE_NAME IS NULL THEN',
'        :P1024_STATUS := ''Please enter file name.'';',
'        RETURN;',
'    END IF;',
'',
'    ------------------------------------------------------------------',
'    -- Step 1: Download file into BLOB variable',
'    ------------------------------------------------------------------',
'    download_filep1_blob(',
'        P_TEMPLATE_FILE_PATH => :P1024_FILE_PATH,',
'        P_TEMPLATE_FILE_NAME => :P1024_FILE_NAME,',
'        P_file_content       => l_file_blob,',
'        P_raw_response       => l_raw_response,',
'        P_http_status        => l_http_status,',
'        P_clean_file_path    => l_clean_file_path,',
'        P_service_request    => l_service_request',
'    );',
'',
'    :P1024_CLEAN_FILE_PATH := l_clean_file_path;',
'',
'    IF l_service_request IS NOT NULL THEN',
'        :P1024_SERVICE_REQUEST := DBMS_LOB.SUBSTR(l_service_request, 32000, 1);',
'    END IF;',
'',
'    IF l_raw_response IS NOT NULL THEN',
'        :P1024_RAW_RESPONSE := DBMS_LOB.SUBSTR(l_raw_response, 32000, 1);',
'    END IF;',
'',
'    ------------------------------------------------------------------',
'    -- Stop if service failed',
'    ------------------------------------------------------------------',
'    IF l_http_status <> 200 THEN',
'        :P1024_STATUS := ''File service failed. HTTP Status: '' || l_http_status || ''. Check Clean File Path and Raw API Response.'';',
'        RETURN;',
'    END IF;',
'',
'    ------------------------------------------------------------------',
'    -- Stop if BLOB empty',
'    ------------------------------------------------------------------',
'    IF l_file_blob IS NULL OR DBMS_LOB.GETLENGTH(l_file_blob) = 0 THEN',
'        :P1024_STATUS := ''API call success, but BLOB is empty. Check Raw API Response.'';',
'        RETURN;',
'    END IF;',
'',
'    l_blob_size := DBMS_LOB.GETLENGTH(l_file_blob);',
'    :P1024_BLOB_SIZE := l_blob_size || '' bytes'';',
'',
'    DBMS_LOB.CREATETEMPORARY(l_extracted_text, TRUE);',
'',
'    ------------------------------------------------------------------',
'    -- Case 1: Excel files',
'    ------------------------------------------------------------------',
'    IF LOWER(:P1024_FILE_NAME) LIKE ''%.xlsx''',
'       OR LOWER(:P1024_FILE_NAME) LIKE ''%.xls''',
'    THEN',
'',
'        append_text(''Excel file detected.'' || CHR(10));',
'        append_text(''BLOB Size: '' || l_blob_size || '' bytes'' || CHR(10));',
'        append_text(''Clean File Path: '' || l_clean_file_path || CHR(10));',
'        append_text(''Reading worksheets. Empty/problem worksheets will be skipped.'' || CHR(10));',
'        append_text(''=================================================='' || CHR(10));',
'',
'        FOR s IN (',
'            SELECT',
'                sheet_sequence,',
'                sheet_display_name,',
'                sheet_file_name',
'            FROM TABLE(',
'                APEX_DATA_PARSER.GET_XLSX_WORKSHEETS(',
'                    p_content => l_file_blob',
'                )',
'            )',
'            ORDER BY sheet_sequence',
'        )',
'        LOOP',
'            BEGIN',
'                append_text(CHR(10));',
'                append_text(''Worksheet: '' || s.sheet_display_name || CHR(10));',
'                append_text(''--------------------------------------------------'' || CHR(10));',
'',
'                FOR r IN (',
'                    SELECT',
'                        line_number,',
'                        col001,',
'                        col002,',
'                        col003,',
'                        col004,',
'                        col005,',
'                        col006,',
'                        col007,',
'                        col008,',
'                        col009,',
'                        col010,',
'                        col011,',
'                        col012,',
'                        col013,',
'                        col014,',
'                        col015,',
'                        col016,',
'                        col017,',
'                        col018,',
'                        col019,',
'                        col020',
'                    FROM TABLE(',
'                        APEX_DATA_PARSER.PARSE(',
'                            p_content           => l_file_blob,',
'                            p_file_name         => :P1024_FILE_NAME,',
'                            p_xlsx_sheet_name   => s.sheet_display_name,',
'                            p_detect_data_types => ''N''',
'                        )',
'                    )',
'                    WHERE line_number <= 100',
