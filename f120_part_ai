'AND DT.PRJ_ID=P_PROJECT_ID)',
');',
'',
'------------KDD------------',
'',
'    INSERT INTO CGCT_PRJ_KEY_DECISION_DOCS',
'    (',
'        ID, KDD_ID, PRJ_ID, APPLICATION_ID,FILE_NAME,FILE_PATH,',
'        TOPIC_NAME, DESCRIPTION, GUIDELINE_NOTE,',
'        MILESTONE_NAME, CAPGEMINI_RECOMMENDATION,',
'        L3_ID, SIZING, STORY_POINTS, ESTIMATION_HOURS,',
'        COPY_FLAG,L1_ID,L2_ID,DOMAIN_ID,MODULE_ID,',
'        CREATION_DATE, CREATED_BY,',
'        LAST_UPDATE_DATE, LAST_UPDATE_BY,',
'        ACTIVE_FLAG,ENTITY_TAG,UPDATE_SOURCE',
'    )',
'    SELECT',
'        NULL, KDD.KDD_ID, P_PROJECT_ID, P_APPLICATION_ID,FILE_NAME,FILE_PATH,',
'        KDD.TOPIC_NAME, KDD.DESCRIPTION, KDD.GUIDELINE_NOTE,',
'        KDD.MILESTONE_NAME, KDD.CAPGEMINI_RECOMMENDATION,',
'        KDD.L3_ID, KDD.SIZING, KDD.STORY_POINTS, KDD.ESTIMATION_HOURS,',
'        ''Y'',KDD.L1_ID,KDD.L2_ID,KDD.DOMAIN_ID,KDD.MODULE_ID,',
