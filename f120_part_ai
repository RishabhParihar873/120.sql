'    apex_debug.message(''Pipeline Status: '' || l_pipeline_status || ',
'                       '' %:'' || l_pct_complete);',
'',
'    EXIT WHEN l_pipeline_status = ''COMPLETED'';',
'',
unistr(' DBMS_SESSION.SLEEP(10); -- \2705 wait 10 seconds'),
'END LOOP;',
'',
unistr('-- \2705 MESSAGE AFTER PIPELINE'),
'apex_debug.message(''Pipeline completed successfully.'');',
'    ------------------------------------------------------------',
unistr('    -- 4. VALIDATE \2705'),
