,p_parent_plug_id=>wwv_flow_imp.id(429587576920802709)
,p_region_template_options=>'#DEFAULT#:t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc'
,p_plug_template=>2100526641005906379
,p_plug_display_sequence=>320
,p_plug_display_point=>'SUB_REGIONS'
,p_plug_item_display_point=>'ABOVE'
,p_query_type=>'SQL'
,p_plug_source=>wwv_flow_string.join(wwv_flow_t_varchar2(
'SELECT',
'    PHASE_NAME,',
'    WORKSTREAM,',
'    START_DATE,',
'    END_DATE,',
'    TOTAL,',
'    COMPLETED,',
'    ON_TRACK,',
'    PAST_DUE,',
'    PAST_DUE_PCT,',
'    UNASSIGNED,',
'    UNASSIGNED_PCT,',
'    NOT_STARTED,',
'    NOT_STARTED_PCT,',
'',
unistr('    -- \2705 Individual column classes'),
'    CASE ',
'        WHEN PAST_DUE_PCT <= 10 THEN ''green-cell''',
'        WHEN PAST_DUE_PCT <= 50 THEN ''yellow-cell''',
'        ELSE ''red-cell''',
'    END AS PAST_DUE_CLASS,',
'',
'    CASE ',
'        WHEN UNASSIGNED_PCT <= 10 THEN ''green-cell''',
'        WHEN UNASSIGNED_PCT <= 50 THEN ''yellow-cell''',
'        ELSE ''red-cell''',
'    END AS UNASSIGNED_CLASS,',
'',
'    CASE ',
'        WHEN NOT_STARTED_PCT <= 10 THEN ''green-cell''',
'        WHEN NOT_STARTED_PCT <= 50 THEN ''yellow-cell''',
'        ELSE ''red-cell''',
'    END AS NOT_STARTED_CLASS,',
'',
unistr('    -- \2705 Overall Status'),
'    CASE ',
'        WHEN GREATEST(PAST_DUE_PCT, UNASSIGNED_PCT, NOT_STARTED_PCT) = PAST_DUE_PCT THEN',
'            CASE ',
'                WHEN PAST_DUE_PCT <= 10 THEN ',
'                    ''<span class="fa fa-circle status-green-ir" title="Past Due"></span>''',
'                WHEN PAST_DUE_PCT <= 50 THEN ',
'                    ''<span class="fa fa-circle status-yellow-ir" title="Past Due"></span>''',
'                ELSE ',
'                    ''<span class="fa fa-circle status-red-ir" title="Past Due"></span>''',
'            END',
'',
'        WHEN GREATEST(PAST_DUE_PCT, UNASSIGNED_PCT, NOT_STARTED_PCT) = UNASSIGNED_PCT THEN',
'            CASE ',
'                WHEN UNASSIGNED_PCT <= 10 THEN ',
'                    ''<span class="fa fa-circle status-green-ir" title="Unassigned"></span>''',
'                WHEN UNASSIGNED_PCT <= 50 THEN ',
'                    ''<span class="fa fa-circle status-yellow-ir" title="Unassigned"></span>''',
'                ELSE ',
'                    ''<span class="fa fa-circle status-red-ir" title="Unassigned"></span>''',
'            END',
'',
'        ELSE',
'            CASE ',
'                WHEN NOT_STARTED_PCT <= 10 THEN ',
'                    ''<span class="fa fa-circle status-green-ir" title="Not Started"></span>''',
'                WHEN NOT_STARTED_PCT <= 50 THEN ',
'                    ''<span class="fa fa-circle status-yellow-ir" title="Not Started"></span>''',
'                ELSE ',
'                    ''<span class="fa fa-circle status-red-ir" title="Not Started"></span>''',
'            END',
'    END AS OVERALL_STATUS',
'',
'FROM (',
'    SELECT',
'        p.PHASE_DISPLAY_NAME AS PHASE_NAME,',
'        l.WORKSTREAM,   ',
'        MIN(l.PLANNED_START) AS START_DATE,',
'        MAX(l.PLANNED_END)   AS END_DATE,',
'',
'        COUNT(l.PROJECT_PLAN_LINE_ID) AS TOTAL,',
'',
'        SUM(CASE WHEN UPPER(l.STATUS) = ''COMPLETED'' THEN 1 ELSE 0 END) AS COMPLETED,',
'        SUM(CASE WHEN UPPER(l.STATUS) = ''WIP'' THEN 1 ELSE 0 END) AS ON_TRACK,',
'',
unistr('        -- \2705 Past Due'),
'        SUM(CASE ',
'                WHEN l.PLANNED_END < TRUNC(SYSDATE)',
'                 AND UPPER(l.STATUS) != ''COMPLETED''',
'             THEN 1 ELSE 0 ',
'        END) AS PAST_DUE,',
'',
'        ROUND(',
'            SUM(CASE ',
'                    WHEN l.PLANNED_END < TRUNC(SYSDATE)',
'                     AND UPPER(l.STATUS) != ''COMPLETED''',
'                 THEN 1 ELSE 0 ',
'            END) * 100 /',
'            NULLIF(COUNT(l.PROJECT_PLAN_LINE_ID), 0)',
'        ,0) AS PAST_DUE_PCT,',
'',
unistr('        -- \2705 Unassigned (UPDATED \2705 Start date must be passed)'),
'        SUM(CASE ',
'                WHEN l.ASSIGNED_TO IS NULL',
'                 AND l.PLANNED_START < TRUNC(SYSDATE)',
'                 ',
'                 ',
'             THEN 1 ELSE 0 ',
'        END) AS UNASSIGNED,',
'',
'        ROUND(',
'            SUM(CASE ',
'                    WHEN l.ASSIGNED_TO IS NULL',
'                     AND l.PLANNED_START < TRUNC(SYSDATE)',
'                     ',
'                 THEN 1 ELSE 0 ',
'            END) * 100 /',
'            NULLIF(COUNT(l.PROJECT_PLAN_LINE_ID), 0)',
'        ,0) AS UNASSIGNED_PCT,',
'',
unistr('        -- \2705 Not Started (Already correct)'),
'        SUM(CASE ',
'                WHEN UPPER(l.STATUS) = ''NOT STARTED''',
'                 AND l.PLANNED_START < TRUNC(SYSDATE)',
'',
'             THEN 1 ELSE 0 ',
'        END) AS NOT_STARTED,',
'',
'        ROUND(',
'            SUM(CASE ',
'                    WHEN UPPER(l.STATUS) = ''NOT STARTED''',
'                     AND l.PLANNED_START < TRUNC(SYSDATE)',
'                 THEN 1 ELSE 0 ',
'            END) * 100 /',
'            NULLIF(COUNT(l.PROJECT_PLAN_LINE_ID), 0)',
'        ,0) AS NOT_STARTED_PCT',
'',
'    FROM CGCT_PP_PROJECT_PHASE p',
'    LEFT JOIN CGCT_PP_PLAN_LINE l',
'        ON l.PHASE_ID = p.PROJECT_PHASE_ID',
'       AND l.PRJ_ID = :P0_PRJ_ID',
'    --    AND l.WAVE_ID = :P1026_WAVE',
'    ',
'    AND l.WAVE_ID IN (',
'        SELECT COLUMN_VALUE',
'        FROM TABLE(apex_string.split(:P1022_WAVE,'':''))',
'    )',
'',
'',
'    WHERE p.PROJECT_ID = :P0_PRJ_ID',
'    --   AND p.WAVE_ID = :P1026_WAVE',
'    ',
'    AND p.WAVE_ID IN (',
'        SELECT COLUMN_VALUE',
'        FROM TABLE(apex_string.split(:P1022_WAVE,'':''))',
'    )',
'',
'      AND p.REFERENCE_PHASE_ID IS NULL',
'      AND l.WORKSTREAM =:P1022_SELECTED_WORKSTREAM',
'',
'    -- GROUP BY p.PHASE_DISPLAY_NAME, p.PROJECT_PHASE_ID, l.WORKSTREAM',
'    GROUP BY p.PHASE_DISPLAY_NAME, l.WORKSTREAM',
')',
'ORDER BY PHASE_NAME, WORKSTREAM;',
''))
